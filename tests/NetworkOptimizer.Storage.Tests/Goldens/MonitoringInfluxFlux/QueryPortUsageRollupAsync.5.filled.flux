from(bucket: "network_monitoring_longterm")
  |> range(start: 2026-01-15T10:00:00Z, stop: 2026-01-15T12:00:00Z)
  |> filter(fn: (r) => r._measurement == "interface_counters")
  |> filter(fn: (r) => r.device_mac == "aa:bb:cc:dd:ee:ff")
  |> filter(fn: (r) => r.if_name == "eth0.10" or r.if_name == "eth8")
  |> filter(fn: (r) => r._field == "bytes_in_1h" or r._field == "bytes_out_1h" or r._field == "rollup_v")
  |> pivot(rowKey:["_time"], columnKey: ["_field"], valueColumn: "_value")
  |> filter(fn: (r) => exists r.bytes_in_1h and exists r.bytes_out_1h and exists r.rollup_v and r.rollup_v >= 5)
  |> group(columns: ["_time"])
  |> reduce(fn: (r, accumulator) => ({to: accumulator.to + r.bytes_out_1h, from: accumulator.from + r.bytes_in_1h}), identity: {to: 0, from: 0})
  |> group()
  |> sort(columns: ["_time"])