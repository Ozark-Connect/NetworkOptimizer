
from(bucket: "network_monitoring_longterm")
  |> range(start: 2026-01-15T10:00:00Z, stop: 2026-01-15T12:00:00Z)
  |> filter(fn: (r) => r._measurement == "sfp")
  |> filter(fn: (r) => (r.device_mac == "cd" and r.port_name == "3") or (r.device_mac == "deceac" and r.port_name == "AA-BB-CC-DD-EE-FF"))
  |> filter(fn: (r) => r._field == "pon_link_status" or r._field == "pon_link_status_prev" or r._field == "onu_id" or r._field == "ds_fec_enabled" or r._field == "us_fec_enabled" or r._field == "onu_response_time" or r._field == "sfp_uptime_s" or r._field == "ploam_elapsed_ms" or r._field == "bip_errors" or r._field == "fec_errors" or r._field == "fec_corrected_words" or r._field == "hec_corrected" or r._field == "hec_uncorrected" or r._field == "bwmap_corrected" or r._field == "bwmap_uncorrected" or r._field == "gem_tx_frames" or r._field == "gem_tx_idle_frames" or r._field == "gem_rx_frames" or r._field == "gem_rx_idle_frames" or r._field == "ds_superframe" or r._field == "gem_rx_dropped" or r._field == "alloc_total" or r._field == "gem_tx_bytes" or r._field == "us_bursts" or r._field == "us_dbru" or r._field == "o5_seconds" or r._field == "not_o5_seconds" or r._field == "o5_exits" or r._field == "los_events" or r._field == "los_seconds" or r._field == "lof_events" or r._field == "lof_seconds" or r._field == "olt_deactivations" or r._field == "boot_count" or r._field == "last_reset_reason" or r._field == "ont_bias_ma" or r._field == "bias_warn_high_ma" or r._field == "transceiver_alarm_count" or r._field == "transceiver_alarms" or r._field == "fec_corrected_bits" or r._field == "omci_rx_frames" or r._field == "mib_data_sync" or r._field == "omci_up" or r._field == "omci_services" or r._field == "ploam_request_key" or r._field == "ploam_key_switch" or r._field == "ploam_ranging_time" or r._field == "td_pir_bytes_s" or r._field == "td_cir_bytes_s" or r._field == "host_link_up" or r._field == "eqd_bits" or r._field == "pon_id_age_s" or r._field == "cpu_busy_s" or r._field == "cpu_total_s" or r._field == "ont_tx_power_dbm" or r._field == "ont_temperature_c" or r._field == "ds_superframe_sampled" or r._field == "gem_rx_bytes" or r._field == "olt_launch_power_dbm" or r._field == "odn_class" or r._field == "reach_extender" or r._field == "path_loss_db" or r._field == "alloc_lost" or r._field == "lan_link_status" or r._field == "lan_mode" or r._field == "lan_rx_fcs_err" or r._field == "lan_tx_drop_events" or r._field == "lan_buffer_overflow" or r._field == "olt_vendor_id" or r._field == "registration_status" or r._field == "key_exchange_status" or r._field == "firmware_version" or r._field == "olt_equipment_id" or r._field == "olt_version")
  |> aggregateWindow(every: 48s, fn: last, createEmpty: false)
  |> pivot(rowKey:["_time"], columnKey: ["_field"], valueColumn: "_value")
