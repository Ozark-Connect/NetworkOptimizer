from(bucket: "network_monitoring_longterm")
  |> range(start: 2026-01-15T10:00:00Z, stop: 2026-01-15T12:00:00Z)
  |> filter(fn: (r) => r._measurement == "wifi_client" and r.client_mac == "aa:bb:cc:dd:ee:ff")
  |> filter(fn: (r) => r._field == "tx_bytes_1h" or r._field == "rx_bytes_1h" or r._field == "rollup_v")
  |> pivot(rowKey:["_time"], columnKey: ["_field"], valueColumn: "_value")
  |> filter(fn: (r) => exists r.tx_bytes_1h and exists r.rollup_v and r.rollup_v >= 5)
  |> group(columns: ["_time"])
  |> reduce(fn: (r, accumulator) => ({to: accumulator.to + r.tx_bytes_1h, from: accumulator.from + r.rx_bytes_1h}), identity: {to: 0, from: 0})
  |> group()
  |> sort(columns: ["_time"])