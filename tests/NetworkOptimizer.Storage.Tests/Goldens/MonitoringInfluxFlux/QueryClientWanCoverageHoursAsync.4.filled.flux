from(bucket: "network_monitoring")
  |> range(start: 2026-01-15T10:00:00Z, stop: 2026-01-15T12:00:00Z)
  |> filter(fn: (r) => r._measurement == "client_wan" and r.client_mac == "_coverage")
  |> filter(fn: (r) => r._field == "window_seconds")
  |> truncateTimeColumn(unit: 1h)
  |> group(columns: ["_time"])
  |> sum()
  |> group()
----
from(bucket: "network_monitoring_longterm")
  |> range(start: 2026-01-15T10:00:00Z, stop: 2026-01-15T12:00:00Z)
  |> filter(fn: (r) => r._measurement == "client_wan" and r.client_mac == "_coverage")
  |> filter(fn: (r) => r._field == "coverage_seconds_1h")
  |> group(columns: ["_time"])
  |> sum()
  |> group()