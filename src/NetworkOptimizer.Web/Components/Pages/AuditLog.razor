@page "/audit-log"
@rendermode InteractiveServer
@using NetworkOptimizer.Storage.Models.Identity
@using NetworkOptimizer.Web.Services.Auditing
@inject IAuditQueryService AuditQuery

<PageTitle>Audit Log - Network Optimizer</PageTitle>

<div class="page-header">
    <h1>Audit Log</h1>
    <p class="page-description">Authentication, access, and configuration changes across all sites.</p>
</div>

<div class="card">
    <div class="card-body">
        <div class="time-range-selector" style="flex-wrap: wrap; gap: 0.5rem;">
            <select class="form-control" @bind="_category" style="max-width: 180px;">
                <option value="">All categories</option>
                @foreach (var c in Categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
            <select class="form-control" @bind="_outcome" style="max-width: 160px;">
                <option value="">All outcomes</option>
                <option value="@AuditOutcomes.Success">Success</option>
                <option value="@AuditOutcomes.Denied">Denied</option>
                <option value="@AuditOutcomes.Failure">Failure</option>
            </select>
            <input class="form-control" placeholder="Actor" @bind="_actor" style="max-width: 160px;" />
            <input class="form-control" placeholder="Site slug" @bind="_site" style="max-width: 160px;" />
            <button class="btn btn-primary btn-sm" @onclick="ApplyAsync">Filter</button>
            <a class="btn btn-secondary btn-sm" href="@ExportUrl("csv")" target="_blank" rel="noopener">Export CSV</a>
            <a class="btn btn-secondary btn-sm" href="@ExportUrl("json")" target="_blank" rel="noopener">Export JSON</a>
        </div>

        @if (_loading)
        {
            <div class="loading-container"><span class="spinner"></span></div>
        }
        else if (_events.Count == 0)
        {
            <div class="empty-state"><p>No audit events match the current filter.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Time (UTC)</th><th>Category</th><th>Action</th>
                            <th>Actor</th><th class="hide-mobile">Site</th><th>Outcome</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _events)
                        {
                            <tr>
                                <td>@e.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@e.Category</td>
                                <td>@e.Action</td>
                                <td>@e.ActorName</td>
                                <td class="hide-mobile">@e.SiteSlug</td>
                                <td>
                                    <span class="status-badge @OutcomeClass(e.Outcome)">@e.Outcome</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(e.DetailsJson))
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Toggle(e.Id)">Details</button>
                                    }
                                </td>
                            </tr>
                            @if (_expanded == e.Id)
                            {
                                <tr>
                                    <td colspan="7"><pre class="detail-value">@e.DetailsJson</pre></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div style="margin-top: 1rem; display: flex; gap: 0.5rem; align-items: center;">
                <button class="btn btn-sm btn-secondary" disabled="@(_skip == 0)" @onclick="PrevAsync">Previous</button>
                <span class="text-muted">@(_skip + 1)-@(_skip + _events.Count) of @_total</span>
                <button class="btn btn-sm btn-secondary" disabled="@(_skip + PageSize >= _total)" @onclick="NextAsync">Next</button>
            </div>
        }
    </div>
</div>

@code {
    private const int PageSize = 100;
    private static readonly string[] Categories =
    {
        AuditCategories.Auth, AuditCategories.User, AuditCategories.Rbac, AuditCategories.Federation,
        AuditCategories.Settings, AuditCategories.Site, AuditCategories.Action, AuditCategories.License,
        AuditCategories.Agent, AuditCategories.Audit,
    };

    private List<AuditEvent> _events = new();
    private int _total;
    private int _skip;
    private bool _loading = true;
    private long? _expanded;

    private string _category = "";
    private string _outcome = "";
    private string _actor = "";
    private string _site = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private AuditFilter CurrentFilter() => new()
    {
        Category = Empty(_category),
        Outcome = Empty(_outcome),
        Actor = Empty(_actor),
        SiteSlug = Empty(_site),
        Skip = _skip,
        Take = PageSize,
    };

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        var filter = CurrentFilter();
        _total = await AuditQuery.CountAsync(filter);
        _events = (await AuditQuery.QueryAsync(filter)).ToList();
        _loading = false;
    }

    private async Task ApplyAsync() { _skip = 0; await LoadAsync(); }
    private async Task NextAsync() { _skip += PageSize; await LoadAsync(); }
    private async Task PrevAsync() { _skip = Math.Max(0, _skip - PageSize); await LoadAsync(); }
    private void Toggle(long id) => _expanded = _expanded == id ? null : id;

    private string ExportUrl(string format)
    {
        var query = new List<string>();
        if (!string.IsNullOrEmpty(_category)) query.Add($"category={Uri.EscapeDataString(_category)}");
        if (!string.IsNullOrEmpty(_outcome)) query.Add($"outcome={Uri.EscapeDataString(_outcome)}");
        if (!string.IsNullOrEmpty(_actor)) query.Add($"actor={Uri.EscapeDataString(_actor)}");
        if (!string.IsNullOrEmpty(_site)) query.Add($"site={Uri.EscapeDataString(_site)}");
        var suffix = query.Count > 0 ? "?" + string.Join("&", query) : "";
        return $"/api/audit/export.{format}{suffix}";
    }

    private static string OutcomeClass(string outcome) => outcome switch
    {
        AuditOutcomes.Denied => "status-active",
        AuditOutcomes.Failure => "status-active",
        _ => "",
    };

    private static string? Empty(string v) => string.IsNullOrEmpty(v) ? null : v;
}
