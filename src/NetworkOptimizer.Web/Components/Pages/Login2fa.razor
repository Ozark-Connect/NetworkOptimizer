@page "/login/2fa"
@layout AuthLayout
@using NetworkOptimizer.Web.Services
@* Static SSR: the second-factor step posts to /api/auth/2fa, which issues the cookie. *@

<PageTitle>Two-factor authentication - Network Optimizer</PageTitle>

<div class="login-container">
    <div class="login-card">
        <a class="login-back" href="@BackUrl()" aria-label="Back to sign in">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
            Back
        </a>
        <div class="login-header">
            <img src="/images/ozark-connect-logo.png" alt="Network Optimizer" class="login-logo" />
            <h1>Two-factor authentication</h1>
        </div>

        <form method="post" action="/api/auth/2fa">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/")" />
            @if (StaySignedIn)
            {
                <input type="hidden" name="rememberMe" value="true" />
            }
            @if (!string.IsNullOrEmpty(Site))
            {
                <input type="hidden" name="@SiteContextService.SiteQueryParam" value="@Site" />
            }

            @if (!_useRecovery)
            {
                <div class="form-group">
                    <label class="form-label" for="code">Authenticator code</label>
                    <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code"
                           class="form-control" placeholder="123456" autofocus />
                </div>
                <label class="remember-device">
                    <input type="checkbox" name="rememberMachine" value="true" /> Remember this device
                </label>
            }
            else
            {
                <div class="form-group">
                    <label class="form-label" for="recoveryCode">Recovery code</label>
                    <input id="recoveryCode" name="recoveryCode" type="text" autocomplete="one-time-code"
                           class="form-control" placeholder="One of the codes you saved at setup" autofocus />
                </div>
            }

            <button type="submit" class="btn btn-primary login-btn">Verify</button>

            @if (Error == "invalid")
            {
                <div class="alert alert-danger">That code wasn't valid. Try again.</div>
            }
        </form>

        @* A registered passkey is a second factor in its own right, so an account that has one should
           not be forced through an authenticator code to finish signing in. Offered above the recovery
           link because it is the everyday route; recovery is the fallback. *@
        @if (HasPasskey)
        {
            <button type="button" class="btn btn-secondary login-btn login-alt-signin" onclick="netoptPasskey.login()">
                Use a passkey
            </button>
        }

        @if (_hasRecoveryCodes)
        {
            <div class="login-footer">
                <a href="@ToggleUrl()">@(_useRecovery ? "Use an authenticator code" : "Use a recovery code")</a>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private bool Recovery { get; set; }

    /// <summary>
    /// Set by the sign-in endpoint when the pending account holds recovery codes. It arrives in the
    /// query rather than being looked up here: this page renders twice and only the prerendered pass
    /// can read the pending two-factor cookie, so a lookup would disagree with itself.
    /// </summary>
    [SupplyParameterFromQuery(Name = "rc")] private bool HasRecoveryCodes { get; set; }

    /// <summary>
    /// Set by the sign-in endpoint when the pending account has a passkey registered. Arrives in the
    /// query for the same reason as <c>rc</c>: this page cannot read the pending-2FA cookie itself.
    /// </summary>
    [SupplyParameterFromQuery(Name = "pk")] private bool HasPasskey { get; set; }

    /// <summary>
    /// Whether "Keep me signed in" was ticked on the first page. The final sign-in happens here, so
    /// without carrying it an account with a second factor would always get a session-scoped cookie.
    /// </summary>
    [SupplyParameterFromQuery(Name = "rm")] private bool StaySignedIn { get; set; }

    [SupplyParameterFromQuery(Name = SiteContextService.SiteQueryParam)]
    private string? Site { get; set; }

    private bool _useRecovery;

    // Offering the recovery route to an account with no codes is a dead end: the link switches the
    // form over and nothing the user types can ever match.
    private bool _hasRecoveryCodes => HasRecoveryCodes;

    protected override void OnInitialized() => _useRecovery = Recovery && HasRecoveryCodes;

    private string BackUrl()
    {
        var query = string.IsNullOrEmpty(Site)
            ? ""
            : $"?{SiteContextService.SiteQueryParam}={Uri.EscapeDataString(Site)}";
        return $"/login{query}";
    }

    private string ToggleUrl()
    {
        var target = _useRecovery ? "false" : "true";
        var query = $"recovery={target}";
        if (HasRecoveryCodes) query += "&rc=true";
        if (HasPasskey) query += "&pk=true";
        if (StaySignedIn) query += "&rm=true";
        if (!string.IsNullOrEmpty(ReturnUrl)) query += $"&returnUrl={Uri.EscapeDataString(ReturnUrl)}";
        if (!string.IsNullOrEmpty(Site)) query += $"&{SiteContextService.SiteQueryParam}={Uri.EscapeDataString(Site)}";
        return $"/login/2fa?{query}";
    }
}
