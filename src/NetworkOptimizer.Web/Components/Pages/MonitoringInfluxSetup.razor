@page "/monitoring/setup-influxdb"
@rendermode InteractiveServer
@using NetworkOptimizer.Storage.Models
@using NetworkOptimizer.Storage.Services
@using NetworkOptimizer.Web.Services
@using Microsoft.EntityFrameworkCore
@inject InfluxDbProvisioningService Provisioner
@inject MonitoringInfluxClient InfluxClient
@inject ICredentialProtectionService CredentialService
@inject IDbContextFactory<NetworkOptimizerDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Set up InfluxDB - Network Optimizer</PageTitle>

<div class="page-header">
    <a href="/monitoring" class="page-back-link back-link">← Back to Monitoring</a>
    <h1>Set up InfluxDB</h1>
    <p class="page-description">
        Network Optimizer needs an InfluxDB instance to store time-series monitoring data.
        This wizard will detect what's available, create a dedicated org and buckets, and
        issue a least-privilege token for ongoing use. <strong>Your admin API token is used
        only during this setup — Network Optimizer never stores it.</strong>
    </p>
</div>

@switch (_state)
{
    case Step.Detecting:
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Looking for InfluxDB</h2>
            </div>
            <div class="card-body">
                <div class="empty-state">
                    <span class="spinner"></span>
                    <p>Probing common URLs...</p>
                </div>
            </div>
        </div>
        break;

    case Step.UrlNotFound:
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">No InfluxDB found</h2>
                <span class="status-badge status-disconnected">Not reachable</span>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    We tried these URLs but none responded:
                    <ul style="margin: 0.5rem 0 0 1.25rem;">
                        @if (_probe?.CandidatesTried != null)
                        {
                            foreach (var c in _probe.CandidatesTried) { <li><code>@c</code></li> }
                        }
                    </ul>
                </div>

                <details class="setup-guide" open>
                    <summary>Install InfluxDB</summary>
                    <div class="setup-guide-content">
                        <p><strong>Docker</strong> (recommended for NAS / Linux hosts):</p>
                        <pre><code>docker run -d --name influxdb -p 8086:8086 \
  -v influxdb-data:/var/lib/influxdb2 \
  influxdb:2</code></pre>
                        <p><strong>macOS</strong>: <code>brew install influxdb && brew services start influxdb</code></p>
                        <p><strong>Other</strong>: see the <a href="https://docs.influxdata.com/influxdb/v2/install/" target="_blank" rel="noopener">InfluxDB install docs</a>.</p>
                        <p>Once it's running, finish the initial setup at <code>http://localhost:8086</code> to create an admin user and an all-access API token, then come back here.</p>
                    </div>
                </details>

                <div class="form-group" style="margin-top: 1rem;">
                    <label class="form-label">Or enter a URL manually</label>
                    <input type="text" class="form-control" @bind="_manualUrl" placeholder="http://localhost:8086" />
                </div>

                <div class="action-buttons">
                    <button class="btn btn-secondary" @onclick="DetectAgainAsync" disabled="@_busy">Detect again</button>
                    <button class="btn btn-primary" @onclick="UseManualUrlAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_manualUrl))">Use this URL</button>
                </div>
            </div>
        </div>
        break;

    case Step.UrlFound:
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">InfluxDB found</h2>
                <span class="status-badge status-connected">Reachable</span>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">URL</label>
                    <div class="form-value">
                        <code>@_probe?.Url</code>
                        @if (!string.IsNullOrEmpty(_probe?.Version))
                        {
                            <span class="page-description" style="margin-left: 0.5rem;">v@_probe.Version</span>
                        }
                    </div>
                </div>
                <p class="section-description">
                    Provide an <strong>admin (all-access)</strong> API token so we can create
                    a dedicated org and the required buckets, then issue a scoped token for
                    Network Optimizer's day-to-day use. The admin token is held in memory
                    for this request and discarded immediately after — it's never saved to
                    disk.
                </p>
                <div class="form-group">
                    <label class="form-label">Admin API token</label>
                    <input type="password" class="form-control" @bind="_adminToken" placeholder="Paste your InfluxDB admin token" />
                </div>
                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert alert-@_messageClass">@_message</div>
                }
                <div class="action-buttons">
                    <button class="btn btn-secondary" @onclick="DetectAgainAsync" disabled="@_busy">Use a different URL</button>
                    <button class="btn btn-primary" @onclick="ValidateTokenAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_adminToken))">
                        @if (_busy) { <span class="spinner-sm"></span> <span>Verifying...</span> }
                        else { <span>Continue</span> }
                    </button>
                </div>
            </div>
        </div>
        break;

    case Step.PickOrg:
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Choose an organization</h2>
                <span class="status-badge status-connected">Authenticated@(string.IsNullOrEmpty(_authedAs) ? "" : $" as {_authedAs}")</span>
            </div>
            <div class="card-body">
                <p class="section-description">
                    By default we'll create a new InfluxDB org named
                    <code>@_newOrgName</code>. This keeps Network Optimizer's data fully
                    isolated — if you ever drop monitoring, you can just delete that one
                    org. If you'd rather reuse one of your existing orgs, pick it below.
                </p>

                <div class="form-group">
                    <label class="form-label">
                        <input type="radio" name="orgChoice" checked="@(_orgChoice == OrgChoice.CreateNew)"
                               @onchange="() => { _orgChoice = OrgChoice.CreateNew; StateHasChanged(); }" />
                        Create a new org
                    </label>
                    @if (_orgChoice == OrgChoice.CreateNew)
                    {
                        <input type="text" class="form-control" @bind="_newOrgName" style="margin-top: 0.5rem; max-width: 320px;" />
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <input type="radio" name="orgChoice" checked="@(_orgChoice == OrgChoice.UseExisting)"
                               @onchange="() => { _orgChoice = OrgChoice.UseExisting; StateHasChanged(); }" />
                        Use an existing org
                    </label>
                    @if (_orgChoice == OrgChoice.UseExisting)
                    {
                        @if (_orgs.Count == 0)
                        {
                            <div class="alert alert-info" style="margin-top: 0.5rem;">
                                No existing orgs found. Create a new one above.
                            </div>
                        }
                        else
                        {
                            <select class="form-control" @bind="_selectedOrgId" style="margin-top: 0.5rem; max-width: 320px;">
                                @foreach (var org in _orgs)
                                {
                                    <option value="@org.Id">@org.Name</option>
                                }
                            </select>
                        }
                    }
                </div>

                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="alert alert-@_messageClass">@_message</div>
                }

                <div class="action-buttons">
                    <button class="btn btn-secondary" @onclick="() => _state = Step.UrlFound" disabled="@_busy">Back</button>
                    <button class="btn btn-primary" @onclick="ProvisionAsync" disabled="@(_busy || !CanProvision)">
                        @if (_busy) { <span class="spinner-sm"></span> <span>Provisioning...</span> }
                        else { <span>Provision</span> }
                    </button>
                </div>
            </div>
        </div>
        break;

    case Step.Done:
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">InfluxDB ready</h2>
                <span class="status-badge status-connected">Set up</span>
            </div>
            <div class="card-body">
                <div class="alert alert-success">
                    Buckets created and a scoped token has been saved. Monitoring will start
                    once enabled.
                </div>
                <div class="action-buttons">
                    <a href="/monitoring" class="btn btn-primary">Go to Monitoring</a>
                </div>
            </div>
        </div>
        break;
}

@code {
    private Step _state = Step.Detecting;
    private InfluxDbProvisioningService.UrlProbeResult? _probe;
    private string _manualUrl = string.Empty;
    private string _adminToken = string.Empty;
    private string? _authedAs;
    private List<InfluxDbProvisioningService.InfluxOrg> _orgs = new();
    private OrgChoice _orgChoice = OrgChoice.CreateNew;
    private string _newOrgName = "network-optimizer";
    private string? _selectedOrgId;
    private bool _busy;
    private string? _message;
    private string _messageClass = "info";

    private bool CanProvision => _orgChoice == OrgChoice.CreateNew
        ? !string.IsNullOrWhiteSpace(_newOrgName)
        : !string.IsNullOrEmpty(_selectedOrgId);

    protected override async Task OnInitializedAsync()
    {
        await DetectAgainAsync();
    }

    private async Task DetectAgainAsync()
    {
        _state = Step.Detecting;
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            _probe = await Provisioner.AutoDetectUrlAsync();
            _state = _probe.Reachable ? Step.UrlFound : Step.UrlNotFound;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task UseManualUrlAsync()
    {
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            _probe = await Provisioner.ProbeAsync(_manualUrl.Trim());
            if (_probe.Reachable)
            {
                _state = Step.UrlFound;
            }
            else
            {
                _message = $"Couldn't reach {_manualUrl}: {_probe.Error}";
                _messageClass = "warning";
            }
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ValidateTokenAsync()
    {
        if (_probe == null || string.IsNullOrEmpty(_probe.Url)) return;
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            var result = await Provisioner.ValidateAdminTokenAsync(_probe.Url, _adminToken.Trim());
            if (!result.Valid)
            {
                _message = result.Error ?? "Token validation failed";
                _messageClass = "danger";
                return;
            }
            _authedAs = result.UserName;

            try
            {
                _orgs = (await Provisioner.ListOrgsAsync(_probe.Url, _adminToken.Trim())).ToList();
            }
            catch (Exception ex)
            {
                _message = $"Authenticated, but couldn't list orgs: {ex.Message}";
                _messageClass = "warning";
                _orgs = new();
            }

            _orgChoice = OrgChoice.CreateNew;
            _selectedOrgId = _orgs.FirstOrDefault()?.Id;
            _state = Step.PickOrg;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ProvisionAsync()
    {
        if (_probe == null) return;
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            var url = _probe.Url;
            var adminToken = _adminToken.Trim();

            // 1. Resolve org
            InfluxDbProvisioningService.InfluxOrg org;
            if (_orgChoice == OrgChoice.CreateNew)
            {
                org = await Provisioner.CreateOrgAsync(url, adminToken, _newOrgName.Trim());
            }
            else
            {
                org = _orgs.First(o => o.Id == _selectedOrgId);
            }
            if (string.IsNullOrEmpty(org.Id))
                throw new InvalidOperationException("Org has no ID");

            // 2. Ensure buckets
            var settings = await GetOrCreateSettingsRowAsync();
            var primaryName = string.IsNullOrWhiteSpace(settings.InfluxDbBucket) ? "network_monitoring" : settings.InfluxDbBucket;
            var longtermName = string.IsNullOrWhiteSpace(settings.InfluxDbLongtermBucket) ? "network_monitoring_longterm" : settings.InfluxDbLongtermBucket;
            var bucketResult = await Provisioner.EnsureBucketsAsync(url, adminToken, org.Id, primaryName, longtermName);

            // 3. Issue scoped token
            var scoped = await Provisioner.CreateScopedTokenAsync(url, adminToken, org.Id, bucketResult.PrimaryBucketId, bucketResult.LongtermBucketId);

            // 4. Persist everything except the admin token (which we drop on next line)
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.MonitoringSettings.FirstAsync();
            row.InfluxDbUrl = url;
            row.InfluxDbOrg = org.Name ?? _newOrgName;
            row.InfluxDbBucket = bucketResult.PrimaryBucketName;
            row.InfluxDbLongtermBucket = bucketResult.LongtermBucketName;
            row.InfluxDbToken = CredentialService.Encrypt(scoped.Token);
            row.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
            _adminToken = string.Empty; // drop the admin token explicitly

            // 5. Reconfigure the runtime client and health-check
            await InfluxClient.ReconfigureAsync();
            await InfluxClient.CheckHealthAsync();

            _state = Step.Done;
        }
        catch (Exception ex)
        {
            _message = $"Provisioning failed: {ex.Message}";
            _messageClass = "danger";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task<MonitoringSettings> GetOrCreateSettingsRowAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var row = await db.MonitoringSettings.FirstOrDefaultAsync();
        if (row == null)
        {
            row = new MonitoringSettings();
            db.MonitoringSettings.Add(row);
            await db.SaveChangesAsync();
        }
        return row;
    }

    public enum Step
    {
        Detecting,
        UrlNotFound,
        UrlFound,
        PickOrg,
        Done
    }

    public enum OrgChoice
    {
        CreateNew,
        UseExisting
    }
}
