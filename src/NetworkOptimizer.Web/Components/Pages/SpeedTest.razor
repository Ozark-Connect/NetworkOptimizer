    // and fallback path re-computes trace against this site's topology.
    private INetworkPathAnalyzer PathAnalyzer => SpeedTestRegistry.GetFor(SiteContext.Slug).PathAnalyzer;

    // Local iperf3 availability
    private LocalIperf3Status? localIperf3Status;
    private bool recheckingIperf3 = false;

    // Agent-backed secondary site whose on-site agent isn't currently connected.
    // LAN tests run through that agent (SSH to devices + throughput at the site),
    // so they're locked out until it reconnects; the poll re-enables them.
    private bool _siteAgentOffline;
    // The site's agent runs on the UniFi gateway itself (monitoring-only install).
    private bool _agentOnGateway;
    // Per-site "SSH and UniFi Console proxy" flag - device SSH through the tunnel.
    private bool _devicesViaAgent;
    // A managed (non-default) site with no live agent at all - covers both the
    // via-agent-but-disconnected case (_siteAgentOffline) and a site that has
    // never set an agent up. LAN tests can't run either way, so the page locks out.
    private bool _agentRequired;
    private System.Threading.Timer? _agentStatusTimer;

    // Schedule banner
    private bool _lanScheduleBannerDismissed = true; // default hidden until loaded

    private List<DeviceSshConfiguration> devices = new();
    private DeviceSshConfiguration editingDevice = new() { DeviceType = DeviceType.Server, Enabled = true };
    private List<Iperf3Result> testHistory = new();
    private List<Iperf3Result> mapResults = new();
    private List<ApMapMarker> apMapMarkers = new();
    private Iperf3Result? currentResult;
    private bool sshConfigured = false;
    private bool _sshConfigLoaded;    // gates the "SSH not configured" warning so it doesn't flash before the check runs

    // Pagination
    private int historyPage = 1;
    private int historyPageSize = 10;
    private int historyTotalPages => (int)Math.Ceiling(filteredHistory.Count / (double)historyPageSize);
    private IEnumerable<Iperf3Result> pagedHistory => filteredHistory.Skip((historyPage - 1) * historyPageSize).Take(historyPageSize);

    // Discovered devices from UniFi controller (using unified discovery service)
    private List<DiscoveredDevice> discoveredDevices = new();
    private bool loadingDiscovered = false;
    private bool _discoveredDevicesLoaded;    // set once the device list has loaded from a connected console; the agent-status poll retries the load when the console reconnects
    // True until the initial load chain finishes, so each card shows a spinner rather than its
    // no-data message during the first render (prerender paints before any list has loaded).
    private bool _initialLoading = true;

    // Saved devices form state
    private bool showAddDevice = false;
    private bool savingDevice = false;
    private bool showAdvancedIperf3 = false;
    private bool isRunningTest = false;
    private string? runningTestHost;
    private string editingDevicePassword = ""; // Separate field for password input (not bound to encrypted value)
    private bool editingDeviceHasSavedPassword = false; // Track if the device being edited has a saved password

    // UniFi Device Speed Test messages (discovered devices)
    private string unifiMessage = "";
    private string unifiMessageClass = "";

    // Other Device Speed Test messages (saved devices)
    private string savedDeviceMessage = "";
    private string savedDeviceMessageClass = "";

    /// <summary>A message shown in a device's result row. <see cref="Result"/> is set once a test returns one.</summary>
    private sealed record RowMessage(string Text, string Kind, Iperf3Result? Result = null, bool Progress = false);

    // This visit's per-device messages, keyed by IP (UniFi) or Host (Other). They replace the stored result.
    private readonly Dictionary<string, RowMessage> _unifiRowMessages = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, RowMessage> _otherRowMessages = new(StringComparer.OrdinalIgnoreCase);

    // Newest server-initiated result per DeviceHost, rebuilt from testHistory on every load.
    private Dictionary<string, Iperf3Result> _latestResultByHost = new(StringComparer.OrdinalIgnoreCase);

    // UniFi Device Speed Test search and filters; family and Online only persist per user per site.
    private string _deviceSearch = "";
    private string _deviceFamily = "";
    private bool _deviceOnlineOnly;
    private List<DeviceModelFilterOption> _familyOptions = new();

    // Selection and batch run, keyed by IP (a device without one cannot run).
    private readonly HashSet<string> _selectedDevices = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _batchQueue = new(StringComparer.OrdinalIgnoreCase);
    private bool _batchRunning;
    private bool _batchStopRequested;
    private int _batchIndex;
    private int _batchTotal;
    private string? _batchSummary;

    // History state
    private bool clearingHistory = false;
    private bool confirmingClearHistory = false;
    private int? expandedHistoryId = null;
    private int? _collapsingHistoryId = null; // Track row being collapsed for smooth transition

    // Search filter for table (uses shared SpeedTestFilterHelper for consistency with repository)
    private string historySearchFilter = "";

    // Device filter (set by clicking filter icon on a row)
    private string deviceFilter = "";
    private string deviceFilterName = "";

    // Filtered history based on search filter and device filter
    private List<Iperf3Result> filteredHistory
    {
        get
        {
            IEnumerable<Iperf3Result> results = testHistory;
            if (!string.IsNullOrEmpty(deviceFilter))
                results = results.Where(r => string.Equals(r.DeviceHost, deviceFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(historySearchFilter))
                results = results.Where(r => SpeedTestFilterHelper.MatchesFilter(r, historySearchFilter.ToLowerInvariant()));
            return results.ToList();
        }
    }

    // Path analysis for historical results (calculated on demand)
    private Dictionary<int, PathAnalysisResult?> historyPathAnalysis = new();
    private int? analyzingResultId = null;

    // Gateway Speed Test state
    private bool gatewayLoading = true;
    private bool gatewayConfigured = false;
    private bool gatewayRunning = false;
    private bool gatewayCheckingIperf3 = false;
    private bool gatewayExpanded = false;
    private string gatewayMessage = "";
    private string gatewayMessageClass = "";
    private string? gatewayLoadError;    // set when the gateway SSH settings read fails, so we degrade instead of claiming "not configured"
    private GatewaySpeedTestResult? gatewayLastResult;
    private Iperf3Status? gatewayIperf3Status;

    // Test progress indicator (shared across all test types)
    private int testProgressPercent = 0;
    private string testProgressPhase = "";        // Abbreviated for buttons
    private string testProgressPhaseVerbose = ""; // Verbose for alerts
    private System.Timers.Timer? progressTimer;

    private bool _liveViewLinkEnabled;


    /// <summary>
    /// These fields override the global Device SSH settings, so blank does not mean the credential is
    /// unused - it means this device inherits it. Saying "not in use" over a working inherited
    /// credential would be wrong, so the header says where the value is coming from instead.
    /// </summary>
    private bool DeviceUsernameOverridden => !string.IsNullOrWhiteSpace(editingDevice?.SshUsername);

    private bool DevicePasswordOverridden =>
        editingDeviceHasSavedPassword || !string.IsNullOrEmpty(editingDevicePassword);

    /// <summary>
    /// Whether this device's password is going to be the thing that authenticates. A stored key takes
    /// over wherever it is installed, so a password set right here still will not be used - which is
    /// a different statement from "you did not set one", and the header says which.
    /// </summary>
    private bool DevicePasswordInPlay => DevicePasswordOverridden && _sshKey is null;

    private string DevicePasswordNote => _sshKey is not null ? " (Not in use)" : "";

    private bool DeviceKeyPathOverridden => !string.IsNullOrWhiteSpace(editingDevice?.SshPrivateKeyPath);

    /// <summary>Whether the site's device SSH settings name a key file, regardless of this device.</summary>
    private bool _globalDeviceKeyFileConfigured;

    /// <summary>
    /// What a caller below global Admin sees in place of the path field: naming a path is theirs to use
    /// but not to set or read, so there is no read-only input here, only a statement of what is
    /// authenticating. It used to be nothing at all, which read as "no key" on a device using one.
    /// </summary>
    private RenderFragment? DeviceKeyFileNote =>
        !(DeviceKeyPathOverridden || _globalDeviceKeyFileConfigured)
            ? null
            : @<div class="form-group">
                   <label class="form-label">SSH Private Key Path</label>
                   <span class="form-help">Set by an administrator. This key authenticates the connection.</span>
               </div>;

    /// <summary>
    /// Dims the header of a field that is inheriting rather than overriding. No wording with it - the
    /// placeholder already says "(using global setting)" in the field itself.
    /// </summary>
    private static string InheritedLabel(bool overridden) => overridden ? "" : "form-label-unused";


    /// <summary>The site's stored SSH key, shown on the per-device override form. Null when it has none.</summary>
    private SshKeyInfo? _sshKey;

    /// <summary>
    /// Read-only, and tolerant of failure: the key row is informational, so a site whose key cannot be
    /// read still gets a working speed test page.
    /// </summary>
    private async Task<SshKeyInfo?> LoadSiteSshKey()
    {
        try
        {
            return await SshKeyService.GetAsync();
        }
        catch (Exception)
        {
            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _canConfigure = AuthState is null
            || (await Authz.AuthorizeAsync((await AuthState).User, SiteContext.Slug, Policies.SiteAdmin)).Succeeded;

        PtrState.RefreshCallback = () => LoadHistory();
        PtrState.NotifyStateChanged = StateHasChanged;

        _sshKey = await LoadSiteSshKey();
        _globalDeviceKeyFileConfigured =
            !string.IsNullOrWhiteSpace((await SshService.GetSettingsAsync())?.PrivateKeyPath);

        _liveViewLinkEnabled = await Readiness.IsHistoricPlaybackAvailableAsync();

        // Check schedule banner dismissal and local iperf3 availability
        _lanScheduleBannerDismissed = await SettingsService.GetAsync("banner.lan_schedule_dismissed") != null;
        localIperf3Status = await SettingsService.CheckLocalIperf3Async();

        // Wait for UniFi controller connection (auto-connect happens in background on startup)
        await ConnectionService.WaitForConnectionAsync();

        try
        {
            (_deviceFamily, _deviceOnlineOnly) = await LanDeviceFilterPreference.LoadAsync(UserPreferences, SiteContext.Slug);
        }
        catch (Exception)
        {
            // A filter that cannot be read starts at All models; the device list still loads.
        }

        try
        {
            await CheckSshConfiguration();
            await LoadGatewayConfiguration();
            await LoadDevices();
            await LoadHistory();
            await LoadDiscoveredDevices();
            await LoadApMarkers();
        }
        finally
        {
            _initialLoading = false;
        }

        await RefreshAgentAvailabilityAsync();
        StartAgentStatusPolling();
    }

    /// <summary>
    /// Recomputes whether this site's on-site agent is offline. LAN tests run
    /// through the agent for an agent-backed secondary site, so an offline agent
    /// locks them out; <see cref="StartAgentStatusPolling"/> re-enables them when
    /// it reconnects. The default site never routes via agent.
    /// </summary>
    private async Task RefreshAgentAvailabilityAsync()
    {
        // A managed site with no live agent can't run LAN tests, full stop: a site
        // that is via-agent configured but momentarily disconnected gets the
        // "resumes when it reconnects" message, a site with no agent set up at all
        // gets pointed at agent setup instead of a runnable-but-wrong test.
        var agentOnline = TunnelRouting.IsAgentOnline(SiteContext.Slug);
        _agentRequired = !SiteContext.IsDefault && !agentOnline;
        _siteAgentOffline = _agentRequired && await TunnelRouting.IsViaAgentAsync(SiteContext.Slug);

        // UI gating for a gateway-resident agent: the Gateway Speed Test is a
        // self-test there (hidden) - unless another connected agent sits off the
        // gateway, which is where the test then runs. The UniFi Device Speed Test
        // needs device SSH through the tunnel, so it keys on the devices-via-agent flag.
        _agentOnGateway = agentOnline
            && await OnGatewayDetector.IsAgentOnGatewayAsync(SiteContext.Slug)
            && await OnGatewayDetector.LanTestAgentAsync(SiteContext.Slug) == null;
        _devicesViaAgent = await TunnelRouting.IsViaAgentAsync(SiteContext.Slug);
    }

    /// <summary>
    /// Polls the site's agent tunnel status so LAN tests re-enable on their own
    /// once the agent reconnects. Only agent-backed secondary sites can go offline,
    /// so the default site skips the timer entirely.
    /// </summary>
    private void StartAgentStatusPolling()
    {
        if (SiteContext.IsDefault) return;
        _agentStatusTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    var before = (_siteAgentOffline, _agentRequired, _agentOnGateway, _devicesViaAgent);
                    await RefreshAgentAvailabilityAsync();
                    var changed = before != (_siteAgentOffline, _agentRequired, _agentOnGateway, _devicesViaAgent);

                    // The console comes back a moment after the agent tunnel does; once
                    // it's connected, load the UniFi device list so it populates without
                    // a manual Refresh.
                    if (!_discoveredDevicesLoaded && ConnectionService.IsConnected)
                    {
                        await LoadDiscoveredDevices();
                        changed = true;
                    }

                    if (changed)
                        StateHasChanged();
                });
            }
            catch { /* keep the timer alive */ }
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task DismissLanScheduleBanner()
    {
        _lanScheduleBannerDismissed = true;
        await SettingsService.SetAsync("banner.lan_schedule_dismissed", "true");
    }

    private async Task RecheckLocalIperf3()
    {
