            recheckingIperf3 = false;
            StateHasChanged();
        }
    }

    private async Task LoadGatewayConfiguration()
    {
        gatewayLoading = true;
        gatewayLoadError = null;
        try
        {
            var settings = await GatewaySpeedTestService.GetSettingsAsync();
