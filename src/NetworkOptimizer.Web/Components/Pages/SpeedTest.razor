    }

    // Progress indicator helpers
    // Phases: 0-3s = Starting (13%), 3-(3+duration)s = From device (43%), (3+duration)-(3+2*duration)s = To device (100%)
    private DateTime testStartTime;
    private int testDurationSeconds = 10; // Effective duration for progress calculation

    private void StartProgressTimer(int durationSeconds = 0)
    {
        testStartTime = DateTime.UtcNow;
        testDurationSeconds = durationSeconds > 0 ? durationSeconds : 10;
        testProgressPercent = 0;
        testProgressPhase = "Starting";
        testProgressPhaseVerbose = "Starting";

        progressTimer?.Dispose();
        progressTimer = new System.Timers.Timer(250); // Update every 250ms
        progressTimer.Elapsed += (s, e) => UpdateProgress();
        progressTimer.Start();
    }

    private void StopProgressTimer()
    {
        // Capture and null the reference first so UpdateProgress guard works immediately
        var timer = progressTimer;
        progressTimer = null;
        timer?.Stop();
        timer?.Dispose();
        testProgressPercent = 0;
        testProgressPhase = "";
        testProgressPhaseVerbose = "";
    }

    private void UpdateProgress()
    {
        // Guard against race condition - timer callback may fire after Stop()
        if (progressTimer == null) return;

        var elapsed = (DateTime.UtcNow - testStartTime).TotalSeconds;
        var d = testDurationSeconds;
        var phaseEnd1 = 3.0;         // End of starting phase
        var phaseEnd2 = 3.0 + d;     // End of "from device" phase
        var phaseEnd3 = 3.0 + d * 2; // End of "to device" phase

        if (elapsed < phaseEnd1)
        {
            // Starting phase: 0-13%
            testProgressPercent = (int)(elapsed / phaseEnd1 * 13);
            testProgressPhase = "Starting";
            testProgressPhaseVerbose = "Starting";
        }
        else if (elapsed < phaseEnd2)
        {
            // From device phase: 13-56%
            testProgressPercent = 13 + (int)((elapsed - phaseEnd1) / d * 43);
            testProgressPhase = "↓ Testing";
            testProgressPhaseVerbose = "From device";
        }
        else if (elapsed < phaseEnd3)
        {
            // To device phase: 56-100%
            testProgressPercent = 56 + (int)((elapsed - phaseEnd2) / d * 44);
            testProgressPhase = "↑ Testing";
            testProgressPhaseVerbose = "To device";
        }
        else
        {
            testProgressPercent = 100;
            testProgressPhase = "Done";
            testProgressPhaseVerbose = "Finishing";
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task LoadApMarkers()
    {
        try
        {
            apMapMarkers = await ApMapService.GetApMapMarkersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadApMarkers error: {ex.Message}");
        }
    }

    private async Task HandleApLocationChanged((string Mac, double Lat, double Lng) args)
    {
        try
        {
            await ApMapAdmin.SaveApLocationAsync(args.Mac, args.Lat, args.Lng);

            var marker = apMapMarkers.FirstOrDefault(m => m.Mac.Equals(args.Mac, StringComparison.OrdinalIgnoreCase));
            if (marker != null)
            {
                marker.Latitude = args.Lat;
                marker.Longitude = args.Lng;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving AP location: {ex.Message}");
        }
    }

    public void Dispose()
    {
        progressTimer?.Dispose();
        _agentStatusTimer?.Dispose();
        _agentStatusTimer = null;
    }

    /// <summary>
    /// Called when the table's search filter changes. Resets pagination.
    /// The filter value is shared with map via two-way binding.
    /// </summary>
    private void OnTableFilterChanged(string filter)
    {
        historyPage = 1;
        expandedHistoryId = null;
        StateHasChanged();
    }

    private void ToggleDeviceFilter(string host, string displayName)
    {
        if (string.Equals(deviceFilter, host, StringComparison.OrdinalIgnoreCase))
        {
            deviceFilter = "";
            deviceFilterName = "";
        }
        else
        {
            deviceFilter = host;
            deviceFilterName = displayName;
        }
        historyPage = 1;
        expandedHistoryId = null;
        StateHasChanged();
    }

    private void ClearDeviceFilter()
    {
        deviceFilter = "";
        deviceFilterName = "";
        historyPage = 1;
        expandedHistoryId = null;
        StateHasChanged();
    }

