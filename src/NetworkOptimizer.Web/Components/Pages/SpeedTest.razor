    private async Task SaveDevice()
    {
        if (string.IsNullOrWhiteSpace(editingDevice.Name) || string.IsNullOrWhiteSpace(editingDevice.Host))
        {
            savedDeviceMessage = "Name and Host are required";
            savedDeviceMessageClass = "danger";
            return;
        }

        savingDevice = true;
        savedDeviceMessage = "";
        StateHasChanged();

        try
        {
            // Clamp overrides to valid ranges before saving
            if (editingDevice.Iperf3ParallelStreams.HasValue)
                editingDevice.Iperf3ParallelStreams = Math.Clamp(editingDevice.Iperf3ParallelStreams.Value, 1, 16);
            if (editingDevice.Iperf3DurationSeconds.HasValue)
                editingDevice.Iperf3DurationSeconds = Math.Clamp(editingDevice.Iperf3DurationSeconds.Value, 1, 300);

            // Only set password if user entered a new one (password field is separate from model)
            if (!string.IsNullOrEmpty(editingDevicePassword))
            {
                editingDevice.SshPassword = editingDevicePassword;
            }

            await SpeedTestService.SaveDeviceAsync(editingDevice);
            savedDeviceMessage = editingDevice.Id > 0 ? "Device updated successfully" : "Device added successfully";
            savedDeviceMessageClass = "success";

            await LoadDevices();
            CancelEdit();
        }
        catch (Exception ex)
        {
            savedDeviceMessage = $"Error saving device: {ex.Message}";
            savedDeviceMessageClass = "danger";
        }
        finally
        {
            savingDevice = false;
            StateHasChanged();
        }
    }

    private async Task DeleteDevice(DeviceSshConfiguration device)
    {
        try
        {
            await SpeedTestService.DeleteDeviceAsync(device.Id);
            savedDeviceMessage = $"Deleted device: {device.Name}";
            savedDeviceMessageClass = "success";
            await LoadDevices();
        }
        catch (Exception ex)
        {
            savedDeviceMessage = $"Error deleting device: {ex.Message}";
            savedDeviceMessageClass = "danger";
        }
        StateHasChanged();
    }

    private async Task TestConnection(DeviceSshConfiguration device)
    {
        var host = device.Host;
        _otherRowMessages[host] = new RowMessage($"Testing SSH connection to {device.Name}...", "info");
        StateHasChanged();

        try
        {
            // Use device-specific credentials if configured
            var (success, msg) = await SpeedTestService.TestConnectionAsync(device);
            if (success)
            {
                var (iperf3Available, version) = await SpeedTestService.CheckIperf3AvailableAsync(device);
                _otherRowMessages[host] = iperf3Available
                    ? new RowMessage($"SSH OK! iperf3 available: {version}", "success")
                    : new RowMessage($"SSH OK. {version}", "warning");
            }
            else
            {
                _otherRowMessages[host] = new RowMessage($"SSH connection failed: {msg}", "danger");
            }
        }
        catch (Exception ex)
        {
            _otherRowMessages[host] = new RowMessage($"Error: {ex.Message}", "danger");
        }
        StateHasChanged();
    }

    private async Task RunSpeedTest(DeviceSshConfiguration device)
    {
        // A Test Again on a result with no saved device runs a temporary one, which has no row.
        var host = device.Host;
        var hasRow = devices.Any(d => string.Equals(d.Host, host, StringComparison.OrdinalIgnoreCase));
        void Show(RowMessage message)
        {
            if (hasRow)
            {
                _otherRowMessages[host] = message;
                return;
            }
            savedDeviceMessage = message.Text;
            savedDeviceMessageClass = message.Kind;
        }

        isRunningTest = true;
        runningTestHost = device.Host;
        Show(new RowMessage($"Running speed test to {device.Name}...", "info", Progress: true));
        var iperf3Settings = await SpeedTestService.GetSettingsAsync();
        StartProgressTimer(device.Iperf3DurationSeconds ?? iperf3Settings.DurationSeconds);
        StateHasChanged();

        try
        {
            currentResult = await SpeedTestService.RunSpeedTestAsync(device);
            Show(MessageFor(currentResult));
            await LoadHistory();
        }
        catch (Exception ex)
        {
            Show(new RowMessage($"Error running speed test: {ex.Message}", "danger"));
        }
        finally
        {
            StopProgressTimer();
            isRunningTest = false;
            runningTestHost = null;
            StateHasChanged();
        }
    }

    /// <summary>The row message for a finished test: the result itself, so the row renders it like a stored one.</summary>
    private static RowMessage MessageFor(Iperf3Result result) => result.Success
        ? new RowMessage(CompletedText(result), "success", result)
        : new RowMessage(SpeedTestFailureSummary.Summarize(result.ErrorMessage).Summary, "danger", result);

    private static string CompletedText(Iperf3Result result) =>
        $"Speed test completed: {result.DownloadMbps:F1} Mbps from / {result.UploadMbps:F1} Mbps to device";

    /// <summary>
    /// What a device's result row shows: this visit's message when there is one, else the newest stored
    /// result for the host. Null renders no row.
    /// </summary>
    private RowMessage? RowResultFor(Dictionary<string, RowMessage> messages, string? host)
    {
        if (string.IsNullOrEmpty(host)) return null;
        if (messages.TryGetValue(host, out var message)) return message;
        return _latestResultByHost.TryGetValue(host, out var stored) ? MessageFor(stored) : null;
    }

    private void RebuildLatestResults()
    {
        var latest = new Dictionary<string, Iperf3Result>(StringComparer.OrdinalIgnoreCase);
        foreach (var result in testHistory
                     .Where(r => r.Direction == SpeedTestDirection.ServerToDevice && !string.IsNullOrEmpty(r.DeviceHost))
                     .OrderByDescending(r => r.TestTime))
            latest.TryAdd(result.DeviceHost, result);
        _latestResultByHost = latest;

        // A deleted or cleared result leaves its row; a refusal that was never saved (Id 0) stays for the visit.
        var ids = testHistory.Select(r => r.Id).ToHashSet();
        foreach (var messages in new[] { _unifiRowMessages, _otherRowMessages })
            foreach (var key in messages.Where(m => m.Value.Result is { Id: > 0 } r && !ids.Contains(r.Id)).Select(m => m.Key).ToList())
                messages.Remove(key);
    }

    /// <summary>
    /// The result row under a device. A success links to its details; a failure shows its summary line
    /// with the raw iperf3 output collapsed beneath it.
    /// </summary>
    private RenderFragment DeviceResultRow(RowMessage message, int colspan)
    {
        var failure = message is { Kind: "danger", Result: { } failed }
            ? SpeedTestFailureSummary.Summarize(failed.ErrorMessage)
            : null;
        return @<tr class="device-result-row">
            <td colspan="@colspan">
                @if (message.Progress && isRunningTest)
                {
                    <div class="alert alert-info alert-progress">
                        <div class="alert-progress-bar" style="width: @(testProgressPercent)%"></div>
                        <span class="alert-progress-text">@message.Text @testProgressPhaseVerbose...</span>
                    </div>
                }
                else if (message is { Kind: "success", Result: { } succeeded })
                {
                    <div class="alert alert-success alert-link" @onclick="() => OpenRowResult(succeeded)">
                        <span>@message.Text</span>
                        <span class="alert-link-hint">Click to view details →</span>
                    </div>
                }
                else
                {
                    <div class="alert alert-@message.Kind alert-with-tooltip">
                        @if (message.Kind == "danger")
                        {
                            <span class="alert-text">@message.Text</span>
                            <SshTroubleshootingTooltip Context="devices" />
                        }
                        else
                        {
                            @message.Text
                        }
                    </div>
                    @if (failure?.RawOutput != null)
                    {
                        <details><summary>Raw output</summary><pre class="gateway-diag-raw">@failure.RawOutput</pre></details>
                    }
                }
            </td>
        </tr>;
    }

    /// <summary>
    /// Opens a row's result: the Latest Test Result card when it is the one shown there, else its row in
    /// Test History, clearing a history filter that hides it.
    /// </summary>
    private async Task OpenRowResult(Iperf3Result result)
    {
        if (currentResult?.Id == result.Id)
        {
            await ScrollToLatestResult();
            return;
        }

        if (filteredHistory.FindIndex(r => r.Id == result.Id) < 0)
        {
            deviceFilter = "";
            deviceFilterName = "";
            historySearchFilter = "";
        }
        var index = filteredHistory.FindIndex(r => r.Id == result.Id);
        if (index < 0)
        {
            await ScrollToLatestResult();
            return;
        }

        historyPage = (index / historyPageSize) + 1;
        expandedHistoryId = result.Id;
        StateHasChanged();
        await Task.Delay(100);
        await JS.InvokeVoidAsync("noHighlightRow", $"result-{result.Id}");
    }

    private RenderFragment EnabledBadge(bool enabled) => enabled
        ? @<span class="status-badge status-connected">Enabled</span>
        : @<span class="status-badge status-disconnected">Disabled</span>;

    private async Task ScrollToLatestResult()
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('latest-result')?.scrollIntoView({ behavior: 'smooth', block: 'start' })");
    }

    private async Task ChangePage(int delta)
    {
        var hadExpanded = expandedHistoryId.HasValue;
        expandedHistoryId = null;
        _collapsingHistoryId = null;
        historyPage += delta;

        StateHasChanged();
        if (hadExpanded)
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("eval", "document.getElementById('test-history')?.scrollIntoView({ behavior: 'smooth', block: 'start' });");
        }
    }

    private async Task ToggleHistoryExpand(int resultId)
    {
        if (expandedHistoryId == resultId)
        {
            // Clicking same row - just collapse
            expandedHistoryId = null;
        }
        else if (expandedHistoryId.HasValue)
        {
            // Switching rows - expand new one first, then collapse old after transition
            var oldId = expandedHistoryId.Value;
            _collapsingHistoryId = oldId;
            expandedHistoryId = resultId;
            StateHasChanged();

            // Wait for expand animation, then collapse old
            await Task.Delay(50);
            _collapsingHistoryId = null;

            // Scroll into view if off-screen
            await JS.InvokeVoidAsync("eval", $@"
                setTimeout(() => {{
                    var el = document.getElementById('result-{resultId}');
                    if (el) {{
                        var rect = el.getBoundingClientRect();
                        if (rect.top < 0 || rect.bottom > window.innerHeight) {{
                            el.scrollIntoView({{ behavior: 'smooth', block: 'start' }});
                        }}
                    }}
                }}, 260);
            ");
        }
        else
        {
            // No row expanded - just expand
            expandedHistoryId = resultId;
        }
    }

    private async Task ScrollToResult(int resultId)
    {
        // Find which page the result is on
        var index = testHistory.FindIndex(r => r.Id == resultId);
        if (index >= 0)
        {
            var targetPage = (index / historyPageSize) + 1;
            if (historyPage != targetPage)
            {
                historyPage = targetPage;
            }
        }

        // Expand the result
        expandedHistoryId = resultId;
        StateHasChanged();

        // Give time for the DOM to update, then scroll
        await Task.Delay(100);
        await JS.InvokeVoidAsync("noHighlightRow", $"result-{resultId}");
    }

    private async Task AnalyzeHistoricalPath(Iperf3Result result)
    {
        if (analyzingResultId != null)
            return;

        analyzingResultId = result.Id;
        StateHasChanged();

        try
        {
            var path = await PathAnalyzer.CalculatePathAsync(result.DeviceHost, result.LocalIp);
            var analysis = PathAnalyzer.AnalyzeSpeedTest(
                path,
                result.DownloadMbps,
                result.UploadMbps,
                result.DownloadRetransmits,
                result.UploadRetransmits,
                result.DownloadBytes,
                result.UploadBytes);
            historyPathAnalysis[result.Id] = analysis;
        }
        catch
        {
            // Store null to indicate analysis failed
            historyPathAnalysis[result.Id] = null;
        }
        finally
        {
            analyzingResultId = null;
            StateHasChanged();
        }
    }

    private async Task LoadDiscoveredDevices()
    {
        if (!ConnectionService.IsConnected)
            return;

        // Invalidate cache to get fresh device list
        ConnectionService.InvalidateDeviceCache();

        loadingDiscovered = true;
        StateHasChanged();

        try
        {
            var allDevices = await ConnectionService.GetDiscoveredDevicesAsync();

            // Filter out gateway devices (have dedicated Gateway Speed Test section)
            // and devices that can't run iperf3
            discoveredDevices = allDevices
                .Where(d => d.Type != DeviceType.Gateway && d.CanRunIperf3)
                .OrderBy(d => d.Name)
                .ToList();
            _familyOptions = DeviceModelFilter.BuildOptions(discoveredDevices.Select(ModelFamilyOf));
            _selectedDevices.IntersectWith(discoveredDevices.Select(d => d.IpAddress));
            _discoveredDevicesLoaded = true;
        }
        catch (Exception ex)
        {
            unifiMessage = $"Error loading devices: {ex.Message}";
            unifiMessageClass = "danger";
        }
        finally
        {
            loadingDiscovered = false;
            StateHasChanged();
        }
    }

    private Task RunSpeedTestOnDiscovered(DiscoveredDevice device) => RunDiscoveredAsync(device);

    /// <summary>
    /// Runs one UniFi device's test into its row. A device the filters hide also gets the card-level
    /// message, so a Test Again from history is never silent. Returns whether the test passed.
    /// </summary>
    private async Task<bool> RunDiscoveredAsync(DiscoveredDevice device)
    {
        if (string.IsNullOrEmpty(device.IpAddress))
        {
            unifiMessage = $"Device {device.Name} has no IP address";
            unifiMessageClass = "danger";
            return false;
        }

        var host = device.IpAddress;
        var hidden = !VisibleDevices.Contains(device);
        void Show(RowMessage message)
        {
            _unifiRowMessages[host] = message;
            if (!hidden) return;
            unifiMessage = message.Text;
            unifiMessageClass = message.Kind;
        }

        var passed = false;
        isRunningTest = true;
        runningTestHost = host;
        Show(new RowMessage($"Running speed test to {device.Name}...", "info", Progress: true));
        var iperf3Settings = await SpeedTestService.GetSettingsAsync();
        StartProgressTimer(iperf3Settings.DurationSeconds);
        StateHasChanged();

        try
        {
            currentResult = await SpeedTestService.RunSpeedTestAsync(device);
            passed = currentResult.Success;
            Show(MessageFor(currentResult));
            await LoadHistory();
        }
        catch (Exception ex)
        {
            Show(new RowMessage($"Error running speed test: {ex.Message}", "danger"));
        }
        finally
        {
            StopProgressTimer();
            isRunningTest = false;
            runningTestHost = null;
            StateHasChanged();
        }
        return passed;
    }

    private static string ModelFamilyOf(DiscoveredDevice device) =>
        UniFiProductDatabase.GetModelFamily(device.Model, device.Shortname);

    private static bool IsDeviceOnline(DiscoveredDevice device) =>
        UniFiDeviceStateMap.ToStatus(device.State).IsOnline && device.Adopted;

    /// <summary>Whether Run Test is available for the device: online, with an IP, and Device SSH configured.</summary>
    private bool IsRunnable(DiscoveredDevice device) =>
        IsDeviceOnline(device) && sshConfigured && !string.IsNullOrEmpty(device.IpAddress);

    /// <summary>The saved family when it is still an option on this site, else All models.</summary>
    private string EffectiveFamily =>
        _familyOptions.Any(o => string.Equals(o.Prefix, _deviceFamily, StringComparison.OrdinalIgnoreCase)) ? _deviceFamily : "";

    /// <summary>The discovered devices that pass the search, family/model filter, and Online only.</summary>
    private List<DiscoveredDevice> VisibleDevices
    {
        get
        {
            var family = EffectiveFamily;
            var search = _deviceSearch.Trim();
            return discoveredDevices.Where(d =>
                    (family.Length == 0 || DeviceModelFilter.Matches(ModelFamilyOf(d), family))
                    && (!_deviceOnlineOnly || IsDeviceOnline(d))
                    && (search.Length == 0
                        || d.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                        || d.FriendlyModelName.Contains(search, StringComparison.OrdinalIgnoreCase)
                        || d.IpAddress.Contains(search, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    /// <summary>Selected devices that Run Selected would test: visible and runnable, in table order.</summary>
    private List<DiscoveredDevice> SelectedRunnable(List<DiscoveredDevice> visible) =>
        visible.Where(d => IsRunnable(d) && _selectedDevices.Contains(d.IpAddress)).ToList();

    private async Task SetDeviceFamilyAsync(string? family)
    {
        _deviceFamily = family ?? "";
        try { await LanDeviceFilterPreference.SaveFamilyAsync(UserPreferences, SiteContext.Slug, _deviceFamily); }
        catch (Exception) { /* the filter still applies for this visit */ }
    }

    private async Task SetDeviceOnlineOnlyAsync(bool onlineOnly)
    {
        _deviceOnlineOnly = onlineOnly;
        try { await LanDeviceFilterPreference.SaveOnlineOnlyAsync(UserPreferences, SiteContext.Slug, onlineOnly); }
        catch (Exception) { /* the filter still applies for this visit */ }
    }

    private void ToggleDeviceSelected(DiscoveredDevice device, bool selected)
    {
        if (selected) _selectedDevices.Add(device.IpAddress);
        else _selectedDevices.Remove(device.IpAddress);
    }

    private void ToggleAllVisible(List<DiscoveredDevice> visibleRunnable, bool selected)
    {
        foreach (var device in visibleRunnable)
            ToggleDeviceSelected(device, selected);
    }

    /// <summary>
    /// Tests the selected devices one after another. A failure moves on to the next device; Stop
    /// ends the batch after the device under test.
    /// </summary>
    private async Task RunSelectedAsync()
    {
        if (isRunningTest || _batchRunning) return;
        var targets = SelectedRunnable(VisibleDevices);
        if (targets.Count == 0) return;

        _batchRunning = true;
        _batchStopRequested = false;
        _batchSummary = null;
        _batchTotal = targets.Count;
        _batchQueue.Clear();
        _batchQueue.UnionWith(targets.Select(d => d.IpAddress));
        int passed = 0, failed = 0;

        try
        {
            for (var i = 0; i < targets.Count && !_batchStopRequested; i++)
            {
                _batchIndex = i + 1;
                _batchQueue.Remove(targets[i].IpAddress);
                if (await RunDiscoveredAsync(targets[i])) passed++;
                else failed++;
            }
        }
        finally
        {
            _batchQueue.Clear();
            _batchRunning = false;
            _batchStopRequested = false;
            _batchSummary = $"{passed + failed} tested: {passed} passed, {failed} failed";
            StateHasChanged();
        }
    }

    private void StopBatch() => _batchStopRequested = true;

    private async Task HandleTestAgain(Iperf3Result result)
    {
        if (isRunningTest || _batchRunning) return;

        // Try saved devices first
        var savedDevice = devices.FirstOrDefault(d =>
            d.Host.Equals(result.DeviceHost, StringComparison.OrdinalIgnoreCase));
        if (savedDevice != null)
        {
            await ScrollTo("saved-devices-test");
            await RunSpeedTest(savedDevice);
            return;
        }

        // Try discovered UniFi devices
        var discovered = discoveredDevices.FirstOrDefault(d =>
            d.IpAddress?.Equals(result.DeviceHost, StringComparison.OrdinalIgnoreCase) == true);
        if (discovered != null)
        {
            await ScrollTo("unifi-test");
            await RunSpeedTestOnDiscovered(discovered);
            return;
        }

        // Fallback: create temporary device config from result
        await ScrollTo("saved-devices-test");
        var tempDevice = new DeviceSshConfiguration
        {
            Name = result.DeviceName ?? result.DeviceHost,
            Host = result.DeviceHost,
            Enabled = true,
            StartIperf3Server = true
        };
        await RunSpeedTest(tempDevice);
    }

