@page "/network-tools"
@attribute [Authorize(Policy = Policies.RequireViewer)]
@rendermode InteractiveServer
@implements IDisposable
@using NetworkOptimizer.Web.Services
@using NetworkOptimizer.Web.Services.Monitoring
@using NetworkOptimizer.Monitoring.Probes
@using NetworkOptimizer.Core.Enums
@using NetworkOptimizer.UniFi
@using NetworkOptimizer.UniFi.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using NetworkOptimizer.Web.Services.Authorization
@inject IAuthorizationService Authz
@inject NetworkOptimizer.Monitoring.Probes.LocalProbeExecutor LocalProbe
@inject ProbeExecutorFactory ExecutorFactory
@inject UniFiConnectionService ConnectionService
@inject ISqmService SqmService
@inject SiteContextService SiteContext
@inject SiteTunnelRouting TunnelRouting
@inject GatewayDiagnosticsService GatewayDiagnostics
@inject NetworkOptimizer.Web.Services.Ssh.IGatewaySshService GatewaySsh

<PageTitle>Network Tools - Network Optimizer</PageTitle>

<div class="page-header">
    <a href="/monitoring" class="page-back-link back-link">← Back to Monitoring</a>
    <h1>Network Tools</h1>
    <p class="page-description">
        Run ping or traceroute from any vantage to any target. Picking a UniFi device
        as the source runs the probe over SSH on that device, which lets you isolate
        whether a problem is on the server's path or on a specific link of your LAN.
        You can also read an interface straight off the gateway - addresses and DHCP
        lease, SFP module diagnostics, and resolved neighbors.
    </p>
</div>

@if (_siteAgentOffline)
{
    <div class="alert alert-warning">
        This site's probes run through its on-site agent, which isn't connected right now.
        Ping, traceroute, and reading a gateway interface can resume when the agent reconnects.
    </div>
}

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Run a probe</h2>
    </div>
    <div class="card-body">
        <div class="form-group">
            <label class="form-label">From (vantage)</label>
            <select class="form-control" value="@_fromKey" @onchange="OnVantageChanged">
                <option value="server">@(ExecutorFactory.ServerVantageIsAgent ? "On-site agent" : "Network Optimizer server")</option>
                @foreach (var d in _devices)
                {
                    <option value="@($"device:{d.Mac}")">@LabelForDevice(d)</option>
                }
            </select>
            @if (_fromKey == "server")
            {
                <p class="page-description" style="margin-top: 0.5rem;">
                    @if (ExecutorFactory.ServerVantageIsAgent)
                    {
                        @:Probes run from this site's on-site agent (on the site's own network), not the central server.
                    }
                    else
                    {
                        @:Probes from this server. Capabilities: @_localCapabilities.
                    }
                </p>
            }
            else if (_sshCredentialsMissing)
            {
                <div class="alert alert-warning">
                    Network Optimizer doesn't have working SSH credentials for this device yet.
                    @if (_canConfigure)
                    {
                        <text>Configure them in <a href="/settings#device-ssh">Settings &gt; Device SSH</a> to run probes from this vantage.</text>
                    }
                    else
                    {
                        <text>A site administrator sets those up before probes can run from this vantage.</text>
                    }
                </div>
            }
        </div>

        @if (_isGatewaySelected && _wanInterfaces.Count > 1)
        {
            <div class="form-group">
                <label class="form-label">WAN interface</label>
                <select class="form-control" style="max-width: 360px;" @bind="_selectedWanInterface">
                    <option value="">Auto (OS routing table)</option>
                    @foreach (var wan in _wanInterfaces)
                    {
                        var wanLabel = !string.IsNullOrEmpty(wan.NetworkGroup)
                            ? $"{wan.Name} ({wan.NetworkGroup}) - {wan.Interface}"
                            : $"{wan.Name} - {wan.Interface}";
                        <option value="@wan.Interface">@wanLabel</option>
                    }
                </select>
                <p class="form-help">Bind the probe to a specific WAN link. Useful on multi-WAN gateways.</p>
            </div>
        }

        <div class="form-group">
            <label class="form-label">To (target)</label>
            <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <select class="form-control" style="max-width: 320px;"
                        @onchange="OnTargetPresetChange">
                    <option value="">Custom address</option>
                    <optgroup label="External">
                        <option value="ext:1.1.1.1">Cloudflare DNS (1.1.1.1)</option>
                        <option value="ext:8.8.8.8">Google DNS (8.8.8.8)</option>
                    </optgroup>
                    @if (_devices.Any())
                    {
                        <optgroup label="Infrastructure">
                            @foreach (var d in _devices)
                            {
                                <option value="@($"dev:{d.Mac}")">@LabelForDevice(d)</option>
                            }
                        </optgroup>
                    }
                </select>
                <input type="text" class="form-control" @bind="_targetAddress"
                       placeholder="hostname or IP" style="flex: 1; min-width: 180px;" />
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Probe Mode</label>
            <select class="form-control" @bind="_probeMode">
                <option value="@ProbeMode.Icmp">ICMP</option>
                <option value="@ProbeMode.Tcp">TCP</option>
                <option value="@ProbeMode.Udp">UDP (traceroute only)</option>
            </select>
        </div>

        @if (_probeMode == ProbeMode.Tcp)
        {
            <div class="form-group">
                <label class="form-label">TCP Port</label>
                <input type="number" class="form-control" @bind="_port" min="1" max="65535" />
            </div>
        }

        @if (!string.IsNullOrEmpty(_runError))
        {
            <div class="alert alert-danger">@_runError</div>
        }

        <div class="action-buttons" style="margin-top: 1rem;">
            <button class="btn btn-primary" @onclick="RunPing" disabled="@(_running || !CanPing)"
                    data-tooltip="@(_probeMode == ProbeMode.Udp ? "Ping runs over ICMP or TCP - UDP is traceroute-only." : null)">
                @if (_running && _runningKind == "ping") { <span class="spinner-sm"></span> <span>Pinging...</span> }
                else { <span>Ping</span> }
            </button>
            <button class="btn btn-secondary" @onclick="RunTraceroute" disabled="@(_running || !CanTraceroute)">
                @if (_running && _runningKind == "trace") { <span class="spinner-sm"></span> <span>Tracing...</span> }
                else { <span>Traceroute</span> }
            </button>
        </div>
    </div>
</div>

@if (_pingResult != null)
{
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
            <h2 class="card-title">Ping result</h2>
            <span class="status-badge @(_pingResult.Success ? "status-connected" : "status-error")">
                @($"{_pingResult.Received}/{_pingResult.Sent}")
                · @($"{_pingResult.LossPercent:0.#}% loss")
            </span>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label class="form-label">From</label>
                <div class="form-value">@VantageLabel(_pingResult.Vantage.Id)</div>
            </div>
            <div class="form-group">
                <label class="form-label">Target</label>
                <div class="form-value">@_pingResult.Target</div>
            </div>
            @if (_pingResult.RttAvgMs.HasValue)
            {
                <div class="form-group">
                    <label class="form-label">RTT min / avg / max / jitter</label>
                    <div class="form-value">
                        @($"{_pingResult.RttMinMs:0.000}") / @($"{_pingResult.RttAvgMs:0.000}") /
                        @($"{_pingResult.RttMaxMs:0.000}") /
                        @(_pingResult.JitterMs.HasValue ? $"{_pingResult.JitterMs:0.000}" : "-") ms
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_pingResult.ErrorMessage))
            {
                <div class="alert alert-warning">@_pingResult.ErrorMessage</div>
            }
        </div>
    </div>
}

@if (_traceResult != null)
{
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
            <h2 class="card-title">Traceroute result</h2>
            <span class="status-badge @(_traceResult.Reached ? "status-connected" : "status-error")">
                @(_traceResult.Reached ? "Target reached" : "Did not reach target")
                · @_traceResult.ModeUsed.ToString().ToUpperInvariant()
            </span>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label class="form-label">From</label>
                <div class="form-value">@VantageLabel(_traceResult.Vantage.Id)</div>
            </div>
            <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Hop</th>
                        <th>Address</th>
                        <th>RTT avg (ms)</th>
                        <th>Responses</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hop in _traceResult.Hops)
                    {
                        <tr>
                            <td>@hop.HopNumber</td>
                            <td>
                                @if (hop.Responded)
                                {
                                    @if (!string.IsNullOrEmpty(hop.Hostname))
                                    { <span>@hop.Hostname (@hop.Address)</span> }
                                    else
                                    { <span>@hop.Address</span> }
                                }
                                else
                                {
                                    <span class="text-muted">* * *</span>
                                }
                            </td>
                            <td>@(hop.RttAvgMs.HasValue ? $"{hop.RttAvgMs:0.0}" : "-")</td>
                            <td>@hop.Responses / @hop.Probes</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            @if (!string.IsNullOrEmpty(_traceResult.ErrorMessage))
            {
                <div class="alert alert-warning">@_traceResult.ErrorMessage</div>
            }
        </div>
    </div>
}

@if (_hasGateway)
{
    <div class="card" style="margin-top: 1.5rem;" data-tour="gateway-interface">
        <div class="card-header">
            <h2 class="card-title">Inspect a gateway interface</h2>
        </div>
        <div class="card-body">
            <p class="page-description" style="margin-top: 0;">
                Read-only detail straight off the gateway: the interface's addresses and, on a
                DHCP WAN, how long the ISP lease has left; the SFP module's transceiver and
                diagnostic readings; and the neighbors it has resolved on the link. Nothing here
                changes gateway state or disturbs the connection.
            </p>

            @if (!_gatewaySshConfigured)
            {
                <div class="alert alert-warning">
                    Gateway SSH isn't configured, so Network Optimizer can't read these.
                    @if (_canConfigure)
                    {
                        <text>Set it up in <a href="/settings#gateway-ssh">Settings &gt; Gateway SSH</a>.</text>
                    }
                    else
                    {
                        <text>A site administrator sets that up.</text>
                    }
                </div>
            }

            <div class="form-group">
                <label class="form-label">Interface</label>
                <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                    <select class="form-control" style="max-width: 320px;" @onchange="OnDiagInterfacePresetChange">
                        <option value="">Custom interface</option>
                        @if (_wanInterfaces.Any())
                        {
                            <optgroup label="WAN">
                                @foreach (var wan in _wanInterfaces)
                                {
                                    var wanLabel = !string.IsNullOrEmpty(wan.NetworkGroup)
                                        ? $"{wan.Name} ({wan.NetworkGroup}) - {wan.Interface}"
                                        : $"{wan.Name} - {wan.Interface}";
                                    <option value="@wan.Interface" selected="@(wan.Interface == _diagInterface)">@wanLabel</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <input type="text" class="form-control" @bind="_diagInterface"
                           placeholder="eth4" style="flex: 1; min-width: 180px;" />
                </div>
                <p class="form-help">
                    Pick a WAN to see its ISP lease, or type any interface on the gateway
                    (an SFP port, a LAN bridge) to inspect it.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(_diagError))
            {
                <div class="alert alert-danger">@_diagError</div>
            }

            <div class="action-buttons" style="margin-top: 1rem;">
                <button class="btn btn-primary" @onclick="RunGatewayDiagnostics"
                        disabled="@(_diagRunning || !CanRunDiagnostics)">
                    @if (_diagRunning) { <span class="spinner-sm"></span> <span>Reading...</span> }
                    else { <span>Read interface</span> }
                </button>
            </div>
        </div>
    </div>
}

@if (_diagResult?.InterfaceInfo != null)
{
    var iface = _diagResult.InterfaceInfo;
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
            <h2 class="card-title">Addresses and DHCP lease</h2>
            <span class="status-badge @(string.Equals(iface.State, "UP", StringComparison.OrdinalIgnoreCase) ? "status-connected" : "status-error")">
                @iface.Name · @(iface.State ?? "unknown")
            </span>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label class="form-label">Link</label>
                <div class="form-value">
                    @(iface.MacAddress ?? "-")
                    @if (iface.Mtu.HasValue) { <span> · MTU @iface.Mtu</span> }
                    @if (!string.IsNullOrEmpty(iface.DefaultGateway)) { <span> · default via @iface.DefaultGateway</span> }
                </div>
            </div>
            @if (iface.Addresses.Count == 0)
            {
                <p class="page-description">No addresses configured on this interface.</p>
            }
            else
            {
                <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Address</th>
                            <th>Subnet</th>
                            <th>Assignment</th>
                            <th>Lease remaining</th>
                            <th>Expires</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var addr in iface.Addresses)
                        {
                            <tr>
                                <td>@addr.Cidr</td>
                                <td>@(addr.SubnetMask ?? (addr.PrefixLength.HasValue ? $"/{addr.PrefixLength}" : "-"))</td>
                                <td>@AssignmentLabel(addr)</td>
                                <td>@LeaseRemainingLabel(addr)</td>
                                <td>@LeaseExpiryLabel(addr, _diagResult.CollectedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <p class="form-help">
                    A dynamic address is a DHCP lease; the gateway renews it around halfway
                    through. The remaining time is how long the address stays valid if no renewal
                    succeeds.
                </p>
            }
        </div>
    </div>
}
else if (_diagResult != null && !string.IsNullOrEmpty(_diagResult.InterfaceError))
{
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header"><h2 class="card-title">Addresses and DHCP lease</h2></div>
        <div class="card-body">
            <div class="alert alert-warning">@_diagResult.InterfaceError</div>
        </div>
    </div>
}

@if (_diagResult != null)
{
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
            <h2 class="card-title">SFP module</h2>
            @if (!string.IsNullOrEmpty(_diagResult.SfpInterface) && _diagResult.SfpInterface != _diagResult.Interface)
            {
                <span class="status-badge status-active">read from @_diagResult.SfpInterface</span>
            }
        </div>
        <div class="card-body">
            @if (_diagResult.SfpModule != null)
            {
                <div class="table-responsive">
                <table class="data-table">
                    <tbody>
                        @foreach (var field in _diagResult.SfpModule.Highlights())
                        {
                            <tr>
                                <td class="detail-label">@field.Name</td>
                                <td class="detail-value">@field.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <details class="setup-guide" style="margin-top: 1rem;">
                    <summary>All transceiver fields</summary>
                    <div class="setup-guide-content">
                        <div class="table-responsive">
                        <table class="data-table">
                            <tbody>
                                @foreach (var field in _diagResult.SfpModule.Fields)
                                {
                                    <tr>
                                        <td class="detail-label">@field.Name</td>
                                        <td class="detail-value">@field.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    </div>
                </details>
            }
            else
            {
                <p class="page-description">@(_diagResult.SfpError ?? "No transceiver data for this interface.")</p>
            }
        </div>
    </div>

    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header"><h2 class="card-title">Neighbors</h2></div>
        <div class="card-body">
            @if (_diagResult.Neighbors.Count > 0)
            {
                <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Address</th>
                            <th>MAC</th>
                            <th class="hide-mobile">Vendor</th>
                            <th>State</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var neighbor in _diagResult.Neighbors)
                        {
                            <tr>
                                <td>@neighbor.IpAddress</td>
                                <td>@(neighbor.MacAddress ?? "-")</td>
                                <td class="hide-mobile">@(neighbor.Vendor ?? "-")</td>
                                <td>
                                    @(neighbor.State ?? "-")
                                    @if (neighbor.IsRouter)
                                    {
                                        <span class="status-badge status-active" style="margin-left: 0.4rem;">router</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
            else
            {
                <p class="page-description">@(_diagResult.NeighborError ?? "No neighbors in the table for this interface.")</p>
            }

            @if (_diagResult.RawOutput.Count > 0)
            {
                <details class="setup-guide" style="margin-top: 1.25rem;">
                    <summary>Raw command output</summary>
                    <div class="setup-guide-content">
                        @foreach (var entry in _diagResult.RawOutput)
                        {
                            <p><strong>@entry.Key</strong></p>
                            <pre class="gateway-diag-raw">@(string.IsNullOrWhiteSpace(entry.Value) ? "(no output)" : entry.Value.Trim())</pre>
                        }
                    </div>
                </details>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>
    /// Whether this caller can open the Settings pages this page points at. Copy only - the controls
    /// themselves are gated by their own wrappers.
    /// </summary>
    private bool _canConfigure;

    private string _fromKey = "server"; // "server" or "device:{mac}"
    private string _targetAddress = "1.1.1.1";
    private ProbeMode _probeMode = ProbeMode.Icmp;
    private int _port = 443;
    private bool _running;
    private string _runningKind = string.Empty;
    private string _localCapabilities = "detecting...";
    private string? _runError;
    private bool _sshCredentialsMissing;

    private List<DiscoveredDevice> _devices = new();
    private List<WanInterfaceInfo> _wanInterfaces = new();
    private string _selectedWanInterface = "";
    private bool _isGatewaySelected;

    private PingProbeResult? _pingResult;
    private TracerouteResult? _traceResult;

    // Gateway interface diagnostics. The section only exists when the site has a gateway,
    // since every command it runs is gateway-only; the SSH check drives the "configure
    // credentials" hint rather than hiding the section, so the user can see what it offers.
    private bool _hasGateway;
    private bool _gatewaySshConfigured;
    private string _diagInterface = "";
    private GatewayDiagnosticsResult? _diagResult;
    private bool _diagRunning;
    private string? _diagError;

    private bool CanRunDiagnostics =>
        _gatewaySshConfigured && !_siteAgentOffline && !string.IsNullOrWhiteSpace(_diagInterface);

    private bool CanRun => !string.IsNullOrWhiteSpace(_targetAddress) && !_sshCredentialsMissing;

    // Ping supports ICMP and TCP (there is no UDP ping); traceroute supports all three
    // modes (ICMP, UDP, TCP). Both also need the site's agent online on an agent-backed site.
    private bool CanPing => CanRun && !_siteAgentOffline && _probeMode != ProbeMode.Udp;
    private bool CanTraceroute => CanRun && !_siteAgentOffline;

    // Agent-backed secondary site whose on-site agent isn't currently connected. Probes run
    // through that agent (server vantage over the tunnel, device vantages over SSH), so they
    // can't run until it reconnects; the poll re-enables them and reloads the device list.
    private bool _siteAgentOffline;
    private bool _consoleDataLoaded;
    private System.Threading.Timer? _agentStatusTimer;

    protected override async Task OnInitializedAsync()
    {
        _canConfigure = AuthState is null
            || (await Authz.AuthorizeAsync((await AuthState).User, SiteContext.Slug, Policies.SiteAdmin)).Succeeded;

        var capTask = LocalProbe.GetCapabilityAsync();
        var devicesTask = LoadDevicesAsync();
        var wanTask = LoadWanInterfacesAsync();
        var gatewaySshTask = LoadGatewaySshStateAsync();
        await Task.WhenAll(capTask, devicesTask, wanTask, gatewaySshTask);
        _localCapabilities = capTask.Result.Describe();
        _consoleDataLoaded = ConnectionService.IsConnected;

        await RefreshAgentAvailabilityAsync();
        StartAgentStatusPolling();
    }

    /// <summary>
    /// Recomputes whether this site's on-site agent is offline. Probes route through the
    /// agent for an agent-backed secondary site, so an offline agent locks them out; the
    /// poll re-enables them when it reconnects. The default site never routes via agent.
    /// </summary>
    private async Task RefreshAgentAvailabilityAsync()
    {
        _siteAgentOffline = !SiteContext.IsDefault
            && await TunnelRouting.IsViaAgentAsync(SiteContext.Slug)
            && !TunnelRouting.IsAgentOnline(SiteContext.Slug);
    }

    /// <summary>
    /// Polls the site's agent tunnel so probes re-enable on their own once the agent
    /// reconnects, and loads the console-dependent device list the moment the console
    /// (which follows the agent) comes back. Only agent-backed secondary sites poll.
    /// </summary>
    private void StartAgentStatusPolling()
    {
        if (SiteContext.IsDefault) return;
        _agentStatusTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    var before = _siteAgentOffline;
                    await RefreshAgentAvailabilityAsync();
                    var changed = before != _siteAgentOffline;

                    if (!_consoleDataLoaded && ConnectionService.IsConnected)
                    {
                        await LoadDevicesAsync();
                        await LoadWanInterfacesAsync();
                        _consoleDataLoaded = true;
                        changed = true;
                    }

                    if (changed)
                        StateHasChanged();
                });
            }
            catch { /* keep the timer alive */ }
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    public void Dispose()
    {
        _agentStatusTimer?.Dispose();
        _agentStatusTimer = null;
    }

    private async Task LoadDevicesAsync()
    {
        try
        {
            if (!ConnectionService.IsConnected) return;
            var devices = await ConnectionService.GetDiscoveredDevicesAsync();
            _devices = devices?
                .Where(d => !string.IsNullOrEmpty(d.Mac) && !string.IsNullOrEmpty(d.DisplayIpAddress))
                .OrderBy(d => d.Type)
                .ThenBy(d => d.Name)
                .ToList() ?? new();
            _hasGateway = _devices.Any(d => d.Type == DeviceType.Gateway);
        }
        catch { _devices = new(); }
    }

    private async Task LoadWanInterfacesAsync()
    {
        try
        {
            if (!ConnectionService.IsConnected) return;
            _wanInterfaces = await SqmService.GetWanInterfacesFromControllerAsync();
            // Start on the primary WAN: the lease countdown that prompted this is a WAN
            // question, and it saves typing an interface name nobody memorizes.
            if (string.IsNullOrEmpty(_diagInterface))
                _diagInterface = _wanInterfaces.OrderBy(w => w.WanIndex).FirstOrDefault()?.Interface ?? "";
        }
        catch { _wanInterfaces = new(); }
    }

    /// <summary>
    /// Whether gateway SSH is usable, which is what the diagnostics run needs. Only reads
    /// the saved settings - it never opens a connection, so loading the page costs nothing.
    /// </summary>
    private async Task LoadGatewaySshStateAsync()
    {
        try
        {
            var settings = await GatewaySsh.GetSettingsAsync();
            _gatewaySshConfigured = settings.Enabled
                && !string.IsNullOrEmpty(settings.Username)
                && settings.HasCredentials;
        }
        catch { _gatewaySshConfigured = false; }
    }

    private void OnDiagInterfacePresetChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        // The blank "Custom interface" option leaves whatever is typed in the box alone.
        if (!string.IsNullOrEmpty(value)) _diagInterface = value;
    }

    private async Task RunGatewayDiagnostics()
    {
        _diagRunning = true;
        _diagError = null;
        _diagResult = null;
        StateHasChanged();
        try
        {
            var result = await GatewayDiagnostics.RunAsync(_diagInterface.Trim());
            if (!string.IsNullOrEmpty(result.RunError))
                _diagError = result.RunError;
            else
                _diagResult = result;
        }
        catch (Exception ex)
        {
            _diagError = $"Couldn't read the interface: {ex.Message}";
        }
        finally
        {
            _diagRunning = false;
            StateHasChanged();
        }
    }

    /// <summary>How the address got there: a DHCP lease, or configured by hand.</summary>
    private static string AssignmentLabel(GatewayInterfaceAddress addr) =>
        addr.IsDynamic ? "DHCP" : "Static";

    /// <summary>
    /// Time left on the lease. A static address (or an IPv6 address with an infinite
    /// lifetime) reports "forever" rather than a countdown, so it reads as "never expires".
    /// </summary>
    private static string LeaseRemainingLabel(GatewayInterfaceAddress addr) =>
        addr.ValidLifetime is TimeSpan span
            ? TimeFormatHelper.FormatDuration(span)
            : "Never expires";

    /// <summary>Absolute local expiry, counted from when the commands actually ran.</summary>
    private static string LeaseExpiryLabel(GatewayInterfaceAddress addr, DateTime collectedAtUtc) =>
        addr.ValidLifetime is TimeSpan span
            ? collectedAtUtc.Add(span).ToLocalTime().ToString("MMM d, yyyy HH:mm")
            : "-";

    private void OnVantageChanged(ChangeEventArgs e)
    {
        _fromKey = e.Value?.ToString() ?? "server";
        _selectedWanInterface = "";
        _sshCredentialsMissing = false;

        if (_fromKey.StartsWith("device:"))
        {
            var mac = _fromKey.Substring("device:".Length);
            var device = _devices.FirstOrDefault(d => d.Mac == mac);
            _isGatewaySelected = device?.Type == DeviceType.Gateway;
        }
        else
        {
            _isGatewaySelected = false;
        }
    }

    private void OnTargetPresetChange(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrEmpty(v)) return;
        if (v.StartsWith("ext:"))
        {
            _targetAddress = v.Substring(4);
            _probeMode = ProbeMode.Icmp;
        }
        else if (v.StartsWith("dev:"))
        {
            var mac = v.Substring(4);
            var match = _devices.FirstOrDefault(d => d.Mac == mac);
            if (match != null && !string.IsNullOrEmpty(match.DisplayIpAddress))
            {
                _targetAddress = match.DisplayIpAddress;
                _probeMode = ProbeMode.Icmp;
            }
        }
    }

    private async Task<IProbeExecutor?> ResolveExecutorAsync()
    {
        _sshCredentialsMissing = false;
        if (_fromKey == "server") return ExecutorFactory.GetServer();
        if (_fromKey.StartsWith("device:"))
        {
            var mac = _fromKey.Substring("device:".Length);
            var exec = await ExecutorFactory.ForDeviceAsync(mac);
            if (exec == null)
            {
                _sshCredentialsMissing = true;
                return null;
            }
            return exec;
        }
        return ExecutorFactory.GetServer();
    }

    private async Task RunPing()
    {
        _running = true;
        _runningKind = "ping";
        _pingResult = null;
        _traceResult = null;
        _runError = null;
        StateHasChanged();
        try
        {
            var executor = await ResolveExecutorAsync();
            if (executor == null)
            {
                _runError = "Couldn't resolve the chosen vantage; check SSH credentials.";
                return;
            }
            var iface = _isGatewaySelected && !string.IsNullOrEmpty(_selectedWanInterface) ? _selectedWanInterface : null;
            var target = new ProbeTarget(_targetAddress.Trim(), _probeMode, _probeMode == ProbeMode.Tcp ? _port : null, iface);
            _pingResult = await executor.PingAsync(target, count: 5);
        }
        catch (Exception ex)
        {
            _runError = $"Probe failed: {ex.Message}";
        }
        finally
        {
            _running = false;
            _runningKind = string.Empty;
            StateHasChanged();
        }
    }

    private async Task RunTraceroute()
    {
        _running = true;
        _runningKind = "trace";
        _pingResult = null;
        _traceResult = null;
        _runError = null;
        StateHasChanged();
        try
        {
            var executor = await ResolveExecutorAsync();
            if (executor == null)
            {
                _runError = "Couldn't resolve the chosen vantage; check SSH credentials.";
                return;
            }
            var iface = _isGatewaySelected && !string.IsNullOrEmpty(_selectedWanInterface) ? _selectedWanInterface : null;
            var target = new ProbeTarget(_targetAddress.Trim(), _probeMode, _probeMode == ProbeMode.Tcp ? _port : null, iface);
            _traceResult = await executor.TracerouteAsync(
                target,
                maxHops: 30,
                perHopTimeout: TimeSpan.FromSeconds(2),
                totalDeadline: TimeSpan.FromSeconds(10));
        }
        catch (Exception ex)
        {
            _runError = $"Traceroute failed: {ex.Message}";
        }
        finally
        {
            _running = false;
            _runningKind = string.Empty;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Friendly label for a probe result's vantage id ("server" or "device:{mac}"):
    /// the device's name/type when known, or the server/on-site-agent label.
    /// </summary>
    private string VantageLabel(string vantageId)
    {
        if (string.IsNullOrEmpty(vantageId)) return "Unknown";
        if (vantageId.StartsWith("device:"))
        {
            var mac = vantageId.Substring("device:".Length);
            var device = _devices.FirstOrDefault(d => d.Mac == mac);
            return device != null ? LabelForDevice(device) : mac;
        }
        if (vantageId == "server")
            return ExecutorFactory.ServerVantageIsAgent ? "On-site agent" : "Network Optimizer server";
        return vantageId;
    }

    private static string LabelForDevice(DiscoveredDevice d)
    {
        var type = d.Type switch
        {
            DeviceType.Gateway => "Gateway",
            DeviceType.Switch => "Switch",
            DeviceType.AccessPoint => "AP",
            _ => d.Type.ToString()
        };
        var name = string.IsNullOrEmpty(d.Name) ? d.Mac : d.Name;
        return string.IsNullOrEmpty(d.DisplayIpAddress)
            ? $"{type}: {name}"
            : $"{type}: {name} ({d.DisplayIpAddress})";
    }
}
