            }
            var target = new ProbeTarget(_targetAddress.Trim(), _probeMode, _probeMode == ProbeMode.Tcp ? _port : null, SelectedSourceBind());
            _traceResult = await executor.TracerouteAsync(
                target,
                maxHops: 30,
                perHopTimeout: TimeSpan.FromSeconds(2),
                totalDeadline: TimeSpan.FromSeconds(10));
        }
        catch (Exception ex)
