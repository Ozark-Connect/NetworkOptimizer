</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>
    /// Whether this caller can open the Settings pages this page points at. Copy only - the controls
    /// themselves are gated by their own wrappers.
    /// </summary>
    private bool _canConfigure;

    private string _fromKey = "server"; // "server" or "device:{mac}"
    private string _targetAddress = "1.1.1.1";
    private ProbeMode _probeMode = ProbeMode.Icmp;
    private int _port = 443;
    private bool _running;
    private string _runningKind = string.Empty;
    private string _localCapabilities = "detecting...";
    private string? _runError;
    private bool _sshCredentialsMissing;

    private List<DiscoveredDevice> _devices = new();
    private List<WanInterfaceInfo> _wanInterfaces = new();
    private string _selectedWanInterface = "";
    private bool _isGatewaySelected;

    // Probe origins to choose between - the server and the site's connected agents, each labeled
    // with the WAN context it probes for. Empty on a site with only one origin, which is where
    // the picker stays out of the way and the vantage list reads exactly as it always has.
    private List<ProbeVantageOption> _probeVantages = new();

    /// <summary>
    /// Remembered vantage, per site. Which box a probe runs from is a property of the site being
    /// looked at, not of the browser, so a multi-site operator doesn't carry one site's WAN
    /// vantage into the next.
    /// </summary>
    private string VantageStorageKey => SiteContext.ScopeStorageKey("networkToolsVantage");

    private PingProbeResult? _pingResult;
    private DnsLookupResult? _dnsResult;
    private TracerouteResult? _traceResult;

    // Gateway interface diagnostics. The section only exists when the site has a gateway,
    // since every command it runs is gateway-only; the SSH check drives the "configure
    // credentials" hint rather than hiding the section, so the user can see what it offers.
    private bool _hasGateway;
    private bool _gatewaySshConfigured;
    private string _diagInterface = "";
    private GatewayDiagnosticsResult? _diagResult;
    private bool _diagRunning;
    private string? _diagError;

    // Gateway dmesg diagnostics
    private DmesgDiagnosticsReport? _dmesgReport;
    private bool _dmesgRunning;
    private string? _dmesgError;

    // Console support file
    private bool _supportFileRunning;
    private string? _supportFileError;

    private bool CanRunDiagnostics =>
        _gatewaySshConfigured && !_siteAgentOffline && !string.IsNullOrWhiteSpace(_diagInterface);

    private bool CanRun => !string.IsNullOrWhiteSpace(_targetAddress) && !_sshCredentialsMissing;

    // Ping supports ICMP and TCP (there is no UDP ping); traceroute supports all three
    // modes (ICMP, UDP, TCP). Both also need the site's agent online on an agent-backed site.
    private bool CanPing => CanRun && !_siteAgentOffline && _probeMode != ProbeMode.Udp;
    private bool CanTraceroute => CanRun && !_siteAgentOffline;

    // Agent-backed secondary site whose on-site agent isn't currently connected. Probes run
    // through that agent (server vantage over the tunnel, device vantages over SSH), so they
    // can't run until it reconnects; the poll re-enables them and reloads the device list.
    private bool _siteAgentOffline;
    private bool _consoleDataLoaded;
    private System.Threading.Timer? _agentStatusTimer;

    protected override async Task OnInitializedAsync()
    {
        _canConfigure = AuthState is null
            || (await Authz.AuthorizeAsync((await AuthState).User, SiteContext.Slug, Policies.SiteAdmin)).Succeeded;

        var capTask = LocalProbe.GetCapabilityAsync();
        var devicesTask = LoadDevicesAsync();
        var wanTask = LoadWanInterfacesAsync();
        var gatewaySshTask = LoadGatewaySshStateAsync();
        await Task.WhenAll(capTask, devicesTask, wanTask, gatewaySshTask);
        _localCapabilities = capTask.Result.Describe();
        _consoleDataLoaded = ConnectionService.IsConnected;

        await LoadProbeVantagesAsync();
        await ApplyInitialVantageAsync();
        await RefreshAgentAvailabilityAsync();
        StartAgentStatusPolling();
    }

    /// <summary>
    /// Vantage to start on, sent by whatever linked here - the Verify action on a WAN vantage is
    /// the one that does. Takes precedence over the remembered choice: the link is the user asking
    /// for a specific origin now, and it is checked against the real list, so a stale link falls
    /// back rather than pointing the page at a vantage the select cannot show.
    /// </summary>
    [SupplyParameterFromQuery(Name = "from")]
    public string? FromParam { get; set; }

    /// <summary>
    /// Decides the starting vantage once, in OnInitializedAsync after the vantage and device
    /// lists have loaded, so no render can race the decision: a from= link first, then the
    /// remembered choice, then the list's first entry. During prerender the localStorage read
    /// throws and the fallback stands; the interactive circuit re-runs the decision in full.
    /// </summary>
    private async Task ApplyInitialVantageAsync()
    {
        // The link outranks the remembered choice and is never persisted - it overrides this
        // load only. server and device keys resolve even when the vantage list is empty,
        // since neither comes from it.
        if (!string.IsNullOrEmpty(FromParam))
        {
            var keys = _probeVantages.Select(v => v.Key)
                .Concat(new[] { ProbeVantages.ServerKey })
                .Concat(_devices.Select(d => $"device:{d.Mac}"))
                .ToList();
            var resolved = ResolveVantageFromLink(FromParam, keys);
            if (resolved != null)
            {
                ApplyVantage(resolved);
                return;
            }
        }

        var stored = await ReadStoredVantageAsync();
        if (stored != null)
        {
            ApplyVantage(stored);
            return;
        }

        EnsureDefaultVantage();
    }

    /// <summary>
    /// The remembered vantage, or null when nothing valid is stored. A remembered agent that has
    /// since been removed (or a device that is gone) must not leave the page pointing at a
    /// vantage the select can't show.
    /// </summary>
    private async Task<string?> ReadStoredVantageAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string>("localStorage.getItem", VantageStorageKey);
            if (!string.IsNullOrEmpty(stored)
                && (_probeVantages.Any(v => v.Key == stored)
                    || (stored.StartsWith("device:") && _devices.Any(d => $"device:{d.Mac}" == stored))))
                return stored;
        }
        catch { /* prerendering, or no localStorage - the default vantage is fine */ }
        return null;
    }

    /// <summary>
    /// With the server not offering itself, the default "server" key names nothing in the
    /// vantage list; start on the first origin that does.
    /// </summary>
    private void EnsureDefaultVantage()
    {
        if (_probeVantages.Count > 0 && _probeVantages.All(v => v.Key != _fromKey) && !_fromKey.StartsWith("device:"))
            ApplyVantage(_probeVantages[0].Key);
    }

    /// <summary>
    /// Which offered vantage a "from" link means. Exact key first, then the first vantage
    /// belonging to the named agent.
    /// </summary>
    /// <remarks>
    /// Callers can only name an agent (<c>agent:7</c>): a WAN context records the agent that
    /// probes it and no vantage id, while the picker keys an agent's entries per vantage
    /// (<c>agent:7:wan2</c>). Returns null when nothing on offer matches, leaving the
    /// remembered choice alone.
    /// </remarks>
    internal static string? ResolveVantageFromLink(string? fromParam, IEnumerable<string> vantageKeys)
    {
        if (string.IsNullOrEmpty(fromParam)) return null;

        var keys = vantageKeys as IReadOnlyList<string> ?? vantageKeys.ToList();
        return keys.FirstOrDefault(k => string.Equals(k, fromParam, StringComparison.OrdinalIgnoreCase))
               ?? keys.FirstOrDefault(k => k.StartsWith(fromParam + ":", StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// Builds the vantage list: this site's connected agents, each labeled with the WAN context
    /// assigned to it and whether it runs on the gateway, alongside the server when the server is
    /// what probes this site. Best-effort - a site whose console or registry can't be read keeps
    /// the single server vantage it has always had.
    /// </summary>
    private async Task LoadProbeVantagesAsync()
    {
        try
        {
            var connections = TunnelRegistry.GetForSite(SiteContext.Slug);
            if (connections.Count == 0)
            {
                _probeVantages = new();
                return;
            }

            List<WanContext> contexts;
            await using (var siteDb = SiteDb.CreateForSite(SiteContext.Slug, SiteContext.IsDefault))
                contexts = await siteDb.WanContexts.AsNoTracking().ToListAsync();

            Dictionary<int, string> agentNames;
            await using (var mainDb = await MainDbFactory.CreateDbContextAsync())
            {
                var site = await mainDb.Sites.AsNoTracking().FirstOrDefaultAsync(s => s.Slug == SiteContext.Slug);
                agentNames = site == null
                    ? new()
                    : await mainDb.SiteAgents.AsNoTracking()
                        .Where(a => a.SiteId == site.Id)
                        .ToDictionaryAsync(a => a.Id, a => a.Name);
            }

            var wans = await LoadWanSummariesAsync();
            var agents = new List<ProbeVantageAgent>();
            foreach (var connection in connections)
            {
                var bindings = contexts
                    .Where(c => c.AgentId == connection.AgentId)
                    .Select(c => new ProbeVantageBinding(
                        c.Id,
                        c.Name,
                        WanLabelFor(wans, c.WanInterface),
                        c.InterfaceName ?? c.ProbeSourceIp))
                    .ToList();
                agents.Add(new ProbeVantageAgent(
                    connection.AgentId,
                    agentNames.GetValueOrDefault(connection.AgentId, connection.AgentName),
                    // TODO(#1106): use the durable per-agent overload
                    // IsAgentOnGatewayAsync(slug, agentId, candidates) instead - this one has no
                    // persisted verdict, so a console that has not answered yet mislabels the
                    // vantage.
                    await OnGatewayDetector.MatchGatewayAddressAsync(SiteContext.Slug, connection.HostAddresses) != null,
                    bindings));
            }

            _probeVantages = ProbeVantages.ForPicker(
                serverProbesSite: !ExecutorFactory.ServerVantageIsAgent,
                serverLabel: "Network Optimizer server",
                agents);
        }
        catch
        {
            _probeVantages = new();
        }
    }

    /// <summary>The site's WANs for labeling, or none when the console can't answer.</summary>
    private async Task<IReadOnlyList<WanSummary>> LoadWanSummariesAsync()
    {
        try { return await PathView.GetWansAsync(); }
        catch { return Array.Empty<WanSummary>(); }
    }

    /// <summary>A WAN key in UniFi's own wording ("My ISP WAN2"), or null when there is no WAN to name.</summary>
    private static string? WanLabelFor(IReadOnlyList<WanSummary> wans, string? wanInterface)
    {
        if (string.IsNullOrEmpty(wanInterface)) return null;
        var wan = wans.FirstOrDefault(w =>
            string.Equals(w.WanInterface, wanInterface, StringComparison.OrdinalIgnoreCase));
        return GatewayWanHelper.FormatWanLabel(
            wan?.FriendlyName, GatewayWanHelper.WanIndexFromKey(wanInterface), null, null);
    }

    /// <summary>
    /// Recomputes whether this site's on-site agent is offline. Probes route through the
    /// agent for an agent-backed secondary site, so an offline agent locks them out; the
    /// poll re-enables them when it reconnects. The default site never routes via agent.
    /// </summary>
    private async Task RefreshAgentAvailabilityAsync()
    {
        _siteAgentOffline = !SiteContext.IsDefault
            && await TunnelRouting.IsViaAgentAsync(SiteContext.Slug)
            && !TunnelRouting.IsAgentOnline(SiteContext.Slug);
    }

    /// <summary>
    /// Polls the site's agent tunnel so probes re-enable on their own once the agent
    /// reconnects, and loads the console-dependent device list the moment the console
    /// (which follows the agent) comes back. Only agent-backed secondary sites poll.
    /// </summary>
    private void StartAgentStatusPolling()
    {
        if (SiteContext.IsDefault) return;
        _agentStatusTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    var before = _siteAgentOffline;
                    await RefreshAgentAvailabilityAsync();
                    var changed = before != _siteAgentOffline;

                    // The vantage list is built from live tunnels, so an agent that was down when
                    // the page opened would otherwise never appear in it.
                    if (changed)
                    {
                        await LoadProbeVantagesAsync();
                        EnsureDefaultVantage();
                    }

                    if (!_consoleDataLoaded && ConnectionService.IsConnected)
                    {
                        await LoadDevicesAsync();
                        await LoadWanInterfacesAsync();
                        _consoleDataLoaded = true;
                        changed = true;
                    }

                    if (changed)
                        StateHasChanged();
                });
            }
            catch { /* keep the timer alive */ }
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    public void Dispose()
    {
        _agentStatusTimer?.Dispose();
        _agentStatusTimer = null;
    }

    private async Task LoadDevicesAsync()
    {
        try
        {
            if (!ConnectionService.IsConnected) return;
            var devices = await ConnectionService.GetDiscoveredDevicesAsync();
            _devices = devices?
                .Where(d => !string.IsNullOrEmpty(d.Mac) && !string.IsNullOrEmpty(d.DisplayIpAddress))
                .OrderBy(d => d.Type)
                .ThenBy(d => d.Name)
                .ToList() ?? new();
            _hasGateway = _devices.Any(d => d.Type == DeviceType.Gateway);
        }
        catch { _devices = new(); }
    }

    private async Task LoadWanInterfacesAsync()
    {
        try
        {
            if (!ConnectionService.IsConnected) return;
            _wanInterfaces = await SqmService.GetWanInterfacesFromControllerAsync();
            // Start on the primary WAN: the lease countdown that prompted this is a WAN
            // question, and it saves typing an interface name nobody memorizes.
            if (string.IsNullOrEmpty(_diagInterface))
                _diagInterface = _wanInterfaces.OrderBy(w => w.WanIndex).FirstOrDefault()?.Interface ?? "";
        }
        catch { _wanInterfaces = new(); }
    }

    /// <summary>
    /// Whether gateway SSH is usable, which is what the diagnostics run needs. Only reads
    /// the saved settings - it never opens a connection, so loading the page costs nothing.
    /// </summary>
    private async Task LoadGatewaySshStateAsync()
    {
        try
        {
            var settings = await GatewaySsh.GetSettingsAsync();
            _gatewaySshConfigured = settings.Enabled
                && !string.IsNullOrEmpty(settings.Username)
                && settings.HasCredentials;
        }
        catch { _gatewaySshConfigured = false; }
    }

    private void OnDiagInterfacePresetChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        // The blank "Custom interface" option leaves whatever is typed in the box alone.
        if (!string.IsNullOrEmpty(value)) _diagInterface = value;
    }

    private async Task RunGatewayDiagnostics()
    {
        _diagRunning = true;
        _diagError = null;
        _diagResult = null;
        StateHasChanged();
        try
        {
            var result = await GatewayDiagnostics.RunAsync(_diagInterface.Trim());
            if (!string.IsNullOrEmpty(result.RunError))
                _diagError = result.RunError;
            else
                _diagResult = result;
        }
        catch (Exception ex)
        {
            _diagError = $"Couldn't read the interface: {ex.Message}";
        }
        finally
        {
            _diagRunning = false;
            StateHasChanged();
        }
    }

    private async Task RunDmesgAsync()
    {
        _dmesgRunning = true;
        _dmesgError = null;
        _dmesgReport = null;
        StateHasChanged();
        try
        {
            _dmesgReport = await DmesgDiagnostics.RunAsync();
        }
        catch (Exception ex)
        {
            _dmesgError = $"Couldn't run dmesg: {ex.Message}";
        }
        finally
        {
            _dmesgRunning = false;
            StateHasChanged();
        }
    }

    private IJSObjectReference? _supportFileJs;

    private async Task GenerateSupportFileAsync()
    {
        _supportFileRunning = true;
        _supportFileError = null;
        StateHasChanged();
        try
        {
            _supportFileJs ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", VersionedJs("/js/support-file.js"));
            await _supportFileJs.InvokeVoidAsync("downloadSupportFile", "/api/support-file/generate");
        }
        catch (Exception ex)
        {
            _supportFileError = $"Couldn't start the download: {ex.Message}";
        }
        finally
        {
            _supportFileRunning = false;
            StateHasChanged();
        }
    }

    private string VersionedJs(string path) => FileVersionProvider.AddFileVersionToPath("", path);

    private static string SeverityDotClass(DmesgSeverity severity) => severity switch
    {
        DmesgSeverity.Error => "error",
        DmesgSeverity.Warning => "provisioning",
        _ => "online"
    };

    /// <summary>How the address got there: a DHCP lease, or configured by hand.</summary>
    private static string AssignmentLabel(GatewayInterfaceAddress addr) =>
        addr.IsDynamic ? "DHCP" : "Static";

    /// <summary>
    /// Time left on the lease. A static address (or an IPv6 address with an infinite
    /// lifetime) reports "forever" rather than a countdown, so it reads as "never expires".
    /// </summary>
    private static string LeaseRemainingLabel(GatewayInterfaceAddress addr) =>
        addr.ValidLifetime is TimeSpan span
            ? TimeFormatHelper.FormatDuration(span)
            : "Never expires";

    /// <summary>Absolute local expiry, counted from when the commands actually ran.</summary>
    private static string LeaseExpiryLabel(GatewayInterfaceAddress addr, DateTime collectedAtUtc) =>
        addr.ValidLifetime is TimeSpan span
            ? collectedAtUtc.Add(span).ToLocalTime().ToString("MMM d, yyyy HH:mm")
            : "-";

    private async Task OnVantageChanged(ChangeEventArgs e)
    {
        ApplyVantage(e.Value?.ToString() ?? "server");
        // Saved whatever the vantage list holds: device and server keys never came from it, so
        // gating on it lost a hand-picked device vantage on any site whose list came back empty.
        // A deep link deliberately does not reach here - it overrides the load, not the choice.
        try { await JS.InvokeVoidAsync("localStorage.setItem", VantageStorageKey, _fromKey); }
        catch { /* remembering the vantage is best-effort */ }
    }

    /// <summary>Selects a vantage and resets the per-vantage state that only applies to the old one.</summary>
    private void ApplyVantage(string key)
    {
        _fromKey = key;
        _selectedWanInterface = "";
        _sshCredentialsMissing = false;

        if (_fromKey.StartsWith("device:"))
        {
            var mac = _fromKey.Substring("device:".Length);
            var device = _devices.FirstOrDefault(d => d.Mac == mac);
            _isGatewaySelected = device?.Type == DeviceType.Gateway;
        }
        else
        {
            _isGatewaySelected = false;
        }
    }

    /// <summary>
    /// What the chosen vantage binds its probes to: the gateway WAN picked by hand on a gateway
    /// SSH vantage, or the WAN context's own interface / source IP on an agent vantage. Null
    /// leaves the probe on the vantage's own route, which is what every vantage did before
    /// contexts existed.
    /// </summary>
    private string? SelectedSourceBind()
    {
        if (_isGatewaySelected)
            return string.IsNullOrEmpty(_selectedWanInterface) ? null : _selectedWanInterface;
        return _probeVantages.FirstOrDefault(v => v.Key == _fromKey)?.SourceBind;
    }

    private void OnTargetPresetChange(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrEmpty(v)) return;
        if (v.StartsWith("ext:"))
        {
            _targetAddress = v.Substring(4);
            _probeMode = ProbeMode.Icmp;
        }
        else if (v.StartsWith("dev:"))
        {
            var mac = v.Substring(4);
            var match = _devices.FirstOrDefault(d => d.Mac == mac);
            if (match != null && !string.IsNullOrEmpty(match.DisplayIpAddress))
            {
                _targetAddress = match.DisplayIpAddress;
                _probeMode = ProbeMode.Icmp;
            }
        }
    }

    private async Task<IProbeExecutor?> ResolveExecutorAsync()
    {
        _sshCredentialsMissing = false;
        if (_fromKey == "server") return ExecutorFactory.GetServer();
        // A named agent runs the probe itself, rather than whichever agent the site's "server"
        // vantage resolves to - the point of picking it is that it sits behind a given WAN.
        if (_fromKey.StartsWith("agent:"))
        {
            // "agent:{id}" or "agent:{id}:{vantageId}" - the vantage decides the binding, which
            // the picker option already carries, so only the agent id is needed here.
            var rest = _fromKey.AsSpan("agent:".Length);
            var separator = rest.IndexOf(':');
            if (int.TryParse(separator >= 0 ? rest[..separator] : rest, out var vantageAgentId))
                return ExecutorFactory.ForAgent(vantageAgentId);
        }
        if (_fromKey.StartsWith("device:"))
        {
            var mac = _fromKey.Substring("device:".Length);
            var exec = await ExecutorFactory.ForDeviceAsync(mac);
            if (exec == null)
            {
                _sshCredentialsMissing = true;
                return null;
            }
            return exec;
        }
        return ExecutorFactory.GetServer();
    }

    /// <summary>
    /// Resolve the target from the chosen vantage. A bare address is treated as a reverse
    /// lookup, since asking a resolver to forward-resolve an address answers nothing.
    /// </summary>
    private async Task RunLookup()
    {
        _running = true;
        _runningKind = "dns";
        _pingResult = null;
        _traceResult = null;
        _dnsResult = null;
        _runError = null;
        StateHasChanged();
        try
        {
            var executor = await ResolveExecutorAsync();
            if (executor == null)
            {
                _runError = "Couldn't resolve the chosen vantage; check SSH credentials.";
                return;
            }
            var address = _targetAddress.Trim();
            var reverse = System.Net.IPAddress.TryParse(address, out _);
            var target = new ProbeTarget(address, _probeMode, null, SelectedSourceBind());
            _dnsResult = await executor.LookupAsync(target, reverse);
        }
        catch (Exception ex)
        {
            _runError = $"Lookup failed: {ex.Message}";
        }
        finally
        {
            _running = false;
            _runningKind = string.Empty;
            StateHasChanged();
        }
    }

    private async Task RunPing()
    {
        _running = true;
        _runningKind = "ping";
        _pingResult = null;
        _traceResult = null;
        _dnsResult = null;
        _runError = null;
        StateHasChanged();
        try
        {
            var executor = await ResolveExecutorAsync();
            if (executor == null)
            {
                _runError = "Couldn't resolve the chosen vantage; check SSH credentials.";
                return;
            }
            var target = new ProbeTarget(_targetAddress.Trim(), _probeMode, _probeMode == ProbeMode.Tcp ? _port : null, SelectedSourceBind());
            _pingResult = await executor.PingAsync(target, count: 5);
        }
        catch (Exception ex)
        {
            _runError = $"Probe failed: {ex.Message}";
        }
        finally
        {
            _running = false;
            _runningKind = string.Empty;
            StateHasChanged();
        }
    }

    private async Task RunTraceroute()
    {
        _running = true;
        _runningKind = "trace";
        _pingResult = null;
        _traceResult = null;
        _dnsResult = null;
        _runError = null;
        StateHasChanged();
        try
        {
            var executor = await ResolveExecutorAsync();
            if (executor == null)
            {
                _runError = "Couldn't resolve the chosen vantage; check SSH credentials.";
