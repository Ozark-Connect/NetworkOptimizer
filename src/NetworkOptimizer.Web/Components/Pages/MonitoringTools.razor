@page "/network-tools"
@attribute [Authorize(Policy = Policies.RequireViewer)]
@rendermode InteractiveServer
@implements IDisposable
@using NetworkOptimizer.Web.Services
@using NetworkOptimizer.Web.Services.Monitoring
@using NetworkOptimizer.Monitoring.Probes
@using NetworkOptimizer.Core.Enums
@using NetworkOptimizer.UniFi
@using NetworkOptimizer.UniFi.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using NetworkOptimizer.Web.Services.Authorization
@using Microsoft.EntityFrameworkCore
@using NetworkOptimizer.Storage.Models
@inject IAuthorizationService Authz
@inject IJSRuntime JS
@inject NetworkOptimizer.Storage.Services.SiteDbContextFactory SiteDb
@inject IDbContextFactory<NetworkOptimizerDbContext> MainDbFactory
@inject AgentTunnelRegistry TunnelRegistry
@inject AgentOnGatewayDetector OnGatewayDetector
@inject MonitoringPathView PathView
@inject NetworkOptimizer.Monitoring.Probes.LocalProbeExecutor LocalProbe
@inject ProbeExecutorFactory ExecutorFactory
@inject UniFiConnectionService ConnectionService
@inject ISqmService SqmService
@inject SiteContextService SiteContext
@inject SiteTunnelRouting TunnelRouting
@inject GatewayDiagnosticsService GatewayDiagnostics
@inject DmesgDiagnosticsService DmesgDiagnostics
@inject ISupportFileService SupportFile
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@inject NetworkOptimizer.Web.Services.Ssh.IGatewaySshService GatewaySsh

<PageTitle>Network Tools - Network Optimizer</PageTitle>

<div class="page-header">
    <a href="/monitoring" class="page-back-link back-link">← Back to Monitoring</a>
    <h1>Network Tools</h1>
    <p class="page-description">
        Run ping or traceroute from any vantage to any target. Picking a UniFi device
        as the source runs the probe over SSH on that device, which lets you isolate
        whether a problem is on the server's path or on a specific link of your LAN.
        You can also read an interface straight off the gateway - addresses and DHCP
        lease, SFP module diagnostics, and resolved neighbors.
    </p>
</div>

@if (_siteAgentOffline)
{
    <div class="alert alert-warning">
        This site's probes run through its on-site agent, which isn't connected right now.
        Ping, traceroute, and reading a gateway interface can resume when the agent reconnects.
    </div>
}

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Run a Probe</h2>
    </div>
    <div class="card-body">
        <div class="form-group">
            <label class="form-label">From (vantage)</label>
            @* Selection rides on each option's selected flag: a value attribute on a select is
               inert, so a vantage applied after first render never reached the control. *@
            <select class="form-control" @onchange="OnVantageChanged">
                @if (_probeVantages.Count > 0)
                {
                    @foreach (var vantage in _probeVantages)
                    {
                        <option value="@vantage.Key" selected="@(vantage.Key == _fromKey)">@vantage.Label</option>
                    }
                }
                else
                {
                    <option value="server" selected="@(_fromKey == "server")">@(ExecutorFactory.ServerVantageIsAgent ? "On-site agent" : "Network Optimizer server")</option>
                }
                @foreach (var d in _devices)
                {
                    <option value="@($"device:{d.Mac}")" selected="@(_fromKey == $"device:{d.Mac}")">@LabelForDevice(d)</option>
                }
            </select>
            @if (_probeVantages.Any(v => v.SourceBind != null))
            {
                <p class="form-help">
                    A probe from a WAN vantage should go out that WAN: its first hops are
                    that WAN's own gateway and upstream. If they aren't, the policy-based route or the
                    interface bind isn't sending traffic where it was meant to.
                </p>
            }
            @if (_fromKey == "server")
            {
                <p class="page-description" style="margin-top: 0.5rem;">
                    @if (ExecutorFactory.ServerVantageIsAgent)
                    {
                        @:Probes run from this site's on-site agent (on the site's own network), not the central server.
                    }
                    else
                    {
                        @:Probes from this server. Capabilities: @_localCapabilities.
                    }
                </p>
            }
            else if (_sshCredentialsMissing)
            {
                <div class="alert alert-warning">
                    Network Optimizer doesn't have working SSH credentials for this device yet.
                    @if (_canConfigure)
                    {
                        <text>Configure them in <a href="/settings#device-ssh">Settings &gt; Device SSH</a> to run probes from this vantage.</text>
                    }
                    else
                    {
                        <text>A site administrator sets those up before probes can run from this vantage.</text>
                    }
                </div>
            }
        </div>

        @if (_isGatewaySelected && _wanInterfaces.Count > 1)
        {
            <div class="form-group">
                <label class="form-label">WAN interface</label>
                <select class="form-control" style="max-width: 360px;" @bind="_selectedWanInterface">
                    <option value="">Auto (OS routing table)</option>
                    @foreach (var wan in _wanInterfaces)
                    {
                        var wanLabel = !string.IsNullOrEmpty(wan.NetworkGroup)
                            ? $"{wan.Name} ({wan.NetworkGroup}) - {wan.Interface}"
                            : $"{wan.Name} - {wan.Interface}";
                        <option value="@wan.Interface">@wanLabel</option>
                    }
                </select>
                <p class="form-help">Bind the probe to a specific WAN link. Useful on multi-WAN gateways.</p>
            </div>
        }

        <div class="form-group">
            <label class="form-label">To (target)</label>
            <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <select class="form-control" style="max-width: 320px;"
                        @onchange="OnTargetPresetChange">
                    <option value="">Custom address</option>
                    <optgroup label="External">
                        <option value="ext:1.1.1.1">Cloudflare DNS (1.1.1.1)</option>
                        <option value="ext:8.8.8.8">Google DNS (8.8.8.8)</option>
                    </optgroup>
                    @if (_devices.Any())
                    {
                        <optgroup label="Infrastructure">
                            @foreach (var d in _devices)
                            {
                                <option value="@($"dev:{d.Mac}")">@LabelForDevice(d)</option>
                            }
                        </optgroup>
                    }
                </select>
                <input type="text" class="form-control" @bind="_targetAddress"
                       placeholder="hostname or IP" style="flex: 1; min-width: 180px;" />
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Probe Mode</label>
            <select class="form-control" @bind="_probeMode">
                <option value="@ProbeMode.Icmp">ICMP</option>
                <option value="@ProbeMode.Tcp">TCP</option>
                <option value="@ProbeMode.Udp">UDP (traceroute only)</option>
            </select>
        </div>

        @if (_probeMode == ProbeMode.Tcp)
        {
            <div class="form-group">
                <label class="form-label">TCP Port</label>
                <input type="number" class="form-control" @bind="_port" min="1" max="65535" />
            </div>
        }

        @if (!string.IsNullOrEmpty(_runError))
        {
            <div class="alert alert-danger">@_runError</div>
        }

        <div class="action-buttons" style="margin-top: 1rem;" data-tour="dns-lookup">
            <button class="btn btn-primary" @onclick="RunPing" disabled="@(_running || !CanPing)"
                    data-tooltip="@(_probeMode == ProbeMode.Udp ? "Ping runs over ICMP or TCP - UDP is traceroute-only." : null)">
                @if (_running && _runningKind == "ping") { <span class="spinner-sm"></span> <span>Pinging...</span> }
                else { <span>Ping</span> }
            </button>
            <button class="btn btn-secondary" @onclick="RunTraceroute" disabled="@(_running || !CanTraceroute)">
                @if (_running && _runningKind == "trace") { <span class="spinner-sm"></span> <span>Tracing...</span> }
                else { <span>Traceroute</span> }
            </button>
            <button class="btn btn-secondary" @onclick="RunLookup" disabled="@_running"
                    data-tooltip="Resolves the target using this vantage's own DNS server.">
                @if (_running && _runningKind == "dns") { <span class="spinner-sm"></span> <span>Looking up...</span> }
                else { <span>DNS Lookup</span> }
            </button>
        </div>
    </div>
</div>

@if (_pingResult != null)
{
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
            <h2 class="card-title">Ping Result</h2>
            <span class="status-badge @(_pingResult.Success ? "status-connected" : "status-error")">
                @($"{_pingResult.Received}/{_pingResult.Sent}")
                · @($"{_pingResult.LossPercent:0.#}% loss")
            </span>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label class="form-label">From</label>
                <div class="form-value">@VantageLabel(_pingResult.Vantage.Id)</div>
            </div>
            <div class="form-group">
                <label class="form-label">Target</label>
                <div class="form-value">
                    @_pingResult.Target
                    @if (!string.IsNullOrEmpty(_pingResult.ResolvedAddress))
                    {
                        <span>(@_pingResult.ResolvedAddress)</span>
                    }
                </div>
            </div>
            @if (_pingResult.RttAvgMs.HasValue)
            {
                <div class="form-group">
                    <label class="form-label">RTT min / avg / max / jitter</label>
                    <div class="form-value">
                        @($"{_pingResult.RttMinMs:0.000}") / @($"{_pingResult.RttAvgMs:0.000}") /
                        @($"{_pingResult.RttMaxMs:0.000}") /
                        @(_pingResult.JitterMs.HasValue ? $"{_pingResult.JitterMs:0.000}" : "-") ms
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_pingResult.ErrorMessage))
            {
                <div class="alert alert-warning">@_pingResult.ErrorMessage</div>
            }
        </div>
    </div>
}

@if (_dnsResult != null)
{
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
            <h2 class="card-title">DNS Result</h2>
            <span class="status-badge @(_dnsResult.Success ? "status-connected" : "status-error")">
                @(_dnsResult.Success
                    ? (_dnsResult.Addresses.Count > 0 ? $"{_dnsResult.Addresses.Count} address(es)" : "Name found")
                    : _dnsResult.NotFound ? "Name not found" : "No answer")
            </span>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label class="form-label">From</label>
                <div class="form-value">@VantageLabel(_dnsResult.Vantage.Id)</div>
            </div>
            <div class="form-group">
                <label class="form-label">Target</label>
                <div class="form-value">@_dnsResult.Target.Address</div>
            </div>
            @* Several device classes name no resolver at all, so the row is omitted rather
               than shown empty or filled with a guess. *@
            @if (!string.IsNullOrEmpty(_dnsResult.Resolver))
            {
                <div class="form-group">
                    <label class="form-label">Resolver</label>
                    <div class="form-value">@_dnsResult.Resolver</div>
                </div>
            }
            @if (_dnsResult.Addresses.Count > 0)
            {
                <div class="form-group">
                    <label class="form-label">Resolves to</label>
                    <div class="form-value">
                        @foreach (var address in _dnsResult.Addresses)
                        {
                            <div>@address</div>
                        }
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_dnsResult.CanonicalName))
            {
                <div class="form-group">
                    <label class="form-label">Name</label>
                    <div class="form-value">@_dnsResult.CanonicalName</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_dnsResult.ErrorMessage))
            {
                <div class="alert alert-warning">@_dnsResult.ErrorMessage</div>
            }
        </div>
    </div>
}

@if (_traceResult != null)
{
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
            <h2 class="card-title">Traceroute Result</h2>
            <span class="status-badge @(_traceResult.Reached ? "status-connected" : "status-error")">
                @(_traceResult.Reached ? "Target reached" : "Did not reach target")
                · @_traceResult.ModeUsed.ToString().ToUpperInvariant()
            </span>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label class="form-label">From</label>
                <div class="form-value">@VantageLabel(_traceResult.Vantage.Id)</div>
            </div>
            <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Hop</th>
                        <th>Address</th>
                        <th>RTT avg (ms)</th>
                        <th>Responses</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hop in _traceResult.Hops)
                    {
                        <tr>
                            <td>@hop.HopNumber</td>
                            <td>
                                @if (hop.Responded)
                                {
                                    @if (!string.IsNullOrEmpty(hop.Hostname))
                                    { <span>@hop.Hostname (@hop.Address)</span> }
                                    else
                                    { <span>@hop.Address</span> }
                                }
                                else
                                {
                                    <span class="text-muted">* * *</span>
                                }
                            </td>
                            <td>@(hop.RttAvgMs.HasValue ? $"{hop.RttAvgMs:0.0}" : "-")</td>
                            <td>@hop.Responses / @hop.Probes</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            @if (!string.IsNullOrEmpty(_traceResult.ErrorMessage))
            {
                <div class="alert alert-warning">@_traceResult.ErrorMessage</div>
            }
        </div>
    </div>
}

@if (_hasGateway)
{
    <div class="card" style="margin-top: 1.5rem;" data-tour="gateway-interface">
        <div class="card-header">
            <h2 class="card-title">Inspect a Gateway Interface</h2>
        </div>
        <div class="card-body">
            <p class="page-description" style="margin-bottom: 0.75rem;">
                Read-only detail straight off the gateway: the interface's addresses and, on a
                DHCP WAN, how long the ISP lease has left; the SFP module's transceiver and
                diagnostic readings; and the neighbors it has resolved on the link. Nothing here
                changes gateway state or disturbs the connection.
            </p>

            @if (!_gatewaySshConfigured)
            {
                <div class="alert alert-warning">
                    Gateway SSH isn't configured, so Network Optimizer can't read these.
                    @if (_canConfigure)
                    {
                        <text>Set it up in <a href="/settings#gateway-ssh">Settings &gt; Gateway SSH</a>.</text>
                    }
                    else
                    {
                        <text>A site administrator sets that up.</text>
                    }
                </div>
            }

            <div class="form-group">
                <label class="form-label">Interface</label>
                <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                    <select class="form-control" style="max-width: 320px;" @onchange="OnDiagInterfacePresetChange">
                        <option value="">Custom interface</option>
                        @if (_wanInterfaces.Any())
                        {
                            <optgroup label="WAN">
                                @foreach (var wan in _wanInterfaces)
                                {
                                    var wanLabel = !string.IsNullOrEmpty(wan.NetworkGroup)
                                        ? $"{wan.Name} ({wan.NetworkGroup}) - {wan.Interface}"
                                        : $"{wan.Name} - {wan.Interface}";
                                    <option value="@wan.Interface" selected="@(wan.Interface == _diagInterface)">@wanLabel</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <input type="text" class="form-control" @bind="_diagInterface"
                           placeholder="eth4" style="flex: 1; min-width: 180px;" />
                </div>
                <p class="form-help">
                    Pick a WAN to see its ISP lease, or type any interface on the gateway
                    (an SFP port, a LAN bridge) to inspect it.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(_diagError))
            {
                <div class="alert alert-danger">@_diagError</div>
            }

            <div class="action-buttons" style="margin-top: 1rem;">
                <button class="btn btn-primary" @onclick="RunGatewayDiagnostics"
                        disabled="@(_diagRunning || !CanRunDiagnostics)">
                    @if (_diagRunning) { <span class="spinner-sm"></span> <span>Reading...</span> }
                    else { <span>Read interface</span> }
                </button>
            </div>
        </div>
    </div>
}

@if (_diagResult?.InterfaceInfo != null)
{
    var iface = _diagResult.InterfaceInfo;
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
            <h2 class="card-title">Addresses and DHCP Lease</h2>
            <span class="status-badge @(string.Equals(iface.State, "UP", StringComparison.OrdinalIgnoreCase) ? "status-connected" : "status-error")">
                @iface.Name · @(iface.State ?? "unknown")
            </span>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label class="form-label">Link</label>
                <div class="form-value">
                    @(iface.MacAddress ?? "-")
                    @if (iface.Mtu.HasValue) { <span> · MTU @iface.Mtu</span> }
                    @if (!string.IsNullOrEmpty(iface.DefaultGateway)) { <span> · default via @iface.DefaultGateway</span> }
                </div>
            </div>
            @if (iface.Addresses.Count == 0)
            {
                <p class="page-description">No addresses configured on this interface.</p>
            }
            else
            {
                <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Address</th>
                            <th>Subnet</th>
                            <th>Assignment</th>
                            <th>Lease remaining</th>
                            <th>Expires</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var addr in iface.Addresses)
                        {
                            <tr>
                                <td>@addr.Cidr</td>
                                <td>@(addr.SubnetMask ?? (addr.PrefixLength.HasValue ? $"/{addr.PrefixLength}" : "-"))</td>
                                <td>@AssignmentLabel(addr)</td>
                                <td>@LeaseRemainingLabel(addr)</td>
                                <td>@LeaseExpiryLabel(addr, _diagResult.CollectedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <p class="form-help">
                    A dynamic address is a DHCP lease; the gateway renews it around halfway
                    through. The remaining time is how long the address stays valid if no renewal
                    succeeds.
                </p>
            }
        </div>
    </div>
}
else if (_diagResult != null && !string.IsNullOrEmpty(_diagResult.InterfaceError))
{
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header"><h2 class="card-title">Addresses and DHCP lease</h2></div>
        <div class="card-body">
            <div class="alert alert-warning">@_diagResult.InterfaceError</div>
        </div>
    </div>
}

@if (_diagResult != null)
{
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
            <h2 class="card-title">SFP Module</h2>
            @if (!string.IsNullOrEmpty(_diagResult.SfpInterface) && _diagResult.SfpInterface != _diagResult.Interface)
            {
                <span class="status-badge status-active">read from @_diagResult.SfpInterface</span>
            }
        </div>
        <div class="card-body">
            @if (_diagResult.SfpModule != null)
            {
                <div class="table-responsive">
                <table class="data-table">
                    <tbody>
                        @foreach (var field in _diagResult.SfpModule.Highlights())
                        {
                            <tr>
                                <td class="detail-label">@field.Name</td>
                                <td class="detail-value">@field.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <details class="setup-guide" style="margin-top: 1rem;">
                    <summary>All transceiver fields</summary>
                    <div class="setup-guide-content">
                        <div class="table-responsive">
                        <table class="data-table">
                            <tbody>
                                @foreach (var field in _diagResult.SfpModule.Fields)
                                {
                                    <tr>
                                        <td class="detail-label">@field.Name</td>
                                        <td class="detail-value">@field.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    </div>
                </details>
            }
            else
            {
                <p class="page-description">@(_diagResult.SfpError ?? "No transceiver data for this interface.")</p>
            }
        </div>
    </div>

    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header"><h2 class="card-title">Neighbors</h2></div>
        <div class="card-body">
            @if (_diagResult.Neighbors.Count > 0)
            {
                <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Address</th>
                            <th>MAC</th>
                            <th class="hide-mobile">Vendor</th>
                            <th>State</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var neighbor in _diagResult.Neighbors)
                        {
                            <tr>
                                <td>@neighbor.IpAddress</td>
                                <td>@(neighbor.MacAddress ?? "-")</td>
                                <td class="hide-mobile">@(neighbor.Vendor ?? "-")</td>
                                <td>
                                    @(neighbor.State ?? "-")
                                    @if (neighbor.IsRouter)
                                    {
                                        <span class="status-badge status-active" style="margin-left: 0.4rem;">router</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
            else
            {
                <p class="page-description">@(_diagResult.NeighborError ?? "No neighbors in the table for this interface.")</p>
            }

            @if (_diagResult.RawOutput.Count > 0)
            {
                <details class="setup-guide" style="margin-top: 1.25rem;">
                    <summary>Raw command output</summary>
                    <div class="setup-guide-content">
                        @foreach (var entry in _diagResult.RawOutput)
                        {
                            <p><strong>@entry.Key</strong></p>
                            <pre class="gateway-diag-raw">@(string.IsNullOrWhiteSpace(entry.Value) ? "(no output)" : entry.Value.Trim())</pre>
                        }
                    </div>
                </details>
            }
        </div>
    </div>
}

@if (_hasGateway)
{
    <div class="card dmesg-card" data-tour="gateway-diagnostics">
        <div class="card-header dmesg-card-header">
            <h2 class="card-title">Gateway Diagnostics</h2>
            <button class="btn btn-primary btn-sm"
                    disabled="@(!_gatewaySshConfigured || _siteAgentOffline || _dmesgRunning)"
                    @onclick="RunDmesgAsync">
                @if (_dmesgRunning)
                {
                    <span class="spinner spinner-sm"></span>
                    <span>Running...</span>
                }
                else
                {
                    <span>Run dmesg</span>
                }
            </button>
        </div>
        <div class="card-body">
            <p class="page-description dmesg-description">
                Kernel message log from the gateway, parsed into categories. On a long-running
                multi-WAN gateway the ring buffer fills with connection tracking noise,
                pushing boot events out; the report counts those and highlights what matters.
            </p>

            @if (!_gatewaySshConfigured && !_siteAgentOffline)
            {
                <p class="text-muted">
                    Gateway SSH credentials haven't been configured.
                    @if (_canConfigure)
                    {
                        <a href="/settings/monitoring">Set them up in Settings - Monitoring.</a>
                    }
                </p>
            }

            @if (_dmesgError != null)
            {
                <div class="alert alert-danger">@_dmesgError</div>
            }

            @if (_dmesgReport != null)
            {
                @if (_dmesgReport.RunError != null)
                {
                    <div class="alert alert-danger">@_dmesgReport.RunError</div>
                }
                else
                {
                    <div class="dmesg-stats">
                        @_dmesgReport.TotalLines.ToString("N0") lines
                        @if (_dmesgReport.ApproximateUptime.HasValue)
                        {
                            var up = _dmesgReport.ApproximateUptime.Value;
                            <span> · uptime ~@(up.Days > 0 ? $"{up.Days}d {up.Hours}h" : $"{up.Hours}h {up.Minutes}m")</span>
                        }
                        @if (_dmesgReport.RingBufferDominatedByNoise)
                        {
                            <span> · ring buffer dominated by noise (boot events may be missing)</span>
                        }
                    </div>

                    @if (_dmesgReport.Categories.Count == 0)
                    {
                        <p class="text-muted">No notable events found.</p>
                    }
                    else
                    {
                        @foreach (var cat in _dmesgReport.Categories)
                        {
                            <details class="dmesg-category">
                                <summary class="dmesg-category-header">
                                    <span class="status-dot @SeverityDotClass(cat.Severity)"></span>
                                    <strong class="dmesg-category-title">@cat.Title</strong>
                                    <span class="dmesg-category-summary">@cat.Summary</span>
                                </summary>
                                @if (cat.Lines.Count > 0)
                                {
                                    <pre class="dmesg-category-output">@string.Join("\n", cat.Lines)</pre>
                                }
                            </details>
                        }
                    }

                    <details class="dmesg-raw">
                        <summary class="dmesg-raw-toggle">
                            Show raw dmesg output
                        </summary>
                        <pre class="dmesg-raw-output">@_dmesgReport.RawOutput.Trim()</pre>
                    </details>
                }
            }
        </div>
    </div>
}

<SiteAdminOnly>
    <div class="card dmesg-card" data-tour="console-support-file">
        <div class="card-header dmesg-card-header">
            <h2 class="card-title">Console Support File</h2>
            @if (ConnectionService.IsConnected && !ConnectionService.IsApiKeyAuth)
            {
                <button class="btn btn-primary btn-sm"
                        disabled="@_supportFileRunning"
                        @onclick="GenerateSupportFileAsync">
                    @if (_supportFileRunning)
                    {
                        <span class="spinner spinner-sm"></span>
                        <span>Generating...</span>
                    }
                    else
                    {
                        <span>Generate &amp; Download</span>
                    }
                </button>
            }
        </div>
        <div class="card-body">
            @if (ConnectionService.IsApiKeyAuth)
            {
                <p class="text-muted dmesg-stats">
                    Support file generation requires a username and password connection to the
                    UniFi Console. API key connections don't have the UniFi OS session this needs.
                    @if (_canConfigure)
                    {
                        <a href="/settings/connection">Switch to username/password in Settings - Connection.</a>
                    }
                </p>
            }
            else if (!ConnectionService.IsConnected)
            {
                <p class="text-muted dmesg-stats">Not connected to a UniFi Console.</p>
            }
            else
            {
                <p class="page-description dmesg-description">
                    Generate a full UniFi OS support file from the console and download it.
                    This is the same bundle the UniFi Console UI produces under Support -
                    the format Ubiquiti Support expects when filing a ticket.
                </p>
            }

            @if (_supportFileError != null)
            {
                <div class="alert alert-danger">@_supportFileError</div>
            }

            @if (_supportFileRunning)
            {
                <p class="dmesg-stats">
                    The console is bundling diagnostics from all installed applications.
                    This can take a few minutes on consoles running Protect or other apps.
                </p>
            }
        </div>
    </div>
</SiteAdminOnly>

<style>
    .dmesg-card { margin-top: 1.5rem; }

