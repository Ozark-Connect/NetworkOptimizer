@page "/login"
@layout AuthLayout
@using NetworkOptimizer.Storage.Models.Identity
@using NetworkOptimizer.Web.Services
@using NetworkOptimizer.Web.Services.Identity
@inject IAdminAuthService AdminAuth
@inject IFederationProviderService Federation
@inject IAuthPolicyOptions AuthPolicy
@inject IIdentityAdminService IdentityAdmin
@inject PersistentComponentState PageState
@implements IDisposable
@* Static SSR (no interactive render mode): sign-in issues a Set-Cookie via a form POST to
   /api/auth/login, which a live Blazor circuit cannot do (design docs 02, 06). *@

<PageTitle>Login - Network Optimizer</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <img src="/images/ozark-connect-logo.png" alt="Network Optimizer" class="login-logo" />
            <h1>Network Optimizer</h1>
            <p class="login-subtitle">for UniFi</p>
        </div>

        <form method="post" action="/api/auth/login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="/" />
            @if (!string.IsNullOrEmpty(Site))
            {
                <input type="hidden" name="@SiteContextService.SiteQueryParam" value="@Site" />
            }

            <div class="form-group login-username-group">
                <label class="form-label" for="login-username">Username</label>
                <input id="login-username" name="username" type="text"
                       class="form-control" value="@(_prefillAdmin ? "admin" : "")"
                       placeholder="Username" autocomplete="username" autofocus />
            </div>

            <div class="form-group">
                <label class="form-label" for="login-password">Password</label>
                <input id="login-password" name="password" type="password"
                       class="form-control" placeholder="Enter your password" autocomplete="current-password" />
            </div>

            @* Without this the cookie is session-scoped whatever ExpireTimeSpan says, so the
               fourteen-day lifetime never applied and the browser discarded the cookie on close.
               Same treatment as Remember this device on the second-factor form. *@
            <label class="remember-device">
                <input type="checkbox" name="rememberMe" value="true" checked /> Keep me signed in
            </label>

            <button type="submit" class="btn btn-primary login-btn">
                <span>Sign In</span>
            </button>

            @if (!string.IsNullOrEmpty(ErrorText))
            {
                <div class="alert alert-danger">@ErrorText</div>

                @* The message lives in the query string, so without this it outlives the attempt that
                   caused it: refresh or navigate back and a stale "invalid credentials" renders over a
                   session that is perfectly fine. Strip it once shown - the banner above is already
                   rendered, so this only affects what a later load would say. *@
                <script suppress-error="BL9992">
                    (function () {
                        var u = new URL(window.location.href);
                        if (!u.searchParams.has('error')) return;
                        u.searchParams.delete('error');
                        window.history.replaceState({}, '', u.toString());
                    })();
                </script>
            }
            @if (!string.IsNullOrEmpty(PromptText))
            {
                <div class="alert alert-info">@PromptText</div>
            }
        </form>

        @* Revealed by the passkey helper when the browser has no secure context. Rendered here rather
           than redirected to, because the browser knows before it asks the server - a round trip just
           to say this costs a page load and races the error-stripping script. *@
        <div class="alert alert-danger" id="passkey-insecure-alert" hidden>
            Passkeys need a secure (HTTPS) connection. Sign in with your password instead.
        </div>

        @if (_providers.Count > 0 || _showPasskey)
        {
            <div class="login-footer">
                @if (_showPasskey)
                {
                    <button type="button" class="btn @(_needsPasskey ? "btn-primary" : "btn-secondary") login-btn"
                            onclick="netoptPasskey.login()">
                        Sign in with a passkey
                    </button>
                }
                @foreach (var p in _providers)
                {
                    var href = p.Type == FederationProviderType.Saml
                        ? $"/login/saml/{p.Scheme}"
                        : $"/login/external/{p.Scheme}";
                    <a class="btn btn-secondary login-btn" href="@href">@p.ButtonLabel</a>
                }
            </div>
        }

        @if (_isAutoGenerated)
        {
            <div class="login-footer">
                <small class="text-muted">
                    Using the auto-generated password from the startup logs.<br />
                    Set a permanent password in Settings after login.
                </small>
            </div>
        }

        @if (BreakGlass.IsRecoveryMode)
        {
            <div class="login-footer">
                <small class="text-muted">
                    Recovery mode is active (NETOPT_RECOVERY). Local Admin login is enabled for this boot.
                </small>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = SiteContextService.SiteQueryParam)]
    private string? Site { get; set; }

    private bool _isAutoGenerated;
    private bool _showPasskey;
    private bool _prefillAdmin;
    private IReadOnlyList<FederationProvider> _providers = new List<FederationProvider>();

    private const string ErrorStateKey = "login.error";
    private PersistingComponentStateSubscription _persisting;

    /// <summary>
    /// What the banner reads, carried across the prerender to interactive handoff rather than read
    /// from the query string twice. The script beside the banner strips the query as soon as the
    /// message has been shown, so a second read finds a clean URL and the message disappears a beat
    /// after it appears - which is what a signed-out user was seeing instead of "Invalid username or
    /// password".
    /// </summary>
    private string? _error;

    // Uniform, non-enumerating messages (never reveal whether a username exists).
    private bool _needsPasskey => _error == "use_passkey";

    /// <summary>
    /// Not a failure: the password was right, but this account's role requires a second factor and its
    /// passkey is the one it holds, so the passkey is what has to be used to get in.
    /// </summary>
    private string? PromptText => _needsPasskey
        ? "Your role requires a second factor. Sign in with your passkey below - a password on its own "
          + "is not enough. You can add an authenticator app from Security once you are in."
        : null;

    private string? ErrorText => _error switch
    {
        "invalid" or "missing" => "Invalid username or password.",
        "lockout" => "Too many attempts. Try again in a few minutes.",
        "sso_only" => "Local login is disabled. Sign in with your identity provider.",
        // Passkey outcomes name the credential, never the account, so they carry no enumeration risk.
        "passkey_rejected" => "That passkey wasn't accepted. It may have been removed from the account - "
            + "sign in another way, then register a new one.",
        "passkey_failed" => "Passkey sign-in couldn't be completed. Try again, or sign in with your password.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        _persisting = PageState.RegisterOnPersisting(() =>
        {
            PageState.PersistAsJson(ErrorStateKey, Error);
            return Task.CompletedTask;
        });
        _error = PageState.TryTakeFromJson<string?>(ErrorStateKey, out var carried) ? carried : Error;

        var source = await AdminAuth.GetPasswordSourceAsync();
        _isAutoGenerated = source == AdminPasswordSource.AutoGenerated;
        // Pre-fill "admin" only on a single-account install (the migration/first-run state), so the
        // seamless single-admin login keeps its muscle memory. Once a second user exists, leave it
        // empty (a Viewer/Operator shouldn't have to clear it, and it stops advertising "admin").
        _prefillAdmin = await IdentityAdmin.CountUsersAsync() <= 1;
        _providers = await Federation.GetEnabledAsync();
        // Passkey login is offered whenever any passkey could exist; the button no-ops in an
        // insecure context (the browser helper guards on window.isSecureContext).
        _showPasskey = true;
    }

    public void Dispose() => _persisting.Dispose();
}
