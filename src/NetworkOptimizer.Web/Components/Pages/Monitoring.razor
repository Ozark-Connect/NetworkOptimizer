    /// <summary>
    /// From a WAN globe on the map, which knows which WAN it is. A globe with no context yet is
    /// sent to make one instead - discovery traces a secondary WAN through its context and cannot
    /// run without it, the same rule the ISP Health tile follows.
    /// </summary>
    [JSInvokable]
    public void NavigateToUpstreamDiscoveryForWan(string? wanInterface)
    {
        InvokeAsync(() =>
        {
            var key = string.IsNullOrWhiteSpace(wanInterface) ? null : wanInterface.Trim().ToLowerInvariant();
            var wan = _wanContexts.FirstOrDefault(c => !string.IsNullOrEmpty(c.WanInterface)
                && string.Equals(c.WanInterface, key, StringComparison.OrdinalIgnoreCase));
            var isPrimary = key == null
                || string.Equals(key, _primaryWanKey, StringComparison.OrdinalIgnoreCase);
            if (!isPrimary && wan == null)
            {
                _activeTab = "performance";
                _forceExpandWanContexts = true;
                _scrollToWanContextsPending = true;
                StateHasChanged();
                return;
            }
            _activeTab = "performance";
            _discoveryWanKey = isPrimary ? null : key;
            _forceExpandUpstream = true;
            _scrollToDiscoveryPending = true;
            StateHasChanged();
        });
    }

