                                        <label>From</label>
                                        <input type="datetime-local" data-input="from" class="custom-range-input" />
                                    </div>
                                    <div class="custom-range-field">
                                        <label>To</label>
                                        <input type="datetime-local" data-input="to" class="custom-range-input" />
                                    </div>
                                    <div class="custom-range-actions">
                                        <button class="btn btn-sm btn-secondary" data-action="cancel-custom">Cancel</button>
                                        <button class="btn btn-sm btn-primary" data-action="apply-custom">Apply</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button class="time-btn" data-shift="forward" data-tooltip="Shift window forward">&#x25B6;</button>
                    </div>
                    <SiteAdminOnly>
                        <a href="/settings#starlink" class="tooltip-icon settings-link" data-tooltip="Starlink settings">
                        <img src="/images/gear.svg" alt="" style="width:16px;height:16px;" />
                    </a>
                    </SiteAdminOnly>
                </div>
            </div>
            <div class="card-body">
                <div class="starlink-filter-badges wan-filter-badges"></div>
                <div class="chart-card">
                    <div class="chart-header"><h3 class="chart-title">Power Draw (W)</h3></div>
                    <div class="starlink-power-chart"></div>
                </div>
                <div class="chart-card">
                    <div class="chart-header"><h3 class="chart-title">Terminal Ping Drop Rate (%)</h3></div>
                    <div class="starlink-drop-chart"></div>
                </div>
                <div class="chart-card">
                    <div class="chart-header"><h3 class="chart-title">Sky Obstruction (%)</h3></div>
                    <div class="starlink-obstruction-chart"></div>
                </div>
                <div class="chart-card">
                    <div class="chart-header"><h3 class="chart-title">Outage Seconds</h3></div>
                    <div class="starlink-outage-chart"></div>
                </div>
                <div class="chart-card">
                    <div class="chart-header"><h3 class="chart-title">GPS Satellites</h3></div>
                    <div class="starlink-gps-chart"></div>
                </div>
                <div class="chart-card">
                    <div class="chart-header"><h3 class="chart-title">Alignment Offset (deg)</h3></div>
                    <div class="starlink-alignment-chart"></div>
                </div>
                <div class="starlink-details"></div>
                <div class="starlink-stats-table"></div>
            </div>
        </div>
        }
        }
    }

    @* ──────────────── Tab: Setup ──────────────── *@
    @if (_activeTab == "setup" && _tabResolved)
    {
        @if (_snmpState == SnmpDetectionState.NotChecked)
        {
            <div class="card">
                <div class="card-header monitoring-chart-header">
                    <h2 class="card-title">SNMP Configuration</h2>
                </div>
                <div class="card-body">
                    <div class="empty-state">
                        <span class="spinner"></span>
                        <p>Detecting SNMP configuration from UniFi Console...</p>
                    </div>
                </div>
            </div>
        }
        else if (_snmpState == SnmpDetectionState.Disabled)
        {
            <div class="card">
                <div class="card-header monitoring-chart-header">
                    <h2 class="card-title">SNMP Setup Required</h2>
                    <span class="status-badge status-disconnected">Disabled</span>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>SNMP is not enabled on your UniFi Console.</strong>
                        Network Optimizer needs SNMP to collect port-level traffic statistics, device health metrics, and interface data from your switches and gateway.
                    </div>

                    <details class="setup-guide" open>
                        <summary>How to Enable SNMP</summary>
                        <div class="setup-guide-content">
                            <ol>
                                <li>Open UniFi Network</li>
                                <li>Search Settings for <strong>"SNMP Monitoring"</strong></li>
                                <li>Enable <strong>SNMP v1/v2c</strong> and set a unique Community String (20 characters max)</li>
                            </ol>
                            <p>Currently at: Settings → CyberSecure → Traffic Logging → SNMP Monitoring. This menu has moved between UniFi versions - the search term is the reliable way to find it.</p>

                            <h4>Per-device SNMP</h4>
                            <p>After enabling SNMP globally, you also need to enable it on each device you want to monitor:</p>
                            <ol>
                                <li>In UniFi Network, go to <strong>UniFi Devices</strong></li>
                                <li>Select a device</li>
                                <li>Open <strong>Settings</strong>, tick <strong>SNMP</strong> on</li>
                                <li>Set a <strong>Location</strong> or <strong>Contact</strong> value, then <strong>Save</strong></li>
                            </ol>
                            <p>Devices without SNMP enabled will not report port-level traffic or health metrics.</p>

                            <h4>Recommended configuration</h4>
                            <p><strong>SNMP v1/v2c</strong> with a unique Community String is recommended over v3. SNMPv3's per-packet authentication and encryption adds measurable CPU load to your gateway and fabric devices. The recommended security posture is a <strong>management VLAN</strong> isolating your network devices, not per-packet crypto.</p>
                        </div>
                    </details>

                    <div class="action-buttons" style="margin-top: 1rem;">
                        <SiteAdminOnly>
                            <button class="btn btn-primary" @onclick="RunDetection" disabled="@_detecting">
                            @if (_detecting) { <span class="spinner-sm"></span> <span>Checking...</span> }
                            else { <span>Re-check</span> }
                        </button>
                        </SiteAdminOnly>
                    </div>
                </div>
            </div>
        }
        else if (_snmpState == SnmpDetectionState.PollFailing)
        {
            <div class="card">
                <div class="card-header monitoring-chart-header">
                    <h2 class="card-title">Monitoring Status</h2>
                    <span class="status-badge status-error">SNMP Error</span>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <strong>SNMP polling is failing.</strong>
                        @(_detectionError ?? "Check that SNMP is still enabled on your UniFi Console and that firewall rules permit UDP/161 from this server to your network devices.")
                    </div>
                    <div class="action-buttons" style="margin-top: 1rem;">
                        <SiteAdminOnly>
                            <button class="btn btn-primary" @onclick="RunDetection" disabled="@_detecting">
                            @if (_detecting) { <span class="spinner-sm"></span> <span>Re-checking...</span> }
                            else { <span>Re-check SNMP</span> }
                        </button>
                        </SiteAdminOnly>
                    </div>
                </div>
            </div>
        }
        else
        {
            @if (CommunityTooLong)
            {
                <div class="alert alert-warning" style="margin-bottom: 1.5rem;">
                    <strong>SNMP Community String is too long.</strong>
                    @* Show the count only when THIS page's detection measured it - the server
                       flag can flip the banner on while the locally cached length is stale. *@
                    @(_snmpCommunityTooLong && _snmpCommunityLength > 0
                        ? $"Yours is {_snmpCommunityLength} characters; UniFi devices only reliably support 20."
                        : "UniFi devices only reliably support 20 characters.")
                    Shorten it and re-check.
                    <div style="margin-top: 0.75rem;">
                        <SiteAdminOnly>
                            <button class="btn btn-sm btn-secondary" @onclick="RunDetection" disabled="@_detecting">
                            @if (_detecting) { <span class="spinner-sm"></span> <span>Re-checking...</span> }
                            else { <span>Re-check</span> }
                        </button>
                        </SiteAdminOnly>
                    </div>
                </div>
            }

            @if (_showV3Recommendation && _snmpState == SnmpDetectionState.EnabledV3Only)
            {
                <div class="alert alert-info" style="margin-bottom: 1.5rem;">
                    <strong>SNMPv3 detected.</strong>
                    Consider switching to v1/v2c - the per-packet crypto adds CPU load to your network devices. The recommended security posture is a management VLAN, not v3 encryption.
                    <button class="btn btn-sm btn-secondary" style="margin-left: 0.5rem;" @onclick="() => _showV3Recommendation = false">Dismiss</button>
                </div>
            }

            @if (!_influxConfigured || _showInfluxWizard)
            {
                @* Provisioning reaches the whole instance - it can create org, buckets and token for
                   this site and, on the silent path, for every site. Not a viewer's to run. *@
                <SiteAdminOnly>
                    <InfluxSetupWizard TitlePrefix="Set up " OnProvisioned="OnInfluxProvisioned" OnDismissed="() => { _showInfluxWizard = false; StateHasChanged(); }" />
                </SiteAdminOnly>
            }

            <div class="card" style="@(!_influxConfigured ? "margin-top: 1.5rem;" : "")">
                <div class="card-header monitoring-chart-header">
                    <h2 class="card-title">Monitoring Status</h2>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span class="status-badge status-connected">@OverallStateBadge()</span>
                        <SiteAdminOnly>
                            <a href="/settings#monitoring" class="tooltip-icon settings-link" data-tooltip="Monitoring settings">
                            <img src="/images/gear.svg" alt="" style="width:16px;height:16px;" />
                        </a>
                        </SiteAdminOnly>
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label class="form-label">SNMP</label>
                        <div class="form-value">
                            <span class="status-indicator status-active"></span>
                            @(_snmpState == SnmpDetectionState.EnabledV2c ? "v2c" : _snmpState == SnmpDetectionState.EnabledV3Only ? "v3" : "Active")
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">InfluxDB</label>
                        <div class="form-value">
                            @if (_influxReachable == true)
                            {
                                <span class="status-indicator status-active"></span>
                                <span>Connected</span>
                            }
                            else if (_influxReachable == false)
                            {
                                <span class="status-indicator status-danger"></span>
                                <span>@ShortInfluxStatus()</span>
                            }
                            else if (!_influxConfigured)
                            {
                                <span class="status-indicator status-inactive"></span>
                                <span>Not configured - follow the setup card above.</span>
                            }
                            else
                            {
                                <span class="status-indicator status-inactive"></span>
                                <span>Not checked</span>
                            }
                            @if (_influxConfigured)
                            {
                                <button class="btn btn-sm btn-secondary" style="margin-left: 0.75rem;" @onclick="CheckInfluxHealth" disabled="@_checkingInflux">
                                    @if (_checkingInflux)
                                    {
                                        <span class="spinner-sm"></span>
                                        <span>Checking...</span>
                                    }
                                    else
                                    {
                                        <span>Test</span>
                                    }
                                </button>
                                @if (_influxReachable == false)
                                {
                                    <a href="/settings#monitoring" class="btn btn-sm btn-secondary" style="margin-left: 0.5rem;">
                                        Update Token
                                    </a>
                                    <SiteAdminOnly>
                                        <button class="btn btn-sm btn-primary" style="margin-left: 0.25rem;" @onclick="ResetInfluxSetup">
                                        Re-run Setup
                                    </button>
                                    </SiteAdminOnly>
                                }
                                @if (_lastInfluxTestAt.HasValue && !_checkingInflux)
                                {
                                    <span class="page-description" style="margin-left: 0.5rem;">
                                        @if (_influxReachable == true)
                                        {
                                            <span style="color: var(--success-color);">&#x2713; Connected</span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--danger-color);">&#x2717; @(_influxError ?? "Unreachable")</span>
                                        }
                                    </span>
                                }
                            }
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Collection</label>
                        <div class="form-value">
                            @if (!_monitoringEnabled)
                            {
                                <span class="status-indicator status-inactive"></span>
                                <span>Disabled</span>
                            }
                            else
                            {
                                <div class="form-value-line">
                                    <span class="status-indicator @(ServerCollecting ? "status-active" : "status-danger")"></span>
                                    <span>Server: @ServerCollectionState</span>
                                </div>
                                @* Rendered when there is NO agent too: a site that cannot probe without one is
                                   exactly where the row has something to say. *@
                                @if (_siteAgent is not null || !CollectionAgent.SiteCanProbe)
                                {
                                    <div class="form-value-line">
                                        <span class="status-indicator @(_siteAgent is not null && TunnelRegistry.IsAgentLive(_siteAgent) ? "status-active" : "status-danger")"></span>
                                        <span>On-Site Agent: @AgentCollectionState</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="action-buttons" style="margin-top: 1rem;">
                        @if (_monitoringEnabled)
                        {
                            <SiteAdminOnly>
                                <button class="btn btn-secondary" @onclick="() => SetMonitoringEnabled(false)" disabled="@_togglingEnable">
                                @if (_togglingEnable) { <span class="spinner-sm"></span> <span>Stopping...</span> }
                                else { <span>Disable Monitoring</span> }
                            </button>
                            </SiteAdminOnly>
                        }
                        else
                        {
                            <SiteAdminOnly>
                                <button class="btn btn-primary" @onclick="() => SetMonitoringEnabled(true)" disabled="@(_togglingEnable || _influxReachable != true)">
                                @if (_togglingEnable) { <span class="spinner-sm"></span> <span>Starting...</span> }
                                else { <span>Enable Monitoring</span> }
                            </button>
                            </SiteAdminOnly>
                            @if (_influxReachable != true)
                            {
                                <span class="page-description" style="margin-left: 0.75rem;">
                                    Complete InfluxDB setup above to enable.
                                </span>
                            }
                        }
                    </div>

                    <div id="snmp-devices" style="margin-top: 1.25rem;">
                        <SnmpDeviceStatusCard @ref="_snmpDeviceCard" Devices="_snmpDeviceStatuses" />
                    </div>

                    <details class="setup-guide" style="margin-top: 1.25rem;">
                        <summary>Not seeing data for some devices?</summary>
                        <div class="setup-guide-content">
                            <p>SNMP must be enabled on each device individually in addition to the global Console setting:</p>
                            <ol>
                                <li>In UniFi Network, go to <strong>UniFi Devices</strong></li>
                                <li>Select a device</li>
                                <li>Open <strong>Settings</strong>, tick <strong>SNMP</strong> on</li>
                                <li>Set a <strong>Location</strong> or <strong>Contact</strong> value, then <strong>Save</strong></li>
                            </ol>
                            <p>Devices without per-device SNMP enabled will not report port-level traffic or health metrics.</p>
                        </div>
                    </details>

                    <div style="margin-top: 1.25rem;">
                        <MonitoringInterfacesCard @ref="_miCard" PrefillTargetIp="@MiTargetParam" PrefillSourceType="@MiTypeParam" />
                    </div>
                </div>
            </div>
        }
    }
}

<style>
    .stat-hint-icon {
        width: 22px;
        height: 22px;
        font-size: 13px;
        cursor: pointer;
    }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Site Operator on this site: what the threshold forms are gated on.</summary>
    private bool _canOperate;

    /// <summary>
    /// Whether this caller can reach the Settings pages these empty states point at. Used for copy
    /// only - the controls themselves are wrapped in SiteAdminOnly / SiteOperatorOnly.
    /// </summary>
    private bool _canConfigure;

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabParam { get; set; }

    // Deep link from a speed-test result: absolute epoch-ms instant to open Live View
    // at, in historic playback (paused). Consumed once when the 3D map first mounts.
    [SupplyParameterFromQuery(Name = "at")]
    public string? AtParam { get; set; }

    /// <summary>
    /// How wide a window to frame around <c>?at=</c>, in milliseconds. An OVERRIDE only: a link
    /// that omits it frames what the destination always framed - 15 minutes on Latency and Packet
    /// Loss, an hour on Device Stats. Sent by a jump from a view that is itself a window, so the
    /// zoom the reader was looking at survives the trip.
    /// </summary>
    [SupplyParameterFromQuery(Name = "span")]
    public string? SpanParam { get; set; }

    [SupplyParameterFromQuery(Name = "discover")]
    public string? DiscoverParam { get; set; }

    /// <summary>Opens and highlights the Multi-WAN contexts card - what a WAN needs before it can be discovered.</summary>
    [SupplyParameterFromQuery(Name = "contexts")]
    public string? ContextsParam { get; set; }

    /// <summary>A WAN named by a link, so a WAN-scoped destination opens on the WAN the link meant.</summary>
    [SupplyParameterFromQuery(Name = "wan")]
    public string? WanParam { get; set; }

    [SupplyParameterFromQuery(Name = "investigate")]
    public string? InvestigateParam { get; set; }

    [SupplyParameterFromQuery(Name = "sfp")]
    public string? SfpParam { get; set; }

    [SupplyParameterFromQuery(Name = "device")]
    public string? DeviceParam { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryParam { get; set; }

    [SupplyParameterFromQuery(Name = "target")]
    public string? TargetParam { get; set; }

    [SupplyParameterFromQuery(Name = "modem")]
    public string? ModemParam { get; set; }

    [SupplyParameterFromQuery(Name = "cm")]
    public string? CmParam { get; set; }

    [SupplyParameterFromQuery(Name = "ont")]
    public string? OntParam { get; set; }

    [SupplyParameterFromQuery(Name = "starlink")]
    public string? StarlinkParam { get; set; }

    [SupplyParameterFromQuery(Name = "expand")]
    public string? ExpandParam { get; set; }

    [SupplyParameterFromQuery(Name = "mifip")]
    public string? MiTargetParam { get; set; }

    [SupplyParameterFromQuery(Name = "mitype")]
    public string? MiTypeParam { get; set; }

    private string? _lastTabParam;
    private string? _soloCellularModemId;
    private string? _soloCmId;
    private string? _soloOntId;
    private string? _soloStarlinkId;

    private bool _upstreamDiscoveryPendingSave =>
        UpstreamTracer.State.Step == NetworkOptimizer.Web.Services.Monitoring.TracerStep.ReviewingResults;

    private SnmpDetectionState _snmpState = SnmpDetectionState.NotChecked;
    private bool _detecting;
    private bool _showV3Recommendation = true;
    private string? _detectionError;
    private bool _snmpCommunityTooLong;
    private int _snmpCommunityLength;
    // Server-side sighting from the collection agent's self-heal re-pull, refreshed on
    // the 15s tick - catches a too-long community set while the user sits on Live View,
    // where page-load detection has already come and gone.
    private bool _serverCommunityTooLong;
    private bool CommunityTooLong => _snmpCommunityTooLong || _serverCommunityTooLong;

    private bool? _influxReachable;
    private string? _influxError;
    private bool _influxConfigured;
    private bool _checkingInflux;
    private DateTime? _lastInfluxTestAt;
    private System.Threading.Timer? _testFeedbackTimer;
    private bool _monitoringEnabled;
    private bool _togglingEnable;
    private bool _showInfluxWizard;
    private List<MonitoringTarget> _targets = new();
    private List<WanContext> _wanContexts = new();
    // Multi-WAN surfaces stay invisible until the site is actually multi-WAN: a second active WAN,
    // or contexts already configured (which can only exist on a site that had one). A single-WAN
    // install should never meet the concept at all.
    private bool _multiWanUiVisible;

    /// <summary>
    /// Whether the LAN / WAN scope bar is worth showing. One WAN is still a split - what is on this
    /// network is not reached over it - so this asks for a LAN to separate rather than for a second
    /// WAN. Comparing WANs is the thing that needs <see cref="_multiWanUiVisible"/>.
    /// </summary>
    private bool ScopeBarVisible => _wanOptions.Count > 1
        || (_wanOptions.Count == 1
            && _targets.Any(NetworkOptimizer.Web.Services.Monitoring.LocalTargetResolver.IsLocal));
    private bool _wanCountChecked;
    private List<MonitoredSfp> _monitoredSfps = new();
    private List<MonitoredSfp> _allSfps = new();
    private Dictionary<string, string> _deviceIpByMac = new();
    private string? _gatewayMac;
    private List<string> _gatewayWanIfNames = new();

    // ─── Per-WAN chart scope (Network Performance) ───
    // Options come from the live WAN enumeration plus any context-bound WANs; ground state is
    // the primary alone, so an untouched multi-WAN site reads exactly like today. The selected
    // SET persists per site (NpWanSetKey); the FOCUSED wan (solo selection, or primary while
    // comparing) is shared with the ISP Health tab via SharedWanScopeKey so investigate
    // deep-links land on the same WAN.
    private sealed record WanOption(string Key, string Label, bool IsPrimary);
    private List<WanOption> _wanOptions = new();
    private bool _wanOptionsLoaded;
    private HashSet<string> _selectedWanKeys = new(StringComparer.OrdinalIgnoreCase);
    // Seed only. WAN group names are arbitrary in UniFi Network and any of them can hold the
    // primary role, so this is a guess that stands until LoadWanOptionsAsync asks which WAN
    // actually holds it. The filter bar is hidden until those options load, so the guess is
    // never what a user acts on.
    private string _primaryWanKey = NetworkOptimizer.UniFi.GatewayWanHelper.DefaultWanKey;
    private bool _wanSelectionRestored;

    /// <summary>
    /// A link named a WAN before the WAN options had loaded, so it could not be resolved yet and
    /// is applied as soon as they arrive. Without it the link was simply lost on those loads.
    /// </summary>
    private bool _linkWanAwaitingOptions;

    // The modifier that adds a WAN to the comparison set, named the way the reader's own keyboard
    // names it - telling a Mac user to Ctrl-click is telling them to open a context menu. Ctrl
    // until the browser says otherwise, so the hint is never blank on the first paint.
    private bool _showWanCompareHint;
    private bool _wanCompareHintResolved;

    /// <summary>A WAN bar is rendered on the tab in view - either the live one or the chart filter.</summary>
    private bool WanBarOnScreen =>
        (_activeTab == "live" && LiveWan.HasChoice)
        || (_activeTab == "performance" && _multiWanUiVisible && _wanOptions.Count > 1);
    private string _wanCompareHint = "Ctrl-click to compare side by side";
    private string NpWanSetKey => SiteCtx.ScopeStorageKey("npWanSelection");
    /// <summary>
    /// Whether the analysis views are scoped to the LAN rather than to a WAN. Kept apart from the
    /// WAN selection on purpose: ISP Health reads that one and LAN means nothing to it, and the
    /// separation is also what lets picking LAN clear the WAN pills on screen without losing which
    /// WAN the user was on.
    /// </summary>
    private string NpScopeKey => SiteCtx.ScopeStorageKey("npAnalysisScope");
    private const string LanScopeToken = "lan";
    private const string AllScopeToken = "all";
    private bool _lanScope;
    /// <summary>
    /// Set by the All pill and by nothing else. Selecting every WAN by hand lands on the same set
    /// of keys without being the same request: All asks for the whole site, the WANs included and
    /// the LAN with them, where picking WANs one at a time asks for exactly those.
    /// </summary>
    private bool _allScope;
    private string SharedWanScopeKey => SiteCtx.ScopeStorageKey("monitoringWanScope");

    /// <summary>Solo-selected wan key, or the primary while comparing / unscoped.</summary>
    private string FocusedWanKey => _selectedWanKeys.Count == 1 ? _selectedWanKeys.First() : _primaryWanKey;

    /// <summary>Focused wan for registry lookups: null routes to the primary instance.</summary>
    private string? FocusedWanKeyOrNull =>
        !_multiWanUiVisible || string.Equals(FocusedWanKey, _primaryWanKey, StringComparison.OrdinalIgnoreCase)
            ? null : FocusedWanKey;

    private string WanThroughputTitleSuffix
    {
        get
        {
            if (!_multiWanUiVisible || _wanOptions.Count <= 1) return string.Empty;
            // Comparing draws every selected WAN on the chart, each named in its own series, so
            // naming one of them in the title would contradict what is on screen.
            if (_selectedWanKeys.Count > 1) return string.Empty;
            var focused = _wanOptions.FirstOrDefault(w => string.Equals(w.Key, FocusedWanKey, StringComparison.OrdinalIgnoreCase));
            // Prose form, not the pill form: a title is read as a phrase, so the WAN token needs
            // parentheses to sit apart from the connection's name instead of running into it.
            return focused == null ? string.Empty
                : $" - {NetworkOptimizer.UniFi.GatewayWanHelper.FormatWanLabelInProse(focused.Label, NetworkOptimizer.UniFi.GatewayWanHelper.WanIndexFromKey(focused.Key))}";
        }
    }

    /// <summary>
    /// Scopes the analysis views to this network. The WAN selection is left exactly as it was -
    /// only its pills go unlit - so returning to a WAN puts the user back where they were.
    /// </summary>
    private async Task SelectLanScopeAsync()
    {
        if (_lanScope) return;
        _lanScope = true;
        _allScope = false;
        await ApplyWanSelectionAsync(persist: true);
    }

    private async Task OnWanPillClickAsync(string key, MouseEventArgs e)
    {
        // Picking a WAN is always a move off the LAN, whichever WAN it is - and off All, even when
        // the WANs that end up selected are all of them.
        _lanScope = false;
        _allScope = false;
        if (e.CtrlKey || e.MetaKey)
        {
            // Toggle into/out of the comparison set; never empty the set.
            if (!_selectedWanKeys.Add(key) && _selectedWanKeys.Count > 1)
                _selectedWanKeys.Remove(key);
        }
        else
        {
            // A plain click always solos, including out of a comparison - only the modifier ever
            // adds. Toggling on a plain click while comparing turned the first modifier click into
            // a mode: every click after it kept adding, so there was no way back to one WAN without
            // knowing to hold the key again. Clicking the WAN that is already solo returns to the
            // ground state, which is the primary alone - one WAN is the view you want back, and
            // "all WANs" is a comparison you asked for.
            var isOnlySelection = _selectedWanKeys.Count == 1 && _selectedWanKeys.Contains(key);
            var isGround = _selectedWanKeys.Count == 1 && _selectedWanKeys.Contains(_primaryWanKey);

            _selectedWanKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            {
                isOnlySelection && !isGround ? _primaryWanKey : key
            };
        }
        await ApplyWanSelectionAsync(persist: true);
    }

    /// <summary>Pushes the current WAN selection to the chart module and optionally persists it.</summary>
    private async Task ApplyWanSelectionAsync(bool persist)
    {
        try
        {
            if (persist)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", NpWanSetKey, string.Join(",", _selectedWanKeys));
                // Stored apart from the WAN set so the set never holds a value ISP Health cannot read.
                await JS.InvokeVoidAsync("localStorage.setItem", NpScopeKey,
                    _lanScope ? LanScopeToken : _allScope ? AllScopeToken : "wan");
                await JS.InvokeVoidAsync("localStorage.setItem", SharedWanScopeKey, FocusedWanKeyOrNull ?? "");
                // persist:true is the user's own pick - the link and the restore both pass false - so
                // this is the moment the link's WAN stops describing what is on screen.
                ClearLinkedWan();
            }
            // Held rather than dropped when the module is not there yet: window.__latencyCharts is
            // assigned inside the mount's own import, so a plain ?. swallowed every push that beat
            // it - which on a cold load is the link's WAN. The mount drains it.
            await JS.InvokeVoidAsync("eval",
                "(window.__netoptSetWanScope ||= function (s) {"
                + " if (window.__latencyCharts) window.__latencyCharts.setWanScope(s);"
                + " else window.__netoptPendingWanScope = s; })("
                + WanScopeJson() + ");");
        }
        catch { /* circuit going away, or charts not mounted yet - the mount push covers it */ }
        _discoveryWanKey = FirstSelectedWanKey();
        StateHasChanged();
        await RefreshLossInvestigationForWanAsync();
    }

    /// <summary>
    /// Runs a deep-linked investigation once everything it reads is in place: the performance tab,
    /// its mounted chart, and the WAN scope the link asked for. Called from OnAfterRenderAsync and
    /// again right after the link's WAN is applied, so it never depends on which render pass gets
    /// there first. Idempotent - the pending kind is taken before the first await.
    /// </summary>
    private async Task TryRunPendingInvestigationAsync()
    {
        if (_pendingInvestigateParam == null || _activeTab != "performance"
            || !_monitoringReady || _investigatingLoss || !LinkWanScopeSettled) return;

        var kind = _pendingInvestigateParam;
        _pendingInvestigateParam = null;
        // Open the (possibly collapsed) card so the deep-linked result and nav controls are
        // visible. Live state only - the saved preference is untouched, and leaving the tab
        // reverts to it, so a linkable investigation never counts as a user-set expand.
        _investigateCollapsed = false;
        _investigateDeepLinkOpened = true;
        await EscapeLanScopeForInvestigationAsync();
        await NavigateToLossEvent(null, null, loadedOnly: kind == "loaded-loss");
    }

    /// <summary>
    /// Moves a linked investigation off the LAN scope. It arrived from ISP Health, which is a
    /// statement about the WAN: the events are graded against a WAN's plan speeds and read off its
    /// counters, so LAN has nothing to answer with and any event found lands on a chart holding
    /// none of its targets. A link that names a WAN has already moved here by applying it - a
    /// single-WAN site names none, which is where a saved LAN scope used to swallow the jump.
    /// Never persisted: following a link is not choosing a filter.
    /// </summary>
    private async Task EscapeLanScopeForInvestigationAsync()
    {
        if (!_lanScope) return;
        var wan = _wanOptions.FirstOrDefault()?.Key;
        if (wan == null) return;

        _selectedWanKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { wan };
        _lanScope = false;
        _allScope = false;
        await ApplyWanSelectionAsync(persist: false);
    }

    /// <summary>
    /// Re-runs an active loss investigation against the WAN scope now selected. The event on screen
    /// was found on the WAN that was focused when Investigate ran - its targets, its plan speeds,
    /// its counters - so leaving it in place after the filter moves shows one WAN's loss event over
    /// another WAN's charts. Runs on every selection change, whether by pill, All, reset, or a link.
    /// </summary>
    private async Task RefreshLossInvestigationForWanAsync()
    {
        if (!_lossNavActive || _investigatingLoss || _activeTab != "performance") return;
        // Fresh search rather than a step: the event stepping is anchored to the old WAN's event
        // bounds, which say nothing about where this one's events are.
        await NavigateToLossEvent(null, null, _lossNavLoadedOnly, resetIfNotFound: true);
    }

    /// <summary>
    /// The selection as a SINGLE WAN, for the panels that only ever show one. Taken in the pill
    /// bar's own order rather than the selection set's, so comparing two WANs hands the downstream
    /// panel the leftmost one every time instead of whichever the set happens to yield first.
    /// </summary>
    /// <summary>
    /// Whether the WAN filter is holding a COMPARISON, which is the only state a clear undoes. One
    /// WAN on its own is not filtered, whichever WAN it is - it is the view the user switched to,
    /// and offering to clear it would read as offering to undo their choice of WAN.
    /// </summary>
    private bool WanFilterIsNarrowed => _multiWanUiVisible && _selectedWanKeys.Count > 1;

    /// <summary>Whether every WAN is on screen, which is what the All pill means.</summary>
    private bool AllWansSelected =>
        _wanOptions.Count > 1 && _wanOptions.All(w => _selectedWanKeys.Contains(w.Key));

    private async Task SelectAllWansAsync()
    {
        _lanScope = false;
        _allScope = true;
        _selectedWanKeys = new HashSet<string>(_wanOptions.Select(w => w.Key), StringComparer.OrdinalIgnoreCase);
        await ApplyWanSelectionAsync(persist: true);
    }

    private async Task ResetWanFilterAsync()
    {
        _lanScope = false;
        _allScope = false;
        _selectedWanKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { _primaryWanKey };
        await ApplyWanSelectionAsync(persist: true);
    }


    /// <summary>
    /// Whether the live WAN filter is holding a comparison - see the note on the Network Performance
    /// bar: one WAN alone is a choice of view, not a filter to clear.
    /// </summary>
    private bool LiveWanIsNarrowed => LiveWan.HasChoice && LiveWan.SelectedKeys.Count > 1;

    private async Task ResetLiveWanAsync()
    {
        var primary = LiveWan.Options.FirstOrDefault(o => o.IsPrimary)?.Key;
        if (primary != null) await LiveWan.SelectAsync(primary);
    }

    private string? FirstSelectedWanKey() =>
        !_multiWanUiVisible ? null
        : _wanOptions.FirstOrDefault(w => _selectedWanKeys.Contains(w.Key))?.Key;

    /// <summary>
    /// Discovery picked its own WAN. It writes back so the tab stays in lockstep, but a selection
    /// that is ALREADY on screen is left exactly as it is: collapsing a two-WAN comparison down to
    /// the one WAN the user just pointed discovery at would throw away a view they built, to tell
    /// them something they can already see.
    /// </summary>
    /// <summary>
    /// Latency Targets picked a WAN, or All. All means every WAN at once, which the pill bar already
    /// expresses as the whole set selected - so it stays one selection shared by the tab rather than
    /// a second mode only this card knows about.
    /// </summary>
    private async Task OnTargetsWanSelectedAsync(string key)
    {
        _lanScope = false;
        _allScope = key == LatencyTargetsCard.AllWansKey;
        _selectedWanKeys = key == LatencyTargetsCard.AllWansKey
            ? new HashSet<string>(_wanOptions.Select(w => w.Key), StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(StringComparer.OrdinalIgnoreCase) { key };
        await ApplyWanSelectionAsync(persist: true);
    }

    private async Task OnDiscoveryWanSelectedAsync(string key)
    {
        _discoveryWanKey = key;
        if (!_lanScope && !_allScope && _selectedWanKeys.Contains(key)) { StateHasChanged(); return; }
        _lanScope = false;
        _allScope = false;
        _selectedWanKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { key };
        await ApplyWanSelectionAsync(persist: true);
    }

    /// <summary>
    /// The current WAN scope as JSON, or "null" on a single-WAN site. Handed to the chart module
    /// at mount time as well as on every change: the module drops its scope when it unmounts, so
    /// leaving the tab and coming back has to re-state it or the chart would quietly render every
    /// WAN while the filter row still showed one selected.
    /// </summary>
    /// <summary>
    /// The category the chart opens on: ISP when the WANs on screen have no LAN targets, so a
    /// monitoring-only or secondary-WAN view opens on a populated chart rather than an empty one.
    /// Read once at mount - after that the chart owns the category, including the user's own picks.
    /// </summary>
    private string DefaultChartCategory() =>
        HasTargetsInWanScope(MonitoringTargetType.Fabric) ? "Fabric" : "AccessIsp";

    private string WanScopeJson()
    {
        var scope = !ScopeBarVisible
            ? null
            : (object)new
            {
                primaryKey = _primaryWanKey,
                selected = _selectedWanKeys.ToArray(),
                // The bare WAN token, not the connection's name: a series is already named by its
                // target, and appending the ISP's name to every one of them is length without
                // information - the token is what tells the two apart.
                tokens = _wanOptions.ToDictionary(
                    w => w.Key.ToLowerInvariant(),
                    w => NetworkOptimizer.UniFi.GatewayWanHelper.FormatWanLabel(
                        null, NetworkOptimizer.UniFi.GatewayWanHelper.WanIndexFromKey(w.Key), null, null)),
                // So the chart can leave the LAN category when the WANs now on screen have no LAN
                // targets. Only the chart knows which category it is currently showing.
                hasLan = HasTargetsInWanScope(MonitoringTargetType.Fabric),
                // LAN is a scope of its own, not a WAN: the chart shows what is on this network and
                // offers only the categories that can fill it.
                lan = _lanScope,
                all = _allScope,
            };
        return System.Text.Json.JsonSerializer.Serialize(scope);
    }

    /// <summary>
    /// Builds the WAN filter options: every live WAN, plus any WAN a context is bound to that
    /// the console currently omits (down/failed WANs still have history worth reading).
    /// </summary>
    /// <summary>
    /// The primary WAN named the way every other WAN is named, for pickers that would otherwise
    /// call it "Primary" - a word that says which ROLE it holds and not which connection it is, so
    /// it reads as a different kind of thing from the vantages beside it. Falls back to the role
    /// word only when the console has not told us the WANs, where there is nothing else to say.
    /// </summary>
    private string PrimaryWanProseLabel()
    {
        var primary = _wanOptions.FirstOrDefault(o => o.Key == _primaryWanKey);
        if (primary == null) return "Primary";
        return NetworkOptimizer.UniFi.GatewayWanHelper.FormatWanLabelInProse(
            primary.Label, NetworkOptimizer.UniFi.GatewayWanHelper.WanIndexFromKey(primary.Key));
    }

    private async Task LoadWanOptionsAsync()
    {
        var options = new List<WanOption>();
        try
        {
            foreach (var wan in await PathView.GetWansAsync())
            {
                var label = NetworkOptimizer.UniFi.GatewayWanHelper.FormatWanLabel(
                    wan.FriendlyName, NetworkOptimizer.UniFi.GatewayWanHelper.WanIndexFromKey(wan.WanInterface), null, null);
                options.Add(new WanOption(wan.WanInterface.ToLowerInvariant(), label, wan.IsPrimary));
            }
        }
        catch { }
        foreach (var ctx in _wanContexts.Where(c => !string.IsNullOrEmpty(c.WanInterface)))
        {
            var key = ctx.WanInterface!.ToLowerInvariant();
            if (!options.Any(o => o.Key == key))
                options.Add(new WanOption(key,
                    NetworkOptimizer.UniFi.GatewayWanHelper.FormatWanLabel(
                        ctx.Name, NetworkOptimizer.UniFi.GatewayWanHelper.WanIndexFromKey(key), null, null),
                    IsPrimary: false));
        }
        // IsPrimary is the console's own answer about which WAN holds the role. The two fallbacks
        // behind it are guesses for when it cannot say: the first enumerated WAN, then the
        // conventional key. Both are wrong on a site whose primary is, say, WAN2 - they decide
        // only which pill starts lit, and the next load with a reachable console corrects it.
        _primaryWanKey = options.FirstOrDefault(o => o.IsPrimary)?.Key ?? options.FirstOrDefault()?.Key ?? NetworkOptimizer.UniFi.GatewayWanHelper.DefaultWanKey;
        _wanOptions = options;
        // Set even when the console could not be reached and the list came back empty: it records
        // that the question has been ASKED, which is what the link-scope gate waits on. Leaving it
        // false on a failure would hold a deep-linked investigation forever.
        _wanOptionsLoaded = true;
        if (_selectedWanKeys.Count == 0)
            _selectedWanKeys.Add(_primaryWanKey);
        // Drop selections whose WAN no longer exists; fall back to primary.
        _selectedWanKeys.RemoveWhere(k => !_wanOptions.Any(o => o.Key.Equals(k, StringComparison.OrdinalIgnoreCase)));
        if (_selectedWanKeys.Count == 0)
            _selectedWanKeys.Add(_primaryWanKey);
        // The stored selection, now that there are options to validate it against. Here as well as
        // at the mount because the mount runs once and can get there first: _monitoringReady does
        // not wait on this load, so the restore would find nothing to restore against, decline to
        // spend its one-shot, and never be asked again. Its own guard makes the second call free.
        await RestoreWanSelectionAsync();
        // A link that arrived before this point resolved nothing and was waiting on it. Applying
        // it here rather than leaving it to the next mount is what makes a deep link land on its
        // WAN every time instead of most of the time.
        await ApplyPendingLinkWanAsync();
    }

    /// <summary>Restores the persisted WAN selection once localStorage is reachable.</summary>
    /// <summary>
    /// Settles the compare hint the first time a WAN bar is actually on screen: whether the user
    /// is still owed it, and the platform's word for the modifier.
    /// <para>
    /// Gated on a bar being visible, not on the page loading. The allowance counts occasions the
    /// user could have read the hint, so resolving it while no bar is rendered would spend a
    /// showing on nothing - and it used to hang off the latency chart's mount, which meant it
    /// never ran at all for someone sitting on Live View.
    /// </para>
    /// </summary>
    private async Task EnsureWanCompareHintAsync()
    {
        if (_wanCompareHintResolved || !WanBarOnScreen) return;
        _wanCompareHintResolved = true;

        try
        {
            if (await JS.InvokeAsync<bool>("eval", "/Mac|iPhone|iPad|iPod/.test(navigator.userAgent)"))
                _wanCompareHint = "⌘-click to compare side by side";
        }
        catch { /* keep the default */ }

        _showWanCompareHint = await UiHints.ShouldShowAsync(UiHintKeys.WanFilterCompare);
        if (_showWanCompareHint)
            await UiHints.RecordShownAsync(UiHintKeys.WanFilterCompare);
        StateHasChanged();
    }

    /// <summary>
    /// Takes the WAN that ISP Health and these charts share as their focus. They are one
    /// investigation - that shared focus is what makes an ?investigate= jump land on the WAN you
    /// were just reading about - so arriving here from a WAN2 report must not drop you back on
    /// whatever set was last used here and quietly change the subject.
    /// <para>
    /// A comparison set that ALREADY contains the focused WAN is kept: you were comparing, and the
    /// WAN you came from is in the picture. One that does not is replaced by the focused WAN
    /// alone, because it does not show what you came to look at.
    /// </para>
    /// </summary>
    private async Task AdoptSharedWanFocusAsync(bool apply = true)
    {
        if (!_multiWanUiVisible || _wanOptions.Count <= 1) return;
        // A link's narrowing is not a selection to reason from. Entering the tab runs this with
        // apply:true, so on the way back from a jump it saw the narrowed set, found no shared
        // focus, defaulted to the primary, and - because the narrowed WAN was not the primary -
        // replaced the set with it AND WROTE THAT to storage. That is what destroyed a saved All:
        // the first round trip looked right, and every one after it read back the primary. The
        // narrowing is released and the stored set re-read when the charts remount; until then
        // there is nothing here worth adopting against.
        // Both: the flag is only set once the link has been applied, which can be after this runs.
        if (_linkNarrowedWanSelection || LinkNarrowsWanFilter) return;
        try
        {
            var shared = await JS.InvokeAsync<string?>("localStorage.getItem", SharedWanScopeKey);
            var focus = string.IsNullOrEmpty(shared) ? _primaryWanKey : shared!.Trim().ToLowerInvariant();
            // LAN and All are scope decisions, not a WAN selection to reconcile - adopting a focus
            // over either one throws away what the user picked. This ran straight after the restore
            // read a stored LAN, so LAN was restored and overwritten on the same pass, every time.
            if (_lanScope || _allScope
                || !_wanOptions.Any(o => o.Key.Equals(focus, StringComparison.OrdinalIgnoreCase))
                || _selectedWanKeys.Contains(focus))
                return;
            _lanScope = false;
            _allScope = false;
            _selectedWanKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { focus };
            if (apply) await ApplyWanSelectionAsync(persist: true);
        }
        catch { /* no interop yet - the stored set stands */ }
    }

    /// <summary>
    /// Lets go of a link's narrowing once the link is gone. The narrowing is something the link
    /// did, not a preference the user set - it is never written to storage - so arriving at the
    /// tab without one has to put the saved filter back rather than carry the narrowed set for
    /// the rest of the page's life, which is what made a saved All look permanently replaced.
    /// </summary>
    private void ReleaseLinkWanSelection()
    {
        if (!_linkNarrowedWanSelection) return;
        if (LinkNarrowsWanFilter) return;

        _linkNarrowedWanSelection = false;
        // Lets the stored selection be read again; nothing else clears this one-shot.
        _wanSelectionRestored = false;
    }

    /// <summary>
    /// Applies a WAN filter carried in from the Live tab, for this visit only. Runs BEFORE the
    /// stored selection is read and claims the restore, so the link decides what the analysis is
    /// scoped to without the saved filter being read over the top of it - or written to. Gated on
    /// a category riding along, which only the Live tab's jump sends: a discovery link carries a
    /// WAN too, and narrowing this filter is not what that one is asking for.
    /// </summary>
    private async Task ApplyLinkWanSelectionAsync()
    {
        // The options answer the question this needs answered, and the mount that calls this runs
        // once - so returning here without remembering the link dropped it for the rest of the
        // visit, and the stored filter that was read a line earlier stood instead. Whether that
        // happened came down to which finished first, so the same link kept or lost its WAN from
        // one load to the next. The flag lets the load itself finish the job.
        if (string.IsNullOrWhiteSpace(WanParam) || !LinkNarrowsWanFilter)
        {
            _linkWanAwaitingOptions = false;
            return;
        }
        if (_appliedLinkWanKey == LinkWanKey)
        {
            _linkWanAwaitingOptions = false;
            return;
        }
        // Nothing to resolve against yet. The mount that calls this runs once, so returning
        // without remembering the link dropped it for the rest of the visit and left the stored
        // filter - read a line earlier - standing in its place. Whether that happened came down
        // to which finished first, so the same link kept or lost its WAN from one load to the
        // next. The flag holds it until the answers arrive.
        if (!_wanOptionsLoaded)
        {
            _linkWanAwaitingOptions = true;
            return;
        }
        _linkWanAwaitingOptions = false;
        // One WAN still has a scope to set: the bar splits it from the LAN, so a link naming it
        // (or naming All) decides which of the two the user lands in. Gating this on multi-WAN
        // left those sites on whatever scope was saved, and the chart dropped the category the
        // link asked for whenever the two disagreed.
        if (_wanOptions.Count == 0) return;

        var keys = ResolveLinkWanKeys(WanParam);
        // Stamped before the resolve is judged: the link has been CONSIDERED either way, and the
        // options are loaded by here, so a WAN this site does not have will not resolve on a later
        // pass either. Leaving it unstamped would hold the deep-link gate open forever.
        _appliedLinkWanKey = LinkWanKey;
        Logger.LogDebug("Link WAN: resolved {Wan} to [{Keys}] against [{Options}]",
            WanParam, string.Join(",", keys), string.Join(",", _wanOptions.Select(o => o.Key)));
        if (keys.Count == 0) return;
        // Narrowing for as long as the link does. Never persisted, and released on the way back
        // in without one, so a saved All is what the tab has again next time.
        _linkNarrowedWanSelection = true;
        // Claims the restore as well, so the stored selection cannot be read over the top of the
        // link on a first load - and is never written, so the saved filter survives the visit.
        _wanSelectionRestored = true;
        // A link naming WANs lands on those WANs, not on whatever scope was left over. Covering
        // every one of them is the whole site, which is what All means.
        _lanScope = false;
        _selectedWanKeys = new HashSet<string>(keys, StringComparer.OrdinalIgnoreCase);
        // The token, not just the keys it resolved to: on a single-WAN site "all" and that one WAN
        // resolve to the same key, and only All keeps the LAN categories on the chart - which is
        // what a link from a LAN view came to see.
        _allScope = IsAllWansToken(WanParam)
            || (_wanOptions.Count > 1 && _wanOptions.All(w => _selectedWanKeys.Contains(w.Key)));
        await ApplyWanSelectionAsync(persist: false);
    }

    /// <summary>
    /// The WAN keys a link's <c>?wan=</c> names: "all" for a view that spans every WAN, otherwise
    /// a comma list. Matched on WAN index rather than string for the same reason the live scope
    /// does it - the primary answers to "wan", "wan1" and "WAN" depending on who wrote the link.
    /// </summary>
    private List<string> ResolveLinkWanKeys(string wanParam)
    {
        var trimmed = wanParam.Trim();
        if (IsAllWansToken(trimmed))
            return _wanOptions.Select(o => o.Key).ToList();
        if (string.Equals(trimmed, Services.Monitoring.LiveWanScope.PrimaryWanToken, StringComparison.OrdinalIgnoreCase))
            return _wanOptions.Where(o => o.IsPrimary).Select(o => o.Key).ToList();

        return trimmed
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(NetworkOptimizer.UniFi.GatewayWanHelper.WanIndexFromKey)
            .Where(index => index > 0)
            .Select(index => _wanOptions
                .FirstOrDefault(o => NetworkOptimizer.UniFi.GatewayWanHelper.WanIndexFromKey(o.Key) == index)?.Key)
            .OfType<string>()
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>Whether a link's <c>?wan=</c> asks for the whole site rather than named WANs.</summary>
    private static bool IsAllWansToken(string? wanParam) =>
        string.Equals(wanParam?.Trim(), Services.Monitoring.LiveWanScope.AllWansToken, StringComparison.OrdinalIgnoreCase);

    private async Task RestoreWanSelectionAsync()
    {
        if (_wanSelectionRestored || !ScopeBarVisible) return;
        _wanSelectionRestored = true;
        try
        {
            var storedScope = await JS.InvokeAsync<string?>("localStorage.getItem", NpScopeKey);
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", NpWanSetKey);
            // No scope stored is either a fresh install or one that predates the key. A WAN set
            // already stored means the second, and moving that user onto LAN would take them off a
            // choice they made; with nothing stored at all, LAN is the honest opening view.
            // Not on a single-WAN site: there LAN hides the one WAN's targets, which is most of
            // the list, so those open on everything until the user narrows it themselves.
            _lanScope = string.IsNullOrEmpty(storedScope)
                ? string.IsNullOrEmpty(stored) && _wanOptions.Count > 1
                : string.Equals(storedScope, LanScopeToken, StringComparison.OrdinalIgnoreCase);
            // And opens on All there: the option list seeds the one WAN as selected, so left alone
            // the LAN rows would be filtered out of a view nobody had narrowed.
            _allScope = string.IsNullOrEmpty(storedScope)
                ? _wanOptions.Count == 1
                : string.Equals(storedScope, AllScopeToken, StringComparison.OrdinalIgnoreCase);
            if (!string.IsNullOrEmpty(stored))
            {
                var keys = stored.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(k => _wanOptions.Any(o => o.Key.Equals(k, StringComparison.OrdinalIgnoreCase)))
                    .ToList();
                if (keys.Count > 0)
                    _selectedWanKeys = new HashSet<string>(keys, StringComparer.OrdinalIgnoreCase);
            }

            await AdoptSharedWanFocusAsync(apply: false);
        }
        catch { }
        await ApplyWanSelectionAsync(persist: false);
    }



    /// <summary>The WAN a target's data describes: its stamped key, or the primary when unstamped.</summary>
    private string TargetWanKey(MonitoringTarget t) =>
        NetworkOptimizer.Storage.Models.MonitoringTarget.IsUnpinned(t.WanInterface)
            ? _primaryWanKey : t.WanInterface!.ToLowerInvariant();
    private System.Threading.Timer? _liveRefreshTimer;
    private System.Threading.Timer? _dataRefreshTimer;
    private DotNetObjectReference<Monitoring>? _mapDotNetRef;
    private DateTime? _mapHistoricAt;
    private HistoricStatSnapshot? _historicSnapshot;

    // Setup is the default so a site that cannot finish initializing - unreachable InfluxDB,
    // failing SNMP - still lands where it can be fixed. It just must not RENDER before the
    // resolve below has had its say, or every visit flashes Setup on the way to its real tab.
    private string _activeTab = "setup";
    private bool _tabResolved;

    // The instant the last navigation named, waiting for a map to hand it to, and the URL that
    // armed it. Keyed on the URL rather than the value: the eye sends the same instant every time
    // round a loop, and each of those navigations is its own request to seek there.
    private long? _pendingAtMs;
    private string? _armedAtUri;

    /// <summary>The URL whose ?investigate= has already run, so the parameter left in the address
    /// bar cannot re-run the search on an unrelated URL change.</summary>
    private string? _armedInvestigateUri;

    /// <summary>The instant a link asked for, while the timeline is still sitting on it.</summary>
    private long? _linkedInstantMs;

    private bool _monitoringReady => _monitoringEnabled && _influxConfigured;

    /// <summary>This site's agent, when it has one. Null on a server-polled site.</summary>
    private SiteAgent? _siteAgent;

    // A tier that has not completed a pass in this long has stopped, not slowed: the slowest tier
    // runs on a 60s cadence and every tier stamps the same field.
    private static readonly TimeSpan CollectionStaleAfter = TimeSpan.FromMinutes(5);

    /// <summary>
    /// Whether collection is actually happening here. The server stands down from probing on every
    /// non-default site, so on an agent site "collecting" is the agent's answer, not the server's.
    /// </summary>
    private bool ServerCollecting =>
        _influxReachable == true
        && CollectionAgent.LastCollectionUtc is DateTime last
        && DateTime.UtcNow - last < CollectionStaleAfter;

    /// <summary>
    /// The frame call for a hardware stat tab whose link carried ?at=, or "" for a plain visit.
    /// One hour around the moment, set as a custom range, so the framing a link asked for never
    /// becomes the tab's remembered preset.
    /// </summary>
    private bool _hardwareAtFramed;
    private string? _lastHardwareAtParam;

    private string HardwareFrameJs()
    {
        // Once per link, like the Device Stats and Network Performance paths clear theirs. The
        // charts remount for reasons of their own - a console reconnect does it - and re-framing
        // then would throw away a window the reader had since chosen.
        if (_hardwareAtFramed) return "";
        if (!long.TryParse(AtParam, out var atMs) || atMs <= 0) return "";
        _hardwareAtFramed = true;
        var iso = DateTimeOffset.FromUnixTimeMilliseconds(atMs).UtcDateTime.ToString("O");
        return $"m.frameMoment('{iso}');";
    }

    private string ServerCollectionState =>
        _influxReachable != true ? "enabled, but InfluxDB unreachable"
        : !CollectionAgent.SiteCanProbe ? "SNMP only (add an agent for network performance data)"
        : !CollectionAgent.ServerProbesThisSite ? "syncing targets (this site is probed by its agent)"
        : ServerCollecting ? "collecting"
        : CollectionAgent.LastCollectionUtc is DateTime last
            ? $"last collected {TimeFormatHelper.FormatRelativeTime(last).ToLowerInvariant()}"
            : "not collecting";

    private string AgentCollectionState
    {
        get
        {
            if (_siteAgent is null) return "not set up";
            var version = _siteAgent.LastVersion is null ? ""
                : $", v{NetworkOptimizer.Core.Helpers.VersionUtilities.StripBuildMetadata(_siteAgent.LastVersion)}";
            if (TunnelRegistry.IsAgentLive(_siteAgent)) return $"connected{version}";
            if (_siteAgent.EnrolledAt is null) return "enrolled but never connected";
            return _siteAgent.LastSeenAt is DateTime seen
                ? $"last seen {TimeFormatHelper.FormatRelativeTime(seen).ToLowerInvariant()}{version}"
                : $"not connected{version}";
        }
    }

    /// <summary>
    /// Loads this site's agent so the Collection status can report it. Best-effort: a registry that
    /// will not answer leaves the agent line off rather than taking the Setup tab down with it.
    /// </summary>
    private async Task LoadSiteAgentAsync()
    {
        try
        {
            var site = (await SiteManagement.GetSitesAsync())
                .FirstOrDefault(x => string.Equals(x.Slug, SiteCtx.Slug, StringComparison.OrdinalIgnoreCase));
            if (site == null) return;
            _siteAgent = (await AgentEnrollment.GetAgentsForSiteAsync(site.Id))
                .Where(a => a.Enabled)
                .OrderByDescending(a => a.LastSeenAt)
                .FirstOrDefault();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not read the site's agent for the Collection status");
        }
    }
