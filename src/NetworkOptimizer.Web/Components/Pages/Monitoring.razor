    private async void OnConnectionChanged()
    {
        // Fires from a background thread (console reconnect); the reload is already
        // marshalled onto the dispatcher, but wrap it so this async void handler can't
        // crash the circuit if detection throws.
        try
        {
            if (ConnectionService.IsConnected)
            {
                await InvokeAsync(async () =>
                {
                    await RunDetection();
                    StateHasChanged();
                });
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* component may be disposed */ }
    }

    private async Task RunDetection()
    {
        _detecting = true;
        _detectionError = null;
        StateHasChanged();

        var result = await SnmpDetection.DetectSnmpSettingsAsync();
        if (result.Success)
        {
            await SnmpDetection.SaveDetectionResultAsync(result);
            var settings = await SnmpDetection.GetOrCreateSettingsAsync();
            _snmpState = settings.SnmpDetectionState;
            _snmpCommunityTooLong = result.CommunityTooLong;
            _snmpCommunityLength = result.Community?.Length ?? 0;
            // Fresh console read beats the agent's cached self-heal sighting - otherwise a
            // fixed community still shows the too-long banner until the agent's next re-pull.
            _serverCommunityTooLong = result.CommunityTooLong;
            CollectionAgent.NoteExternalDetection(result.CommunityTooLong);
        }
        else
        {
            _detectionError = result.ErrorMessage;
            _snmpState = SnmpDetectionState.PollFailing;
        }

        _detecting = false;
        StateHasChanged();
    }

    private string ShortInfluxStatus()
    {
        if (string.IsNullOrEmpty(_influxError)) return "Unreachable";
        if (_influxError.Contains("unauthorized", StringComparison.OrdinalIgnoreCase)) return "Auth error";
        if (_influxError.Contains("refused", StringComparison.OrdinalIgnoreCase)) return "Connection refused";
        if (_influxError.Contains("timeout", StringComparison.OrdinalIgnoreCase)) return "Timeout";
        if (_influxError.Contains("bucket", StringComparison.OrdinalIgnoreCase)
            && _influxError.Contains("not found", StringComparison.OrdinalIgnoreCase)) return "Bucket not found";
        if (_influxError.Contains("organization", StringComparison.OrdinalIgnoreCase)
            && _influxError.Contains("not found", StringComparison.OrdinalIgnoreCase)) return "Org not found";
        return "Unreachable";
    }

    private string OverallStateBadge()
    {
        if (_snmpState != SnmpDetectionState.EnabledV2c
            && _snmpState != SnmpDetectionState.EnabledV3Only
            && _snmpState != SnmpDetectionState.Working)
        {
            return _snmpState.ToString();
        }
        if (!_influxConfigured) return "InfluxDB not configured";
        if (_influxReachable == false) return "InfluxDB unreachable";
        if (!_monitoringEnabled) return "Ready (disabled)";
        return "Monitoring active";
    }

    private async Task LoadSnmpDeviceStatusesAsync()
    {
        if (!ConnectionService.IsConnected) return;
        try
        {
            _snmpDeviceStatuses = await CollectionAgent.GetSnmpDeviceStatusesAsync();
            var serverTooLong = CollectionAgent.CommunityTooLongDetected;
            // While the too-long banner is showing (either source), re-run detection each
            // tick: the count stays accurate, and the banner auto-dismisses as soon as the
            // console reports a fixed Community String - no manual re-check needed. Also
            // fires when the server flag first flips on, so a stale local length never
            // pairs with a fresh too-long verdict.
            if (!_detecting && ((serverTooLong && !_serverCommunityTooLong) || CommunityTooLong))
                _ = InvokeAsync(RunDetection);
            _serverCommunityTooLong = serverTooLong;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to load SNMP device statuses");
        }
    }

    // A "key device" is one whose loss of monitoring data is most impactful. For now
    // that's the gateway. "Not being polled" means SNMP is off on the device, or it
    // was dropped from polling after repeated failures.
    private List<SnmpDeviceStatus> GetUnpolledKeyDevices() =>
        _snmpDeviceStatuses
            .Where(d => d.DeviceType == DeviceType.Gateway
                && (d.PollState == SnmpPollState.SnmpDisabled || d.PollState == SnmpPollState.Excluded))
            .ToList();

    private static string KeyDeviceReason(SnmpDeviceStatus d) => d.PollState == SnmpPollState.SnmpDisabled
        ? "isn't being polled. Enable SNMP and set a Location or Contact on it in UniFi to collect its metrics."
        : $"stopped responding to SNMP and was dropped after {d.FailureCount} failures. Retrying automatically.";

