@page "/monitoring"
@rendermode InteractiveServer
@using NetworkOptimizer.Web.Services
@using NetworkOptimizer.Storage.Models
@inject SnmpDetectionService SnmpDetection
@inject UniFiConnectionService ConnectionService

<PageTitle>Monitoring - Network Optimizer</PageTitle>

<div class="page-header">
    <h1>Monitoring</h1>
    <p class="page-description">Real-time network monitoring with SNMP polling, latency tracking, and SFP diagnostics</p>
</div>

@if (!ConnectionService.IsConnected)
{
    <div class="connection-banner">
        <div class="banner-content">
            <span class="banner-icon">!</span>
            <div class="banner-text">
                @if (!string.IsNullOrEmpty(ConnectionService.LastError))
                {
                    <strong>Connection Error</strong>
                    <span>@ConnectionService.LastError</span>
                }
                else
                {
                    <strong>Not Connected</strong>
                    <span>Configure your UniFi Console connection in Settings to get started.</span>
                }
            </div>
            <a href="/settings" class="btn btn-primary btn-sm">Settings</a>
        </div>
    </div>
}
else if (_detecting)
{
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">SNMP Configuration</h2>
        </div>
        <div class="card-body">
            <div class="empty-state">
                <span class="spinner"></span>
                <p>Detecting SNMP configuration from UniFi Console...</p>
            </div>
        </div>
    </div>
}
else if (_detectionResult == null || !_detectionResult.Success)
{
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">SNMP Configuration</h2>
            <span class="status-badge status-error">Error</span>
        </div>
        <div class="card-body">
            <div class="alert alert-danger">
                <strong>Could not detect SNMP settings.</strong>
                @(_detectionResult?.ErrorMessage ?? "Failed to read SNMP configuration from UniFi Console.")
            </div>
            <div class="action-buttons" style="margin-top: 1rem;">
                <button class="btn btn-primary" @onclick="RunDetection">
                    Retry Detection
                </button>
            </div>
        </div>
    </div>
}
else if (_detectionResult.DetectionState == SnmpDetectionState.Disabled)
{
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">SNMP Configuration</h2>
            <span class="status-badge status-disconnected">Disabled</span>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>SNMP is not enabled on your UniFi Console.</strong>
                Network Optimizer needs SNMP to collect port-level traffic statistics, device health metrics, and interface data from your switches and gateway.
            </div>

            <details class="setup-guide" open>
                <summary>How to Enable SNMP</summary>
                <div class="setup-guide-content">
                    <ol>
                        <li>Open UniFi Network</li>
                        <li>Search Settings for <strong>"SNMP Monitoring"</strong></li>
                        <li>Enable <strong>SNMP v1/v2c</strong> and set a unique community string</li>
                    </ol>
                    <p>Currently at: Settings → CyberSecure → Traffic Logging → SNMP Monitoring. This menu has moved between UniFi versions - the search term is the reliable way to find it.</p>

                    <h4>Recommended configuration</h4>
                    <p><strong>SNMP v1/v2c</strong> with a unique community string is recommended over v3. SNMPv3's per-packet authentication and encryption adds measurable CPU load to your gateway and fabric devices. The recommended security posture is a <strong>management VLAN</strong> isolating your network devices, not per-packet crypto.</p>
                </div>
            </details>

            <div class="action-buttons" style="margin-top: 1rem;">
                <button class="btn btn-primary" @onclick="RunDetection">Re-check</button>
            </div>
        </div>
    </div>
}
else if (_detectionResult.DetectionState == SnmpDetectionState.EnabledV3Only)
{
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">SNMP Configuration</h2>
            <span class="status-badge status-connected">Detected</span>
        </div>
        <div class="card-body">
            <p class="section-description">Found SNMPv3 credentials on your UniFi Console.</p>

            <div class="form-group">
                <label class="form-label">Version</label>
                <div class="form-value">SNMPv3</div>
            </div>
            <div class="form-group">
                <label class="form-label">Username</label>
                <div class="form-value">@_detectionResult.V3Username</div>
            </div>

            <div class="alert alert-info" style="margin-top: 1rem;">
                <strong>Consider switching to SNMPv1/v2c.</strong>
                SNMPv3's per-packet crypto adds measurable CPU load to your gateway and switches. The recommended security posture is a management VLAN (which your Security Audit already checks for) rather than per-packet encryption. This is a recommendation, not a requirement - you can proceed with v3.
            </div>

            @if (!_saved)
            {
                <div class="action-buttons" style="margin-top: 1rem;">
                    <button class="btn btn-primary" @onclick="SaveAndProceed">Use SNMPv3</button>
                    <button class="btn btn-secondary" @onclick="RunDetection">Re-check</button>
                </div>
            }
            else
            {
                <div class="alert alert-success" style="margin-top: 1rem;">
                    SNMP configuration saved. Monitoring is ready to start collecting data.
                </div>
            }
        </div>
    </div>
}
else if (_detectionResult.DetectionState == SnmpDetectionState.EnabledV2c)
{
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">SNMP Configuration</h2>
            <span class="status-badge status-connected">Ready</span>
        </div>
        <div class="card-body">
            <p class="section-description">Found your SNMP config - looks good. Network Optimizer will use these credentials for SNMP polling.</p>

            <div class="form-group">
                <label class="form-label">Version</label>
                <div class="form-value">SNMPv2c</div>
            </div>
            <div class="form-group">
                <label class="form-label">Community string</label>
                <div class="form-value">@MaskString(_detectionResult.Community)</div>
            </div>
            @if (_detectionResult.SnmpV3Enabled)
            {
                <div class="form-group">
                    <label class="form-label">SNMPv3</label>
                    <div class="form-value">Also enabled (v2c will be used for polling)</div>
                </div>
            }

            @if (!_saved)
            {
                <div class="action-buttons" style="margin-top: 1rem;">
                    <button class="btn btn-primary" @onclick="SaveAndProceed">Confirm & Enable Monitoring</button>
                    <button class="btn btn-secondary" @onclick="RunDetection">Re-check</button>
                </div>
            }
            else
            {
                <div class="alert alert-success" style="margin-top: 1rem;">
                    SNMP configuration saved. Monitoring is ready to start collecting data.
                </div>
            }
        </div>
    </div>
}

@if (_settings != null && _settings.SnmpDetectionState != SnmpDetectionState.NotChecked && _settings.SnmpDetectionState != SnmpDetectionState.Disabled)
{
    <div class="card" style="margin-top: 1.5rem;">
        <div class="card-header">
            <h2 class="card-title">Monitoring Status</h2>
            <span class="status-badge status-disconnected">Pending Setup</span>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label class="form-label">SNMP</label>
                <div class="form-value">
                    <span class="status-indicator status-active"></span>
                    @FormatDetectionState(_settings.SnmpDetectionState)
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Last detection</label>
                <div class="form-value">@(_settings.LastSnmpDetection?.ToString("g") ?? "Never")</div>
            </div>
            <div class="form-group">
                <label class="form-label">InfluxDB</label>
                <div class="form-value">
                    <span class="status-indicator status-inactive"></span>
                    Not configured
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Collection</label>
                <div class="form-value">
                    <span class="status-indicator status-inactive"></span>
                    Waiting for InfluxDB
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _detecting;
    private bool _saved;
    private SnmpDetectionResult? _detectionResult;
    private MonitoringSettings? _settings;

    protected override async Task OnInitializedAsync()
    {
        await ConnectionService.WaitForConnectionAsync();
        _settings = await SnmpDetection.GetOrCreateSettingsAsync();

        if (ConnectionService.IsConnected && _settings.SnmpDetectionState == SnmpDetectionState.NotChecked)
        {
            await RunDetection();
        }
    }

    private async Task RunDetection()
    {
        _detecting = true;
        _saved = false;
        StateHasChanged();

        _detectionResult = await SnmpDetection.DetectSnmpSettingsAsync();
        _detecting = false;
        StateHasChanged();
    }

    private async Task SaveAndProceed()
    {
        if (_detectionResult == null) return;

        await SnmpDetection.SaveDetectionResultAsync(_detectionResult);
        _settings = await SnmpDetection.GetOrCreateSettingsAsync();
        _saved = true;
        StateHasChanged();
    }

    private static string MaskString(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "(empty)";
        if (value.Length <= 4) return new string('*', value.Length);
        return value[..2] + new string('*', value.Length - 4) + value[^2..];
    }

    private static string FormatDetectionState(SnmpDetectionState state) => state switch
    {
        SnmpDetectionState.EnabledV2c => "Configured (v2c)",
        SnmpDetectionState.EnabledV3Only => "Configured (v3)",
        SnmpDetectionState.Working => "Active",
        SnmpDetectionState.PollFailing => "Poll failures",
        _ => state.ToString()
    };
}
