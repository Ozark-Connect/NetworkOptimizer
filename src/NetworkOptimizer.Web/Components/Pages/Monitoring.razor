    private async Task DismissLanFlakyHintAsync(MonitoringTarget target)
    {
        try
        {
            await TargetService.DismissLanFlakyHintAsync(target.Id);
        }
        catch (Exception ex)
        {
            // Do NOT hide the row when the write did not happen: it would reappear on the next
            // load, so the dismissal would read as having worked and then silently undone itself.
            Logger.LogWarning(ex, "Could not persist the LAN flaky-hint dismissal for target {TargetId}", target.Id);
            return;
        }
        // _targets is loaded AsNoTracking, so reflect the dismissal in memory to drop the row
        // from the advisory immediately without waiting for a reload.
        var local = _targets.FirstOrDefault(t => t.Id == target.Id);
        if (local != null) local.LanFlakyHintDismissedAt = DateTime.UtcNow;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnMapTimeChanged(string? isoTimestamp)
    {
        // Sync WAN live chart to the same timeline position
        if (_wanLiveChartMounted)
        {
            try { await JS.InvokeVoidAsync("eval", $"window.__wanLiveChart?.seekTime({(isoTimestamp != null ? $"'{isoTimestamp}'" : "null")});"); }
            catch { }
        }

        // Sync the port stats table to the same timeline position
        if (_portStatsMounted)
        {
            try { await JS.InvokeVoidAsync("eval", $"window.__portStatsTable?.seekTime({(isoTimestamp != null ? $"'{isoTimestamp}'" : "null")});"); }
            catch { }
        }

        if (isoTimestamp == null)
        {
            // Back to live under their own hand, so the linked instant is behind them.
            ClearLinkedInstant();
            _mapHistoricAt = null;
            _historicSnapshot = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var at = DateTime.Parse(isoTimestamp, null, System.Globalization.DateTimeStyles.RoundtripKind);
        // Anywhere but the instant the link asked for means the timeline was moved - scrubbed,
        // played, stepped - so the parameter describing where the link wanted them stops being
        // true. Compared against that instant rather than acted on blindly, because the link's own
        // seek reports back through here too and must not clear what it just applied.
        if (_linkedInstantMs is { } linked
            && Math.Abs(new DateTimeOffset(at.ToUniversalTime()).ToUnixTimeMilliseconds() - linked) > 1000)
        {
            ClearLinkedInstant();
        }
        _mapHistoricAt = at;
        await FetchHistoricSnapshotAsync(at);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Told by the analysis charts that the user moved their own window - a range button, a shift
    /// arrow, a custom range, a drag-zoom.
    /// </summary>
    [JSInvokable]
    public void OnTimelineMovedByUser() => ClearLinkedInstant();

    /// <summary>
    /// Drops ?at= and ?wan= once the timeline is under the user's own hand. Both say where a link
    /// wanted to put them - one in time, one on a WAN - and left in place after they move, a reload
    /// or the back button drags them back to it. Done on THEIR input and nowhere else - clearing on
    /// arrival instead cost an extra navigation per jump, and looping between the jump icons tripped
    /// the browser's throttle. The two are dropped in ONE navigation for the same reason: a second
    /// replaceState behind Blazor's router is what desynchronized the two views of the URL before.
    /// </summary>
    /// <summary>
    /// Drops ?wan= once the user picks their own WAN, and leaves ?at= alone: choosing which WAN is
    /// on screen says nothing about the instant they are looking at. Otherwise the same reasoning as
    /// <see cref="ClearLinkedInstant"/> - the parameter records which WAN a link wanted, and left in
    /// place a reload or the back button re-narrows to it over the choice they just made.
    /// </summary>
    private void ClearLinkedWan()
    {
        if (string.IsNullOrWhiteSpace(WanParam)) return;
        // Never before the link has been read. Loading the live scope self-selects a WAN and raises
        // its own change, so on a cold load this threw the parameter away while it was still the
        // only record of where the user asked to go.
        if (LinkNarrowsWanFilter && _appliedLinkWanKey != LinkWanKey) return;

        var stripped = SiteContextService.RemoveQueryParam(NavigationManager.Uri, "wan");
        if (stripped == NavigationManager.Uri) return;
        // The URL is about to change, which re-arms the linked instant unless the arm moves with it -
        // a WAN change would then seek them back to the link's moment. _pendingAtMs is deliberately
        // left as it stands: this is not a statement about time. The investigation arm moves too -
        // the URL changed, the search did not.
        _armedAtUri = stripped;
        if (_armedInvestigateUri != null) _armedInvestigateUri = stripped;
        NavigationManager.NavigateTo(stripped, forceLoad: false, replace: true);
    }

    private void ClearLinkedInstant()
    {
        _linkedInstantMs = null;
        var current = NavigationManager.Uri;
        var stripped = current;
        if (!string.IsNullOrWhiteSpace(AtParam))
            stripped = SiteContextService.RemoveQueryParam(stripped, "at");
        if (!string.IsNullOrWhiteSpace(WanParam))
            stripped = SiteContextService.RemoveQueryParam(stripped, "wan");
        if (stripped == current) return;
        // Armed against the new URL first, or being re-supplied under it would arm a fresh seek
        // and pull them straight back to where they just left. Set even when only the WAN was
        // dropped, since the URL still changed and would otherwise re-arm the instant. Same for the
        // investigation: this call is how a drag-zoom reaches the URL.
        _armedAtUri = stripped;
        if (_armedInvestigateUri != null) _armedInvestigateUri = stripped;
        if (!string.IsNullOrWhiteSpace(AtParam)) _pendingAtMs = null;
        NavigationManager.NavigateTo(stripped, forceLoad: false, replace: true);
    }

    private async Task FetchHistoricSnapshotAsync(DateTime at)
    {
        var from = at.AddSeconds(-90);
        var to = at.AddSeconds(30);

        double wanDown = 0, wanUp = 0;
        double? gwRtt = null; double gwLoss = 0;
        double? ispRtt = null; double ispLoss = 0;
        double? transitRtt = null; double transitLoss = 0;
        double? gwCpu = null, gwMem = null, gwTemp = null;
        double fabricIn = 0, fabricOut = 0;

        var tasks = new List<Task>();

        // The counters of the WANs actually on screen. Falling back to the gateway's whole list
        // read the primary's throughput under a secondary WAN's name; restricting it to the
        // primary instead left a secondary WAN's tiles blank, which is where this started. The
        // selection carries each WAN's own counter interface, so it can answer for any of them.
        var snapshotWanIfNames = LiveWan.SelectedOptions
            .Select(o => o.CounterIfName)
            .Where(n => !string.IsNullOrEmpty(n))
            .Select(n => n!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (snapshotWanIfNames.Count == 0) snapshotWanIfNames = _gatewayWanIfNames;

        // WAN rates
        if (_gatewayMac != null && snapshotWanIfNames.Count > 0)
        {
            tasks.Add(Task.Run(async () =>
            {
                var points = await InfluxClient.QueryGatewayWanRatesAsync(
                    _gatewayMac, snapshotWanIfNames, from, to);
                var closest = points
                    .OrderBy(p => Math.Abs((p.Time - at).TotalMilliseconds))
                    .FirstOrDefault();
                if (closest != null)
                {
                    wanDown = closest.DownloadBps ?? 0;
                    wanUp = closest.UploadBps ?? 0;
                }
            }));
        }

        // Gateway health
        if (_gatewayMac != null)
        {
            tasks.Add(Task.Run(async () =>
            {
                var points = await InfluxClient.QueryDeviceHealthAsync(_gatewayMac, from, to);
                var closest = points
                    .OrderBy(p => Math.Abs((p.Time - at).TotalMilliseconds))
                    .FirstOrDefault();
                if (closest != null)
                {
                    gwCpu = closest.CpuPercent;
                    gwMem = closest.MemoryUsedPercent;
                    gwTemp = closest.TemperatureC;
                }
            }));
        }

        // Gateway latency (Fabric target for the gateway)
        var gwFabric = _targets.FirstOrDefault(t =>
            t.TargetType == MonitoringTargetType.Fabric
            && t.Enabled
            && !string.IsNullOrEmpty(t.DeviceMac)
            && _gatewayMac != null
            && t.DeviceMac.Replace("-", ":").Equals(_gatewayMac, StringComparison.OrdinalIgnoreCase));
        if (gwFabric != null)
        {
            tasks.Add(Task.Run(async () =>
            {
                var points = await InfluxClient.QueryLatencyAsync(gwFabric.TargetId, from, to);
                var closest = points
                    .OrderBy(p => Math.Abs((p.Time - at).TotalMilliseconds))
                    .FirstOrDefault();
                if (closest != null)
                {
                    gwRtt = closest.RttAvgMs;
                    gwLoss = closest.LossPercent ?? 0;
                }
            }));
        }

        // ISP latency (mean across enabled ISP targets)
        // Points are read for the WAN on screen. Unscoped, the tiles averaged every WAN's targets
        // together, so a playback figure could not match the chart beside it.
        var snapshotWanScope = BuildSnapshotWanScope();
        tasks.Add(Task.Run(async () =>
        {
            var data = await InfluxClient.QueryLatencyByTargetTypeAsync(
                MonitoringTargetType.AccessIsp, from, to, wanScope: snapshotWanScope);
            var rtts = new List<double>();
            var losses = new List<double>();
            foreach (var (_, pts) in data)
            {
                var closest = pts
                    .OrderBy(p => Math.Abs((p.Time - at).TotalMilliseconds))
                    .FirstOrDefault();
                if (closest == null) continue;
                if (closest.RttAvgMs.HasValue) rtts.Add(closest.RttAvgMs.Value);
                if (closest.LossPercent.HasValue) losses.Add(closest.LossPercent.Value);
            }
            ispRtt = rtts.Count > 0 ? rtts.Average() : null;
            ispLoss = losses.Count > 0 ? losses.Average() : 0;
        }));

        // Transit latency (mean across enabled Transit targets)
        tasks.Add(Task.Run(async () =>
        {
            var data = await InfluxClient.QueryLatencyByTargetTypeAsync(
                MonitoringTargetType.Transit, from, to, wanScope: snapshotWanScope);
            var rtts = new List<double>();
            var losses = new List<double>();
            foreach (var (_, pts) in data)
            {
                var closest = pts
                    .OrderBy(p => Math.Abs((p.Time - at).TotalMilliseconds))
                    .FirstOrDefault();
                if (closest == null) continue;
                if (closest.RttAvgMs.HasValue) rtts.Add(closest.RttAvgMs.Value);
                if (closest.LossPercent.HasValue) losses.Add(closest.LossPercent.Value);
            }
            transitRtt = rtts.Count > 0 ? rtts.Average() : null;
            transitLoss = losses.Count > 0 ? losses.Average() : 0;
        }));

        // Fabric load (sum across switches, gateways, and cellular modems only -
        // APs are excluded because their radio interfaces over-count beacons/retries.
        // The live path only calls RecordFabricSum for these device types, so APs
        // have FabricIngressBps == null and contribute 0 to the live total.)
        // Which devices count is a question about their TYPE, and it used to be asked of the live
        // stats instead - a device was included only if it had already reported a fabric sum. That
        // reads correctly on a site whose data is flowing and fails in the two places it matters:
        // an OFFLINE site has no live stats at all, so playback found no devices and the tiles read
        // "-" forever; and after a server restart the in-memory stats start empty, so an agent site
        // showed nothing until each device's next SNMP poll refilled them - the "eventually catches
        // up" part. Device type is known from the SNMP status list either way.
        //
        // The types match what the live path records for exactly (MonitoringCollectionAgent's
        // RecordFabricSum): switches, gateways and cellular modems. APs are excluded because their
        // radio interfaces over-count beacons and retries.
        var fabricTypes = _snmpDeviceStatuses
            .Where(d => d.DeviceType == DeviceType.Switch
                || d.DeviceType == DeviceType.Gateway
                || d.DeviceType == DeviceType.CellularModem)
            .Select(d => d.Mac)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var fabricMacs = _targets
            .Where(t => t.TargetType == MonitoringTargetType.Fabric && !t.IsRetired && !string.IsNullOrEmpty(t.DeviceMac))
            .Select(t => t.DeviceMac!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            // Three ways to answer, in order of how much the site can currently tell us:
            //   types known      - the console answered, so filter to the types that count
            //   live stats exist - the site is up but the status list has not loaded yet
            //   neither          - the site is OFFLINE, which is when playback matters most
            // The last case is the one that read "-" forever: both other sources need a console,
            // so an offline site failed every test and no device was ever queried. Its fabric
            // targets are in the site's own database and Influx still holds their history, so
            // they are used as they stand. Where the console has never named the types, an AP
            // among them can inflate the total - a number with a caveat beats a dash.
            .Where(mac => fabricTypes.Count > 0
                ? fabricTypes.Contains(mac)
                : LiveStats.GetForDevice(mac) is { } st
                    && (st.FabricIngressBps != null || st.FabricEgressBps != null))
            .ToList();
        if (fabricMacs.Count == 0 && fabricTypes.Count == 0)
        {
            fabricMacs = _targets
                .Where(t => t.TargetType == MonitoringTargetType.Fabric && !t.IsRetired && !string.IsNullOrEmpty(t.DeviceMac))
                .Select(t => t.DeviceMac!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        if (fabricMacs.Count > 0)
        {
            tasks.Add(Task.Run(async () =>
            {
                double totalIn = 0, totalOut = 0;
                foreach (var mac in fabricMacs)
                {
                    var points = await InfluxClient.QueryInterfaceRatesAsync(mac, from, to);
                    var isGateway = _gatewayMac != null
                        && mac.Replace("-", ":").Equals(_gatewayMac, StringComparison.OrdinalIgnoreCase);
                    if (isGateway)
                        points = points
                            .Where(p => System.Text.RegularExpressions.Regex.IsMatch(p.IfName, @"^eth\d+$"))
                            .ToList();
                    var closest = points
                        .GroupBy(p => p.Time)
                        .OrderBy(g => Math.Abs((g.Key - at).TotalMilliseconds))
                        .FirstOrDefault();
                    if (closest == null) continue;
                    foreach (var p in closest)
                    {
                        totalIn += p.RateInBps ?? 0;
                        totalOut += p.RateOutBps ?? 0;
                    }
                }
                fabricIn = totalIn;
                fabricOut = totalOut;
            }));
        }

        try { await Task.WhenAll(tasks); }
        catch { }

        var perWan = LiveWan.IsComparing
            ? await BuildPerWanLatencyAsync(from, to, at)
            : new Dictionary<string, WanLatencySnapshot>();

        _historicSnapshot = new HistoricStatSnapshot
        {
            PerWan = perWan,
            WanDownloadBps = wanDown,
            WanUploadBps = wanUp,
            GatewayRttMs = gwRtt,
            GatewayLossPercent = gwLoss,
            IspRttMs = ispRtt,
            IspLossPercent = ispLoss,
            TransitRttMs = transitRtt,
            TransitLossPercent = transitLoss,
            GatewayCpuPercent = gwCpu,
            GatewayMemoryPercent = gwMem,
            GatewayTempC = gwTemp,
            FabricIngressBps = fabricIn,
            FabricEgressBps = fabricOut,
        };
    }

    /// <summary>
    /// The playback tiles' WAN scope: the focused WAN's tags, or the primary's untagged points.
    /// Null while comparing - the tiles show one figure, and no single scope describes several
    /// WANs at once, so they fall back to the whole site rather than to one of them.
    /// </summary>
    /// <summary>
    /// Each compared WAN's ISP and Transit latency at the playback instant, scoped to that WAN
    /// alone. One query pair per WAN because a scope names one WAN - the whole reason the focused
    /// figures cannot serve the stacked rows.
    /// </summary>
    private async Task<Dictionary<string, WanLatencySnapshot>> BuildPerWanLatencyAsync(
        DateTime from, DateTime to, DateTime at)
    {
        var byWan = new Dictionary<string, WanLatencySnapshot>(StringComparer.OrdinalIgnoreCase);
        foreach (var wan in LiveWan.SelectedOptions)
        {
            try
            {
                var key = NetworkOptimizer.UniFi.GatewayWanHelper.WanInterfaceKeyFromKey(wan.Key);
                var scope = Services.Monitoring.IspHealth.IspHealthService
                    .BuildWanScope(_wanContexts, key, wan.IsPrimary);
                var isp = await ClosestLatencyAsync(MonitoringTargetType.AccessIsp, from, to, at, scope);
                var transit = await ClosestLatencyAsync(MonitoringTargetType.Transit, from, to, at, scope);
                byWan[wan.Key] = new WanLatencySnapshot(isp.Rtt, isp.Loss, transit.Rtt, transit.Loss);
            }
            catch
            {
                // One WAN failing leaves its row on live values rather than emptying the stack.
            }
        }
        return byWan;
    }

    /// <summary>Mean RTT and loss across a type's targets at the instant nearest the playhead.</summary>
    private async Task<(double? Rtt, double Loss)> ClosestLatencyAsync(
        MonitoringTargetType type, DateTime from, DateTime to, DateTime at,
        MonitoringInfluxClient.LatencyWanScope? scope)
    {
        var data = await InfluxClient.QueryLatencyByTargetTypeAsync(type, from, to, wanScope: scope);
        var rtts = new List<double>();
        var losses = new List<double>();
        foreach (var (_, pts) in data)
        {
            var closest = pts.OrderBy(p => Math.Abs((p.Time - at).TotalMilliseconds)).FirstOrDefault();
            if (closest == null) continue;
            if (closest.RttAvgMs.HasValue) rtts.Add(closest.RttAvgMs.Value);
            if (closest.LossPercent.HasValue) losses.Add(closest.LossPercent.Value);
        }
        return (rtts.Count > 0 ? rtts.Average() : null, losses.Count > 0 ? losses.Average() : 0);
    }

    private MonitoringInfluxClient.LatencyWanScope? BuildSnapshotWanScope()
    {
        if (!_multiWanUiVisible || LiveWan.IsComparing) return null;
        var key = NetworkOptimizer.UniFi.GatewayWanHelper.WanInterfaceKeyFromKey(
            LiveWan.Selected?.Key ?? _primaryWanKey);
        var isPrimary = LiveWan.Selected?.IsPrimary ?? true;
        try { return Services.Monitoring.IspHealth.IspHealthService.BuildWanScope(_wanContexts, key, isPrimary); }
        catch { return null; }
    }

    // ─── Stat card helpers ───

    private bool HasUpstreamTargets(MonitoringTargetType type) =>
        _targets.Any(t => t.TargetType == type && t.Enabled);

    /// <summary>
    /// Whether EVERY WAN currently on screen has a target of this type, for deciding which category
    /// the chart shows. Site-wide is the wrong question: LAN targets belong to the site rather than
    /// to a WAN, so a secondary WAN has none, and asking site-wide opens that WAN on the LAN
    /// category and draws an empty chart.
    /// <para>
    /// Any rather than every. The answer only decides whether a category is worth showing, and an
    /// all-WAN scope routinely includes a WAN with no LAN targets of its own - refusing LAN over
    /// that one hides the LAN targets every other WAN does have, which is the more surprising
    /// outcome. A partial comparison is still the data someone asked to see; nothing at all is not.
    /// </para>
    /// <para>
    /// Falls back to the site-wide answer when no WAN is resolved - a single-WAN site, or one whose
    /// console could not be read - so the selection those sites have always had is unchanged.
    /// </para>
    /// </summary>
    private bool HasTargetsInWanScope(MonitoringTargetType type)
    {
        var scoped = _wanOptions.Where(w => _selectedWanKeys.Contains(w.Key)).ToList();
        return scoped.Count == 0
            ? HasUpstreamTargets(type)
            : scoped.Any(w => TargetsForWan(type, w.Key, w.IsPrimary).Count > 0);
    }

    /// <summary>
    /// Live throughput for the WANs on screen. One WAN reads its own counter; several are summed,
    /// which is what asking to see them together means - and the label says so, because a bigger
    /// number with no explanation is worse than no number. A WAN whose counters are not in the
    /// polled data contributes nothing and is named in the tooltip rather than silently folded in
    /// as a zero.
    /// </summary>
    private (double? download, double? upload) GetWanRates()
    {
        // The snapshot recorded the primary's series, so it answers for the primary and for a site
        // with no WAN picker at all - where Selected is null and playback worked long before any
        // of this. Only a deliberate non-primary selection has nothing to show.
        // The snapshot is built from the selection's own counters now, so it answers for whichever
        // WAN is on screen rather than the primary alone.
        if (_historicSnapshot is not null)
            return (_historicSnapshot.WanDownloadBps, _historicSnapshot.WanUploadBps);

        if (_gatewayMac == null) return (null, null);

        // No WAN options is the ordinary state, not an empty selection: they come from the
        // console's WAN list, which a site without a reachable console never produces - and every
        // such site was reading its rate from the discovered interface names long before there
        // was a WAN picker. Falling through to the per-option loop returned nothing at all and
        // blanked the tiles on exactly those sites.
        var selected = LiveWan.SelectedOptions;
        if (selected.Count == 0)
        {
            if (_gatewayWanIfNames.Count == 0) return (null, null);
            double? legacyDown = null, legacyUp = null;
            foreach (var ifName in _gatewayWanIfNames)
            {
                var r = LiveStats.GetPortRate(_gatewayMac, ifName);
                if (r == null) continue;
                legacyDown = (legacyDown ?? 0) + r.UpBps;
                legacyUp = (legacyUp ?? 0) + r.DownBps;
            }
            return (legacyDown, legacyUp);
        }

        double? down = null, up = null;
        foreach (var wan in selected)
        {
            // A WAN the console names but has no counter for falls back to the discovered
            // interface, which is the same name the tiles used before any of this existed.
            var ifName = wan.IsPrimary && string.IsNullOrEmpty(wan.CounterIfName)
                ? _gatewayWanIfNames.FirstOrDefault()
                : wan.CounterIfName;
            if (string.IsNullOrEmpty(ifName)) continue;
            var rate = LiveStats.GetPortRate(_gatewayMac, ifName!);
            if (rate == null) continue;
            // PortLiveRate: DownBps = SNMP rateOut (port TX), UpBps = rateIn (RX). On a WAN port
            // RX is download from the ISP and TX is upload to it.
            down = (down ?? 0) + rate.UpBps;
            up = (up ?? 0) + rate.DownBps;
        }
        return (down, up);
    }

    /// <summary>Label for the throughput tiles: names the aggregate so a summed figure cannot read as one WAN's.</summary>
    private string WanRateCount() =>
        LiveWan.IsComparing ? $" ({LiveWan.SelectedKeys.Count} WANs)" : "";

    /// <summary>The comparison count without its unit, for the mobile label where the arrow has
    /// already established what the tile is and the width will not carry "WANs".</summary>
    private string WanRateCountShort() =>
        LiveWan.IsComparing ? $" ({LiveWan.SelectedKeys.Count})" : "";

