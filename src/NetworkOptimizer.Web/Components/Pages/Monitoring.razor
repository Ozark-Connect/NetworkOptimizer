@page "/monitoring"
@rendermode InteractiveServer
@implements IDisposable
@using NetworkOptimizer.Web.Services
@using NetworkOptimizer.Storage.Models
@using Microsoft.EntityFrameworkCore
@inject SnmpDetectionService SnmpDetection
@inject UniFiConnectionService ConnectionService
@inject MonitoringInfluxClient InfluxClient
@inject MonitoringLiveStats LiveStats
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<NetworkOptimizer.Storage.Models.NetworkOptimizerDbContext> DbFactory
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Monitoring - Network Optimizer</PageTitle>

<div class="page-header">
    <h1>Monitoring</h1>
    <p class="page-description">Real-time network monitoring with SNMP polling, latency tracking, and SFP diagnostics</p>
</div>

@if (!ConnectionService.IsConnected)
{
    <div class="connection-banner">
        <div class="banner-content">
            <span class="banner-icon">!</span>
            <div class="banner-text">
                @if (!string.IsNullOrEmpty(ConnectionService.LastError))
                {
                    <strong>Connection Error</strong>
                    <span>@ConnectionService.LastError</span>
                }
                else
                {
                    <strong>Not Connected</strong>
                    <span>Configure your UniFi Console connection in Settings to get started.</span>
                }
            </div>
            <a href="/settings" class="btn btn-primary btn-sm">Settings</a>
        </div>
    </div>
}
else if (_snmpState == SnmpDetectionState.NotChecked)
{
    <!-- Detection in progress or about to start -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">SNMP Configuration</h2>
        </div>
        <div class="card-body">
            <div class="empty-state">
                <span class="spinner"></span>
                <p>Detecting SNMP configuration from UniFi Console...</p>
            </div>
        </div>
    </div>
}
else if (_snmpState == SnmpDetectionState.Disabled)
{
    <!-- SNMP not enabled - setup guide -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">SNMP Setup Required</h2>
            <span class="status-badge status-disconnected">Disabled</span>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>SNMP is not enabled on your UniFi Console.</strong>
                Network Optimizer needs SNMP to collect port-level traffic statistics, device health metrics, and interface data from your switches and gateway.
            </div>

            <details class="setup-guide" open>
                <summary>How to Enable SNMP</summary>
                <div class="setup-guide-content">
                    <ol>
                        <li>Open UniFi Network</li>
                        <li>Search Settings for <strong>"SNMP Monitoring"</strong></li>
                        <li>Enable <strong>SNMP v1/v2c</strong> and set a unique community string</li>
                    </ol>
                    <p>Currently at: Settings → CyberSecure → Traffic Logging → SNMP Monitoring. This menu has moved between UniFi versions - the search term is the reliable way to find it.</p>

                    <h4>Recommended configuration</h4>
                    <p><strong>SNMP v1/v2c</strong> with a unique community string is recommended over v3. SNMPv3's per-packet authentication and encryption adds measurable CPU load to your gateway and fabric devices. The recommended security posture is a <strong>management VLAN</strong> isolating your network devices, not per-packet crypto.</p>
                </div>
            </details>

            <div class="action-buttons" style="margin-top: 1rem;">
                <button class="btn btn-primary" @onclick="RunDetection" disabled="@_detecting">
                    @if (_detecting) { <span class="spinner-sm"></span> <span>Checking...</span> }
                    else { <span>Re-check</span> }
                </button>
            </div>
        </div>
    </div>
}
else if (_snmpState == SnmpDetectionState.EnabledV2c || _snmpState == SnmpDetectionState.EnabledV3Only || _snmpState == SnmpDetectionState.Working)
{
    <!-- SNMP configured - show monitoring content -->

    @if (_showV3Recommendation && _snmpState == SnmpDetectionState.EnabledV3Only)
    {
        <div class="alert alert-info" style="margin-bottom: 1.5rem;">
            <strong>SNMPv3 detected.</strong>
            Consider switching to v1/v2c - the per-packet crypto adds CPU load to your network devices. The recommended security posture is a management VLAN, not v3 encryption.
            <button class="btn btn-sm btn-secondary" style="margin-left: 0.5rem;" @onclick="() => _showV3Recommendation = false">Dismiss</button>
        </div>
    }

    @if (!_influxConfigured)
    {
        <!-- First-run InfluxDB setup happens right here inline. No click-through. -->
        <InfluxSetupWizard TitlePrefix="Set up " OnProvisioned="OnInfluxProvisioned" />
    }

    <div class="card" style="@(_influxConfigured ? "" : "margin-top: 1.5rem;")">
        <div class="card-header card-header-collapsible" @onclick="ToggleStatus">
            <h2 class="card-title">Monitoring Status</h2>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span class="status-badge status-connected" @onclick:stopPropagation="true">@OverallStateBadge()</span>
                <a href="/settings#monitoring" class="tooltip-icon settings-link" data-tooltip="Monitoring settings" @onclick:stopPropagation="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.84 1.804A1 1 0 018.82 1h2.36a1 1 0 01.98.804l.331 1.652a6.993 6.993 0 011.929 1.115l1.598-.54a1 1 0 011.186.447l1.18 2.044a1 1 0 01-.205 1.251l-1.267 1.113a7.047 7.047 0 010 2.228l1.267 1.113a1 1 0 01.206 1.25l-1.18 2.045a1 1 0 01-1.187.447l-1.598-.54a6.993 6.993 0 01-1.929 1.115l-.33 1.652a1 1 0 01-.98.804H8.82a1 1 0 01-.98-.804l-.331-1.652a6.993 6.993 0 01-1.929-1.115l-1.598.54a1 1 0 01-1.186-.447l-1.18-2.044a1 1 0 01.205-1.251l1.267-1.114a7.05 7.05 0 010-2.227L1.821 7.773a1 1 0 01-.206-1.25l1.18-2.045a1 1 0 011.187-.447l1.598.54A6.993 6.993 0 017.51 3.456l.33-1.652zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                    </svg>
                </a>
                <span class="issue-type-chevron">@(_statusCollapsed ? "▼" : "▲")</span>
            </div>
        </div>
        <div class="expand-wrapper @(!_statusCollapsed ? "expanded" : "")">
            <div class="expand-content">
        <div class="card-body">
            <div class="form-group">
                <label class="form-label">SNMP</label>
                <div class="form-value">
                    <span class="status-indicator status-active"></span>
                    @(_snmpState == SnmpDetectionState.EnabledV2c ? "v2c" : _snmpState == SnmpDetectionState.EnabledV3Only ? "v3" : "Active")
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">InfluxDB</label>
                <div class="form-value">
                    @if (_influxReachable == true)
                    {
                        <span class="status-indicator status-active"></span>
                        <span>Connected</span>
                    }
                    else if (_influxReachable == false && !string.IsNullOrEmpty(_influxError))
                    {
                        <span class="status-indicator status-danger"></span>
                        <span>@_influxError</span>
                    }
                    else if (!_influxConfigured)
                    {
                        <span class="status-indicator status-inactive"></span>
                        <span>Not configured - follow the setup card above.</span>
                    }
                    else
                    {
                        <span class="status-indicator status-inactive"></span>
                        <span>Not checked</span>
                    }
                    @if (_influxConfigured)
                    {
                        <button class="btn btn-sm btn-secondary" style="margin-left: 0.75rem;" @onclick="CheckInfluxHealth" disabled="@_checkingInflux">
                            @if (_checkingInflux)
                            {
                                <span class="spinner-sm"></span>
                                <span>Checking...</span>
                            }
                            else
                            {
                                <span>Test</span>
                            }
                        </button>
                        @if (_lastInfluxTestAt.HasValue && !_checkingInflux)
                        {
                            <span class="page-description" style="margin-left: 0.5rem;">
                                @if (_influxReachable == true)
                                {
                                    <span style="color: var(--success-color);">✓ Connected</span>
                                }
                                else
                                {
                                    <span style="color: var(--danger-color);">✗ @(_influxError ?? "Unreachable")</span>
                                }
                            </span>
                        }
                    }
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Collection</label>
                <div class="form-value">
                    @if (_monitoringEnabled && _influxReachable == true)
                    {
                        <span class="status-indicator status-active"></span>
                        <span>Agent running</span>
                    }
                    else if (_monitoringEnabled && _influxReachable != true)
                    {
                        <span class="status-indicator status-danger"></span>
                        <span>Enabled, but InfluxDB unreachable</span>
                    }
                    else
                    {
                        <span class="status-indicator status-inactive"></span>
                        <span>Disabled</span>
                    }
                </div>
            </div>

            <div class="action-buttons" style="margin-top: 1rem;">
                @if (_monitoringEnabled)
                {
                    <button class="btn btn-secondary" @onclick="() => SetMonitoringEnabled(false)" disabled="@_togglingEnable">
                        @if (_togglingEnable) { <span class="spinner-sm"></span> <span>Stopping...</span> }
                        else { <span>Disable Monitoring</span> }
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="() => SetMonitoringEnabled(true)" disabled="@(_togglingEnable || _influxReachable != true)">
                        @if (_togglingEnable) { <span class="spinner-sm"></span> <span>Starting...</span> }
                        else { <span>Enable Monitoring</span> }
                    </button>
                    @if (_influxReachable != true)
                    {
                        <span class="page-description" style="margin-left: 0.75rem;">
                            Complete InfluxDB setup above to enable.
                        </span>
                    }
                }
            </div>
        </div>
            </div>
        </div>
    </div>

    @if (_monitoringEnabled && _monitoredSfps.Count > 0)
    {
        <div class="card" style="margin-top: 1.5rem;">
            <div class="card-header">
                <h2 class="card-title">Optical (SFP / ONT)</h2>
                <span class="status-badge status-active">@_monitoredSfps.Count modules</span>
            </div>
            <div class="card-body">
                <p class="section-description">
                    GPON / XGS-PON ONTs and other SFP modules detected on switch / gateway
                    ports. RX optical power should sit in a healthy range (typically
                    -3 to -25 dBm for single-mode); values outside that range need
                    attention.
                </p>
                <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Port</th>
                            <th>Module</th>
                            <th>RX power</th>
                            <th>TX power</th>
                            <th>Temp</th>
                            <th>Voltage</th>
                            <th>Bias</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sfp in _monitoredSfps.OrderBy(s => s.DeviceMac).ThenBy(s => s.PortName))
                        {
                            var stats = LiveStats.GetSfpStats(sfp.DeviceMac, sfp.PortName);
                            var deviceName = ResolveDeviceName(sfp.DeviceMac);
                            var portLabel = !string.IsNullOrEmpty(sfp.FriendlyName) ? sfp.FriendlyName : $"port {sfp.PortName}";
                            <tr>
                                <td>
                                    <div class="sfp-port-cell">
                                        <strong>@deviceName</strong>
                                        <span class="text-muted">@portLabel</span>
                                        @if (sfp.IsPon)
                                        {
                                            <span class="status-badge status-active">@PonVariantLabel(sfp.SfpPart, sfp.SfpVendor)</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(sfp.SfpPart))
                                    { <code>@sfp.SfpPart</code> }
                                    else
                                    { <span class="text-muted">-</span> }
                                </td>
                                <td class="@RxClass(stats?.RxPowerDbm)">@FormatOptical(stats?.RxPowerDbm, "dBm")</td>
                                <td>@FormatOptical(stats?.TxPowerDbm, "dBm")</td>
                                <td>@FormatOptical(stats?.TemperatureC, "°C")</td>
                                <td>@FormatOptical(stats?.VoltageV, "V")</td>
                                <td>@FormatOptical(stats?.BiasMa, "mA")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    }

    @if (_monitoringEnabled && _influxReachable == true)
    {
        <!-- 3D LAN flow map (spec 5.7). Centerpiece of the monitoring view. -->
        <div class="card lan-flow-map-card" style="margin-top: 1.5rem;">
            <div class="card-header">
                <h2 class="card-title">3D LAN Flow Map</h2>
            </div>
            <div class="card-body lan-flow-map-body">
                <div class="lan-flow-map-stage" id="lan-flow-map-stage">
                    <canvas id="lan-flow-map-canvas" class="lan-flow-map-canvas"></canvas>
                </div>
            </div>
        </div>

        <!-- Latency time-series charts. Four categories matching target types, with
             per-target drill-down via filter badges. -->
        <div class="card" style="margin-top: 1.5rem;">
            <div class="card-header" style="flex-wrap: wrap; gap: 0.75rem;">
                <h2 class="card-title">Latency &amp; Packet Loss</h2>
                <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                    <div class="time-range-selector">
                        @foreach (var cat in _latencyCategories)
                        {
                            <button class="time-btn @(_latencyCategory == cat.Type ? "active" : "")"
                                    @onclick="() => SelectLatencyCategoryAsync(cat.Type)">
                                @cat.Label
                            </button>
                        }
                    </div>
                    <div class="time-range-selector">
                        @foreach (var r in _latencyTimeRanges)
                        {
                            <button class="time-btn @(_latencyRangeHours == r.Hours ? "active" : "")"
                                    @onclick="() => SelectLatencyRangeAsync(r.Hours)">
                                @r.Label
                            </button>
                        }
                    </div>
                </div>
            </div>
            <div class="card-body">
                @{ var categoryTargets = GetCategoryTargets(); }
                @if (categoryTargets.Count == 0)
                {
                    <div class="empty-state">
                        <p>@EmptyStateMessage()</p>
                    </div>
                }
                else
                {
                    @if (categoryTargets.Count > 1)
                    {
                        <div class="wan-filter-badges">
                            @foreach (var t in categoryTargets)
                            {
                                var color = GetTargetColor(t.TargetId);
                                var visible = IsTargetVisible(t.TargetId);
                                <button class="wan-filter-badge @(visible ? "active" : "")"
                                        @onclick="() => ToggleTargetVisibility(t.TargetId)">
                                    <span class="wan-filter-dot" style="background: @color;"></span>
                                    <span>@t.Name</span>
                                </button>
                            }
                        </div>
                    }

                    <div class="chart-card">
                        <div class="chart-header">
                            <h3 class="chart-title">Round-trip time</h3>
                        </div>
                        @if (_latencyRttSeries.Count == 0 && !_latencyLoading)
                        {
                            <div class="empty-state" style="padding: 2rem 0;">
                                <p>No data in this time range.</p>
                            </div>
                        }
                        else
                        {
                            <ApexChart @ref="_rttChart" @key="@($"rtt-{_latencyChartKey}")"
                                       TItem="LatencyChartPoint"
                                       Options="_rttChartOptions"
                                       Height="@("260px")">
                                @foreach (var series in _latencyRttSeries)
                                {
                                    <ApexPointSeries TItem="LatencyChartPoint"
                                                     Items="@(IsTargetVisible(series.TargetId) ? series.Points : _emptyLatencyPoints)"
                                                     Name="@series.Name"
                                                     SeriesType="SeriesType.Line"
                                                     XValue="e => e.Time"
                                                     YValue="e => (decimal?)e.Value"
                                                     OrderBy="e => e.X"
                                                     Color="@series.Color" />
                                }
                            </ApexChart>
                        }
                    </div>

                    <div class="chart-card" style="margin-top: 1rem;">
                        <div class="chart-header">
                            <h3 class="chart-title">Packet loss</h3>
                        </div>
                        @if (_latencyLossSeries.Count == 0 && !_latencyLoading)
                        {
                            <div class="empty-state" style="padding: 2rem 0;">
                                <p>No data in this time range.</p>
                            </div>
                        }
                        else
                        {
                            <ApexChart @ref="_lossChart" @key="@($"loss-{_latencyChartKey}")"
                                       TItem="LatencyChartPoint"
                                       Options="_lossChartOptions"
                                       Height="@("200px")">
                                @foreach (var series in _latencyLossSeries)
                                {
                                    <ApexPointSeries TItem="LatencyChartPoint"
                                                     Items="@(IsTargetVisible(series.TargetId) ? series.Points : _emptyLatencyPoints)"
                                                     Name="@series.Name"
                                                     SeriesType="SeriesType.Area"
                                                     XValue="e => e.Time"
                                                     YValue="e => (decimal?)e.Value"
                                                     OrderBy="e => e.X"
                                                     Color="@series.Color" />
                                }
                            </ApexChart>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Upstream tracer wizard (Build #10). User-initiated discovery of the access
             ISP path + transit ASN clouds; output populates AccessIsp / Transit
             MonitoringTarget rows for the agent's latency tier to probe. -->
        <div style="margin-top: 1.5rem;">
            <UpstreamTracerPanel />
        </div>
    }

    @if (_monitoringEnabled)
    {
        <div class="card" style="margin-top: 1.5rem;">
            <div class="card-header card-header-collapsible" @onclick="ToggleTargetsCollapse">
                <h2 class="card-title">Latency targets</h2>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span class="status-badge status-active" @onclick:stopPropagation="true">@_targets.Count active</span>
                    <a href="/monitoring/tools" class="tooltip-icon settings-link" data-tooltip="Run an ad-hoc probe" @onclick:stopPropagation="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM5.5 8.5a.5.5 0 010-1h2.793L7.146 6.354a.5.5 0 11.708-.708l2 2a.5.5 0 010 .708l-2 2a.5.5 0 11-.708-.708L8.293 8.5H5.5zm6.354-1.146a.5.5 0 010 .708L10.707 9.207H13.5a.5.5 0 010 1h-2.793l1.147 1.147a.5.5 0 11-.708.708l-2-2a.5.5 0 010-.708l2-2a.5.5 0 01.708 0z" clip-rule="evenodd" />
                        </svg>
                    </a>
                    <span class="issue-type-chevron">@(_targetsCollapsed ? "▼" : "▲")</span>
                </div>
            </div>
            <div class="expand-wrapper @(!_targetsCollapsed ? "expanded" : "")">
                <div class="expand-content">
            <div class="card-body">
                <p class="section-description">
                    Default WAN targets and one fabric target per discovered device. The agent probes
                    each target at its own interval and writes results to the <code>latency</code>
                    measurement in InfluxDB.
                </p>
                @if (_targets.Count == 0)
                {
                    <div class="empty-state">
                        <p>No targets yet. They'll appear once the agent's first cycle completes.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Target</th>
                                <th>Address</th>
                                <th>Interval</th>
                                <th>Latest</th>
                                <th>Last verified</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _targets.OrderBy(t => t.TargetType).ThenBy(t => t.Name))
                            {
                                var latest = LiveStats.GetTargetStats(t.TargetId);
                                <tr style="@(t.Enabled ? "" : "opacity: 0.55;")">
                                    <td>
                                        <span class="status-badge @TargetTypeBadgeClass(t.TargetType)">
                                            @t.TargetType.ToDisplayName()
                                        </span>
                                    </td>
                                    <td>@t.Name</td>
                                    <td><code>@t.Address</code></td>
                                    <td>@t.PollIntervalSeconds s</td>
                                    <td>
                                        @if (!t.Enabled)
                                        {
                                            <span class="text-muted">paused</span>
                                        }
                                        else if (latest != null)
                                        {
                                            @if (latest.Success && latest.RttAvgMs.HasValue)
                                            {
                                                <span>@($"{latest.RttAvgMs.Value:0.#} ms")</span>
                                                @if (latest.LossPercent > 0)
                                                {
                                                    <span style="color: var(--danger-color); margin-left: 0.5rem;">
                                                        @($"{latest.LossPercent:0.#}% loss")
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: var(--danger-color);">no response</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (t.LastVerified.HasValue)
                                        { <span>@RelativeTime(t.LastVerified.Value)</span> }
                                        else
                                        { <span class="text-muted">never</span> }
                                    </td>
                                    <td style="white-space: nowrap;">
                                        <button class="btn btn-sm btn-secondary"
                                                @onclick="() => ToggleTargetAsync(t.Id)"
                                                title="@(t.Enabled ? "Pause probing" : "Resume probing")">
                                            @(t.Enabled ? "Pause" : "Resume")
                                        </button>
                                        <button class="btn btn-sm btn-danger"
                                                @onclick="() => DeleteTargetAsync(t.Id)"
                                                title="Remove this target"
                                                style="margin-left: 0.25rem;">
                                            Remove
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    <p class="page-description" style="margin-top: 0.5rem;">
                        Removing a fabric or default WAN target will trigger it to be re-created
                        on the next agent cycle. Use <strong>Pause</strong> instead to stop
                        probing without losing the row's history.
                    </p>
                }
            </div>
                </div>
            </div>
        </div>
    }
}
else if (_snmpState == SnmpDetectionState.PollFailing)
{
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Monitoring Status</h2>
            <span class="status-badge status-error">SNMP Error</span>
        </div>
        <div class="card-body">
            <div class="alert alert-danger">
                <strong>SNMP polling is failing.</strong>
                @(_detectionError ?? "Check that SNMP is still enabled on your UniFi Console and that firewall rules permit UDP/161 from this server to your network devices.")
            </div>
            <div class="action-buttons" style="margin-top: 1rem;">
                <button class="btn btn-primary" @onclick="RunDetection" disabled="@_detecting">
                    @if (_detecting) { <span class="spinner-sm"></span> <span>Re-checking...</span> }
                    else { <span>Re-check SNMP</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private SnmpDetectionState _snmpState = SnmpDetectionState.NotChecked;
    private bool _detecting;
    private bool _showV3Recommendation = true;
    private string? _detectionError;

    private bool? _influxReachable;
    private string? _influxError;
    private bool _influxConfigured;
    private bool _checkingInflux;
    private DateTime? _lastInfluxTestAt;
    private System.Threading.Timer? _testFeedbackTimer;
    private bool _monitoringEnabled;
    private bool _togglingEnable;
    private List<MonitoringTarget> _targets = new();
    private List<MonitoredSfp> _monitoredSfps = new();
    private System.Threading.Timer? _refreshTimer;

    // Collapse state. Status auto-collapses when fully healthy (computed below);
    // targets default-collapsed so the 3D map can stay centerstage.
    private bool _statusCollapsed = false;
    private bool _targetsCollapsed = true;
    private bool _userToggledStatus = false; // once the user clicks, stop auto-collapsing

    // 3D map JS module handle. Mounted after first render (canvas must exist in DOM).
    private bool _mapMounted = false;

    protected override async Task OnInitializedAsync()
    {
        ConnectionService.OnConnectionChanged += OnConnectionChanged;

        var settings = await SnmpDetection.GetOrCreateSettingsAsync();
        _snmpState = settings.SnmpDetectionState;
        LoadInfluxStateFromSettings(settings);
        await LoadTargetsAsync();

        if (_monitoringEnabled && _influxConfigured)
        {
            await LoadLatencyChartsAsync();
            _latencyChartTimer = new System.Threading.Timer(async _ =>
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadLatencyChartsAsync();
                        StateHasChanged();
                    });
                }
                catch { }
            }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        }

        // Refresh the targets list periodically so LastVerified updates show movement
        // without requiring a full page reload.
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    await LoadTargetsAsync();
                    StateHasChanged();
                });
            }
            catch { /* prevent timer death */ }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));

        if (_snmpState == SnmpDetectionState.NotChecked && ConnectionService.IsConnected)
        {
            await RunDetection();
        }
        else if (_snmpState == SnmpDetectionState.NotChecked)
        {
            await ConnectionService.WaitForConnectionAsync();
            if (ConnectionService.IsConnected)
                await RunDetection();
        }
    }

    private void LoadInfluxStateFromSettings(MonitoringSettings settings)
    {
        _influxConfigured = !string.IsNullOrEmpty(settings.InfluxDbToken)
            && !string.IsNullOrEmpty(settings.InfluxDbUrl);
        _influxReachable = settings.InfluxDbReachable;
        _influxError = settings.LastInfluxDbError;
        _monitoringEnabled = settings.Enabled;
    }

    private async Task OnInfluxProvisioned()
    {
        // Wizard reports success - refresh the page state so the card flips from
        // "set up InfluxDB" to "configured + ready to enable" without a navigation.
        var settings = await SnmpDetection.GetOrCreateSettingsAsync();
        LoadInfluxStateFromSettings(settings);
        // Also check health since the runtime client was just reconfigured.
        var health = await InfluxClient.CheckHealthAsync();
        _influxReachable = health.Reachable;
        _influxError = health.Error;
        StateHasChanged();
    }

    private async Task SetMonitoringEnabled(bool enabled)
    {
        _togglingEnable = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var settings = await db.MonitoringSettings.FirstOrDefaultAsync()
                ?? new MonitoringSettings();
            if (settings.Id == 0) db.MonitoringSettings.Add(settings);
            settings.Enabled = enabled;
            settings.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
            _monitoringEnabled = enabled;
        }
        finally
        {
            _togglingEnable = false;
            StateHasChanged();
        }
    }

    private async Task CheckInfluxHealth()
    {
        _checkingInflux = true;
        StateHasChanged();
        try
        {
            await InfluxClient.ReconfigureAsync();
            var health = await InfluxClient.CheckHealthAsync();
            _influxReachable = health.Reachable;
            _influxError = health.Error;
            _lastInfluxTestAt = DateTime.UtcNow;
            // Hide the "Last tested: just now" indicator after a few seconds so it doesn't
            // become permanent visual noise.
            _testFeedbackTimer?.Dispose();
            _testFeedbackTimer = new System.Threading.Timer(_ =>
            {
                _lastInfluxTestAt = null;
                _ = InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromSeconds(5), Timeout.InfiniteTimeSpan);
        }
        finally
        {
            _checkingInflux = false;
            StateHasChanged();
        }
    }

    private async void OnConnectionChanged()
    {
        if (ConnectionService.IsConnected && _snmpState == SnmpDetectionState.NotChecked)
        {
            await InvokeAsync(async () =>
            {
                await RunDetection();
                StateHasChanged();
            });
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunDetection()
    {
        _detecting = true;
        _detectionError = null;
        StateHasChanged();

        var result = await SnmpDetection.DetectSnmpSettingsAsync();

        if (result.Success)
        {
            await SnmpDetection.SaveDetectionResultAsync(result);
            var settings = await SnmpDetection.GetOrCreateSettingsAsync();
            _snmpState = settings.SnmpDetectionState;
        }
        else
        {
            _detectionError = result.ErrorMessage;
            _snmpState = SnmpDetectionState.PollFailing;
        }

        _detecting = false;
        StateHasChanged();
    }

    /// <summary>
    /// The Monitoring Status badge reflects the holistic state of the subsystem, not
    /// just SNMP. "SNMP Ready" was confusing when everything was actually online and
    /// pumping data.
    /// </summary>
    private string OverallStateBadge()
    {
        // SNMP must be detected to do anything; if it isn't, surface that.
        if (_snmpState != SnmpDetectionState.EnabledV2c
            && _snmpState != SnmpDetectionState.EnabledV3Only
            && _snmpState != SnmpDetectionState.Working)
        {
            return _snmpState.ToString();
        }
        if (!_influxConfigured) return "InfluxDB not configured";
        if (_influxReachable == false) return "InfluxDB unreachable";
        if (!_monitoringEnabled) return "Ready (disabled)";
        return "Monitoring active";
    }

    private static string FormatSnmpState(SnmpDetectionState state) => state switch
    {
        SnmpDetectionState.EnabledV2c => "v2c",
        SnmpDetectionState.EnabledV3Only => "v3",
        SnmpDetectionState.Working => "Active",
        _ => state.ToString()
    };

    private async Task LoadTargetsAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _targets = await db.MonitoringTargets.AsNoTracking()
                .OrderBy(t => t.TargetType).ThenBy(t => t.Name).ToListAsync();
            _monitoredSfps = await db.MonitoredSfps.AsNoTracking()
                .Where(s => s.IsMonitoredOnt)
                .ToListAsync();

            // Auto-collapse the Monitoring Status card once everything is healthy. The
            // user is here to see live data, not the green checkmarks. Once they've
            // manually expanded or collapsed, respect their choice.
            if (!_userToggledStatus)
            {
                _statusCollapsed = _monitoringEnabled
                    && _influxReachable == true
                    && (_snmpState == SnmpDetectionState.EnabledV2c
                        || _snmpState == SnmpDetectionState.EnabledV3Only
                        || _snmpState == SnmpDetectionState.Working);
            }
        }
        catch
        {
            _targets = new List<MonitoringTarget>();
            _monitoredSfps = new List<MonitoredSfp>();
        }
    }

    private void ToggleStatus()
    {
        _statusCollapsed = !_statusCollapsed;
        _userToggledStatus = true;
        StateHasChanged();
    }

    private void ToggleTargetsCollapse()
    {
        _targetsCollapsed = !_targetsCollapsed;
        StateHasChanged();
    }

    private async Task ToggleTargetAsync(int targetId)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.MonitoringTargets.FindAsync(targetId);
            if (row == null) return;
            row.Enabled = !row.Enabled;
            await db.SaveChangesAsync();
            await LoadTargetsAsync();
            StateHasChanged();
        }
        catch { /* best effort */ }
    }

    private async Task DeleteTargetAsync(int targetId)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.MonitoringTargets.FindAsync(targetId);
            if (row == null) return;
            db.MonitoringTargets.Remove(row);
            await db.SaveChangesAsync();
            await LoadTargetsAsync();
            StateHasChanged();
        }
        catch { /* best effort */ }
    }

    private static string FormatOptical(double? value, string unit)
    {
        if (!value.HasValue) return "-";
        return $"{value.Value:0.##} {unit}";
    }

    // Single-mode SFP/PON optical receive should land roughly between -3 and -25 dBm.
    // Outside that range, the link is either over-driven (too strong, will cause errors)
    // or under-driven (failing). Color-code the cell so problems jump out.
    private static string RxClass(double? rxDbm)
    {
        if (!rxDbm.HasValue) return string.Empty;
        var v = rxDbm.Value;
        if (v >= -27 && v <= -3) return "";              // healthy range
        if (v >= -30 && v <= -1) return "signal-fair";
        return "signal-poor";
    }

    // Resolves a device MAC to its friendly UniFi device name via the fabric
    // monitoring targets (which carry both). Falls back to the MAC so the user
    // always sees *something*, never an empty cell.
    private string ResolveDeviceName(string deviceMac)
    {
        if (string.IsNullOrEmpty(deviceMac)) return deviceMac;
        var normalized = deviceMac.Replace("-", ":").ToLowerInvariant();
        var target = _targets.FirstOrDefault(t =>
            t.TargetType == MonitoringTargetType.Fabric
            && !string.IsNullOrEmpty(t.DeviceMac)
            && t.DeviceMac.Replace("-", ":").ToLowerInvariant() == normalized);
        return !string.IsNullOrEmpty(target?.Name) ? target.Name : deviceMac;
    }

    private static string PonVariantLabel(string? sfpPart, string? sfpVendor)
    {
        var s = $"{sfpPart} {sfpVendor}";
        if (s.Contains("XGS-PON", StringComparison.OrdinalIgnoreCase)
            || s.Contains("XGSPON", StringComparison.OrdinalIgnoreCase)) return "XGS-PON";
        if (s.Contains("XG-PON", StringComparison.OrdinalIgnoreCase)) return "XG-PON";
        if (s.Contains("GPON", StringComparison.OrdinalIgnoreCase)) return "GPON";
        if (s.Contains("EPON", StringComparison.OrdinalIgnoreCase)) return "EPON";
        if (s.Contains("NG-PON", StringComparison.OrdinalIgnoreCase)) return "NG-PON";
        return "PON";
    }

    private static string TargetTypeBadgeClass(MonitoringTargetType type) => type switch
    {
        MonitoringTargetType.Fabric => "status-connected",
        MonitoringTargetType.Wan => "status-active",
        MonitoringTargetType.AccessIsp => "status-active",
        MonitoringTargetType.Transit => "status-active",
        MonitoringTargetType.InternetService => "status-active",
        _ => "status-disconnected"
    };

    private static string RelativeTime(DateTime when)
    {
        var delta = DateTime.UtcNow - when.ToUniversalTime();
        if (delta < TimeSpan.Zero) return "just now";
        if (delta < TimeSpan.FromSeconds(15)) return "just now";
        if (delta < TimeSpan.FromMinutes(1)) return $"{(int)delta.TotalSeconds}s ago";
        if (delta < TimeSpan.FromHours(1)) return $"{(int)delta.TotalMinutes}m ago";
        if (delta < TimeSpan.FromDays(1)) return $"{(int)delta.TotalHours}h ago";
        return $"{(int)delta.TotalDays}d ago";
    }

    // --- Latency charts ---
    private static readonly string[] LatencyPalette = { "#2ba89a", "#3b82f6", "#a78bfa", "#ef5858", "#f59e0b", "#10b981" };

    private record LatencyCategoryDef(MonitoringTargetType Type, string Label);
    private static readonly LatencyCategoryDef[] _latencyCategories =
    {
        new(MonitoringTargetType.Fabric, "LAN"),
        new(MonitoringTargetType.AccessIsp, "ISP"),
        new(MonitoringTargetType.Transit, "Transit"),
        new(MonitoringTargetType.InternetService, "Internet")
    };

    private record TimeRangeDef(int Hours, string Label);
    private static readonly TimeRangeDef[] _latencyTimeRanges =
    {
        new(0, "15m"), new(1, "1h"), new(6, "6h"), new(24, "24h"), new(168, "7d"), new(720, "30d")
    };

    private MonitoringTargetType _latencyCategory = MonitoringTargetType.Fabric;
    private int _latencyRangeHours = 1;
    private bool _latencyLoading;
    private List<LatencySeriesInfo> _latencyRttSeries = new();
    private List<LatencySeriesInfo> _latencyLossSeries = new();
    private Dictionary<string, bool> _latencyVisibility = new();
    private List<LatencyChartPoint> _emptyLatencyPoints = new();
    private ApexChart<LatencyChartPoint>? _rttChart;
    private ApexChart<LatencyChartPoint>? _lossChart;
    private ApexChartOptions<LatencyChartPoint> _rttChartOptions = BuildRttChartOptions();
    private ApexChartOptions<LatencyChartPoint> _lossChartOptions = BuildLossChartOptions();
    private System.Threading.Timer? _latencyChartTimer;
    private bool _latencyChartsInitialized;
    private int _latencyChartKey;

    public class LatencyChartPoint
    {
        public DateTime Time { get; set; }
        public double? Value { get; set; }
        public long X => Time.Ticks;
    }

    public class LatencySeriesInfo
    {
        public required string TargetId { get; init; }
        public required string Name { get; init; }
        public required string Color { get; init; }
        public List<LatencyChartPoint> Points { get; set; } = new();
    }

    private List<MonitoringTarget> GetCategoryTargets() =>
        _targets.Where(t => t.TargetType == _latencyCategory && t.Enabled).OrderBy(t => t.Name).ToList();

    private string GetTargetColor(string targetId)
    {
        var targets = GetCategoryTargets();
        var idx = targets.FindIndex(t => t.TargetId == targetId);
        return idx >= 0 ? LatencyPalette[idx % LatencyPalette.Length] : LatencyPalette[0];
    }

    private bool IsTargetVisible(string targetId) =>
        !_latencyVisibility.TryGetValue(targetId, out var v) || v;

    private void ToggleTargetVisibility(string targetId)
    {
        var targets = GetCategoryTargets();
        var allVisible = targets.All(t => IsTargetVisible(t.TargetId));
        var onlyThisVisible = _latencyVisibility.TryGetValue(targetId, out var vis) && vis
            && targets.Where(t => t.TargetId != targetId).All(t => !IsTargetVisible(t.TargetId));

        if (onlyThisVisible)
        {
            _latencyVisibility.Clear();
        }
        else if (allVisible)
        {
            foreach (var t in targets)
                _latencyVisibility[t.TargetId] = t.TargetId == targetId;
        }
        else
        {
            _latencyVisibility[targetId] = !IsTargetVisible(targetId);
        }

        _latencyChartKey++;
    }

    private string EmptyStateMessage() => _latencyCategory switch
    {
        MonitoringTargetType.Fabric => "No LAN fabric targets yet. They appear once the agent discovers your network devices.",
        MonitoringTargetType.AccessIsp => "No ISP targets configured. Run upstream path discovery below to identify your access ISP hops.",
        MonitoringTargetType.Transit => "No transit targets configured. Run upstream path discovery below to identify intermediate networks.",
        MonitoringTargetType.InternetService => "No internet service targets yet. They appear once monitoring starts (Cloudflare, Google) or after upstream path discovery.",
        _ => "No targets in this category."
    };

    private async Task SelectLatencyCategoryAsync(MonitoringTargetType type)
    {
        _latencyCategory = type;
        _latencyVisibility.Clear();
        await LoadLatencyChartsAsync();
    }

    private async Task SelectLatencyRangeAsync(int hours)
    {
        _latencyRangeHours = hours;
        await LoadLatencyChartsAsync();
    }

    private async Task LoadLatencyChartsAsync()
    {
        var targets = GetCategoryTargets();
        if (targets.Count == 0)
        {
            _latencyRttSeries = new();
            _latencyLossSeries = new();
            return;
        }

        _latencyLoading = true;
        try
        {
            var now = DateTime.UtcNow;
            var from = _latencyRangeHours == 0 ? now.AddMinutes(-15) : now.AddHours(-_latencyRangeHours);
            var ids = targets.Select(t => t.TargetId);
            var data = await InfluxClient.QueryLatencyMultiTargetAsync(ids, from, now);

            var rttSeries = new List<LatencySeriesInfo>();
            var lossSeries = new List<LatencySeriesInfo>();

            for (int i = 0; i < targets.Count; i++)
            {
                var t = targets[i];
                var color = LatencyPalette[i % LatencyPalette.Length];
                data.TryGetValue(t.TargetId, out var points);
                var pts = points ?? new List<MonitoringInfluxClient.LatencyPoint>();

                rttSeries.Add(new LatencySeriesInfo
                {
                    TargetId = t.TargetId,
                    Name = t.Name,
                    Color = color,
                    Points = pts.Select(p => new LatencyChartPoint
                    {
                        Time = DateTime.SpecifyKind(p.Time, DateTimeKind.Utc),
                        Value = p.RttAvgMs
                    }).ToList()
                });

                lossSeries.Add(new LatencySeriesInfo
                {
                    TargetId = t.TargetId,
                    Name = t.Name,
                    Color = color,
                    Points = pts.Select(p => new LatencyChartPoint
                    {
                        Time = DateTime.SpecifyKind(p.Time, DateTimeKind.Utc),
                        Value = p.LossPercent
                    }).ToList()
                });
            }

            _latencyRttSeries = rttSeries;
            _latencyLossSeries = lossSeries;
        }
        catch { }
        finally { _latencyLoading = false; }

        _latencyChartKey++;
    }

