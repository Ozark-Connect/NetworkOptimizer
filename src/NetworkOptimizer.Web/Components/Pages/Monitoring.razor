    /// The ISP Health tile opens the ISP Health tab once the feature is set up, but
    /// while it is still pre-setup (Upstream Discovery hasn't run, so there are no
    /// ISP/transit targets yet) it sends the user straight to the Network Performance
    /// tab's Upstream Discovery section - where setup actually happens - rather than
    /// the ISP Health tab, which would only tell them to go run discovery.
    /// </summary>
    private void NavigateFromIspHealthTile(IspHealthStatus status)
    {
        if (status is IspHealthStatus.NotConfigured or IspHealthStatus.NeedsDiscovery)
        {
            // Discovery traces a secondary WAN THROUGH its context, so a WAN without one cannot be
            // discovered however many times it is run - the context is the step that actually
            // comes first, and that is where the tile has to point.
            if (LiveWan.Selected is { IsPrimary: false, HasContext: false })
                NavigationManager.NavigateTo("/monitoring?tab=performance&contexts=1");
            else
                NavigateToUpstreamDiscovery();
        }
        else
            NavigationManager.NavigateTo($"/monitoring?tab=isp-health{IspHealthWanQuery()}");
    }

