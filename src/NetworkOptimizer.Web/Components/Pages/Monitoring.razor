    private (double? rtt, double loss) GetGatewayLatency()
    {
        if (_historicSnapshot != null)
            return (_historicSnapshot.GatewayRttMs, _historicSnapshot.GatewayLossPercent);
        var targetId = GetGatewayFabricTargetId();
        if (targetId == null) return (null, 0);
        var s = LiveStats.GetTargetStats(targetId);
        return (s?.RttAvgMs, s?.LossPercent ?? 0);
    }

    private (double? rtt, double loss) GetBestTargetStats(MonitoringTargetType type)
    {
        if (_historicSnapshot != null)
        {
            return type switch
            {
                MonitoringTargetType.AccessIsp => (_historicSnapshot.IspRttMs, _historicSnapshot.IspLossPercent),
                _ => (null, 0)
            };
        }
        var targets = _targets.Where(t => t.TargetType == type && t.Enabled).ToList();
        if (targets.Count == 0) return (null, 0);

        // Pick the target with the lowest RTT (nearest ISP infrastructure).
        double? bestRtt = null;
        double bestLoss = 0;
        var freshLosses = new List<double>();
        var freshAfter = DateTime.UtcNow - Services.MonitoringLiveStats.LiveReadingMaxAge;
        foreach (var t in targets)
        {
            var s = LiveStats.GetTargetStats(t.TargetId);
            // Current readings only - a target that stopped reporting must not keep presenting
            // the reading it carried before it went quiet.
            if (s == null || s.LastUpdate < freshAfter) continue;
            freshLosses.Add(s.LossPercent);
            if (s.RttAvgMs != null && (bestRtt == null || s.RttAvgMs.Value < bestRtt.Value))
            {
                bestRtt = s.RttAvgMs;
                bestLoss = s.LossPercent;
            }
        }
        // Nothing answered, so there is no nearest hop to read loss off; the mean of what did
        // report is the honest figure, and 0% would read as a healthy connection mid-outage.
        return (bestRtt, bestRtt == null ? (freshLosses.Count > 0 ? freshLosses.Average() : 0) : bestLoss);
    }


    /// <summary>
    /// One WAN's share of a target type. Targets carry the WAN their data describes, and an
    /// unstamped target is a primary-path measurement - the same rule every per-WAN reader uses,
    /// so the tiles cannot disagree with the reports about which WAN a number belongs to.
    /// </summary>
    private List<MonitoringTarget> TargetsForWan(MonitoringTargetType type, string wanKey, bool isPrimary) =>
        _targets.Where(t => t.TargetType == type && t.Enabled)
            .Where(t => NetworkOptimizer.Storage.Models.MonitoringTarget.IsUnpinned(t.WanInterface)
                ? isPrimary
                : string.Equals(
                    NetworkOptimizer.UniFi.GatewayWanHelper.WanInterfaceKeyFromKey(t.WanInterface!),
                    NetworkOptimizer.UniFi.GatewayWanHelper.WanInterfaceKeyFromKey(wanKey),
                    StringComparison.OrdinalIgnoreCase))
            .ToList();

    /// <summary>
    /// Live RTT and loss per selected WAN, for stacking in one tile. Deliberately NOT averaged
    /// across WANs: a healthy fiber and a failing LTE link average to "fine", which is the reading
    /// the operator most needs not to be given. A WAN with no live samples yet is listed with no
    /// value rather than dropped, so the stack always says which WANs are on screen.
    /// </summary>

    /// <summary>
    /// The selected WAN's own ISP/Transit live figures. The site-wide helpers below answer for
    /// every target regardless of WAN, so selecting a secondary WAN used to show the primary's
    /// latency beside that WAN's throughput - a number that belongs to another connection,
    /// presented as this one's. A WAN with no targets of its own reads as no data.
    /// </summary>
    private (double? rtt, double loss) ScopedTargetStats(MonitoringTargetType type, bool meanAcrossTargets)
    {
        // Playback answers from the snapshot, which is already scoped to the WAN in focus
        // (BuildSnapshotWanScope). The per-WAN path below reads live stats only, so during
        // playback it showed the live figures instead of the playhead's.
        if (_historicSnapshot != null)
        {
            return type switch
            {
                MonitoringTargetType.AccessIsp => (_historicSnapshot.IspRttMs, _historicSnapshot.IspLossPercent),
                MonitoringTargetType.Transit => (_historicSnapshot.TransitRttMs, _historicSnapshot.TransitLossPercent),
                _ => (null, 0)
            };
        }
        var wan = LiveWan.Selected;
        if (wan == null) return meanAcrossTargets ? GetMeanTargetStats(type) : GetBestTargetStats(type);

        var rows = PerWanTargetStats(type, meanAcrossTargets);
        var row = rows.FirstOrDefault(r => string.Equals(
            r.Label,
            NetworkOptimizer.UniFi.GatewayWanHelper.SplitWanLabel(
                wan.Label, NetworkOptimizer.UniFi.GatewayWanHelper.WanIndexFromKey(wan.Key)).WanToken ?? wan.Label,
            StringComparison.OrdinalIgnoreCase));
        return (row.Rtt, row.Loss);
    }

    /// <summary>The WAN's short token for a stacked row, falling back to its full label.</summary>
    private static string WanRowLabel(Services.Monitoring.LiveWanScope.Option wan) =>
        NetworkOptimizer.UniFi.GatewayWanHelper.SplitWanLabel(
            wan.Label, NetworkOptimizer.UniFi.GatewayWanHelper.WanIndexFromKey(wan.Key)).WanToken ?? wan.Label;

    private List<(string Label, double? Rtt, double Loss)> PerWanTargetStats(MonitoringTargetType type, bool meanAcrossTargets)
    {
        var rows = new List<(string, double?, double)>();
        foreach (var wan in LiveWan.SelectedOptions)
        {
            // Playback: this WAN's own figures at the playhead. Without them the stack showed live
            // values while the chart beside it showed history.
            if (_historicSnapshot is not null
                && _historicSnapshot.PerWan.TryGetValue(wan.Key, out var historic))
            {
                rows.Add((WanRowLabel(wan),
                    type == MonitoringTargetType.AccessIsp ? historic.IspRttMs : historic.TransitRttMs,
                    type == MonitoringTargetType.AccessIsp ? historic.IspLossPercent : historic.TransitLossPercent));
                continue;
            }
            var targets = TargetsForWan(type, wan.Key, wan.IsPrimary);
            double? rtt = null;
            double loss = 0;
            if (targets.Count > 0)
            {
                var rtts = new List<double>();
                var losses = new List<double>();
                double? best = null;
                double bestLoss = 0;
                var freshAfter = DateTime.UtcNow - Services.MonitoringLiveStats.LiveReadingMaxAge;
                foreach (var t in targets)
                {
                    var st = LiveStats.GetTargetStats(t.TargetId);
                    // A reading only counts while it is current: a target that stops reporting
                    // otherwise keeps presenting the reading it carried before it went quiet.
                    if (st == null || st.LastUpdate < freshAfter) continue;
                    losses.Add(st.LossPercent);
                    if (st.RttAvgMs == null) continue;
                    rtts.Add(st.RttAvgMs.Value);
                    if (best == null || st.RttAvgMs.Value < best.Value)
                    {
                        best = st.RttAvgMs;
                        bestLoss = st.LossPercent;
                    }
                }
                // Transit reads as the mean of its hops; the access ISP reads as its nearest clean
                // hop. Same choice the single-WAN tiles have always made, kept per WAN.
                rtt = meanAcrossTargets ? (rtts.Count > 0 ? rtts.Average() : null) : best;
                // With no hop answering there is no nearest hop to read loss off, and taking it
                // from one anyway left the tile reporting that hop's last loss - 0% - through an
                // outage where every hop was dark. Fall back to the mean of what did report.
                loss = meanAcrossTargets || best == null
                    ? (losses.Count > 0 ? losses.Average() : 0)
                    : bestLoss;
            }
            rows.Add((WanRowLabel(wan), rtt, loss));
        }
        return rows;
    }

    private (double? rtt, double loss) GetMeanTargetStats(MonitoringTargetType type)
    {
        if (_historicSnapshot != null)
        {
            return type switch
            {
                MonitoringTargetType.Transit => (_historicSnapshot.TransitRttMs, _historicSnapshot.TransitLossPercent),
                _ => (null, 0)
            };
        }
        var targets = _targets.Where(t => t.TargetType == type && t.Enabled).ToList();
        if (targets.Count == 0) return (null, 0);

        var rtts = new List<double>();
        var losses = new List<double>();
        foreach (var t in targets)
        {
            var s = LiveStats.GetTargetStats(t.TargetId);
            if (s?.RttAvgMs != null) rtts.Add(s.RttAvgMs.Value);
            if (s != null) losses.Add(s.LossPercent);
        }
        return (rtts.Count > 0 ? rtts.Average() : null, losses.Count > 0 ? losses.Average() : 0);
    }

    private (double ingress, double egress) GetTotalFabricLoad()
    {
        if (_historicSnapshot != null)
            return (_historicSnapshot.FabricIngressBps, _historicSnapshot.FabricEgressBps);
        var total = LiveStats.GetTotalFabricLoad();
        return (total.IngressBps, total.EgressBps);
    }

    private static string FormatRate(double? bps)
    {
        if (!bps.HasValue || bps.Value < 1) return "-";
        var v = bps.Value;
        if (v >= 1_000_000_000) return $"{v / 1_000_000_000:0.#} Gbps";
        if (v >= 1_000_000) return $"{v / 1_000_000:0.#} Mbps";
        if (v >= 1_000) return $"{v / 1_000:0.#} Kbps";
        return $"{v:0} bps";
    }

    /// <summary>
    /// Splits a formatted rate into its numeric value and unit so the unit can be styled separately.
    /// </summary>
    private static (string Value, string? Unit) FormatRateParts(double? bps)
    {
        var text = FormatRate(bps);
        var space = text.IndexOf(' ');
        return space < 0 ? (text, null) : (text[..space], text[(space + 1)..]);
    }

    private static string FormatRtt(double? ms) => NetworkOptimizer.Web.Services.Monitoring.MonitoringStatFormat.Rtt(ms);

    private static string FormatLoss(double percent) => NetworkOptimizer.Web.Services.Monitoring.MonitoringStatFormat.Loss(percent);

    private static string FormatPercent(double? val)
    {
        if (!val.HasValue) return "-";
        return $"{val.Value:0.#}%";
    }

    private static string FormatTemp(double? val)
    {
        if (!val.HasValue) return "-";
        return $"{val.Value:0.#} °C";
    }

    // ─── SFP chart remount ───

    private System.Threading.Timer? _sfpChartDebounce;

    private void DebounceSfpChartRemount()
    {
        _sfpChartDebounce?.Dispose();
        _sfpChartDebounce = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    if (_sfpChartsMounted)
                    {
                        try { await JS.InvokeVoidAsync("eval", "window.__sfpCharts?.unmount();"); }
                        catch { }
                        _sfpChartsMounted = false;
                    }
                    StateHasChanged();
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(2), Timeout.InfiniteTimeSpan);
    }

    // ─── Investigation ───

    private async Task ToggleInvestigateCollapse()
    {
        _investigateCollapsed = !_investigateCollapsed;
        // A manual toggle is a real preference: update the saved baseline too, so leaving the
        // tab (which reverts to the baseline) keeps the user's choice rather than undoing it.
        _investigateSavedCollapsed = _investigateCollapsed;
        try { await JS.InvokeVoidAsync("localStorage.setItem", InvestigateCollapseKey, _investigateCollapsed ? "true" : "false"); }
        catch { }
    }

    private Task InvestigatePacketLoss() => NavigateToLossEvent(null, null, loadedOnly: false);

    /// <summary>
    /// Loaded loss is a WAN's own signal - graded against that WAN's plan speeds and read off its
    /// counters - so the LAN scope has nothing to answer with, and any event found would land on a
    /// chart holding none of its targets. Move to the first WAN, then investigate.
    /// </summary>
    private async Task InvestigateLoadedLoss()
    {
        var firstWan = _wanOptions.FirstOrDefault()?.Key;
        if (_lanScope && firstWan != null)
        {
            // Claim the spinner before the scope round-trip, so the button is disabled for the
            // whole action rather than only the query at the end of it.
            _investigatingLoss = true;
            _lossNavLoadedOnly = true;
            StateHasChanged();
            _lanScope = false;
            _allScope = false;
            _selectedWanKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { firstWan };
            // Released here rather than left to the investigation's own finally: a scope change
            // that threw would strand both buttons disabled for the life of the circuit. The
            // investigation re-claims it before its first await, so nothing renders in between.
            try { await ApplyWanSelectionAsync(persist: true); }
            finally { _investigatingLoss = false; }
        }
        await NavigateToLossEvent(null, null, loadedOnly: true);
    }
    // Step to the previous/next distinct event by querying strictly outside the current
    // event's bounds, so a multi-minute burst is one stop rather than one stop per minute.
    // The 1-minute aggregateWindow buckets are stamped at their STOP edge, so the bucket at
    // EventStart holds data from the minute before it; an exclusive range stop at EventStart
    // would still return that bucket. Step back a full minute so the current event's first
    // bucket is actually excluded (the coalesce gap guarantees the previous event is >= 2 min
    // earlier, so it is never dropped). Forward needs no such fudge: the current event's data
    // all precedes the EventEnd stamp, so an inclusive start just past EventEnd excludes it.
    private Task LossNavBack() => _lossNavEventStart.HasValue
        ? NavigateToLossEvent(_lossNavEventStart.Value.AddMinutes(-1), null, _lossNavLoadedOnly) : Task.CompletedTask;
    private Task LossNavForward() => _lossNavEventEnd.HasValue
        ? NavigateToLossEvent(null, _lossNavEventEnd.Value.AddSeconds(1), _lossNavLoadedOnly) : Task.CompletedTask;

    // Clear the loss-investigation state (no chart call). Used both by the Exit button and
    // when leaving the performance tab, so the card never shows "active" without a live chart.
    private void ResetLossNavState()
    {
        _lossNavActive = false;
        _lossNavTimestamp = null;
        _lossNavEventStart = null;
        _lossNavEventEnd = null;
        _lossInvestigateResult = null;
        _lossNavLoadedOnly = false;
    }

    private async Task LossNavDeactivate()
    {
        ResetLossNavState();
        StateHasChanged();
        await JS.InvokeVoidAsync("eval", "window.__latencyCharts?.restoreState();");
    }

    private async Task NavigateToLossEvent(DateTime? before, DateTime? after, bool loadedOnly, bool resetIfNotFound = false)
    {
        _investigatingLoss = true;
        // Set before the await so only the clicked button shows its spinner
        _lossNavLoadedOnly = loadedOnly;
        StateHasChanged();
        try
        {
            // Under the multi-WAN gate the investigation follows the chart's focused WAN: only
            // that WAN's targets, and - for loaded events - that WAN's own plan speeds and
            // counter interface, so "loaded" means loaded on the link whose loss is on screen.
            // Gate closed: exactly the pre-multi-WAN behavior (all enabled targets, primary
            // instance, page-resolved counters).
            var wanScoped = _multiWanUiVisible && _wanOptions.Count > 1;
            var ispHealth = wanScoped && FocusedWanKeyOrNull != null
                ? IspHealthRegistry.GetFor(SiteCtx.Slug, FocusedWanKeyOrNull)
                : IspHealthService;
            var enabledIds = _targets
                .Where(t => t.Enabled && (!wanScoped
                    || t.TargetType == MonitoringTargetType.Fabric
                    || string.Equals(TargetWanKey(t), FocusedWanKey, StringComparison.OrdinalIgnoreCase)))
                .Select(t => t.TargetId).ToList();
            MonitoringInfluxClient.RecentLossEvent? result;
            if (loadedOnly)
            {
                var (downMbps, upMbps) = await ispHealth.GetExpectedWanSpeedsAsync();
                var (lossGwMac, lossIfNames) = wanScoped
                    ? await ispHealth.GetWanCounterInterfacesAsync()
                    : (_gatewayMac, _gatewayWanIfNames);
                if (lossGwMac == null || lossIfNames.Count == 0 || (downMbps is not > 0 && upMbps is not > 0))
                {
                    _lossInvestigateResult = "Set your ISP speeds in UniFi Network to find loaded loss events.";
                    return;
                }
                var fraction = ispHealth.Options.LoadedThresholdFraction;
                // Direction without a configured speed gets an unreachable threshold
                var downThreshold = downMbps is > 0 ? downMbps.Value * 1_000_000 * fraction : double.MaxValue;
                var upThreshold = upMbps is > 0 ? upMbps.Value * 1_000_000 * fraction : double.MaxValue;
                result = await InfluxClient.FindRecentLoadedLossEventAsync(
                    lossGwMac, lossIfNames, downThreshold, upThreshold, before, after, enabledIds);
            }
            else
            {
                result = await InfluxClient.FindRecentLossEventAsync(before, after, enabledIds);
            }
            if (result == null)
            {
                // A re-scope that finds nothing has to let go of the event it was showing - it
                // belonged to the WAN that just left the view. Stepping is different: "no newer
                // events" means stay where you are.
                if (resetIfNotFound)
                {
                    ResetLossNavState();
                    _lossInvestigateResult = "No loss events on this WAN";
                    await JS.InvokeVoidAsync("eval", "window.__latencyCharts?.restoreState();");
                    return;
                }
                // Older/newer only answer a step. A first search that finds nothing has no event to
                // be on either side of, so it reports the empty window it actually searched.
                _lossInvestigateResult =
                    after.HasValue ? "No newer events"
                    : before.HasValue ? "No older events"
                    : loadedOnly ? "No loaded loss events in the last 30 days"
                    : "No packet loss events in the last 30 days";
                return;
            }
            var category = result.TargetType switch
            {
                "accessisp" => "AccessIsp",
                "transit" => "Transit",
                _ => "InternetService"
            };
            _lossNavActive = true;
            _lossNavTimestamp = result.Timestamp;
            _lossNavEventStart = result.EventStart;
            _lossNavEventEnd = result.EventEnd;
            var delta = DateTime.UtcNow - result.Timestamp;
            var ago = delta.TotalMinutes < 60 ? $"{(int)delta.TotalMinutes}m ago"
                : delta.TotalHours < 24 ? $"{(int)delta.TotalHours}h ago"
                : $"{(int)delta.TotalDays}d ago";
            var localTime = result.Timestamp.ToLocalTime().ToString("M/d h:mm tt");
            // The event is found on its single worst target's peak minute, but the highlight should
            // read the loss the score is actually graded on: the pooled per-sample mean across the
            // exact ISP Health loss pool (access + transit excl. non-transit infra + anycast DNS) over
            // the event window. The band's start is backed up one bucket, so pool over the same widened
            // window. Fall back to the peak target's value if the pooled query returns nothing.
            var poolIds = await ispHealth.GetLossPoolTargetIdsAsync();
            var pooledLoss = await InfluxClient.QueryMeanLossAcrossTargetsAsync(
                poolIds, result.EventStart.AddMinutes(-1), result.EventEnd)
                ?? result.LossPercent;
            _lossInvestigateResult = $"{pooledLoss:0.#}% loss {ago} ({localTime})";
            StateHasChanged();
            var annotationLabel = $"{(loadedOnly ? "Loaded" : "Packet")} loss {pooledLoss:0.#}%";
            await JS.InvokeVoidAsync("eval",
                $"window.__latencyCharts?.navigateToTime('{result.Timestamp:o}', '{category}', '{annotationLabel}', {(loadedOnly ? "true" : "false")}, '{result.EventStart:o}', '{result.EventEnd:o}');");
        }
        catch (Exception ex)
        {
            _lossInvestigateResult = $"Query failed: {ex.Message}";
        }
        finally
        {
            _investigatingLoss = false;
            StateHasChanged();
        }
    }

    private async Task InvestigateSfpAnomaly()
    {
        _investigatingSfp = true;
        _sfpInvestigateResult = null;
        StateHasChanged();
        try
        {
            var result = await InfluxClient.FindRecentSfpAnomalyAsync();
            if (result == null)
            {
                _sfpInvestigateResult = "No SFP anomalies in the last 7 days.";
                return;
            }
            var desc = result.Metric == "temperature"
                ? $"temperature {result.Value:0.#} °C"
                : $"RX power {result.Value:0.##} dBm";
            var delta = DateTime.UtcNow - result.Timestamp;
            var ago = delta.TotalMinutes < 60 ? $"{(int)delta.TotalMinutes}m ago"
                : delta.TotalHours < 24 ? $"{(int)delta.TotalHours}h ago"
                : $"{(int)delta.TotalDays}d ago";
            var localTime = result.Timestamp.ToLocalTime().ToString("M/d h:mm tt");
            _sfpInvestigateResult = $"SFP {desc} {ago} ({localTime})";
            StateHasChanged();
            await JS.InvokeVoidAsync("eval",
                $"window.__sfpCharts?.navigateToTime('{result.Timestamp:o}');");
        }
        catch (Exception ex)
        {
            _sfpInvestigateResult = $"Query failed: {ex.Message}";
        }
        finally
        {
            _investigatingSfp = false;
            StateHasChanged();
        }
    }

    // ─── Chart mount/unmount lifecycle (tab-aware) ───

    private string VersionedJs(string path) => FileVersionProvider.AddFileVersionToPath("", path);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Live WAN tile scope: separate per-site key, restored once interop is reachable. A link's
        // selection is released first when the URL no longer names a WAN, so the stored one is
        // read again rather than the jump's choice holding for the rest of the page's life.
        if (_multiWanUiVisible)
        {
            if (string.IsNullOrWhiteSpace(WanParam)) LiveWan.ReleaseLink();
            await LiveWan.RestoreAsync();
        }

        // A deep link naming a WAN (?wan=, from a speed test result or an ISP Health tile) solos
        // it, AFTER the restore above so it beats the stored selection rather than being
        // overwritten by it. Both tabs read this one selection, so both honor the link. Once only:
        // the link chooses where the user arrives, not where they have to stay. A single-WAN site
        // resolves nothing and keeps what it had.
        if (_multiWanUiVisible && LiveWan.HasChoice && _appliedLinkWanKey != LinkWanKey
            && (_activeTab == "live" || _activeTab == "isp-health")
            && !string.IsNullOrWhiteSpace(WanParam))
        {
            // Only recorded once it actually took: a pass that arrives before the WAN options
            // have loaded resolves nothing, and must be free to try again on the next one.
            // Deliberately NOT stripped from the address bar here. replaceState behind Blazor's
            // back desynchronizes the router's idea of the URL from the browser's: the parameter
            // stayed set while the release below saw it gone, the two fought over the selection,
            // and looping between the jump icons tripped the browser's navigation throttle until
            // the icons stopped working altogether. A reload re-applying the link is the smaller
            // problem, and the release below still gives the tab-away-and-back case.
            _applyingLinkWan = true;
            try
            {
                if (await LiveWan.SelectFromLinkAsync(WanParam)) _appliedLinkWanKey = LinkWanKey;
            }
            finally { _applyingLinkWan = false; }
        }

        // After render, so the tab and the WAN options have settled and the check reflects what
        // is actually on screen.
        await EnsureWanCompareHintAsync();
        // Pending jump from the ISP Health disable hint: once the Network Performance tab's Latency
        // targets card has mounted, expand + highlight the target, then clear so it fires once.
        if (_pendingLatencyJumpId is int jumpId && _latencyTargetsCard != null)
        {
            _pendingLatencyJumpId = null;
            await _latencyTargetsCard.ExpandAndHighlightAsync(jumpId);
        }

        // The chart containers only exist while the console is connected - the whole
        // tab region renders behind the connection banner. Without this guard, a page
        // opened during a console outage (agent-backed site waiting for its tunnel,
        // app restart) "mounts" its charts against a container that isn't in the DOM,
        // the mounted flag sticks, and when the console connects the fresh empty
        // containers never get their JS - blank charts until a tab switch happens to
        // reset the flags. Reset them here so the connected render remounts cleanly;
        // the same path also tears the modules down when the console drops mid-session
        // (Blazor destroyed their DOM with the region swap).
        //
        // Nothing swaps out on a disconnect any more: every tab, Live View included, stays rendered
        // so a site whose console is gone can still be read. The map and port stats are what replay
        // the timeline, so tearing them down here is exactly what would empty the tab this comment
        // used to justify emptying. Their live polling already returns early while disconnected.

        // Auto-expand the SNMP Devices table after the Live-tab banner jumps here.
        if (_pendingExpandSnmpCard && _activeTab == "setup" && _snmpDeviceCard != null)
        {
            _pendingExpandSnmpCard = false;
            _snmpDeviceCard.Expand();
            await ScrollToSnmpDevicesAsync();
        }

        // Auto-expand the Monitoring Interfaces card when deep-linked from a monitor
        // form's "set up a monitoring interface" link (mifip query param).
        if (_pendingExpandMiCard && _activeTab == "setup" && _miCard != null)
        {
            _pendingExpandMiCard = false;
            _miCard.Expand();
            await ScrollToMonitoringInterfacesAsync();
        }

        // Load the Investigate card's saved collapse state once the performance tab is shown.
        // Set the loaded flag before the await so this can't re-enter on later renders; the body
        // stays collapsed (default) until the preference resolves, so nothing flashes open.
        if (_activeTab == "performance" && _monitoringReady && !_investigateStateLoaded)
        {
            _investigateStateLoaded = true;
            string? val = null;
            try { val = await JS.InvokeAsync<string>("localStorage.getItem", InvestigateCollapseKey); }
            catch { }
            // Saved preference wins; with none, default to expanded so the controls are discoverable.
            _investigateSavedCollapsed = val == "true";

            // ...but never over a deep link. The flag above is set BEFORE this await, so a render
            // arriving while localStorage is still answering lets the deep-link block below run and
            // force the card open - and this line then put it straight back. That is why the first
            // link into a loss investigation often did nothing while later ones always worked: once
            // the key is warm the read returns before the next render and the race stops happening.
            // Checked both ways round because either block can reach its state first.
            if (_pendingInvestigateParam is null && !_investigateDeepLinkOpened)
                _investigateCollapsed = _investigateSavedCollapsed;

            StateHasChanged();
        }

        await TryRunPendingInvestigationAsync();

        // Mount/unmount charts based on active tab. Only mount when the container
        // div exists in the DOM (i.e., the tab is active). Unmount when switching away.

        // Flaky-target banner (#849): detect once, the first time Live View or ISP Health is shown
        // (both surface the banner). No polling.
        if ((_activeTab == "live" || _activeTab == "isp-health") && _monitoringReady && !_flakyChecked)
        {
            _flakyChecked = true;
            try
            {
                _flakyTargetCount = (await FlakyTargets.DetectAsync()).Count;
                if (_flakyTargetCount > 0) StateHasChanged();
            }
            catch (Exception ex) { Logger.LogDebug(ex, "Flaky-target banner check failed"); }
        }

        // 3D map - Live tab only
        if (_activeTab == "live" && _monitoringReady && !_mapMounted)
        {
            _mapMounted = true;
            try
            {
                _mapDotNetRef ??= DotNetObjectReference.Create(this);
                // Whatever the last navigation armed, consumed here so a remount later in the
                // same visit leaves a scrubbed position alone.
                long initialAtMs = _pendingAtMs ?? 0;
                _pendingAtMs = null;
                if (initialAtMs > 0) _linkedInstantMs = initialAtMs;
                // Per-mount values (storagePrefix, initialAt) MUST be arguments, never
                // interpolated into the function body: JS interop resolves the
                // identifier to a function reference once and keeps invoking that
                // original closure, so a re-eval'd definition with different baked-in
                // values is silently ignored on every mount after the first.
                await JS.InvokeVoidAsync("eval",
                    "window.__mountLanFlowMap = async function(canvasId, ref, storagePrefix, initialAt) {" +
                    "  window.__monitoringRef = ref;" +
                    $"  const m = await import('{VersionedJs("/js/lan-flow-map.js")}');" +
                    "  window.__lanFlowMap = m;" +
                    "  const opts = { storagePrefix: storagePrefix };" +
                    "  if (initialAt > 0) opts.initialAt = initialAt;" +
                    "  await m.mount(canvasId, opts);" +
                    "}");
                await JS.InvokeVoidAsync("__mountLanFlowMap", "lan-flow-map-canvas", _mapDotNetRef,
                    SiteCtx.ScopeStorageKey("lanFlowMap"), initialAtMs);
            }
            catch (Exception ex) { _mapMounted = false; Logger.LogDebug(ex, "3D map mount failed; will retry on next render"); }
        }
        else if (_activeTab != "live" && _mapMounted)
        {
            _mapMounted = false;
            _mapHistoricAt = null;
            _historicSnapshot = null;
            try { await JS.InvokeVoidAsync("eval", "window.__lanFlowMap?.unmount();"); }
            catch { }
        }

        // 2D hierarchy map - Live tab only
        if (_activeTab == "live" && _monitoringReady && !_map2dMounted)
        {
            _map2dMounted = true;
            try
            {
                await JS.InvokeVoidAsync("eval",
                    $"(async () => {{ const m = await import('{VersionedJs("/js/lan-flow-map-2d.js")}'); window.__lanFlowMap2d = m; await m.mount('lan-flow-map-2d-stage', {{ storagePrefix: '{SiteCtx.ScopeStorageKey("lanFlowMap2d")}' }}); }})();");
            }
            catch (Exception ex) { _map2dMounted = false; Logger.LogDebug(ex, "2D map mount failed; will retry on next render"); }
        }
        else if (_activeTab != "live" && _map2dMounted)
        {
            _map2dMounted = false;
            try { await JS.InvokeVoidAsync("eval", "window.__lanFlowMap2d?.unmount();"); }
            catch { }
        }

        // WAN live chart - Live tab only
        if (_activeTab == "live" && _monitoringReady && !_wanLiveChartMounted)
        {
            _wanLiveChartMounted = true;
            try
            {
                // The WAN scope rides in as an ARGUMENT rather than baked into the body, for the
                // same reason the map's initialAt does: interop resolves the identifier to a
                // function reference once and keeps invoking that closure, so a re-eval'd
                // definition carrying a different scope would be silently ignored.
                await JS.InvokeVoidAsync("eval",
                    "window.__mountWanLiveChart = async function(elId, wansJson) {" +
                    $"  const m = await import('{VersionedJs("/js/wan-live-chart.js")}');" +
                    "  window.__wanLiveChart = m;" +
                    "  await m.mount(elId, { seekOnClick: true, wans: JSON.parse(wansJson) });" +
                    "}");
                var scopeAtMount = LiveWanJsLiteral();
                // Fire-and-forget so a slow import cannot stall the rest of the pass. This pass can
                // run before the WAN list has resolved - _monitoringReady is settings-only, while
                // _multiWanUiVisible waits on a console call - so the chart could mount on the
                // primary while the selection restoring behind it lost the race against a mount
                // still in flight, leaving the pills reading multi-WAN over a single-WAN chart.
                //
                // Mounting again is what corrects it, NOT switching the mounted chart: only the
                // mount path loads the history window for a comparison, so a switch after the fact
                // left the chart tick-filling from empty instead of arriving backfilled.
                _ = InvokeAsync(async () =>
                {
                    // The settled-scope check below is the recovery path, so a first mount that
                    // faulted (transient interop failure, a render torn down mid-flight) must not
                    // take it down with it - unprotected, the fault silently killed this task and
                    // the chart stayed on the stale scope with no history load ever arriving.
                    var mountFaulted = false;
                    try { await JS.InvokeVoidAsync("__mountWanLiveChart", "monitoring-wan-live-chart", scopeAtMount); }
                    catch (Exception ex)
                    {
                        mountFaulted = true;
                        Logger.LogDebug(ex, "WAN live chart mount failed; retrying with the settled scope");
                    }
                    var settledScope = LiveWanJsLiteral();
                    if (!mountFaulted && settledScope == scopeAtMount) return;
