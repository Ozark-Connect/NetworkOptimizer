    // Reads the scheduled re-discovery review flag and the user's dismissal. When no review
    // is pending (user committed, flag cleared) we drop any stale dismissal so the next run's
    // results re-arm the banner.
    private async Task RefreshUpstreamReviewAsync()
    {
        try
        {
            await using var db = SiteDb.CreateForSite(SiteCtx.Slug, SiteCtx.IsDefault);
            var needsReview = await db.MonitoringSettings
                .Select(s => s.UpstreamDiscoveryNeedsReview)
                .FirstOrDefaultAsync();
            if (!needsReview)
            {
                if (_upstreamReviewDismissed)
                {
                    await SystemSettings.SetAsync(SystemSettingKeys.UpstreamDiscoveryResultsReadyDismissed, null);
                    _upstreamReviewDismissed = false;
                }
                _upstreamNeedsReview = false;
            }
            else
            {
                _upstreamReviewDismissed = string.Equals(
                    await SystemSettings.GetAsync(SystemSettingKeys.UpstreamDiscoveryResultsReadyDismissed),
                    "true", StringComparison.OrdinalIgnoreCase);
                _upstreamNeedsReview = true;
            }
        }
        catch
        {
            _upstreamNeedsReview = false;
        }
    }

    /// <summary>
    /// Whether this site meets multi-WAN at all. Contexts existing answers it on their own - they
    /// only get created on a multi-WAN site, and they are the only source of WAN-tagged data - so
    /// the WAN count is consulted only when there are none, and only once per page: this runs on
    /// the 15-second refresh, and a site does not grow a second WAN while the page is open.
    /// </summary>
    private async Task ResolveMultiWanVisibilityAsync()
    {
        if (_wanContexts.Count > 0)
        {
            _multiWanUiVisible = true;
            await ApplyPendingLinkWanAsync();
            return;
        }
        if (_wanCountChecked) return;
        _wanCountChecked = true;
        try { _multiWanUiVisible = (await PathView.GetWansAsync()).Count > 1; }
        catch { _multiWanUiVisible = false; }
        await ApplyPendingLinkWanAsync();
    }

