    private sealed record LatencyChartView(string AtIso, string Category);

    /// <summary>
    /// Plays back the moment Latency and Packet Loss is framing - the center of the window on
    /// screen, which is where someone puts the spike they are looking at. A LAN or Custom view
    /// spans every WAN and asks for all of them; ISP, Transit and Internet carry their WAN filter
    /// across. The Live tab's own saved filter is left where it was either way: the link applies
    /// for the visit only.
    /// </summary>
    private async Task JumpToLiveAsync()
    {
        try
        {
            var view = await JS.InvokeAsync<LatencyChartView>("__latencyCharts.currentView");
            var at = DateTime.Parse(view.AtIso, null, System.Globalization.DateTimeStyles.RoundtripKind);
            var atMs = new DateTimeOffset(at.ToUniversalTime()).ToUnixTimeMilliseconds();
            var spansEveryWan = view.Category == FabricCategory || view.Category == CustomCategory;
            var wan = spansEveryWan || AllWansSelected
                ? Services.Monitoring.LiveWanScope.AllWansToken
                : string.Join(",", _selectedWanKeys);
            var wanQuery = _multiWanUiVisible && wan.Length > 0 ? $"&wan={Uri.EscapeDataString(wan)}" : "";
            NavigationManager.NavigateTo($"/monitoring?tab=live&at={atMs}{wanQuery}");
        }
        catch (Exception ex) { Logger.LogDebug(ex, "Live view jump failed; latency charts not ready"); }
    }

    private string LiveWanJsLiteral()
    {
        var selected = LiveWan.SelectedOptions;
        if (selected.Count == 0 || (selected.Count == 1 && selected[0].IsPrimary)) return "null";
        var payload = selected.Select(w => new
        {
            key = w.Key,
            label = NetworkOptimizer.UniFi.GatewayWanHelper.SplitWanLabel(
                w.Label, NetworkOptimizer.UniFi.GatewayWanHelper.WanIndexFromKey(w.Key)).WanToken ?? w.Label,
        });
        return System.Text.Json.JsonSerializer.Serialize(payload);
    }

    /// <summary>
    /// Re-render the tiles and point the live chart at the newly selected WAN. The scope service
    /// holds the selection but cannot re-render or reach interop itself.
    /// </summary>

    /// <summary>
    /// The ISP Health score for the WAN the live tiles are showing. Each WAN grades itself, so the
    /// tile follows the selection rather than captioning the primary's number as someone else's.
    /// A WAN whose report has never been computed comes back as Computing and populates itself -
    /// GetCachedScore kicks the compute off - so the tile settles on its own without a fallback to
    /// another WAN's score, which is the one thing it must never show.
    /// </summary>

    /// <summary>
    /// The score tile's label. While comparing, the throughput beside it is several WANs added up
    /// but the score is one WAN's, so it names that WAN. A single selection needs no qualifier -
    /// the whole row is that WAN.
    /// </summary>
    private string IspHealthTileLabel()
    {
        if (!LiveWan.IsComparing || LiveWan.Selected is not { } wan) return "ISP Health";
        var token = NetworkOptimizer.UniFi.GatewayWanHelper.SplitWanLabel(
            wan.Label, NetworkOptimizer.UniFi.GatewayWanHelper.WanIndexFromKey(wan.Key)).WanToken;
        return string.IsNullOrEmpty(token) ? "ISP Health" : $"ISP Health ({token})";
    }

    private IspHealthSnapshot CurrentIspHealth()
    {
        var wan = LiveWan.Selected;
        if (wan is null || wan.IsPrimary) return IspHealthService.GetCachedScore();
        return IspHealthRegistry.GetFor(SiteCtx.Slug, wan.Key).GetCachedScore();
    }

