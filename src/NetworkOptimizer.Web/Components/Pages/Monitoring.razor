@page "/monitoring"
@rendermode InteractiveServer
@implements IDisposable
@using NetworkOptimizer.Web.Services
@using NetworkOptimizer.Storage.Models
@using Microsoft.EntityFrameworkCore
@inject SnmpDetectionService SnmpDetection
@inject UniFiConnectionService ConnectionService
@inject MonitoringInfluxClient InfluxClient
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<NetworkOptimizer.Storage.Models.NetworkOptimizerDbContext> DbFactory

<PageTitle>Monitoring - Network Optimizer</PageTitle>

<div class="page-header">
    <h1>Monitoring</h1>
    <p class="page-description">Real-time network monitoring with SNMP polling, latency tracking, and SFP diagnostics</p>
</div>

@if (!ConnectionService.IsConnected)
{
    <div class="connection-banner">
        <div class="banner-content">
            <span class="banner-icon">!</span>
            <div class="banner-text">
                @if (!string.IsNullOrEmpty(ConnectionService.LastError))
                {
                    <strong>Connection Error</strong>
                    <span>@ConnectionService.LastError</span>
                }
                else
                {
                    <strong>Not Connected</strong>
                    <span>Configure your UniFi Console connection in Settings to get started.</span>
                }
            </div>
            <a href="/settings" class="btn btn-primary btn-sm">Settings</a>
        </div>
    </div>
}
else if (_snmpState == SnmpDetectionState.NotChecked)
{
    <!-- Detection in progress or about to start -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">SNMP Configuration</h2>
        </div>
        <div class="card-body">
            <div class="empty-state">
                <span class="spinner"></span>
                <p>Detecting SNMP configuration from UniFi Console...</p>
            </div>
        </div>
    </div>
}
else if (_snmpState == SnmpDetectionState.Disabled)
{
    <!-- SNMP not enabled — setup guide -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">SNMP Setup Required</h2>
            <span class="status-badge status-disconnected">Disabled</span>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>SNMP is not enabled on your UniFi Console.</strong>
                Network Optimizer needs SNMP to collect port-level traffic statistics, device health metrics, and interface data from your switches and gateway.
            </div>

            <details class="setup-guide" open>
                <summary>How to Enable SNMP</summary>
                <div class="setup-guide-content">
                    <ol>
                        <li>Open UniFi Network</li>
                        <li>Search Settings for <strong>"SNMP Monitoring"</strong></li>
                        <li>Enable <strong>SNMP v1/v2c</strong> and set a unique community string</li>
                    </ol>
                    <p>Currently at: Settings → CyberSecure → Traffic Logging → SNMP Monitoring. This menu has moved between UniFi versions - the search term is the reliable way to find it.</p>

                    <h4>Recommended configuration</h4>
                    <p><strong>SNMP v1/v2c</strong> with a unique community string is recommended over v3. SNMPv3's per-packet authentication and encryption adds measurable CPU load to your gateway and fabric devices. The recommended security posture is a <strong>management VLAN</strong> isolating your network devices, not per-packet crypto.</p>
                </div>
            </details>

            <div class="action-buttons" style="margin-top: 1rem;">
                <button class="btn btn-primary" @onclick="RunDetection" disabled="@_detecting">
                    @if (_detecting) { <span class="spinner-sm"></span> <span>Checking...</span> }
                    else { <span>Re-check</span> }
                </button>
            </div>
        </div>
    </div>
}
else if (_snmpState == SnmpDetectionState.EnabledV2c || _snmpState == SnmpDetectionState.EnabledV3Only || _snmpState == SnmpDetectionState.Working)
{
    <!-- SNMP configured — show monitoring content -->

    @if (_showV3Recommendation && _snmpState == SnmpDetectionState.EnabledV3Only)
    {
        <div class="alert alert-info" style="margin-bottom: 1.5rem;">
            <strong>SNMPv3 detected.</strong>
            Consider switching to v1/v2c - the per-packet crypto adds CPU load to your network devices. The recommended security posture is a management VLAN, not v3 encryption.
            <button class="btn btn-sm btn-secondary" style="margin-left: 0.5rem;" @onclick="() => _showV3Recommendation = false">Dismiss</button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Monitoring Status</h2>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span class="status-badge status-connected">@FormatSnmpState(_snmpState)</span>
                <a href="/settings#monitoring" class="tooltip-icon settings-link" data-tooltip="Monitoring settings">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.84 1.804A1 1 0 018.82 1h2.36a1 1 0 01.98.804l.331 1.652a6.993 6.993 0 011.929 1.115l1.598-.54a1 1 0 011.186.447l1.18 2.044a1 1 0 01-.205 1.251l-1.267 1.113a7.047 7.047 0 010 2.228l1.267 1.113a1 1 0 01.206 1.25l-1.18 2.045a1 1 0 01-1.187.447l-1.598-.54a6.993 6.993 0 01-1.929 1.115l-.33 1.652a1 1 0 01-.98.804H8.82a1 1 0 01-.98-.804l-.331-1.652a6.993 6.993 0 01-1.929-1.115l-1.598.54a1 1 0 01-1.186-.447l-1.18-2.044a1 1 0 01.205-1.251l1.267-1.114a7.05 7.05 0 010-2.227L1.821 7.773a1 1 0 01-.206-1.25l1.18-2.045a1 1 0 011.187-.447l1.598.54A6.993 6.993 0 017.51 3.456l.33-1.652zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                    </svg>
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label class="form-label">SNMP</label>
                <div class="form-value">
                    <span class="status-indicator status-active"></span>
                    @(_snmpState == SnmpDetectionState.EnabledV2c ? "v2c" : _snmpState == SnmpDetectionState.EnabledV3Only ? "v3" : "Active")
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">InfluxDB</label>
                <div class="form-value">
                    @if (_influxReachable == true)
                    {
                        <span class="status-indicator status-active"></span>
                        <span>Connected</span>
                    }
                    else if (_influxReachable == false && !string.IsNullOrEmpty(_influxError))
                    {
                        <span class="status-indicator status-danger"></span>
                        <span>@_influxError</span>
                    }
                    else if (!_influxConfigured)
                    {
                        <span class="status-indicator status-inactive"></span>
                        <span>Not configured — <a href="/settings#monitoring">configure</a></span>
                    }
                    else
                    {
                        <span class="status-indicator status-inactive"></span>
                        <span>Not checked</span>
                    }
                    @if (_influxConfigured)
                    {
                        <button class="btn btn-sm btn-secondary" style="margin-left: 0.75rem;" @onclick="CheckInfluxHealth" disabled="@_checkingInflux">
                            @if (_checkingInflux)
                            {
                                <span class="spinner-sm"></span>
                                <span>Checking...</span>
                            }
                            else
                            {
                                <span>Test</span>
                            }
                        </button>
                    }
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Collection</label>
                <div class="form-value">
                    @if (_monitoringEnabled && _influxReachable == true)
                    {
                        <span class="status-indicator status-active"></span>
                        <span>Agent running</span>
                    }
                    else if (_monitoringEnabled && _influxReachable != true)
                    {
                        <span class="status-indicator status-danger"></span>
                        <span>Enabled, but InfluxDB unreachable</span>
                    }
                    else
                    {
                        <span class="status-indicator status-inactive"></span>
                        <span>Disabled</span>
                    }
                </div>
            </div>

            <div class="action-buttons" style="margin-top: 1rem;">
                @if (_monitoringEnabled)
                {
                    <button class="btn btn-secondary" @onclick="() => SetMonitoringEnabled(false)" disabled="@_togglingEnable">
                        @if (_togglingEnable) { <span class="spinner-sm"></span> <span>Stopping...</span> }
                        else { <span>Disable Monitoring</span> }
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="() => SetMonitoringEnabled(true)" disabled="@(_togglingEnable || _influxReachable != true)">
                        @if (_togglingEnable) { <span class="spinner-sm"></span> <span>Starting...</span> }
                        else { <span>Enable Monitoring</span> }
                    </button>
                    @if (_influxReachable != true)
                    {
                        <span class="page-description" style="margin-left: 0.75rem;">
                            Configure InfluxDB in <a href="/settings#monitoring">Settings</a> first.
                        </span>
                    }
                }
            </div>
        </div>
    </div>

    @if (_monitoringEnabled)
    {
        <div class="card" style="margin-top: 1.5rem;">
            <div class="card-header">
                <h2 class="card-title">Latency targets</h2>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span class="status-badge status-active">@_targets.Count active</span>
                    <a href="/monitoring/tools" class="tooltip-icon settings-link" data-tooltip="Run an ad-hoc probe">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM5.5 8.5a.5.5 0 010-1h2.793L7.146 6.354a.5.5 0 11.708-.708l2 2a.5.5 0 010 .708l-2 2a.5.5 0 11-.708-.708L8.293 8.5H5.5zm6.354-1.146a.5.5 0 010 .708L10.707 9.207H13.5a.5.5 0 010 1h-2.793l1.147 1.147a.5.5 0 11-.708.708l-2-2a.5.5 0 010-.708l2-2a.5.5 0 01.708 0z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </div>
            </div>
            <div class="card-body">
                <p class="page-description">
                    Default WAN targets and one fabric target per discovered device. The agent probes
                    each target at its own interval and writes results to the <code>latency</code>
                    measurement in InfluxDB.
                </p>
                @if (_targets.Count == 0)
                {
                    <div class="empty-state">
                        <p>No targets yet. They'll appear once the agent's first cycle completes.</p>
                    </div>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Target</th>
                                <th>Address</th>
                                <th>Interval</th>
                                <th>Last verified</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _targets.OrderBy(t => t.TargetType).ThenBy(t => t.Name))
                            {
                                <tr>
                                    <td>
                                        <span class="status-badge @TargetTypeBadgeClass(t.TargetType)">
                                            @t.TargetType
                                        </span>
                                    </td>
                                    <td>@t.Name</td>
                                    <td><code>@t.Address</code></td>
                                    <td>@t.PollIntervalSeconds s</td>
                                    <td>
                                        @if (t.LastVerified.HasValue)
                                        { <span>@RelativeTime(t.LastVerified.Value)</span> }
                                        else
                                        { <span class="text-muted">never</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}
else if (_snmpState == SnmpDetectionState.PollFailing)
{
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Monitoring Status</h2>
            <span class="status-badge status-error">SNMP Error</span>
        </div>
        <div class="card-body">
            <div class="alert alert-danger">
                <strong>SNMP polling is failing.</strong>
                @(_detectionError ?? "Check that SNMP is still enabled on your UniFi Console and that firewall rules permit UDP/161 from this server to your network devices.")
            </div>
            <div class="action-buttons" style="margin-top: 1rem;">
                <button class="btn btn-primary" @onclick="RunDetection" disabled="@_detecting">
                    @if (_detecting) { <span class="spinner-sm"></span> <span>Re-checking...</span> }
                    else { <span>Re-check SNMP</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private SnmpDetectionState _snmpState = SnmpDetectionState.NotChecked;
    private bool _detecting;
    private bool _showV3Recommendation = true;
    private string? _detectionError;

    private bool? _influxReachable;
    private string? _influxError;
    private bool _influxConfigured;
    private bool _checkingInflux;
    private bool _monitoringEnabled;
    private bool _togglingEnable;
    private List<MonitoringTarget> _targets = new();
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        ConnectionService.OnConnectionChanged += OnConnectionChanged;

        var settings = await SnmpDetection.GetOrCreateSettingsAsync();
        _snmpState = settings.SnmpDetectionState;
        LoadInfluxStateFromSettings(settings);
        await LoadTargetsAsync();

        // Refresh the targets list periodically so LastVerified updates show movement
        // without requiring a full page reload.
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    await LoadTargetsAsync();
                    StateHasChanged();
                });
            }
            catch { /* prevent timer death */ }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));

        if (_snmpState == SnmpDetectionState.NotChecked && ConnectionService.IsConnected)
        {
            await RunDetection();
        }
        else if (_snmpState == SnmpDetectionState.NotChecked)
        {
            await ConnectionService.WaitForConnectionAsync();
            if (ConnectionService.IsConnected)
                await RunDetection();
        }
    }

    private void LoadInfluxStateFromSettings(MonitoringSettings settings)
    {
        _influxConfigured = !string.IsNullOrEmpty(settings.InfluxDbToken)
            && !string.IsNullOrEmpty(settings.InfluxDbUrl);
        _influxReachable = settings.InfluxDbReachable;
        _influxError = settings.LastInfluxDbError;
        _monitoringEnabled = settings.Enabled;
    }

    private async Task SetMonitoringEnabled(bool enabled)
    {
        _togglingEnable = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var settings = await db.MonitoringSettings.FirstOrDefaultAsync()
                ?? new MonitoringSettings();
            if (settings.Id == 0) db.MonitoringSettings.Add(settings);
            settings.Enabled = enabled;
            settings.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
            _monitoringEnabled = enabled;
        }
        finally
        {
            _togglingEnable = false;
            StateHasChanged();
        }
    }

    private async Task CheckInfluxHealth()
    {
        _checkingInflux = true;
        StateHasChanged();
        try
        {
            await InfluxClient.ReconfigureAsync();
            var health = await InfluxClient.CheckHealthAsync();
            _influxReachable = health.Reachable;
            _influxError = health.Error;
        }
        finally
        {
            _checkingInflux = false;
            StateHasChanged();
        }
    }

    private async void OnConnectionChanged()
    {
        if (ConnectionService.IsConnected && _snmpState == SnmpDetectionState.NotChecked)
        {
            await InvokeAsync(async () =>
            {
                await RunDetection();
                StateHasChanged();
            });
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunDetection()
    {
        _detecting = true;
        _detectionError = null;
        StateHasChanged();

        var result = await SnmpDetection.DetectSnmpSettingsAsync();

        if (result.Success)
        {
            await SnmpDetection.SaveDetectionResultAsync(result);
            var settings = await SnmpDetection.GetOrCreateSettingsAsync();
            _snmpState = settings.SnmpDetectionState;
        }
        else
        {
            _detectionError = result.ErrorMessage;
            _snmpState = SnmpDetectionState.PollFailing;
        }

        _detecting = false;
        StateHasChanged();
    }

    private static string FormatSnmpState(SnmpDetectionState state) => state switch
    {
        SnmpDetectionState.EnabledV2c => "SNMP Ready",
        SnmpDetectionState.EnabledV3Only => "SNMP Ready (v3)",
        SnmpDetectionState.Working => "Active",
        _ => state.ToString()
    };

    private async Task LoadTargetsAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _targets = await db.MonitoringTargets.AsNoTracking()
                .OrderBy(t => t.TargetType).ThenBy(t => t.Name).ToListAsync();
        }
        catch
        {
            _targets = new List<MonitoringTarget>();
        }
    }

    private static string TargetTypeBadgeClass(MonitoringTargetType type) => type switch
    {
        MonitoringTargetType.Fabric => "status-connected",
        MonitoringTargetType.Wan => "status-active",
        MonitoringTargetType.AccessIsp => "status-active",
        MonitoringTargetType.Transit => "status-active",
        _ => "status-disconnected"
    };

    private static string RelativeTime(DateTime when)
    {
        var delta = DateTime.UtcNow - when.ToUniversalTime();
        if (delta < TimeSpan.Zero) return "just now";
        if (delta < TimeSpan.FromSeconds(15)) return "just now";
        if (delta < TimeSpan.FromMinutes(1)) return $"{(int)delta.TotalSeconds}s ago";
        if (delta < TimeSpan.FromHours(1)) return $"{(int)delta.TotalMinutes}m ago";
        if (delta < TimeSpan.FromDays(1)) return $"{(int)delta.TotalHours}h ago";
        return $"{(int)delta.TotalDays}d ago";
    }

    public void Dispose()
    {
        ConnectionService.OnConnectionChanged -= OnConnectionChanged;
        _refreshTimer?.Dispose();
    }
}
