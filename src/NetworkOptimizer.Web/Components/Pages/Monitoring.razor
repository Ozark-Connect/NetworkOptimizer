    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Mount the 3D map once the canvas is in the DOM and monitoring is active.
        // Idempotent: the JS module unmounts any previous instance on re-mount.
        if (_monitoringEnabled && _influxReachable == true && !_mapMounted)
        {
            _mapMounted = true;
            try
            {
                await JS.InvokeVoidAsync("import", "/js/lan-flow-map.js?v=1");
                await JS.InvokeVoidAsync("eval",
                    "(async () => { const m = await import('/js/lan-flow-map.js'); window.__lanFlowMap = m; await m.mount('lan-flow-map-canvas'); })();");
            }
            catch
            {
                _mapMounted = false;
            }
        }
        else if ((!_monitoringEnabled || _influxReachable != true) && _mapMounted)
        {
            // Map card is no longer rendered; tear the JS instance down.
            _mapMounted = false;
            try { await JS.InvokeVoidAsync("eval", "window.__lanFlowMap?.unmount();"); }
            catch { /* best effort */ }
        }
    }

    public void Dispose()
    {
        ConnectionService.OnConnectionChanged -= OnConnectionChanged;
        _refreshTimer?.Dispose();
        _testFeedbackTimer?.Dispose();
        _latencyChartTimer?.Dispose();
        if (_mapMounted)
        {
            try
            {
                _ = JS.InvokeVoidAsync("eval", "window.__lanFlowMap?.unmount();").AsTask();
            }
            catch { /* best effort */ }
        }
    }
