@page "/threats/waf"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.RequireViewer)]
@using Microsoft.AspNetCore.Authorization
@using NetworkOptimizer.Web.Services.Authorization
@using NetworkOptimizer.Threats.Models
@using NetworkOptimizer.Threats.Waf
@inject ThreatDashboardService DashboardService
@inject NetworkOptimizer.Threats.ThreatCollectionService CollectionService
@inject SiteContextService SiteContext
@inject IWafConnectionAdmin WafAdmin
@inject NetworkOptimizer.Threats.Interfaces.IThreatSettingsAccessor ThreatSettings
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Web Application Firewall - Network Optimizer</PageTitle>

<div class="page-header">
    <PageBackButton />
    <h1>Web Application Firewall</h1>
    <p class="page-description">Attacks on the apps behind this site's NetworkOptimizer-Proxy, and the sources it refuses</p>
</div>

@* Same header row as Threat Intelligence: page tabs left, time range right. *@
<div class="threat-header-bar">
    <div class="wifi-view-tabs-wrapper" style="margin-bottom:0;">
        <button class="wifi-tabs-scroll-btn wifi-tabs-scroll-left" onclick="this.parentElement.querySelector('.wifi-view-tabs').scrollBy({left: -200, behavior: 'smooth'})">&#8249;</button>
        <div class="wifi-view-tabs" style="border-bottom:none; padding-bottom:0;">
            @foreach (var (id, label) in Tabs)
            {
                <button class="wifi-view-tab @(_tab == id ? "active" : "")" @onclick="() => SetTab(id)">@label</button>
            }
        </div>
        <button class="wifi-tabs-scroll-btn wifi-tabs-scroll-right" onclick="this.parentElement.querySelector('.wifi-view-tabs').scrollBy({left: 200, behavior: 'smooth'})">&#8250;</button>
    </div>
    <div class="threat-controls" style="@(_tab is "overview" or "events" ? "" : "visibility:hidden;")">
        <div class="time-range-selector">
            @foreach (var range in new[] { "24h", "7d", "30d" })
            {
                <button class="time-btn threat-time-preset @(_range == range ? "active" : "")" @onclick="() => SetRange(range)">@range</button>
            }
        </div>
    </div>
</div>

@if (_tab == "overview")
{
    @if (_status == null && _configured)
    {
        <div class="card">
            <div class="card-body">
                <div class="empty-state">
                    <p>Connected. Waiting for the WAF's first report, which takes up to a minute.</p>
                </div>
            </div>
        </div>
    }
    else if (_status == null)
    {
        <div class="card">
            <div class="card-body">
                <div class="empty-state">
                    <p>No WAF is connected to this site yet.</p>
                    <SiteAdminOnly>
                        <button class="btn btn-primary" @onclick='() => SetTab("setup")'>Set Up</button>
                    </SiteAdminOnly>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (_status.Error != null)
        {
            <div class="alert alert-warning">@_status.Error</div>
        }
        <div class="threat-summary-grid">
            <div class="card threat-stat-card">
                <div class="threat-stat-value" style="color:#ef4444;">@(_summary?.Blocked ?? 0)</div>
                <div class="threat-stat-label">Blocked</div>
            </div>
            <div class="card threat-stat-card">
                <div class="threat-stat-value" style="color:#f59e0b;">@(_summary?.Detected ?? 0)</div>
                <div class="threat-stat-label">Detected</div>
            </div>
            <div class="card threat-stat-card">
                <div class="threat-stat-value" style="color:var(--text-primary);">@(_status.Stats?.Banned ?? 0)</div>
                <div class="threat-stat-label">Refused by Ban List Since WAF Start</div>
            </div>
            <div class="card threat-stat-card">
                <div class="threat-stat-value" style="color:var(--text-primary);">@(_status.Stats?.Inspected ?? 0)</div>
                <div class="threat-stat-label">Requests Inspected Since WAF Start</div>
            </div>
        </div>
        <div class="card card-spaced">
            <div class="card-header">
                <h3 class="card-title">Mode</h3>
                <div class="waf-card-mode">
                    <span class="waf-meta">Paranoia Level @_status.Paranoia <span class="tooltip-icon tooltip-icon-sm" data-tooltip="OWASP CRS paranoia level, set by WAF_PARANOIA in the proxy's .env. Level 1 suits most sites. Higher levels catch more and flag more legitimate requests.">?</span></span>
                    <span class="status-badge @(_status.Mode == "block" ? "status-active" : "")">@(_status.Mode == "block" ? "Blocking" : "Detection Only")</span>
                </div>
            </div>
            <div class="card-body">
                @if (_status.Mode != "block" && DetectDays >= 7)
                {
                    <div class="alert alert-info">
                        <div class="banner-content">
                            <div class="banner-text">
                                <span><strong>@DetectDays days in Detection Only.</strong> In the last 7 days it flagged @(_week?.Detected ?? 0) requests.
                                    Review them on Events and add exclusions for anything legitimate, then switch to Block.</span>
                            </div>
                            <SiteAdminOnly>
                                <div class="banner-actions">
                                    <button class="btn btn-sm btn-primary" disabled="@_modeBusy" @onclick='() => SetMode("block")'>Switch to Block</button>
                                </div>
                            </SiteAdminOnly>
                        </div>
                    </div>
                }
                <p class="section-description">
                    @if (_status.Mode == "block")
                    {
                        <text>Blocking@(SinceText). A request that crosses the CRS anomaly threshold gets a 403.</text>
                    }
                    else if (DetectDays >= 7)
                    {
                        <text>Detection Only@(SinceText). Attacks are logged and let through.</text>
                    }
                    else
                    {
                        <text>Detection Only@(SinceText). Attacks are logged and let through. Run it for a week, review <a href="/threats/waf?tab=events" @onclick='() => SetTab("events")' @onclick:preventDefault>Events</a>, then switch to Block.</text>
                    }
                </p>
                @if (_status.Mode == "block" || DetectDays < 7)
                {
                    <SiteAdminOnly>
                        <div class="action-buttons">
                            @if (_status.Mode == "block")
                            {
                                <button class="btn btn-contrast" disabled="@_modeBusy" @onclick='() => SetMode("detect")'>Switch to Detection Only</button>
                            }
                            else
                            {
                                <button class="btn btn-contrast" disabled="@_modeBusy" @onclick='() => SetMode("block")'>Switch to Block</button>
                            }
                        </div>
                    </SiteAdminOnly>
                }
                @if (_modeMessage != null)
                {
                    <div class="alert alert-@_modeMessageClass">@_modeMessage</div>
                }
            </div>
        </div>
        @if ((_summary?.Total ?? 0) > 0)
        {
            <div class="threat-two-chart-row">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead><tr><th>Top Rules</th><th>Events</th></tr></thead>
                        <tbody>
                            @foreach (var rule in _summary!.TopRules)
                            {
                                <tr><td class="text-truncate-300"><code>@rule.RuleId</code> @rule.Message</td><td>@rule.Count</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead><tr><th>Top Hosts</th><th>Events</th></tr></thead>
                        <tbody>
                            @foreach (var host in _summary!.TopHosts)
                            {
                                <tr><td class="text-truncate-300">@host.Host</td><td>@host.Count</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}
else if (_tab == "events")
{
    <div class="card">
        <div class="card-body">
            <div class="form-group">
                <input type="search" class="form-control" placeholder="Search source, host, request, or rule" @bind="_search" @bind:event="oninput" @bind:after="LoadEvents" />
            </div>
            @if (_events.Count == 0)
            {
                <div class="empty-state"><p>No WAF events in this period.</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="data-table waf-events">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Source</th>
                                <th class="hide-mobile">Host</th>
                                <th>Request</th>
                                <th>Rule</th>
                                <th>Action</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in _events)
                            {
                                <tr>
                                    <td>@e.Timestamp.ToLocalTime().ToString("MMM d HH:mm")</td>
                                    <td><a href="/threats?tab=drilldown&ip=@Uri.EscapeDataString(e.SourceIp)"><code>@e.SourceIp</code></a></td>
                                    <td class="hide-mobile text-truncate-300">@e.Domain</td>
                                    <td class="text-truncate-300"><code>@e.Service</code></td>
                                    <td class="text-truncate-300" data-tooltip="@e.SignatureName"><code>@e.SignatureId</code> @e.SignatureName</td>
                                    <td><span class="status-badge @(e.Action == ThreatAction.Blocked ? "status-error" : "")">@(e.Action == ThreatAction.Blocked ? "Blocked" : "Detected")</span></td>
                                    <td>
                                        <SiteAdminOnly>
                                            <button class="btn btn-sm btn-contrast" @onclick="() => ShowExclusion(e)">@(_exclusionFor == e.Id ? "Hide Exclusion" : "Show Exclusion")</button>
                                        </SiteAdminOnly>
                                    </td>
                                </tr>
                                @if (_exclusionFor == e.Id)
                                {
                                    <tr class="history-details-row">
                                        <td colspan="7">
                                            <p class="form-help">If this request was legitimate, add this to <code>waf-rules/before-crs.conf</code> beside the proxy and restart netopt-waf. It turns rule @e.SignatureId off for this host and path only.</p>
                                            <pre class="gateway-diag-raw">@_exclusionText</pre>
                                            <div class="action-buttons">
                                                <button class="btn btn-sm btn-contrast" @onclick="CopyExclusion">@(_copied ? "Copied" : "Copy")</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else if (_tab == "blocking")
{
    <BlockedSourcesCard />
    <p class="form-help">
        Automatic Blocking is set up in <a href="/settings?tab=security#automatic-blocking">Settings - Security &amp; Alerts</a>.
    </p>
}
else if (_tab == "setup")
{
    <SiteAdminOnly>
        <ChildContent>
            <WafConnectionCard />
        </ChildContent>
        <NotAuthorized>
            <div class="card"><div class="card-body"><p class="form-help">A Site Admin sets up this site's WAF connection.</p></div></div>
        </NotAuthorized>
    </SiteAdminOnly>
}

@code {
    private static readonly (string Id, string Label)[] Tabs =
        [("overview", "Overview"), ("events", "Events"), ("blocking", "Blocking"), ("setup", "Setup")];

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabParam { get; set; }

    private string _tab = "overview";
    private string _range = "24h";
    private WafStatus? _status;
    private bool _configured;
    private WafSummary? _summary;
    private WafSummary? _week;
    private bool _modeBusy;
    private string? _modeMessage;
    private string _modeMessageClass = "info";

    private int DetectDays => _status?.ModeSince is { } since ? (int)(DateTimeOffset.UtcNow - since).TotalDays : 0;

    private string SinceText => _status?.ModeSince is { } since
        ? $" for {TimeFormatHelper.FormatDurationCompact(DateTimeOffset.UtcNow - since)}"
        : "";

    private async Task SetMode(string mode)
    {
        _modeBusy = true;
        _modeMessage = null;
        try
        {
            var state = await WafAdmin.SetModeAsync(mode);
            _status = _status! with { Mode = state.Mode, ModeSince = state.Since };
            _modeMessage = (state.Mode == "block"
                ? "Switched to Block. Requests that cross the CRS anomaly threshold now get a 403. If a legitimate app breaks, add an exclusion from Events or switch back here."
                : "Switched to Detection Only. CRS rule matches are now logged and let through. Bans and the trusted list still refuse what they did before.")
                + (state.Persisted ? "" : " This WAF has no state directory, so a restart returns it to the mode in its WAF_MODE setting. Update NetworkOptimizer-Proxy to keep the switch.");
            _modeMessageClass = state.Persisted ? "success" : "warning";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException)
        {
            _modeMessage = ex.Message;
            _modeMessageClass = "danger";
        }
        finally
        {
            _modeBusy = false;
        }
    }
    private List<ThreatEvent> _events = [];
    private string _search = "";
    private int? _exclusionFor;
    private string _exclusionText = "";
    private bool _copied;

    protected override async Task OnInitializedAsync()
    {
        if (Tabs.Any(t => t.Id == TabParam)) _tab = TabParam!;
        await Load();
    }

    private (DateTime From, DateTime To) Window()
    {
        var to = DateTime.UtcNow;
        return (_range switch { "7d" => to.AddDays(-7), "30d" => to.AddDays(-30), _ => to.AddHours(-24) }, to);
    }

    private async Task SetRange(string range)
    {
        _range = range;
        await Load();
    }

    // Re-read on every view tab: a connection saved on Setup shows up without a page reload.
    private async Task SetTab(string id)
    {
        _tab = id;
        if (id != "setup") await Load();
    }

    private async Task Load()
    {
        _status = CollectionService.WafStatusFor(SiteContext.Slug);
        var site = SiteContext.IsDefault ? null : SiteContext.Slug;
        _configured = await NetworkOptimizer.Threats.Blocking.BlockingSettings.WafConnectedAsync(k => ThreatSettings.GetSettingAsync(k), site);
        var (from, to) = Window();
        _summary = await DashboardService.GetWafSummaryAsync(from, to);
        _week = await DashboardService.GetWafSummaryAsync(to.AddDays(-7), to);
        await LoadEvents();
        WatchForFirstReport();
    }

    private System.Threading.Timer? _firstReportTimer;

    // Connected but not reported yet: re-check every 5 seconds until the first report lands.
    private void WatchForFirstReport()
    {
        if (_status != null || !_configured)
        {
            _firstReportTimer?.Dispose();
            _firstReportTimer = null;
            return;
        }
        _firstReportTimer ??= new System.Threading.Timer(async _ =>
        {
            try
            {
                if (CollectionService.WafStatusFor(SiteContext.Slug) == null) return;
                await InvokeAsync(async () =>
                {
                    await Load();
                    StateHasChanged();
                });
            }
            catch { /* prevent timer death */ }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    public void Dispose() => _firstReportTimer?.Dispose();

    private async Task LoadEvents()
    {
        var (from, to) = Window();
        _events = await DashboardService.GetWafEventsAsync(from, to, string.IsNullOrWhiteSpace(_search) ? null : _search);
    }

    private void ShowExclusion(ThreatEvent e)
    {
        _copied = false;
        if (_exclusionFor == e.Id)
        {
            _exclusionFor = null;
            return;
        }
        _exclusionFor = e.Id;
        _exclusionText = WafExclusion.ForRule(e.SignatureId, e.Domain, WafExclusion.PathOf(e.Service));
    }

    private async Task CopyExclusion()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _exclusionText);
        _copied = true;
    }
}
