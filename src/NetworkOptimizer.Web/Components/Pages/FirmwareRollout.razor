@page "/firmware-rollout"
@using NetworkOptimizer.UniFi
@attribute [Authorize(Policy = Policies.RequireViewer)]
@implements IAsyncDisposable
@inject IFirmwareRolloutService RolloutService
@inject SiteContextService SiteContext
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@inject ILogger<FirmwareRollout> Logger
@rendermode InteractiveServer
@using NetworkOptimizer.Storage.Models
@using NetworkOptimizer.Core.Helpers
@using NetworkOptimizer.Web.Services.Firmware

<PageTitle>Firmware Rollout - Network Optimizer</PageTitle>

<div class="page-header">
    <h1>Firmware Rollout</h1>
    <p class="page-description">Upgrade the whole site the way you would by hand, without the evening lost to it: ordered by topology, canaried per model, scheduled from the site's own LAN and WAN activity, and verified device by device.</p>
</div>

<RestrictedSiteNotice />

@if (_loading)
{
    <div class="loading-container"><span class="spinner"></span><span>Loading rollout state...</span></div>
}
else if (_active != null)
{
    @* ---- Live / scheduled rollout view ---- *@
    <div class="card" data-tour="firmware-rollout">
        <div class="card-header">
            <h2 class="card-title">@ActiveTitle</h2>
            <div class="firmware-rollout-controls">
                <SiteAdminOnly>
                    @if (_active.Status == FirmwareRolloutStatus.Running)
                    {
                        <button class="btn btn-sm btn-secondary" @onclick="() => ControlAsync(RolloutService.PauseAsync)" disabled="@_busy">Pause</button>
                    }
                    @if (_active.Status == FirmwareRolloutStatus.Paused)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => ControlAsync(RolloutService.ResumeAsync)" disabled="@_busy">@(WaitingApproval ? "Approve Next Wave" : "Resume")</button>
                    }
                    @if (_active.Status is FirmwareRolloutStatus.Scheduled or FirmwareRolloutStatus.Announced)
                    {
                        <button class="btn btn-sm btn-secondary" @onclick="PostponeAsync" disabled="@_busy">Postpone 24h</button>
                    }
                    @if (_active.Status is not FirmwareRolloutStatus.SoakWait)
                    {
                        <button class="btn btn-sm btn-danger" @onclick="AbortAsync" disabled="@_busy">Abort</button>
                    }
                </SiteAdminOnly>
            </div>
        </div>
        <div class="card-body">
            @if (_controlNotice != null)
            {
                <div class="alert alert-info firmware-rollout-note">@_controlNotice</div>
            }
            @if (_active.Status is FirmwareRolloutStatus.Scheduled or FirmwareRolloutStatus.Announced)
            {
                <p class="firmware-rollout-note">Scheduled to start <strong>@LocalTime(_active.ScheduledStartAt)</strong>@SiteAside(_active.ScheduledStartAt ?? DateTime.UtcNow). Estimated duration @Duration(_active.Plan.TotalEstimatedSeconds).</p>
            }
            @if (WaitingApproval)
            {
                <div class="alert alert-info firmware-rollout-note">Paused at a wave boundary, waiting for approval to continue.</div>
            }
            @if (_active.Status == FirmwareRolloutStatus.SoakWait)
            {
                <p class="firmware-rollout-note">Every device is upgraded. The report compares @SoakHours hours of settled running against the same stretch before the upgrade, so it lands about @SoakHours hours after the last device came back.</p>
            }
            @foreach (var note in _active.Plan.Notes)
            {
                <p class="firmware-rollout-plan-note">@note</p>
            }

            @if (ActivePlanHasMap)
            {
                <div id="firmware-rollout-map-stage" class="firmware-rollout-map-stage"></div>
                <div id="firmware-rollout-timeline"></div>
            }
            else
            {
                <div class="firmware-rollout-map-stage firmware-rollout-map-waiting">
                    <div class="empty-state">
                        <h3>Waiting for the scheduled start</h3>
                        <p>Devices light up here as each one upgrades.</p>
                    </div>
                </div>
            }

            <div class="table-responsive firmware-rollout-steps">
                <table class="data-table">
                    <thead>
                        <tr><th>Wave</th><th>Device</th><th>Model</th><th class="hide-mobile">From</th><th>To</th><th>State</th><th class="hide-mobile">Downtime</th><th></th></tr>
                    </thead>
                    <tbody>
                        @* The console's own phases are not device steps, but they are part of the
                           run and bracket it: the application first, UniFi OS after every device. *@
                        @if (_active.Plan.IncludesUniFiNetworkUpdate)
                        {
                            <tr>
                                <td>@_active.Plan.NetworkAppUpdate.Wave</td>
                                <td>UniFi Network application</td>
                                <td>@ConsoleRowModel</td>
                                <td class="hide-mobile">@(FirmwareVersionFormat.ShortOrNull(_active.Plan.NetworkAppUpdate.FromVersion) ?? "-")</td>
                                <td>@(FirmwareVersionFormat.ShortOrNull(_active.Plan.NetworkAppUpdate.TargetVersion) ?? "-")</td>
                                <td><span class="firmware-rollout-chip @ConsoleChipClass(_active.Plan.NetworkAppUpdate)">@ConsoleChipLabel(_active.Plan.NetworkAppUpdate)</span></td>
                                <td class="hide-mobile">-</td>
                                <td></td>
                            </tr>
                        }
                        @foreach (var step in _active.Steps.Where(s => s.State != FirmwareRolloutStepState.SkippedExcluded))
                        {
                            <tr>
                                <td>@(step.Wave > 0 ? step.Wave.ToString() : "-")</td>
                                <td>@step.Name</td>
                                <td>@step.DisplayModel</td>
                                <td class="hide-mobile">@(FirmwareVersionFormat.ShortOrNull(step.FromVersion) ?? "-")</td>
                                <td>@(FirmwareVersionFormat.ShortOrNull(step.ToVersion) ?? "-")</td>
                                <td><span class="firmware-rollout-chip @ChipClass(step.State)">@ChipLabel(step.State)</span></td>
                                <td class="hide-mobile">@(step.DowntimeSeconds is int d ? Duration(d) : "-")</td>
                                <td>
                                    <SiteAdminOnly>
                                        @if (step.CanRollBack)
                                        {
                                            <button class="btn btn-sm btn-secondary" @onclick="() => RollbackAsync(step)" disabled="@_busy">Roll back</button>
                                        }
                                        else if (step.RollbackUnavailableReason != null && step.State == FirmwareRolloutStepState.RegressionFlagged)
                                        {
                                            <span class="tooltip-icon tooltip-icon-sm" data-tooltip="@step.RollbackUnavailableReason">?</span>
                                        }
                                    </SiteAdminOnly>
                                </td>
                            </tr>
                        }
                        @if (_active.Plan.IncludesUniFiOsUpdate)
                        {
                            <tr>
                                <td>@_active.Plan.UniFiOsUpdate.Wave</td>
                                <td>UniFi OS</td>
                                <td>@ConsoleRowModel</td>
                                <td class="hide-mobile">@(FirmwareVersionFormat.ShortOrNull(_active.Plan.UniFiOsUpdate.FromVersion) ?? "-")</td>
                                <td>@(FirmwareVersionFormat.ShortOrNull(_active.Plan.UniFiOsUpdate.TargetVersion) ?? "-")</td>
                                <td><span class="firmware-rollout-chip @ConsoleChipClass(_active.Plan.UniFiOsUpdate)">@ConsoleChipLabel(_active.Plan.UniFiOsUpdate)</span></td>
                                <td class="hide-mobile">-</td>
                                <td></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (_wizardOpen)
{
    @* ---- Wizard ---- *@
    <div class="card" data-tour="firmware-rollout">
        <div class="card-header">
            <h2 class="card-title">Plan a Rollout</h2>
            <button class="btn btn-sm btn-secondary" @onclick="CloseWizard" disabled="@_busy">Cancel</button>
        </div>
        <div class="card-body">
            <div class="site-wizard-steps">
                @{ var stepNames = new[] { "Scope & Channels", "Schedule", "Preview" }; }
                @for (var i = 0; i < stepNames.Length; i++)
                {
                    var n = i + 1;
                    var stepClass = n < _step ? "done" : n == _step ? "current" : "upcoming";
                    <div class="site-wizard-step @stepClass">
                        <span class="site-wizard-step-node">@if (n < _step) { <text>&#x2713;</text> } else { @n }</span>
                        <span class="site-wizard-step-label">@stepNames[i]</span>
                    </div>
                }
            </div>

            @if (_wizardError != null)
            {
                <div class="alert alert-danger firmware-rollout-note">@_wizardError</div>
            }

            @if (_step == 1 && _settings != null)
            {
                <p class="section-description">Pick the release channel for @ChannelScopeLabel. Everything upgradable is included by default; fine tune what gets which release channel, or leave devices out, in the sections below.</p>

                @foreach (var warning in _preview?.Warnings ?? [])
                {
                    <div class="alert alert-warning firmware-rollout-note">@warning</div>
                }
                @foreach (var notice in _preview?.Notices ?? [])
                {
                    <div class="alert alert-info firmware-rollout-note">@notice</div>
                }

                <div class="form-group">
                    <label class="form-label">Release channel</label>
                    <select class="form-control firmware-rollout-select" @bind="_settings.GlobalChannel">
                        <option value="@FirmwareChannels.Release">Official (GA)</option>
                        <option value="@FirmwareChannels.ReleaseCandidate">Release Candidate</option>
                        @if (_preview?.Channels.EarlyAccessAvailable == true)
                        {
                            <option value="@FirmwareChannels.Beta">Early Access</option>
                        }
                    </select>
                    <small class="form-help">
                        Everything in this rollout follows this channel@(ConsoleSurfacesLabel).@(_preview != null && !_preview.Channels.EarlyAccessAvailable
                            ? " Early Access is enabled through your Ubiquiti account, so it only appears here once the console offers it."
                            : "")
                    </small>
                </div>

                <div class="form-group">
                    @if (_preview?.ConsoleApiAvailable != false)
                    {
                        <label class="checkbox-label"><input type="checkbox" @bind="_settings.IncludeUniFiNetwork" /><span>Update the UniFi Network application first</span></label>
                    }
                    @if (_preview?.HasCloudGateway == true)
                    {
                        <label class="checkbox-label"><input type="checkbox" @bind="_settings.IncludeUniFiOs" /><span>Include the UniFi OS update on the Cloud Gateway</span></label>
                    }
                </div>

                @if (_settings.IncludeUniFiNetwork || (_settings.IncludeUniFiOs && _preview?.HasCloudGateway == true))
                {
                    <details class="setup-guide firmware-rollout-guide">
                        <summary>Different channel for the console</summary>
                        <div class="setup-guide-content">
                            @if (_settings.IncludeUniFiNetwork)
                            {
                                <div class="form-group firmware-rollout-inline">
                                    <label class="form-label">UniFi Network application</label>
                                    <select class="form-control firmware-rollout-select" value="@(_settings.NetworkAppChannel ?? "")" @onchange="e => _settings.NetworkAppChannel = Blank(e.Value?.ToString())">
                                        <option value="">Same as everything else</option>
                                        <option value="@FirmwareChannels.Release">Official (GA)</option>
                                        <option value="@FirmwareChannels.ReleaseCandidate">Release Candidate</option>
                                        @if (_preview?.Channels.EarlyAccessAvailable == true)
                                        {
                                            <option value="@FirmwareChannels.Beta">Early Access</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (_settings.IncludeUniFiOs && _preview?.HasCloudGateway == true)
                            {
                                <div class="form-group firmware-rollout-inline">
                                    <label class="form-label">UniFi OS</label>
                                    <select class="form-control firmware-rollout-select" value="@(_settings.UniFiOsChannel ?? "")" @onchange="e => _settings.UniFiOsChannel = Blank(e.Value?.ToString())">
                                        <option value="">Same as everything else</option>
                                        <option value="@FirmwareChannels.Release">Official (GA)</option>
                                        <option value="@FirmwareChannels.ReleaseCandidate">Release Candidate</option>
                                        @if (_preview?.Channels.EarlyAccessAvailable == true)
                                        {
                                            <option value="@FirmwareChannels.Beta">Early Access</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    </details>
                }

                <details class="setup-guide firmware-rollout-guide">
                    <summary>Per-device-type channels</summary>
                    <div class="setup-guide-content">
                        @foreach (var (code, label) in TypeChannelRows)
                        {
                            <div class="form-group firmware-rollout-inline">
                                <label class="form-label">@label</label>
                                <select class="form-control firmware-rollout-select" value="@TypeChannel(code)" @onchange="e => SetTypeChannel(code, e.Value?.ToString())">
                                    <option value="">Same as everything else</option>
                                    <option value="@FirmwareChannels.Release">Official (GA)</option>
                                    <option value="@FirmwareChannels.ReleaseCandidate">Release Candidate</option>
                                    @if (_preview?.Channels.EarlyAccessAvailable == true)
                                    {
                                        <option value="@FirmwareChannels.Beta">Early Access</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </details>

                <details class="setup-guide firmware-rollout-guide">
                    <summary>Per-model channels</summary>
                    <div class="setup-guide-content">
                        @foreach (var model in SiteModels)
                        {
                            <div class="form-group firmware-rollout-inline">
                                <label class="form-label">@model.Label</label>
                                <select class="form-control firmware-rollout-select" value="@SkuChannel(model.Code)" @onchange="e => SetSkuChannel(model.Code, e.Value?.ToString())">
                                    <option value="">Same as its device type</option>
                                    <option value="@FirmwareChannels.Release">Official (GA)</option>
                                    <option value="@FirmwareChannels.ReleaseCandidate">Release Candidate</option>
                                    @if (_preview?.Channels.EarlyAccessAvailable == true)
                                    {
                                        <option value="@FirmwareChannels.Beta">Early Access</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (SiteModels.Count == 0)
                        {
                            <small class="form-help">Models appear here once the device list has loaded.</small>
                        }
                    </div>
                </details>

                <details class="setup-guide firmware-rollout-guide">
                    <summary>Exclude devices @(_exMacs.Count + _exSkus.Count + _exTypes.Count > 0 ? $"({_exMacs.Count + _exSkus.Count + _exTypes.Count} rules)" : "")</summary>
                    <div class="setup-guide-content">
                        <div class="form-group">
                            <input type="text" class="form-control" placeholder="Search devices..." @bind="_exclusionSearch" @bind:event="oninput" />
                        </div>
                        <div class="firmware-rollout-exclusion-groups firmware-rollout-exclude">
                            @foreach (var (code, label) in TypeChannelRows)
                            {
                                <label class="checkbox-label"><input type="checkbox" checked="@_exTypes.Contains(code)" @onchange="e => ToggleSet(_exTypes, code, e)" /><span>Exclude all @label.ToLowerInvariant()</span></label>
                            }
                        </div>
                        <div class="firmware-rollout-exclusion-list firmware-rollout-exclude">
                            @foreach (var device in FilteredExclusionCandidates)
                            {
                                @* Tooltip on the checkbox alone: on the row it fired anywhere along it. *@
                                var derived = DerivedExclusion(device);
                                <label class="checkbox-label firmware-rollout-device-row">
                                    <input type="checkbox" checked="@IsExcluded(device)" disabled="@(derived != null)" data-tooltip="@derived" @onchange="e => ToggleSet(_exMacs, device.Mac, e)" />
                                    <span>@device.Name</span>
                                    <span class="firmware-rollout-muted">@device.DisplayModel</span>
                                    @if (device.Upgradable)
                                    {
                                        <span class="firmware-rollout-chip chip-active"
                                              data-tooltip="@UpdateTooltip(device)">@(FirmwareVersionFormat.ShortOrNull(device.TargetVersion) ?? "Update waiting")</span>
                                    }
                                    <button type="button" class="btn btn-sm btn-tertiary firmware-rollout-sku-btn" @onclick="() => ToggleSku(device)" @onclick:stopPropagation="true">@(SkuExcluded(device) ? "Include model" : "Exclude model")</button>
                                </label>
                            }
                        </div>
                    </div>
                </details>

                <div class="firmware-rollout-wizard-nav">
                    <button class="btn btn-primary" @onclick="() => _step = 2" disabled="@(_busy || _preview?.ConsoleConnected == false)">Next</button>
                </div>
            }
            else if (_step == 2 && _settings != null)
            {
                <p class="section-description">Run it now, book a one-time window, or let autopilot take it from here: updates get planned during quiet hours, are announced ahead of time, and can be postponed with one click.</p>

                <div class="form-group firmware-rollout-mode-row">
                    <label class="radio-label"><input type="radio" name="fr-mode" checked="@(_scheduleMode == "now")" @onchange="@(() => _scheduleMode = "now")" /><span>Start now</span></label>
                    <label class="radio-label"><input type="radio" name="fr-mode" checked="@(_scheduleMode == "once")" @onchange="@(() => _scheduleMode = "once")" /><span>Schedule once</span></label>
                    <label class="radio-label"><input type="radio" name="fr-mode" checked="@(_scheduleMode == "autopilot")" @onchange="@(() => _scheduleMode = "autopilot")" /><span>Autopilot</span></label>
                </div>

                @if (_scheduleMode == "once")
                {
                    <div class="form-group">
                        <label class="form-label">Start</label>
                        <input type="range" class="firmware-rollout-slider" min="0" max="167" step="1" value="@_startOffsetHours" @oninput="e => SetStartOffset(e.Value?.ToString())" />
                        <div class="firmware-rollout-slider-labels">
                            <span><strong>@LocalTime(SelectedStartUtc)</strong>@SiteAside(SelectedStartUtc)</span>
                            <span>done by ~@LocalTime(SelectedStartUtc.AddSeconds(_preview?.Plan.TotalEstimatedSeconds ?? 0))</span>
                        </div>
                        @if (_preview?.ProposedWindow is { } window)
                        {
                            <small class="form-help">Suggested: @LocalTime(window.StartUtc) - based on @window.Basis.@(window.UsedFallback ? " Collecting a week of usage history will refine this." : "")</small>
                        }
                    </div>
                }
                @if (_scheduleMode == "autopilot")
                {
                    <p class="firmware-rollout-note">Autopilot plans a rollout whenever updates are waiting, books it into the site's quietest window, and tells you <strong>@_settings.NotifyHoursAhead hours</strong> ahead so you can postpone with one click.</p>
                    <div class="alert alert-info firmware-rollout-note">Turn off UniFi's own auto-updates first - devices, the UniFi Network application, and UniFi OS - so two updaters never run at once.</div>
                    <div class="form-group firmware-rollout-inline">
                        <label class="form-label">Heads-up hours</label>
                        <input type="number" class="form-control firmware-rollout-num" min="1" max="168" @bind="_settings.NotifyHoursAhead" />
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">Pace</label>
                    <div class="firmware-rollout-mode-row">
                        <label class="radio-label"><input type="radio" name="fr-pace" checked="@(_settings.SpacingProfile == FirmwareSpacingProfile.Conservative)" @onchange="@(() => _settings.SpacingProfile = FirmwareSpacingProfile.Conservative)" /><span>Conservative</span></label>
                        <label class="radio-label"><input type="radio" name="fr-pace" checked="@(_settings.SpacingProfile == FirmwareSpacingProfile.Balanced)" @onchange="@(() => _settings.SpacingProfile = FirmwareSpacingProfile.Balanced)" /><span>Balanced</span></label>
                        <label class="radio-label"><input type="radio" name="fr-pace" checked="@(_settings.SpacingProfile == FirmwareSpacingProfile.Fast)" @onchange="@(() => _settings.SpacingProfile = FirmwareSpacingProfile.Fast)" /><span>Fast</span></label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="checkbox-label"><input type="checkbox" @bind="_settings.SuppressStandardAlerts" /><span>Skip the usual offline and restart alerts for devices rebooted during the rollout</span></label>
                    <label class="checkbox-label"><input type="checkbox" @bind="_settings.PerWaveApproval" /><span>Pause for approval at every wave</span></label>
                </div>

                <details class="setup-guide firmware-rollout-guide">
                    <summary>Advanced</summary>
                    <div class="setup-guide-content">
                        <label class="checkbox-label"><input type="checkbox" @bind="_settings.WaiveBackup" /><span>Skip the pre-flight console backup</span></label>
                        @if (_scheduleMode == "autopilot")
                        {
                            <div class="form-group firmware-rollout-inline">
                                <label class="form-label">Minimum release age (days)</label>
                                <input type="number" class="form-control firmware-rollout-num" min="0" max="90" @bind="_settings.MinReleaseAgeDays" />
                                <small class="form-help">0 rolls out releases as they arrive; a few days lets the earliest adopters find the surprises.</small>
                            </div>
                        }
                    </div>
                </details>

                <div class="firmware-rollout-wizard-nav">
                    <button class="btn btn-secondary" @onclick="() => _step = 1" disabled="@_busy">Back</button>
                    <button class="btn btn-primary" @onclick="GoToPreviewAsync" disabled="@_busy">
                        @if (_busy) { <span class="spinner spinner-sm"></span> } else { <span>Preview</span> }
                    </button>
                </div>
            }
            else if (_step == 3 && _preview != null)
            {
                <p class="section-description">This is the whole plan: leaf devices first, the gateway last, one canary per model, and roam-aware AP pairing. Nothing starts until you say so.</p>

                <div class="firmware-rollout-stats">
                    <div class="firmware-rollout-stat"><span class="detail-value">@_preview.UpgradableCount</span><span class="detail-label">to upgrade</span></div>
                    <div class="firmware-rollout-stat"><span class="detail-value">@_preview.Plan.Waves.Count</span><span class="detail-label">waves</span></div>
                    <div class="firmware-rollout-stat"><span class="detail-value">@Duration(_preview.Plan.TotalEstimatedSeconds)</span><span class="detail-label">estimated</span></div>
                    <div class="firmware-rollout-stat"><span class="detail-value">@(_scheduleMode == "autopilot" ? "Autopilot" : _scheduleMode == "now" ? "Now" : LocalTime(SelectedStartUtc) + SiteAside(SelectedStartUtc))</span><span class="detail-label">starts</span></div>
                    @if (_preview.ExcludedCount > 0)
                    {
                        <div class="firmware-rollout-stat"><span class="detail-value">@_preview.ExcludedCount</span><span class="detail-label">excluded</span></div>
                    }
                </div>

                <div id="firmware-rollout-map-stage" class="firmware-rollout-map-stage"></div>
                <div id="firmware-rollout-timeline"></div>

                @foreach (var note in _preview.Plan.Notes)
                {
                    <p class="firmware-rollout-plan-note">@note</p>
                }
                @foreach (var warning in _preview.Warnings)
                {
                    <div class="alert alert-warning firmware-rollout-note">@warning</div>
                }
                @foreach (var notice in _preview.Notices)
                {
                    <div class="alert alert-info firmware-rollout-note">@notice</div>
                }

                <div class="firmware-rollout-waves">
                    @if (_preview.Plan.IncludesUniFiNetworkUpdate && _preview.NetworkApplication is { UpdateAvailable: true } app)
                    {
                        <div class="firmware-rollout-wave">
                            <span class="firmware-rollout-wave-no">0</span>
                            <span class="firmware-rollout-wave-eta">T+0m</span>
                            <span class="firmware-rollout-wave-devices">
                                <span class="firmware-rollout-wave-device">
                                    UniFi Network application
                                    <span class="firmware-rollout-chip chip-muted firmware-rollout-version-badge">@(FirmwareVersionFormat.ShortOrNull(app.CurrentVersion)) &#8594; @(FirmwareVersionFormat.ShortOrNull(app.TargetVersion))</span>
                                </span>
                            </span>
                        </div>
                    }

                    @foreach (var wave in _preview.Plan.Waves)
                    {
                        <div class="firmware-rollout-wave">
                            <span class="firmware-rollout-wave-no">@wave.Number</span>
                            <span class="firmware-rollout-wave-eta">T+@Duration(wave.StartOffsetSeconds)</span>
                            <span class="firmware-rollout-wave-devices">
                                @foreach (var step in wave.Steps)
                                {
                                    var changelog = ChangelogFor(step.Mac);
                                    <span class="firmware-rollout-wave-device">
                                        @step.Name@(step.IsCanary ? " (canary)" : "")@(step.HeldForCanary ? " (held)" : "")
                                        @if (step.ToVersion != null)
                                        {
                                            if (changelog != null)
                                            {
                                                <a class="firmware-rollout-chip chip-muted firmware-rollout-version-badge" href="@changelog" target="_blank" rel="noopener"
                                                   data-tooltip="Release notes for @FirmwareVersionFormat.ShortOrNull(step.ToVersion)">@VersionChange(step.FromVersion, step.ToVersion)</a>
                                            }
                                            else
                                            {
                                                <span class="firmware-rollout-chip chip-muted firmware-rollout-version-badge">@VersionChange(step.FromVersion, step.ToVersion)</span>
                                            }
                                        }
                                    </span>
                                }
                            </span>
                        </div>
                    }
                    @if (_preview.Plan.IncludesUniFiOsUpdate && _preview.UniFiOs is { UpdateAvailable: true } os)
                    {
                        <div class="firmware-rollout-wave">
                            <span class="firmware-rollout-wave-no">@(_preview.Plan.Waves.Count + 1)</span>
                            <span class="firmware-rollout-wave-eta">T+@Duration(_preview.Plan.UniFiOsStartOffsetSeconds)</span>
                            <span class="firmware-rollout-wave-devices">
                                <span class="firmware-rollout-wave-device">
                                    UniFi OS on @(os.Host ?? "the console")
