    private async Task ExportReportPdfAsync()
    {
        if (_report == null) return;
        _exportingPdf = true;
        StateHasChanged();
        try
        {
            var url = $"/api/firmware-rollout/reports/{_report.PlanId}/pdf";
            if (!SiteContext.IsDefault) url = SiteContextService.WithSiteParam(url, SiteContext.Slug);
            // Blob fetch instead of a plain link: a Safari PWA opens a linked PDF inline instead of
            // saving it (same reason the ISP Health export does this).
            await JS.InvokeVoidAsync("eval", $@"(async () => {{
                const r = await fetch('{url}');
                if (!r.ok) return;
                const blob = await r.blob();
                const cd = r.headers.get('content-disposition') || '';
                const m = /filename=""?([^"";]+)""?/.exec(cd);
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = m ? m[1] : 'FirmwareRollout.pdf';
                a.click();
                URL.revokeObjectURL(a.href);
            }})();");
        }
        catch { }
        finally
        {
            _exportingPdf = false;
            StateHasChanged();
        }
    }

    // ---- Visualization interop ----

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var wantsViz = (_wizardOpen && _step == 3 && _preview != null) ||
                       (_active != null && _active.Status is FirmwareRolloutStatus.Running or FirmwareRolloutStatus.Paused or FirmwareRolloutStatus.SoakWait);
        if (!wantsViz)
        {
            if (_vizMounted) await DisposeVizAsync();
            return;
        }

        try
        {
            _viz ??= await JS.InvokeAsync<IJSObjectReference>("import", VersionedJs("/js/firmware-rollout-viz.js"));
            if (!_vizMounted)
            {
                await _viz.InvokeVoidAsync("mount", "firmware-rollout-map-stage", "firmware-rollout-timeline",
                    new { storagePrefix = SiteContext.ScopeStorageKey("firmwareRollout") });
                _vizMounted = true;
                _vizMode = null;
            }

            if (_wizardOpen && _step == 3 && _preview != null && _vizMode != "planned")
            {
                var excluded = _preview.Steps.Where(s => s.State == FirmwareRolloutStepState.SkippedExcluded).Select(s => s.Mac).ToList();
                await _viz.InvokeVoidAsync("setPlan", _preview.Plan, excluded);
                _vizMode = "planned";
            }
            else if (_active != null && _vizMode != "live")
            {
                await PushLiveStateAsync();
                _vizMode = "live";
            }
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Rollout visualization unavailable");
        }
    }

    private async Task PushLiveStateAsync()
    {
        if (_viz == null || _active == null) return;
        var steps = _active.Steps.Select(s => new { deviceMac = s.Mac, state = (int)s.State }).ToList();
        var startedMs = _active.StartedAt is { } started
            ? new DateTimeOffset(DateTime.SpecifyKind(started, DateTimeKind.Utc)).ToUnixTimeMilliseconds()
            : (long?)null;
        await _viz.InvokeVoidAsync("setLiveSteps", _active.Plan, steps, startedMs);
    }

    private async Task DisposeVizAsync()
    {
        if (_viz != null && _vizMounted)
        {
            try { await _viz.InvokeVoidAsync("dispose"); }
            catch (JSDisconnectedException) { }
            catch (Exception ex) { Logger.LogDebug(ex, "Rollout visualization dispose failed"); }
        }
        _vizMounted = false;
        _vizMode = null;
    }

    // ---- Live polling ----

    private void StartPolling()
    {
        _pollTimer ??= new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    var wasActive = _active != null;
                    _active = await RolloutService.GetActivePlanAsync();
                    if (_active == null && wasActive)
                    {
                        _history = await RolloutService.GetPlanHistoryAsync();
                        await DisposeVizAsync();
                    }
                    else if (_active != null && _vizMounted)
                    {
                        await PushLiveStateAsync();
                    }
                    StateHasChanged();
                });
            }
            catch { /* prevent timer death */ }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    // ---- Display helpers ----

    private string VersionedJs(string path) => FileVersionProvider.AddFileVersionToPath("", path);

    private static string LocalTime(DateTime? utc) =>
        utc is { } t ? DateTime.SpecifyKind(t, DateTimeKind.Utc).ToLocalTime().ToString("ddd MMM d, h:mm tt") : "-";

    private static string Duration(int seconds)
    {
        var h = seconds / 3600; var m = (int)Math.Round(seconds % 3600 / 60.0);
        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }

    private static string ChipLabel(FirmwareRolloutStepState state) => state switch
    {
        FirmwareRolloutStepState.Pending => "Queued",
        FirmwareRolloutStepState.Held => "Held for canary",
        FirmwareRolloutStepState.Commanded => "Upgrading",
        FirmwareRolloutStepState.Down => "Rebooting",
        FirmwareRolloutStepState.BackOnline => "Back online",
        FirmwareRolloutStepState.CoolDown => "Cooling down",
        FirmwareRolloutStepState.LitmusPassed => "Upgraded",
        FirmwareRolloutStepState.RegressionFlagged => "Check resources",
        FirmwareRolloutStepState.Failed => "Failed",
        FirmwareRolloutStepState.SkippedExcluded => "Excluded",
        FirmwareRolloutStepState.AbortedSku => "Skipped (model aborted)",
        _ => state.ToString(),
    };

    private static string ChipClass(FirmwareRolloutStepState state) => state switch
    {
        FirmwareRolloutStepState.LitmusPassed => "chip-success",
        FirmwareRolloutStepState.Failed or FirmwareRolloutStepState.AbortedSku => "chip-danger",
        FirmwareRolloutStepState.RegressionFlagged => "chip-warning",
        FirmwareRolloutStepState.Commanded or FirmwareRolloutStepState.Down
            or FirmwareRolloutStepState.BackOnline or FirmwareRolloutStepState.CoolDown => "chip-active",
        _ => "chip-muted",
    };

    private static string PlanChipLabel(FirmwareRolloutStatus status) => status switch
    {
        FirmwareRolloutStatus.Reported => "Completed",
        FirmwareRolloutStatus.SoakWait => "Soaking",
        FirmwareRolloutStatus.Aborted => "Aborted",
        FirmwareRolloutStatus.Failed => "Failed",
        _ => status.ToString(),
    };

    private static string PlanChipClass(FirmwareRolloutStatus status) => status switch
    {
        FirmwareRolloutStatus.Reported => "chip-success",
        FirmwareRolloutStatus.Aborted or FirmwareRolloutStatus.Failed => "chip-danger",
        _ => "chip-muted",
    };

    public async ValueTask DisposeAsync()
    {
        _pollTimer?.Dispose();
        await DisposeVizAsync();
        if (_viz != null)
        {
            try { await _viz.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
