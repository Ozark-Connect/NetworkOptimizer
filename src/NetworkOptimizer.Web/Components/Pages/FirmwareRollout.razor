                    <div class="table-responsive">
                        <table class="data-table">
                            <thead><tr><th>Device</th><th>Model</th><th class="hide-mobile">From</th><th>To</th><th>Downtime</th><th>Outcome</th></tr></thead>
                            <tbody>
                                @foreach (var step in _report.Steps)
                                {
                                    <tr>
                                        <td>@step.Name</td>
                                        <td>@step.DisplayModel</td>
