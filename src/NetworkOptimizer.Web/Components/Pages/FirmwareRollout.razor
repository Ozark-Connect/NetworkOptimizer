                }
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _wizardOpen;
    private int _step = 1;
    private string? _wizardError;
    private string? _controlNotice;

    private int SoakHours => _settings?.SoakHours > 0 ? _settings.SoakHours : 2;

    /// <summary>The console's phases run on the gateway when the gateway IS the console.</summary>
    private string ConsoleRowModel => _active?.Steps
        .FirstOrDefault(s => string.Equals(s.Mac, _active.Plan.ConsoleMac, StringComparison.OrdinalIgnoreCase))
        ?.DisplayModel ?? "Console";

    /// <summary>
    /// A console phase reports progress as triggered/settled plus an outcome word, not as a step
    /// state, so it needs its own reading of the same three questions the chips answer.
    /// </summary>
    private static string ConsoleChipLabel(RolloutConsoleStepState state)
    {
        if (!state.Triggered) return "Queued";
        if (!state.Settled) return "Upgrading";
        return state.Outcome switch
        {
            "updated" => "Upgraded",
            "nothing-to-update" => "Already current",
            "unchanged" => "No change",
            "refused" => "Refused",
            "stuck" => "Stuck",
            "skipped" => "Skipped",
            _ => "Done",
        };
    }

    private static string ConsoleChipClass(RolloutConsoleStepState state)
    {
        if (!state.Triggered) return "chip-muted";
        if (!state.Settled) return "chip-active";
        return state.Outcome switch
        {
            "updated" => "chip-success",
            "refused" or "stuck" => "chip-danger",
            _ => "chip-muted",
        };
    }
    private bool _exportingPdf;

    private FirmwareRolloutSettings? _settings;
    private RolloutPreviewView? _preview;
    private RolloutPlanView? _active;
    private List<RolloutPlanSummaryView> _history = [];
    private RolloutReportView? _report;
    private RolloutReport? _reportTyped;

    private string _scheduleMode = "once";
    private int _startOffsetHours;
    private bool _startMoved;
    private string _exclusionSearch = string.Empty;
    private readonly HashSet<string> _exMacs = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _exSkus = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _exTypes = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> _typeChannels = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> _skuChannels = new(StringComparer.OrdinalIgnoreCase);

    private IJSObjectReference? _viz;
    private bool _vizMounted;
    private string? _vizMode;
    private System.Threading.Timer? _pollTimer;

    private static readonly (string Code, string Label)[] AllTypeRows =
    [
        ("uap", "Access Points"),
        ("usw", "Switches"),
        ("ugw", "Gateways"),
    ];

    /// <summary>
    /// Device-type rows worth offering. On a Cloud Gateway site the gateway is the console and its
    /// firmware is the UniFi OS update, so a separate Gateways row would set a channel that never
    /// applies to anything.
    /// </summary>
    private IEnumerable<(string Code, string Label)> TypeChannelRows =>
        _preview?.HasCloudGateway == true ? AllTypeRows.Where(r => r.Code != "ugw") : AllTypeRows;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        try
        {
            _settings = await RolloutService.GetSettingsAsync();
            _active = await RolloutService.GetActivePlanAsync();
            _history = await RolloutService.GetPlanHistoryAsync();
            // Any live plan polls, not just a running one. A scheduled or announced plan starts
            // on its own clock, and without a timer nothing re-renders to notice it happened -
            // somebody watching the page through the start time would sit on a stale view.
            if (_active != null) StartPolling();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load firmware rollout state");
        }
    }

    // ---- Wizard flow ----

    private async Task OpenWizardAsync()
    {
        _busy = true;
        _wizardError = null;
        StateHasChanged();
        try
        {
            _settings = await RolloutService.GetSettingsAsync();
            LoadWorkingSets();
            // First preview: channel options, device models, and console warnings for step 1.
            _preview = await RolloutService.BuildPreviewAsync(WorkingSettings());
            SeedChannelsFromConsole();
            SeedStartFromProposal();
            _wizardOpen = true;
            _step = 1;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Rollout wizard failed to open");
            _wizardError = "Could not read the console. Check the UniFi Console Connection in Settings and try again.";
            _wizardOpen = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private void CloseWizard()
    {
        _wizardOpen = false;
        _preview = null;
        _wizardError = null;
        _ = DisposeVizAsync();
    }

    private async Task GoToPreviewAsync()
    {
        _busy = true;
        _wizardError = null;
        StateHasChanged();
        try
        {
            _preview = await RolloutService.BuildPreviewAsync(WorkingSettings());
            SeedStartFromProposal();
            _step = 3;
            _vizMode = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Rollout preview failed");
            _wizardError = "The preview could not be built. The console may be briefly unreachable - try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void BackFromPreview()
    {
        _step = 2;
        _ = DisposeVizAsync();
    }

    private string CommitLabel => _scheduleMode switch
    {
        "now" => "Start Now",
        "autopilot" => "Turn On Autopilot",
        _ => "Schedule",
    };

    private async Task CommitAsync()
    {
        if (_settings == null) return;
        _busy = true;
        _wizardError = null;
        StateHasChanged();
        try
        {
            var settings = WorkingSettings();
            switch (_scheduleMode)
            {
                case "now":
                    settings.Mode = FirmwareRolloutMode.ManualOnly;
                    await RolloutService.StartNowAsync(settings, overrideHealthGate: true);
                    break;
                case "autopilot":
                    settings.Mode = FirmwareRolloutMode.Autopilot;
                    await RolloutService.SaveSettingsAsync(settings);
                    break;
                default:
                    settings.Mode = FirmwareRolloutMode.ManualOnly;
                    await RolloutService.SchedulePlanAsync(settings, SelectedStartUtc);
                    break;
            }
            _wizardOpen = false;
            await DisposeVizAsync();
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _wizardError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Committing the rollout failed");
            _wizardError = "Starting the rollout failed. See the logs for details.";
        }
        finally
        {
            _busy = false;
        }
    }

    // ---- Settings working copies ----

    private void LoadWorkingSets()
    {
        var ex = RolloutExclusions.Parse(_settings?.ExclusionsJson);
        _exMacs.Clear(); foreach (var m in ex.Macs) _exMacs.Add(m);
        _exSkus.Clear(); foreach (var s in ex.Skus) _exSkus.Add(s);
        _exTypes.Clear(); foreach (var t in ex.DeviceTypes) _exTypes.Add(t);
        _typeChannels = ParseMap(_settings?.PerDeviceTypeChannelsJson);
        _skuChannels = ParseMap(_settings?.PerSkuChannelsJson);
        _scheduleMode = _settings?.Mode == FirmwareRolloutMode.Autopilot ? "autopilot" : "once";
    }

    private FirmwareRolloutSettings WorkingSettings()
    {
        var s = _settings!;
        s.ExclusionsJson = System.Text.Json.JsonSerializer.Serialize(new
        {
            macs = _exMacs.ToList(),
            skus = _exSkus.ToList(),
            deviceTypes = _exTypes.ToList(),
        });
        s.PerDeviceTypeChannelsJson = System.Text.Json.JsonSerializer.Serialize(_typeChannels);
        s.PerSkuChannelsJson = System.Text.Json.JsonSerializer.Serialize(_skuChannels);
        return s;
    }

    private static Dictionary<string, string> ParseMap(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        try
        {
            var map = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(json);
            return map == null ? new(StringComparer.OrdinalIgnoreCase) : new(map, StringComparer.OrdinalIgnoreCase);
        }
        catch (System.Text.Json.JsonException)
        {
            return new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }
    }

    /// <summary>
    /// What the single channel select covers on THIS site. UniFi OS is only named where one is
    /// ours to update, so a UXG site is never told about a surface it does not have.
    /// </summary>
    private string ChannelScopeLabel
    {
        get
        {
            var surfaces = new List<string> { "UniFi Devices" };
            if (_preview?.HasCloudGateway == true) surfaces.Add("UniFi OS");
            surfaces.Add("the UniFi Network application");
            return surfaces.Count == 2
                ? $"{surfaces[0]} and {surfaces[1]}"
                : $"{surfaces[0]}, {surfaces[1]} and {surfaces[2]}";
        }
    }

    /// <summary>What else the single channel select covers, named so the lockstep is not a surprise.</summary>
    private string ConsoleSurfacesLabel
    {
        get
        {
            var surfaces = new List<string>();
            if (_settings?.IncludeUniFiNetwork == true) surfaces.Add("the UniFi Network application");
            if (_settings?.IncludeUniFiOs == true && _preview?.HasCloudGateway == true) surfaces.Add("UniFi OS");
            return surfaces.Count == 0 ? "" : ", including " + string.Join(" and ", surfaces);
        }
    }

    private static string? Blank(string? value) => string.IsNullOrEmpty(value) ? null : value;

    private string TypeChannel(string code) => _typeChannels.GetValueOrDefault(code, "");
    private void SetTypeChannel(string code, string? channel)
    {
        if (string.IsNullOrEmpty(channel)) _typeChannels.Remove(code);
        else _typeChannels[code] = channel;
    }

    private string SkuChannel(string model) => _skuChannels.GetValueOrDefault(model, "");
    private void SetSkuChannel(string model, string? channel)
    {
        if (string.IsNullOrEmpty(channel)) _skuChannels.Remove(model);
        else _skuChannels[model] = channel;
    }

    private void ToggleSet(HashSet<string> set, string value, ChangeEventArgs e)
    {
        if (e.Value is true) set.Add(value);
        else set.Remove(value);
    }

    /// <summary>Excluded by its own rule or by one covering its model or type.</summary>
    private bool IsExcluded(RolloutDeviceView device) =>
        _exMacs.Contains(device.Mac) || SkuExcluded(device) || _exTypes.Contains(device.DeviceType);

    /// <summary>
    /// Whether a stored model rule covers this device, matched on the family so a rule written on
    /// one color covers the same hardware in another. The planner already matches this way, and a
    /// checkbox that disagreed with it would be showing something the rollout will not do.
    /// </summary>
    private bool SkuExcluded(RolloutDeviceView device)
    {
        if (_exSkus.Contains(device.Model)) return true;
        var family = ModelFamilyOf(device);
        return _exSkus.Any(s => string.Equals(
            UniFiProductDatabase.GetModelFamily(s), family, StringComparison.OrdinalIgnoreCase));
    }

    private static string ModelFamilyOf(RolloutDeviceView device) =>
        UniFiProductDatabase.GetModelFamily(device.Model, device.DisplayModel);

    /// <summary>
    /// Why a device is excluded when the rule is not its own MAC, else null. Doubles as the test
    /// for whether this row's checkbox can clear it, which it cannot.
    /// </summary>
    private string? DerivedExclusion(RolloutDeviceView device)
    {
        if (_exMacs.Contains(device.Mac)) return null;
        if (SkuExcluded(device)) return $"Excluded by the rule for every {ModelFamilyOf(device)}.";
        if (_exTypes.Contains(device.DeviceType)) return "Excluded by the rule for this device type.";
        return null;
    }

    /// <summary>
    /// Adds or clears a model rule for the device's whole family. Removing has to sweep the family
    /// too: the stored rule may name the other color's code, and Include would otherwise appear to
    /// do nothing.
    /// </summary>
    private void ToggleSku(RolloutDeviceView device)
    {
        var family = ModelFamilyOf(device);
        var existing = _exSkus.Where(s => string.Equals(
            UniFiProductDatabase.GetModelFamily(s), family, StringComparison.OrdinalIgnoreCase)).ToList();

        if (existing.Count > 0)
            foreach (var s in existing) _exSkus.Remove(s);
        else
            _exSkus.Add(device.Model);
    }

    /// <summary>
    /// Every model on the site, one row per family and labeled by product name. A site running the
    /// same AP in two colors gets one control rather than two that quietly govern each other, since
    /// the planner resolves both to one key.
    /// </summary>
    private List<(string Code, string Label)> SiteModels =>
        (_preview?.Devices ?? [])
            .Where(d => !string.IsNullOrEmpty(d.Model))
            .GroupBy(d => UniFiProductDatabase.GetModelFamily(d.Model, d.DisplayModel), StringComparer.OrdinalIgnoreCase)
            .Select(g => (Code: g.First().Model, Label: g.Key))
            .OrderBy(m => m.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IEnumerable<RolloutDeviceView> FilteredExclusionCandidates =>
        (_preview?.Devices ?? [])
            .Where(d => string.IsNullOrEmpty(_exclusionSearch)
                || d.Name.Contains(_exclusionSearch, StringComparison.OrdinalIgnoreCase)
                || d.DisplayModel.Contains(_exclusionSearch, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(d => d.Upgradable)
            .ThenBy(d => d.Name, StringComparer.OrdinalIgnoreCase);

    // ---- Schedule ----

    private int ProposalOffsetHours()
    {
        if (_preview?.ProposedWindow?.StartUtc is not { } start || start == default) return 24;
        var hours = (int)Math.Round((start - DateTime.UtcNow).TotalHours);
        return Math.Clamp(hours, 1, 167);
    }

    private void SetStartOffset(string? raw)
    {
        if (!int.TryParse(raw, out var v)) return;
        _startOffsetHours = Math.Clamp(v, 0, 167);
        _startMoved = true;
    }

    /// <summary>
    /// Open on what the console is set to today. The single select takes the least aggressive of
    /// the three channels in use, so opening the wizard never proposes moving a surface onto a
    /// riskier channel than it is on; a surface that sits somewhere else is pinned as an override.
    /// Only channels that could actually be read count - a surface whose channel is unknown must
    /// not vote, or an unreadable one drags the whole site back to Official.
    /// </summary>
    private void SeedChannelsFromConsole()
    {
        if (_settings == null || _preview == null) return;

        var device = _preview.Channels.CurrentDeviceChannel;
        var app = _preview.Channels.CurrentNetworkAppChannel;
        var os = _preview.Channels.CurrentUniFiOsChannel;

        var inUse = new[] { device, app, os }.Where(c => !string.IsNullOrWhiteSpace(c)).ToList();
        if (inUse.Count == 0)
        {
            Logger.LogInformation("Firmware Rollout: the console reported no channels, so the wizard opens on {Channel}", _settings.GlobalChannel);
            return;
        }

        _settings.GlobalChannel = inUse.OrderBy(ChannelRisk).First()!;
        _settings.NetworkAppChannel = PinIfDifferent(app);
        _settings.UniFiOsChannel = PinIfDifferent(os);

        Logger.LogInformation(
            "Firmware Rollout: console channels are devices={Device}, network={App}, os={Os}; wizard opens on {Global} with network override {AppPin} and OS override {OsPin}",
            device ?? "unknown", app ?? "unknown", os ?? "unknown",
            _settings.GlobalChannel, _settings.NetworkAppChannel ?? "none", _settings.UniFiOsChannel ?? "none");

        string? PinIfDifferent(string? channel) =>
            !string.IsNullOrWhiteSpace(channel) && !SameChannel(channel, _settings.GlobalChannel) ? channel : null;
    }

    /// <summary>Stable first, then release candidate, then early access.</summary>
    private static int ChannelRisk(string? channel) => channel?.ToLowerInvariant() switch
    {
        FirmwareChannels.Release => 0,
        FirmwareChannels.ReleaseCandidate => 1,
        FirmwareChannels.Beta => 2,
        _ => 3,
    };

    private static bool SameChannel(string? a, string? b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    /// <summary>Park the slider on the proposed window until the user drags it somewhere else.</summary>
    private void SeedStartFromProposal()
    {
        if (!_startMoved) _startOffsetHours = ProposalOffsetHours();
    }

    /// <summary>
    /// Hours from now, snapped to the hour. Computed in UTC so a site in another timezone is not
    /// scheduled against this server's clock; the labels convert back to the site's own hours.
    /// </summary>
    private DateTime SelectedStartUtc
    {
        get
        {
            // Start now means now, not the window that would have been proposed instead.
            if (_scheduleMode == "now") return DateTime.UtcNow;

            // Until the slider is dragged, the answer is the proposed instant itself - rounding it
            // back out of an hour offset is what made the label disagree with the suggestion.
            if (!_startMoved && _preview?.ProposedWindow?.StartUtc is { } proposed && proposed != default)
                return proposed;

            var utc = DateTime.UtcNow.AddHours(_startOffsetHours);
            return new DateTime(utc.Year, utc.Month, utc.Day, utc.Hour, 0, 0, DateTimeKind.Utc);
        }
    }

    /// <summary>
    /// The site's own reading of an instant, for the two places the decision is site-local: picking
    /// the start and watching a schedule. Times are shown in the server's zone everywhere, because
    /// an operator reads any timestamp in their own clock whether it is labelled or not, and one
    /// clock is the only way rollouts across sites can be compared. Empty when the site keeps the
    /// same hours, which is every single-site install.
    /// </summary>
    private string SiteAside(DateTime utc)
    {
        var zone = _active?.Plan.TimeZoneId ?? _preview?.Plan.TimeZoneId ?? _preview?.ProposedWindow?.TimeZoneId;
        if (string.IsNullOrWhiteSpace(zone)) return string.Empty;

        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById(zone);
            if (tz.BaseUtcOffset == TimeZoneInfo.Local.BaseUtcOffset) return string.Empty;

            var at = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), tz);
            return $" ({at:h:mm tt} at-site)";
        }
        catch (Exception ex) when (ex is TimeZoneNotFoundException or InvalidTimeZoneException)
        {
            Logger.LogDebug(ex, "Unknown site timezone {Zone}", zone);
            return string.Empty;
        }
    }

    // ---- Active plan controls ----

    private bool WaitingApproval => _active?.Plan.WaitingApprovalWave is > 0;

    private string ActiveTitle => _active?.Status switch
    {
        FirmwareRolloutStatus.Scheduled or FirmwareRolloutStatus.Announced => "Scheduled Rollout",
        FirmwareRolloutStatus.Paused => "Rollout Paused",
        FirmwareRolloutStatus.SoakWait => "Rollout Complete - Soaking",
        _ => "Rollout in Progress",
    };

    /// <summary>
    /// Postpone moves a start time by a fixed step and says nothing on its own, so a click that
    /// worked and a click that did nothing look identical - which is how one turns into several.
    /// </summary>
    private async Task PostponeAsync()
    {
        await ControlAsync(RolloutService.PostponeAsync);
        if (_active?.ScheduledStartAt is { } at)
            _controlNotice = $"Postponed. The rollout now starts {LocalTime(at)}.";
    }

    private async Task ControlAsync(Func<int, CancellationToken, Task> action)
    {
        if (_active == null) return;
        _controlNotice = null;
        _busy = true;
        try
        {
            await action(_active.Id, CancellationToken.None);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Rollout control action failed");
        }
        finally
        {
            _busy = false;
        }
    }

    private Task AbortAsync() => ControlAsync(async (id, ct) =>
    {
        await RolloutService.AbortAsync(id, ct);
        await DisposeVizAsync();
    });

    private async Task RollbackAsync(RolloutStepView step)
    {
        _busy = true;
        try
        {
            await RolloutService.RollbackStepAsync(step.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Rollback failed for {Mac}", step.Mac);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenReportAsync(int planId)
    {
        try
        {
            _report = await RolloutService.GetReportAsync(planId);
            _reportTyped = RolloutReport.Parse(_report?.ReportJson);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load rollout report {PlanId}", planId);
        }
    }

    private async Task ExportReportPdfAsync()
    {
        if (_report == null) return;
        _exportingPdf = true;
        StateHasChanged();
        try
        {
            var url = $"/api/firmware-rollout/reports/{_report.PlanId}/pdf";
            if (!SiteContext.IsDefault) url = SiteContextService.WithSiteParam(url, SiteContext.Slug);
            // Blob fetch instead of a plain link: a Safari PWA opens a linked PDF inline instead of
            // saving it (same reason the ISP Health export does this).
            await JS.InvokeVoidAsync("eval", $@"(async () => {{
                const r = await fetch('{url}');
                if (!r.ok) return;
                const blob = await r.blob();
                const cd = r.headers.get('content-disposition') || '';
                const m = /filename=""?([^"";]+)""?/.exec(cd);
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = m ? m[1] : 'FirmwareRollout.pdf';
                a.click();
                URL.revokeObjectURL(a.href);
            }})();");
        }
        catch
        {
            // A failed download is visible to the user in the browser; nothing to recover here.
        }
        finally
        {
            _exportingPdf = false;
            StateHasChanged();
        }
    }

    /// <summary>The map only has something to draw once steps are moving.</summary>
    private bool ActivePlanHasMap => _active != null && _active.Status
        is FirmwareRolloutStatus.Running or FirmwareRolloutStatus.Paused or FirmwareRolloutStatus.SoakWait;

    // ---- Visualization interop ----

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var wantsViz = (_wizardOpen && _step == 3 && _preview != null) || ActivePlanHasMap;
        if (!wantsViz)
        {
            if (_vizMounted) await DisposeVizAsync();
            return;
        }

        try
        {
            _viz ??= await JS.InvokeAsync<IJSObjectReference>("import", VersionedJs("/js/firmware-rollout-viz.js"));
            if (!_vizMounted)
            {
                await _viz.InvokeVoidAsync("mount", "firmware-rollout-map-stage", "firmware-rollout-timeline",
                    new { storagePrefix = SiteContext.ScopeStorageKey("firmwareRollout") });
                _vizMounted = true;
                _vizMode = null;
            }

            if (_wizardOpen && _step == 3 && _preview != null && _vizMode != "planned")
            {
                var excluded = _preview.Steps.Where(s => s.State == FirmwareRolloutStepState.SkippedExcluded).Select(s => s.Mac).ToList();
                var startMs = new DateTimeOffset(DateTime.SpecifyKind(SelectedStartUtc, DateTimeKind.Utc))
                    .ToUnixTimeMilliseconds();
                await _viz.InvokeVoidAsync("setPlan", _preview.Plan, excluded, startMs, TimeZoneInfo.Local.Id);
                _vizMode = "planned";
            }
            else if (_active != null && _vizMode != "live")
            {
                await PushLiveStateAsync();
                _vizMode = "live";
            }
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Rollout visualization unavailable");
        }
    }

    private async Task PushLiveStateAsync()
    {
        if (_viz == null || _active == null) return;
        var steps = _active.Steps.Select(s => new { deviceMac = s.Mac, state = (int)s.State }).ToList();
        var startedMs = _active.StartedAt is { } started
            ? new DateTimeOffset(DateTime.SpecifyKind(started, DateTimeKind.Utc)).ToUnixTimeMilliseconds()
            : (long?)null;
        await _viz.InvokeVoidAsync("setLiveSteps", _active.Plan, steps, startedMs);
    }

    private async Task DisposeVizAsync()
    {
        if (_viz != null && _vizMounted)
        {
            try { await _viz.InvokeVoidAsync("dispose"); }
            catch (JSDisconnectedException) { }
            catch (Exception ex) { Logger.LogDebug(ex, "Rollout visualization dispose failed"); }
        }
        _vizMounted = false;
        _vizMode = null;
    }

    // ---- Live polling ----

    private void StartPolling()
    {
        _pollTimer ??= new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    var wasActive = _active != null;
                    _active = await RolloutService.GetActivePlanAsync();
                    if (_active == null && wasActive)
                    {
                        _history = await RolloutService.GetPlanHistoryAsync();
                        await DisposeVizAsync();
                    }
                    else if (_active != null && _vizMounted)
                    {
                        await PushLiveStateAsync();
                    }
                    StateHasChanged();
                });
            }
            catch { /* prevent timer death */ }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    // ---- Display helpers ----

    private string VersionedJs(string path) => FileVersionProvider.AddFileVersionToPath("", path);

    private static string LocalTime(DateTime? utc) =>
        utc is { } t ? DateTime.SpecifyKind(t, DateTimeKind.Utc).ToLocalTime().ToString("ddd MMM d, h:mm tt") : "-";

    private static string Duration(int seconds)
    {
        // Round to whole minutes first so 59m 55s reads 1h 0m, not 1h 60m.
        var totalMinutes = (int)Math.Round(seconds / 60.0);
        var h = totalMinutes / 60; var m = totalMinutes % 60;
        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }

    private static string ChipLabel(FirmwareRolloutStepState state) => state switch
    {
        FirmwareRolloutStepState.Pending => "Queued",
        FirmwareRolloutStepState.Held => "Held for canary",
        FirmwareRolloutStepState.Commanded => "Starting",
        FirmwareRolloutStepState.Down => "Upgrading",
        FirmwareRolloutStepState.BackOnline => "Back online",
        FirmwareRolloutStepState.CoolDown => "Cooling down",
        FirmwareRolloutStepState.LitmusPassed => "Upgraded",
        FirmwareRolloutStepState.RegressionFlagged => "Check resources",
        FirmwareRolloutStepState.Failed => "Failed",
        FirmwareRolloutStepState.SkippedExcluded => "Excluded",
        FirmwareRolloutStepState.AbortedSku => "Skipped (model aborted)",
        _ => state.ToString(),
    };

    private static string ChipClass(FirmwareRolloutStepState state) => state switch
    {
        FirmwareRolloutStepState.LitmusPassed => "chip-success",
        FirmwareRolloutStepState.Failed or FirmwareRolloutStepState.AbortedSku => "chip-danger",
        FirmwareRolloutStepState.RegressionFlagged => "chip-warning",
        FirmwareRolloutStepState.Commanded or FirmwareRolloutStepState.Down
            or FirmwareRolloutStepState.BackOnline or FirmwareRolloutStepState.CoolDown => "chip-active",
        _ => "chip-muted",
    };

    /// <summary>Full version and current firmware behind the update badge.</summary>
    private static string UpdateTooltip(RolloutDeviceView device)
    {
        var current = FirmwareVersionFormat.ShortOrNull(device.CurrentVersion) ?? "unknown";
        var target = FirmwareVersionFormat.ShortOrNull(device.TargetVersion);
        return target == null
            ? $"An update is waiting. Running {current}."
            : $"Update waiting: {target}. Running {current}.";
    }

    /// <summary>"5.1.28 -> 5.1.30", or just the target when the current version is unknown.</summary>
    private static string VersionChange(string? from, string? to)
    {
        var target = FirmwareVersionFormat.ShortOrNull(to);
        var current = FirmwareVersionFormat.ShortOrNull(from);
        if (target == null) return current ?? "";
        return current == null || current == target ? target : $"{current} → {target}";
    }

    /// <summary>
    /// Whether this plan would do anything. A console update counts: on a Cloud Gateway the
    /// UniFi OS build waits while every device reports nothing pending.
    /// </summary>
    private bool HasSomethingToDo =>
        _preview != null
        && (_preview.UpgradableCount > 0
            || _preview.Plan.IncludesUniFiNetworkUpdate
            || _preview.Plan.IncludesUniFiOsUpdate);

    private string? ChangelogFor(string mac) =>
        _preview?.Steps.FirstOrDefault(s => string.Equals(s.Mac, mac, StringComparison.OrdinalIgnoreCase))?.ChangelogUrl;

    private static string OutcomeChipClass(string outcome) => outcome switch
    {
        "Upgraded" => "chip-success",
        "Failed" => "chip-danger",
        "Regression flagged" or "Rolled back" => "chip-warning",
        _ => "chip-muted",
    };

    private static string PlanChipLabel(FirmwareRolloutStatus status) => status switch
    {
        FirmwareRolloutStatus.Reported => "Completed",
        FirmwareRolloutStatus.SoakWait => "Soaking",
        FirmwareRolloutStatus.Aborted => "Aborted",
        FirmwareRolloutStatus.Failed => "Failed",
        _ => status.ToString(),
    };

    private static string PlanChipClass(FirmwareRolloutStatus status) => status switch
    {
        FirmwareRolloutStatus.Reported => "chip-success",
        FirmwareRolloutStatus.Aborted or FirmwareRolloutStatus.Failed => "chip-danger",
        _ => "chip-muted",
    };

    public async ValueTask DisposeAsync()
    {
        _pollTimer?.Dispose();
        await DisposeVizAsync();
        if (_viz != null)
        {
            try { await _viz.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
