@rendermode InteractiveServer
@using NetworkOptimizer.Storage.Models.Identity
@using NetworkOptimizer.Web.Services.Authorization
@using NetworkOptimizer.Web.Services.Identity
@inject NavigationManager Navigation
@inject SiteContextService SiteContext
@inject ICallerContext Caller
@inject ISiteAccessFilter SiteAccess

@if (_siteResolved)
{
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @* Gate 4 (design doc 06): page [Authorize] policies decide navigation. The policies succeed
           when the install has authentication disabled, so nothing changes for those installs. *@
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <div class="page-content">
                    <div class="empty-state">
                        <div class="empty-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                            </svg>
                        </div>
                        <h2>You do not have access to this page</h2>
                        <p class="page-description">
                            Ask an administrator for the access you need, or head back to the dashboard.
                        </p>
                        <a class="btn btn-primary" href="/">Go to Dashboard</a>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
}
<SiteTabSync />

@code {
    private bool _siteResolved;

    protected override async Task OnInitializedAsync()
    {
        // Pin this scope to the site in the tab's URL before the Router renders
        // anything that could resolve the site context. The circuit's WebSocket
        // upgrade request only carries the shared site cookie, so without this pin
        // every tab of the browser would collapse onto the same site.
        SiteContext.PinFromUri(Navigation.Uri);

        // A circuit is its own DI scope, so the request middleware's correction does not reach it and
        // the pin above has to be re-checked here. Both short-circuits below are deliberately
        // synchronous: an install with authentication off, and any Admin, can see every site, so they
        // never gate their first render and never flash an empty page while a check resolves.
        var caller = Caller.Current;
        if (caller is null || caller.AuthenticationDisabled || caller.Principal is null
            || caller.Principal.IsInRole(Roles.Admin))
        {
            _siteResolved = true;
            return;
        }

        if (!await SiteAccess.IsAuthorizedAsync(SiteContext.Slug))
            SiteContext.OverrideSite(await SiteAccess.FallbackSlugAsync());

        _siteResolved = true;
    }
}
