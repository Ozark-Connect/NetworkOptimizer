@inject NavigationManager NavigationManager
@inject NetworkOptimizer.Web.Services.ISiteManagementService SiteManagement
@implements IDisposable

<nav class="nav-menu">
    <ul class="nav-list">
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <img src="/icons/chart-v2.png" alt="" class="nav-icon-img" />
                <span class="nav-text">Dashboard</span>
            </NavLink>
        </li>
        @if (_multiSiteEnabled)
        {
            <li class="nav-item" @onclick="HandleNavClick">
                <NavLink class="nav-link" href="/sites">
                    <img src="/icons/sites.png" alt="" class="nav-icon-img" />
                    <span class="nav-text">Sites</span>
                </NavLink>
            </li>
        }
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/monitoring">
                <img src="/icons/port-scan.png" alt="" class="nav-icon-img" />
                <span class="nav-text">Monitoring</span>
            </NavLink>
        </li>
        <li class="nav-item nav-sub-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/network-tools">
                <span class="nav-sub-icon">└</span>
                <span class="nav-text">Network Tools</span>
            </NavLink>
        </li>
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/config-optimizer">
                <img src="/icons/tools.png" alt="" class="nav-icon-img" />
                <span class="nav-text">Config Optimizer</span>
            </NavLink>
        </li>
        <li class="nav-item nav-sub-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/perf-tweaks">
                <span class="nav-sub-icon">└</span>
                <span class="nav-text">Performance Tweaks</span>
            </NavLink>
        </li>
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/wifi-optimizer">
                <img src="/icons/wifi-optimizer.png" alt="" class="nav-icon-img" />
                <span class="nav-text">Wi-Fi Optimizer</span>
            </NavLink>
        </li>
        <li class="nav-item nav-sub-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/client-dashboard">
                <span class="nav-sub-icon">└</span>
                <span class="nav-text">Client Performance</span>
            </NavLink>
        </li>
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/audit">
                <img src="/icons/shield-v2.png" alt="" class="nav-icon-img" />
                <span class="nav-text">Security Audit</span>
            </NavLink>
        </li>
        <li class="nav-item nav-sub-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/upnp-inspector">
                <span class="nav-sub-icon">└</span>
                <span class="nav-text">UPnP Inspector</span>
            </NavLink>
        </li>
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/threats">
                <img src="/icons/threats.png" alt="" class="nav-icon-img" />
                <span class="nav-text">Threat Intelligence</span>
            </NavLink>
        </li>
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/sqm">
                <img src="/icons/sqm-v3.png" alt="" class="nav-icon-img" />
                <span class="nav-text">Adaptive SQM</span>
            </NavLink>
        </li>
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/wan-steering">
                <img src="/icons/wan-steering.png" alt="" class="nav-icon-img" />
                <span class="nav-text">WAN Steering</span>
            </NavLink>
        </li>
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/wan-speedtest">
                <img src="/icons/speed-wan.png" alt="" class="nav-icon-img" />
                <span class="nav-text">WAN Speed Test</span>
            </NavLink>
        </li>
        <li class="nav-item nav-sub-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/client-wan-speedtest">
                <span class="nav-sub-icon">└</span>
                <span class="nav-text">Client WAN Test</span>
            </NavLink>
        </li>
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/speedtest">
                <img src="/icons/speed-v4.png" alt="" class="nav-icon-img" />
                <span class="nav-text">LAN Speed Test</span>
            </NavLink>
        </li>
        <li class="nav-item nav-sub-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/client-speedtest">
                <span class="nav-sub-icon">└</span>
                <span class="nav-text">Client Speed Test</span>
            </NavLink>
        </li>
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/alerts">
                <img src="/icons/alerts.png" alt="" class="nav-icon-img" />
                <span class="nav-text">Alerts & Schedule</span>
            </NavLink>
        </li>
        <li class="nav-item" @onclick="HandleNavClick">
            <NavLink class="nav-link" href="/settings">
                <img src="/icons/settings-v2.png" alt="" class="nav-icon-img" />
                <span class="nav-text">Settings</span>
            </NavLink>
        </li>
        @* The top bar runs out of room on a phone, so logout moves in here and the header button
           hides - see .nav-item-logout. A form post for the same reason as the header's. *@
        <AuthorizeView>
            <Authorized>
                <li class="nav-item nav-item-logout">
                    <form method="post" action="/api/auth/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link nav-logout-btn">
                            <span class="nav-logout-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                                </svg>
                            </span>
                            <span class="nav-text">Logout</span>
                        </button>
                    </form>
                </li>
            </Authorized>
        </AuthorizeView>
    </ul>
</nav>

@code {
    [Parameter]
    public Action? OnNavigate { get; set; }

    private bool _multiSiteEnabled;

    protected override async Task OnInitializedAsync()
    {
        _multiSiteEnabled = await SiteManagement.IsMultiSiteEnabledAsync();
    }

    private void HandleNavClick()
    {
        OnNavigate?.Invoke();
    }

    public void Dispose()
    {
        // No cleanup needed
    }
}
