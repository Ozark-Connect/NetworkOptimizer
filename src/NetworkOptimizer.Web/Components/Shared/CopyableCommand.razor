@* A command block with a copy button in its upper right. The commands we print are meant to be run
   somewhere else - on a gateway, on an agent host - so selecting one by hand out of a wrapped <pre>
   is the fiddliest step of the whole flow. Feedback is the same tick swap the account key uses. *@

<div class="code-copy-block">
    <pre><code>@Text</code></pre>
    <button type="button" class="code-copy-btn" data-tooltip="@Tooltip" data-tooltip-hover-only
            onclick="copyFromCodeBlock(this)" aria-label="@Tooltip">
        <span class="copy-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
            </svg>
        </span>
        <span class="copy-check" style="display:none;">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
        </span>
    </button>
</div>

@code {
    /// <summary>The command to show, and the exact text the button puts on the clipboard.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    /// <summary>Tooltip on the button; say what is being copied when a page shows several.</summary>
    [Parameter] public string Tooltip { get; set; } = "Copy the command";
}
