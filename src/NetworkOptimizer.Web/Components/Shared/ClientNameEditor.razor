@using NetworkOptimizer.Web.Services
@inject IClientSettingsService ClientSettings
@inject ILogger<ClientNameEditor> Logger

@* Inline rename for a client. The page's own name element is the child content. *@
<InlineEditField Class="@Class" Tooltip="Rename client in UniFi Network" Placeholder="@Hostname"
                 Load="@(() => Task.FromResult(Name ?? ""))" Save="SaveAsync">
    @ChildContent
</InlineEditField>

@code {
    /// <summary>The client's MAC address.</summary>
    [Parameter, EditorRequired] public string Mac { get; set; } = "";

    /// <summary>The alias to start editing from; empty when the client has none.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Shown as the field's placeholder: what UniFi Network falls back to when the alias is cleared.</summary>
    [Parameter] public string? Hostname { get; set; }

    /// <summary>Extra class on the wrapper around the name and the pencil.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The page's name element, shown when not editing.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Called with the alias written and the name UniFi Network now shows.</summary>
    [Parameter] public EventCallback<(string Alias, string Shown)> OnRenamed { get; set; }

    private async Task<string?> SaveAsync(string alias)
    {
        if (alias == (Name ?? "")) return null;
        if (alias.Length > ClientSettingsService.MaxNameLength) return ClientSettingsService.NameTooLongMessage;
        try
        {
            var shown = await ClientSettings.RenameAsync(Mac, alias);
            await OnRenamed.InvokeAsync((alias, shown));
            return null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Client rename failed for {Mac}", Mac);
            return ClientSettingsService.Describe(ex, "Could not rename the client in UniFi Network.");
        }
    }
}
