@using NetworkOptimizer.Threats.Blocking
@inject IThreatBlockingAdmin Blocking
@inject NavigationManager Nav

@* Threat Intelligence - Overview: the recommended protection setup for the site in context, in
   the order it should be done. Folds to one line once complete. *@

@if (_status != null && !_status.Hidden)
{
    @if (_status.Complete)
    {
        <div class="protection-setup-done">
            <span class="status-dot online"></span>
            <span>Protection: enforcing on the gateway@(_status.WafConnected ? " and the WAF" : "").</span>
            <a href="/settings#automatic-blocking">Settings</a>
        </div>
    }
    else
    {
        <div class="card card-spaced protection-setup">
            <div class="card-header">
                <h3 class="card-title">Protection Setup</h3>
                <span class="protection-setup-count">@Done of 4 done</span>
            </div>
            <div class="card-body">
                <ul class="protection-steps">
                    <li class="@StepClass(_status.EventsSeen)">
                        <span class="protection-step-text">
                            @if (_status.EventsSeen)
                            {
                                <text>Threat Intelligence is reading your gateway's events</text>
                            }
                            else
                            {
                                <text>No gateway threat events in the last 7 days</text>
                            }
                        </span>
                    </li>
                    <li class="@StepClass(_status.WafConnected, optional: true)">
                        <span class="protection-step-text">
                            @if (_status.WafConnected)
                            {
                                <text>Web Application Firewall connected</text>
                            }
                            else
                            {
                                <text>Web Application Firewall (optional): inspects requests to the apps you host and blocks attackers behind Cloudflare</text>
                            }
                        </span>
                        @if (!_status.WafConnected)
                        {
                            <SiteAdminOnly>
                                <a class="btn btn-sm btn-contrast" href="/settings#waf">Connect</a>
                            </SiteAdminOnly>
                        }
                    </li>
                    <li class="@StepClass(_status.SiteAddresses > 0)">
                        <span class="protection-step-text">
                            Trusted Sources: @Plural(_status.TrustedSites, "site", "sites"), @Plural(_status.TrustedAddresses, "address", "addresses"), @Plural(_status.ExtraAddresses, "extra address", "extra addresses"). Never blocked.
                        </span>
                        <SiteAdminOnly>
                            <a class="btn btn-sm btn-contrast" href="/settings#trusted-sources">Review</a>
                        </SiteAdminOnly>
                    </li>
                    <li class="@StepClass(_status.Mode == BlockingMode.Enforce)">
                        <span class="protection-step-text">
                            Automatic Blocking: @ModeText
                        </span>
                        @if (_status.Mode != BlockingMode.Enforce)
                        {
                            <SiteAdminOnly>
                                <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="TurnOnRecommended">Turn On Recommended</button>
                            </SiteAdminOnly>
                        }
                    </li>
                    <li class="@StepClass(_status.GatewaySetUp)">
                        <span class="protection-step-text">
                            @(_status.GatewaySetUp ? "Gateway blocking set up" : "Gateway blocking not set up. Turn On Recommended sets it up.")
                        </span>
                    </li>
                </ul>
                <p class="form-help protection-optional">
                    Optional: <a href="/settings#automatic-blocking">Cloudflare edge blocking</a>@(_status.CloudflareSetUp ? " (set up)" : "")
                    and <a href="/settings#trusted-sources">UniFi Trusted Sources groups</a>@(_status.UniFiGroups ? " (on)" : "").
                </p>
                @if (_message != null)
                {
                    <div class="alert alert-@_messageClass">@_message</div>
                }
                <SiteAdminOnly>
                    <div class="protection-hide">
                        <button class="btn btn-sm btn-tertiary" disabled="@_busy" @onclick="Hide">Hide</button>
                    </div>
                </SiteAdminOnly>
            </div>
        </div>
    }
}

@code {
    private ProtectionStatus? _status;
    private bool _busy;
    private string? _message;
    private string _messageClass = "info";

    protected override async Task OnInitializedAsync() => _status = await Blocking.GetProtectionStatusAsync();

    // The four steps the recommended setup needs; the WAF is optional and not counted.
    private int Done => new[]
    {
        _status!.EventsSeen, _status.SiteAddresses > 0, _status.Mode == BlockingMode.Enforce, _status.GatewaySetUp
    }.Count(d => d);

    private string ModeText => _status!.Mode switch
    {
        BlockingMode.Enforce => "enforcing",
        BlockingMode.DryRun => _status.WouldBlock == 1 ? "Dry Run, 1 source would be blocked now" : $"Dry Run, {_status.WouldBlock} sources would be blocked now",
        _ => "off"
    };

    private static string StepClass(bool done, bool optional = false) =>
        done ? "protection-step is-done" : optional ? "protection-step is-optional" : "protection-step";

    private static string Plural(int n, string one, string many) => n == 1 ? $"1 {one}" : $"{n} {many}";

    private async Task TurnOnRecommended()
    {
        _busy = true;
        _message = null;
        try
        {
            var r = await Blocking.TurnOnRecommendedAsync();
            _status = await Blocking.GetProtectionStatusAsync();
            _message = r.GatewayError == null ? null : $"Enforcing, but the gateway was not set up: {r.GatewayError}";
            _messageClass = "warning";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException)
        {
            _message = ex.Message;
            _messageClass = "danger";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Hide()
    {
        _busy = true;
        try
        {
            await Blocking.SetProtectionSetupHiddenAsync(true);
            _status = _status! with { Hidden = true };
        }
        finally
        {
            _busy = false;
        }
    }
}
