@using NetworkOptimizer.Threats.Blocking
@using NetworkOptimizer.Threats.WanFlood
@using NetworkOptimizer.Web.Services.WanFlood
@inject IThreatBlockingAdmin Blocking
@inject IWanFloodAdmin WanFlood
@inject IWafConnectionAdmin WafAdmin
@inject NavigationManager Nav
@inject SiteContextService SiteContext

@* Threat Intelligence - Overview: the recommended protection setup for the site in context, in
   the order it should be done. Folds to one line once complete. *@

@if (_status != null && !_status.Hidden)
{
    @if (AllComplete)
    {
        <div class="protection-setup-done">
            <span class="status-dot online"></span>
            <span>Protection: blocking on @EnforcingOn@(FloodDone ? " + WAN Flood Protection on" : "").</span>
            <a href="/settings#automatic-blocking">Settings</a>
        </div>
    }
    else
    {
        <div class="card card-spaced protection-setup" data-tour="protection-setup">
            <div class="card-header">
                <h3 class="card-title">Protection Setup</h3>
                <span class="protection-setup-count">@Done of @TotalSteps done</span>
            </div>
            <div class="card-body">
                <ul class="protection-steps">
                    <li class="@StepClass(_status.EventsSeen)">
                        <span class="protection-step-text">
                            @if (_status.EventsSeen)
                            {
                                <text>Threat Intelligence is reading your gateway's events</text>
                            }
                            else
                            {
                                <text>No gateway threat events in the last 7 days</text>
                            }
                        </span>
                    </li>
                    <li class="@StepClass(_status.WafConnected, optional: true)">
                        <span class="protection-step-text">
                            @if (_status.WafConnected && _status.WafDetectDays >= 7)
                            {
                                <text>Web Application Firewall: @_status.WafDetectDays days in Detection Only. Review its detections, then switch to Blocking.</text>
                            }
                            else if (_status.WafConnected)
                            {
                                <text>Web Application Firewall connected@(_status.WafMode == "block" ? ", blocking" : _status.WafMode == "detect" ? ", Detection Only" : "")</text>
                            }
                            else
                            {
                                <text>Web Application Firewall (optional): inspects requests to every app you host and blocks attacks, reached directly or through Cloudflare</text>
                            }
                        </span>
                        @if (!_status.WafConnected)
                        {
                            <SiteAdminOnly>
                                <a class="btn btn-sm btn-contrast" href="/settings#waf">Connect</a>
                            </SiteAdminOnly>
                        }
                        else if (_status.WafDetectDays >= 7)
                        {
                            <a class="btn btn-sm btn-contrast" href="/threats/waf?tab=events">Review</a>
                            <SiteAdminOnly>
                                <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="SwitchWafToBlock">Switch to Blocking</button>
                            </SiteAdminOnly>
                        }
                    </li>
                    <li class="@StepClass(_status.SiteAddresses > 0)">
                        <span class="protection-step-text">
                            Trusted Sources: @Plural(_status.TrustedSites, "site", "sites"), @Plural(_status.TrustedAddresses, "address", "addresses"), @Plural(_status.ExtraAddresses, "extra trusted address", "extra trusted addresses"). Never blocked.
                        </span>
                        <SiteAdminOnly>
                            <a class="btn btn-sm btn-contrast" href="/settings#trusted-sources">Review</a>
                        </SiteAdminOnly>
                    </li>
                    <li class="@StepClass(_status.Mode == BlockingMode.Enforce)">
                        <span class="protection-step-text">
                            Automatic Blocking: @ModeText
                            @if (_status.Mode != BlockingMode.Enforce && _status.RecommendedNote != null)
                            {
                                <small class="form-help">@_status.RecommendedNote</small>
                            }
                        </span>
                        @if (_status.Mode != BlockingMode.Enforce)
                        {
                            <SiteAdminOnly>
                                <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="TurnOnRecommended">Turn On Recommended</button>
                            </SiteAdminOnly>
                        }
                    </li>
                    <li class="@StepClass(_status.BlockingTargetReady)">
                        <span class="protection-step-text">
                            @GatewayText
                        </span>
                    </li>
                    @if (_flood != null)
                    {
                        <li class="@StepClass(FloodDone, optional: !FloodRequired)">
                            <span class="protection-step-text">@FloodText</span>
                            @if (_flood.AgentState == WanFloodAgentState.NeedsUpdate)
                            {
                                <SiteAdminOnly>
                                    <a class="btn btn-sm btn-primary" href="@($"/settings?tab=multisite&configure={SiteContext.Slug}")">Upgrade Agent</a>
                                </SiteAdminOnly>
                            }
                            else if (_flood.Settings.Mode != WanFloodMode.Enforce)
                            {
                                <SiteAdminOnly>
                                    <a class="btn btn-sm btn-contrast" href="/settings#wan-flood-protection">Set Up</a>
                                </SiteAdminOnly>
                            }
                        </li>
                    }
                </ul>
                <p class="form-help protection-optional">
                    Optional: <a href="/settings#automatic-blocking">Cloudflare edge blocking</a>@(_status.CloudflareSetUp ? " (set up)" : "")
                    and <a href="/settings#trusted-sources">UniFi Trusted Sources Network Lists</a>@(_status.UniFiGroups ? " (on)" : "").
                </p>
                @if (_message != null)
                {
                    <div class="alert alert-@_messageClass">@_message</div>
                }
                <SiteAdminOnly>
                    <div class="protection-hide">
                        <button class="btn btn-sm btn-tertiary" disabled="@_busy" @onclick="Hide">Hide</button>
                    </div>
                </SiteAdminOnly>
            </div>
        </div>
    }
}

@code {
    private ProtectionStatus? _status;
    private bool _busy;
    private string? _message;
    private string _messageClass = "info";

    private WanFloodOverview? _flood;

    protected override async Task OnInitializedAsync()
    {
        _status = await Blocking.GetProtectionStatusAsync();
        try
        {
            _flood = await WanFlood.GetOverviewAsync();
        }
        catch (Exception)
        {
            // Optional step: without it the checklist reads as before.
            _flood = null;
        }
    }

    // Required where the gateway's On-Site Agent runs it or an agent update would; a site without one cannot
    // complete the step, so it stays optional there instead of holding the checklist open for good.
    private bool FloodRequired => _flood is { AgentCapable: true } or { AgentState: WanFloodAgentState.NeedsUpdate };
    private bool FloodDone => _flood is { AgentCapable: true, Settings.Mode: WanFloodMode.Enforce };
    private bool AllComplete => _status!.Complete && (!FloodRequired || FloodDone);
    private int TotalSteps => 4 + (FloodRequired ? 1 : 0);

    private string FloodText => _flood!.AgentState == WanFloodAgentState.NeedsUpdate
        ? "WAN Flood Protection stops floods of unsolicited traffic before they max out the gateway's CPU and stall internet access, inter-VLAN traffic, and UniFi apps. Update the gateway's On-Site Agent to turn it on."
        : _flood.NeedsUniFiOs6
            ? "WAN Flood Protection (optional): this gateway needs UniFi OS 6.0 or later to run it."
        : _flood.AgentState == WanFloodAgentState.Unsupported
            ? "WAN Flood Protection (optional): this gateway can't run it."
        : (_flood.Settings.Mode, _flood.AgentCapable) switch
    {
        (WanFloodMode.Enforce, true) => "WAN Flood Protection on, enforced by the gateway's On-Site Agent",
        (WanFloodMode.Detect, true) => "WAN Flood Protection in Detection Only. Review what it would drop on the Blocking tab, then turn it on.",
        (not WanFloodMode.Off, false) => "WAN Flood Protection is on, but no On-Site Agent on the gateway is connected to enforce it",
        (WanFloodMode.Off, true) => "WAN Flood Protection is off. A flood of unsolicited traffic can max out the gateway's CPU, stalling internet access, inter-VLAN traffic, and the UniFi apps it runs.",
        _ => "WAN Flood Protection (optional): keeps floods of unsolicited traffic from overloading the gateway. Needs the On-Site Agent on the gateway.",
    };

    // The steps the recommended setup needs; the WAF is optional and not counted. WAN flood protection
    // counts where it is required (FloodRequired).
    private int Done => new[]
    {
        _status!.EventsSeen, _status.SiteAddresses > 0, _status.Mode == BlockingMode.Enforce, _status.BlockingTargetReady
    }.Count(d => d) + (FloodRequired && FloodDone ? 1 : 0);

    private string GatewayText => _status!.GatewaySetUp
        ? "Gateway blocking configured"
        : _status.WafConnected && _status.WafTarget
            ? "Blocking through the WAF. Gateway blocking is not set up; Turn On Recommended adds it."
            : "Gateway blocking not set up. Turn On Recommended sets it up.";

    private string EnforcingOn => (_status!.GatewaySetUp, _status.WafConnected && _status.WafTarget) switch
    {
        (true, true) => "the gateway and the WAF",
        (true, false) => "the gateway",
        _ => "the WAF",
    };

    private string ModeText => _status!.Mode switch
    {
        BlockingMode.Enforce => "Blocking",
        BlockingMode.DryRun => _status.WouldBlock == 1 ? "Detection Only, 1 source would be blocked now" : $"Detection Only, {_status.WouldBlock} sources would be blocked now",
        _ => "off"
    };

    private static string StepClass(bool done, bool optional = false) =>
        done ? "protection-step is-done" : optional ? "protection-step is-optional" : "protection-step";

    private static string Plural(int n, string one, string many) => n == 1 ? $"1 {one}" : $"{n} {many}";

    private async Task TurnOnRecommended()
    {
        _busy = true;
        _message = null;
        try
        {
            var r = await Blocking.TurnOnRecommendedAsync();
            await OnInitializedAsync();
            _message = r.GatewayError == null ? null : $"Blocking, but the gateway was not set up: {r.GatewayError}";
            _messageClass = "warning";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException)
        {
            _message = ex.Message;
            _messageClass = "danger";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SwitchWafToBlock()
    {
        _busy = true;
        _message = null;
        try
        {
            var state = await WafAdmin.SetModeAsync("block");
            _status = _status! with { WafMode = state.Mode, WafModeSince = state.Since };
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException)
        {
            _message = ex.Message;
            _messageClass = "danger";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Hide()
    {
        _busy = true;
        try
        {
            await Blocking.SetProtectionSetupHiddenAsync(true);
            _status = _status! with { Hidden = true };
        }
        finally
        {
            _busy = false;
        }
    }
}
