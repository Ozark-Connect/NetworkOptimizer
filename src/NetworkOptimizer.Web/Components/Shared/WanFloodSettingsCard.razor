@using NetworkOptimizer.Threats.WanFlood
@using NetworkOptimizer.Web.Services.WanFlood
@inject IWanFloodAdmin WanFlood

@* Settings - Security & Alerts: WAN Flood Protection for the site in context. *@

<div class="card settings-tab-security wan-flood" id="wan-flood-protection">
    <div class="card-header">
        <h2 class="card-title">WAN Flood Protection</h2>
        @if (_saved != null && _saved.Mode != WanFloodMode.Off)
        {
            <span class="status-badge @(_saved.Mode == WanFloodMode.Enforce ? "status-active" : "")">@ModeLabel(_saved.Mode)</span>
        }
    </div>
    <div class="card-body">
        <p class="section-description">
            Keep a flood of unsolicited traffic from overloading the gateway. Each source may open only so many new
            connections to the gateway per second, and when one CPU core is overwhelmed the source carrying the flood is
            dropped at the WAN for a while. It needs the On-Site Agent on the gateway.
        </p>

        @if (_form == null)
        {
            <div class="loading-container"><span class="spinner spinner-sm"></span></div>
        }
        else
        {
            <div class="form-group">
                <label class="form-label">Mode</label>
                <div class="radio-group">
                    @foreach (var mode in new[] { WanFloodMode.Off, WanFloodMode.Detect, WanFloodMode.Enforce })
                    {
                        <label class="radio-label">
                            <input type="radio" name="wan-flood-mode" checked="@(_form.Mode == mode)" @onchange="() => _form.Mode = mode" />
                            <span>@ModeLabel(mode)</span>
                        </label>
                    }
                </div>
                <small class="form-help">Detection Only installs the limits without dropping and reports what it would drop. A flood from very many sources can still make the gateway drop new connections from sources it has not seen.</small>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="_form.ReactiveDrop" />
                    <span>Drop the source of a flood at the WAN when the gateway is overloaded</span>
                </label>
                <small class="form-help">Each drop ends on its own, and a drop that has stopped seeing traffic ends sooner.</small>
            </div>

            <div class="form-group">
                <label class="form-label">Never limit or drop</label>
                <textarea class="form-control" rows="3" placeholder="One address or range per line" @bind="_form.NeverDrop"></textarea>
            </div>

            <details class="setup-guide">
                <summary>Advanced</summary>
                <div class="setup-guide-content">
                    <div class="ab-section">
                        <h3 class="ab-section-title">New Connections to the Gateway</h3>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">UDP per source (per second) <span class="tooltip-icon tooltip-icon-sm" data-tooltip="New UDP connections per second one internet address may open to the gateway, port forwards included, before the rest are dropped. Replies to connections your own network opened never count. Raise it if one address legitimately opens many sessions at once, such as a carrier's shared address reaching a game server you host. Lower it to cut off a single-source flood sooner. During a flood aimed at one port, such as WireGuard's, new connections to that port are held to a tenth of this; tunnels already up are unaffected.">?</span></label>
                                <input type="number" class="form-control" min="@WanFloodSettings.MinRate" max="@WanFloodSettings.MaxRate" @bind="_form.UdpPerSource" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">UDP burst <span class="tooltip-icon tooltip-icon-sm" data-tooltip="How many new UDP connections one address may open in a quick burst before the per-second limit applies. Raise it for clients that reopen many sessions at once, for example after their connection drops. Lower it so a flood is limited from its first moments.">?</span></label>
                                <input type="number" class="form-control" min="@WanFloodSettings.MinRate" max="@WanFloodSettings.MaxRate" @bind="_form.UdpBurst" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">TCP per source (per second) <span class="tooltip-icon tooltip-icon-sm" data-tooltip="New TCP connections per second one internet address may open to the gateway, port forwards included. A TCP SYN flood overloads the gateway at a small fraction of the bandwidth a UDP flood needs. Raise it if you host a busy service that many people reach from one shared address. Lower it if the gateway hosts nothing over TCP.">?</span></label>
                                <input type="number" class="form-control" min="@WanFloodSettings.MinRate" max="@WanFloodSettings.MaxRate" @bind="_form.SynPerSource" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">TCP burst <span class="tooltip-icon tooltip-icon-sm" data-tooltip="How many new TCP connections one address may open in a quick burst before the per-second limit applies. Raise it for a web app whose pages open many connections at once. Lower it so a SYN flood is limited from its first moments.">?</span></label>
                                <input type="number" class="form-control" min="@WanFloodSettings.MinRate" max="@WanFloodSettings.MaxRate" @bind="_form.SynBurst" />
                            </div>
                        </div>
                    </div>

                    <div class="ab-section">
                        <h3 class="ab-section-title">Port Forwards</h3>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">New connections per port forward (per second) <span class="tooltip-icon tooltip-icon-sm" data-tooltip="New connections per second to one port forward, from every source together. Each new connection holds an entry in the gateway's connection table for up to two minutes, so a flood here can fill the table and break connections for the whole network. Raise it for a port forward that really takes this many new connections. Lower it to protect the table sooner.">?</span></label>
                                <input type="number" class="form-control" min="@WanFloodSettings.MinRate" max="@WanFloodSettings.MaxRate" @bind="_form.ForwardedPort" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">While the connection table is filling <span class="tooltip-icon tooltip-icon-sm" data-tooltip="The tighter limit put on the busiest port forwards while the gateway's connection table is over 80% full. New sessions to that port may be refused during the attack; sessions already open keep working. Raise it if a service must keep accepting new users during an attack. Lower it to protect the rest of the network first.">?</span></label>
                                <input type="number" class="form-control" min="@WanFloodSettings.MinRate" max="@WanFloodSettings.MaxRate" @bind="_form.ForwardedCapped" />
                            </div>
                        </div>
                    </div>

                    <div class="ab-section">
                        <h3 class="ab-section-title">Drops</h3>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Drop for (seconds) <span class="tooltip-icon tooltip-icon-sm" data-tooltip="How long a drop of a flood's source lasts before it is checked again; a drop that still sees traffic is extended. Raise it to re-check less often during a long attack. Lower it so an address that was dropped by mistake recovers sooner.">?</span></label>
                                <input type="number" class="form-control" min="@WanFloodSettings.MinTtl" max="@WanFloodSettings.MaxTtl" @bind="_form.DropTtlSeconds" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Longest drop (seconds) <span class="tooltip-icon tooltip-icon-sm" data-tooltip="The longest a drop can be extended. After it, the drop is removed and a flood that is still going is detected again from scratch, so no drop outlives the attack it was for. Raise it for attacks that run for hours. Lower it if legitimate users share an address with an attacker, as behind a carrier's shared address.">?</span></label>
                                <input type="number" class="form-control" min="@WanFloodSettings.MinTtl" max="@WanFloodSettings.MaxTtl" @bind="_form.MaxDropTtlSeconds" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="_form.TestDrop" />
                                <span>Hold a test drop</span>
                            </label>
                            <small class="form-help">Drops traffic from 198.51.100.1, a documentation address no real traffic comes from, so you can check that a Smart Queues change on the gateway does not remove the drops. Its status shows on Threat Intelligence.</small>
                        </div>
                    </div>
                </div>
            </details>

            <div class="action-buttons ab-save">
                <button class="btn btn-primary" disabled="@_busy" @onclick="Save">
                    @if (_busy)
                    {
                        <span class="spinner"></span>
                    }
                    <span>Save</span>
                </button>
            </div>

            @if (_message != null)
            {
                <div class="alert alert-@_messageClass">@_message</div>
            }
        }
    </div>
</div>

@code {
    private sealed class Form
    {
        public WanFloodMode Mode { get; set; }
        public bool ReactiveDrop { get; set; }
        public int UdpPerSource { get; set; }
        public int UdpBurst { get; set; }
        public int SynPerSource { get; set; }
        public int SynBurst { get; set; }
        public int ForwardedPort { get; set; }
        public int ForwardedCapped { get; set; }
        public int DropTtlSeconds { get; set; }
        public int MaxDropTtlSeconds { get; set; }
        public string NeverDrop { get; set; } = "";
        public bool TestDrop { get; set; }
    }

    private Form? _form;
    private WanFloodSettings? _saved;
    private bool _busy;
    private string? _message;
    private string _messageClass = "info";

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            var s = (await WanFlood.GetOverviewAsync()).Settings;
            _saved = s;
            _form = new Form
            {
                Mode = s.Mode,
                ReactiveDrop = s.ReactiveDrop,
                UdpPerSource = s.UdpPerSource,
                UdpBurst = s.UdpBurst,
                SynPerSource = s.SynPerSource,
                SynBurst = s.SynBurst,
                ForwardedPort = s.ForwardedPort,
                ForwardedCapped = s.ForwardedCapped,
                DropTtlSeconds = s.DropTtlSeconds,
                MaxDropTtlSeconds = s.MaxDropTtlSeconds,
                NeverDrop = s.NeverDrop,
                TestDrop = s.TestDrop,
            };
        }
        catch (Exception ex)
        {
            _message = $"Could not load WAN Flood Protection: {ex.Message}";
            _messageClass = "danger";
        }
    }

    private async Task Save()
    {
        if (_form == null || _saved == null) return;
        _busy = true;
        _message = null;
        try
        {
            await WanFlood.SaveSettingsAsync(_saved with
            {
                Mode = _form.Mode,
                ReactiveDrop = _form.ReactiveDrop,
                UdpPerSource = _form.UdpPerSource,
                UdpBurst = _form.UdpBurst,
                SynPerSource = _form.SynPerSource,
                SynBurst = _form.SynBurst,
                ForwardedPort = _form.ForwardedPort,
                ForwardedBurst = _form.ForwardedPort * 2,
                ForwardedCapped = _form.ForwardedCapped,
                DropTtlSeconds = _form.DropTtlSeconds,
                MaxDropTtlSeconds = _form.MaxDropTtlSeconds,
                NeverDrop = _form.NeverDrop,
                TestDrop = _form.TestDrop,
            });
            await Load();
            _message = "Saved. The gateway's On-Site Agent applies it within a few seconds.";
            _messageClass = "success";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageClass = "danger";
        }
        finally
        {
            _busy = false;
        }
    }

    internal static string ModeLabel(WanFloodMode mode) => mode switch
    {
        WanFloodMode.Enforce => "Protecting",
        WanFloodMode.Detect => "Detection Only",
        _ => "Off"
    };
}
