@using NetworkOptimizer.Web.Services.ChangeControl
@using NetworkOptimizer.Storage.Models

@if (Detail == null)
{
    <div class="loading-container"><div class="spinner"></div></div>
}
else
{
    <div class="cc-detail-grid">
        <div class="cc-panel">
            <div class="cc-panel-title">What changed</div>
            <table class="cc-field-table">
                @foreach (var (label, value) in Detail.Facts)
                {
                    <tr><td class="label">@label</td><td style="text-align:right">@value</td></tr>
                }
                @foreach (var o in Detail.Objects.OrderBy(o => o.Action == ConfigChangeAction.Deleted ? 0 : 1))
                {
                    @if (Detail.Objects.Count > 1 || o.Action != ConfigChangeAction.Updated)
                    {
                        <tr><td colspan="2"><span class="cc-action-text @CcFormat.ActionClass(o.Action)">@CcFormat.ActionText(o.Action, true)</span> @o.CollectionName: @o.Name</td></tr>
                    }
                    @foreach (var f in o.Fields.Take(12))
                    {
                        <tr>
                            <td class="label">@f.Label</td>
                            <td style="text-align:right">@(f.Secret ? "changed" : $"{f.Old} to {f.New}")</td>
                        </tr>
                    }
                }
                @if (!string.IsNullOrEmpty(Detail.Source))
                {
                    <tr><td class="label">Source</td><td style="text-align:right">@Detail.Source</td></tr>
                }
                @foreach (var line in Detail.Impact)
                {
                    <tr>
                        <td class="label">@line.Kind</td>
                        <td style="text-align:right" class="@(line.Kind == "Regression" ? "danger-text" : "success-text")">@line.Title@(line.Device is { Length: > 0 } device ? $" ({device})" : "")</td>
                    </tr>
                }
            </table>
        </div>
        <div class="cc-panel">
            <div class="cc-panel-title" data-tooltip="Site Health: 3 hours each side, ISP problems left out. Monitoring metrics: 1 hour each side.">Before / after</div>
            @if (Detail.BeforeAfter.Count == 0)
            {
                <div class="cc-item-detail">Not enough monitoring data yet.</div>
            }
            <table class="cc-field-table">
                @foreach (var m in Detail.BeforeAfter)
                {
                    <tr>
                        <td class="label">@m.Label</td>
                        <td style="text-align:right">@m.Before to <span class="@(m.Worse ? "danger-text" : "")">@m.After</span></td>
                    </tr>
                }
            </table>
        </div>
        <div class="cc-panel">
            <div class="cc-panel-title">Incidents after</div>
            @{
                var linked = Detail.IncidentsAfter.Where(i => !i.IsWan).ToList();
                var wan = Detail.IncidentsAfter.Where(i => i.IsWan).ToList();
            }
            @if (linked.Count == 0)
            {
                var windowEnd = Detail.Row.OccurredAt.AddHours(2);
                <div class="cc-item-detail">@(DateTime.UtcNow < windowEnd
                    ? $"No incidents so far. Watching until {CcFormat.Local(windowEnd):h:mm tt}."
                    : "No incidents in the 2 hours after.")</div>
            }
            <table class="cc-field-table">
                @foreach (var i in linked)
                {
                    <tr>
                        <td colspan="2">
                            <div>@i.Title</div>
                            <div class="muted-text">@MinutesAfter(i.StartedAt) after, @CcFormat.Local(i.StartedAt).ToString("h:mm tt") to @(i.ResolvedAt is { } r ? CcFormat.Local(r).ToString("h:mm tt") : "now")</div>
                        </td>
                    </tr>
                }
                @foreach (var i in wan)
                {
                    <tr>
                        <td colspan="2">
                            <div>@i.Title</div>
                            <div class="muted-text" data-tooltip="WAN and ISP incidents are listed, not linked to LAN config changes">WAN, @MinutesAfter(i.StartedAt) after</div>
                        </td>
                    </tr>
                }
            </table>
            @if (Detail.Row.RolledBackByPlanId is { } rolledBackBy)
            {
                <div class="cc-item-detail">
                    Rolled back@(Detail.Row.RolledBackAt is { } at ? $" {CcFormat.Local(at):MMM d, h:mm tt}" : "").
                    <a href="@SiteContextService.WithSiteParam($"/change-control/plans/{rolledBackBy}", Detail.Row.SiteSlug)">View the plan</a>
                </div>
            }
            <div class="action-buttons">
                @if (Detail.CanRollBack)
                {
                    <SiteOperatorOnly>
                        <button class="btn btn-primary" disabled="@Busy" @onclick="OnRollBack">
                            @if (RollingBack)
                            {
                                <span class="spinner-sm"></span>
                            }
                            Roll Back
                        </button>
                    </SiteOperatorOnly>
                }
                @if (Detail.Row.PreviousSnapshotId != null && Detail.Row.SnapshotId != null)
                {
                    <button class="btn btn-contrast" @onclick="OnViewDiff">View Diff</button>
                    @if (Detail.Row.ActorKind != ConfigChangeActorKind.Person && OnRecompute.HasDelegate)
                    {
                        <SiteAdminOnly>
                            <button class="btn btn-contrast" disabled="@Busy" @onclick="OnRecompute"
                                    data-tooltip="Rebuild this change from its two snapshots with the current version of Change Control">
                                @if (Recomputing)
                                {
                                    <span class="spinner-sm"></span>
                                }
                                Recompute
                            </button>
                        </SiteAdminOnly>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public ChangeDetailView? Detail { get; set; }
    [Parameter] public bool Busy { get; set; }

    /// <summary>The Roll Back plan is being built: its button shows a spinner.</summary>
    [Parameter] public bool RollingBack { get; set; }
    [Parameter] public EventCallback OnRollBack { get; set; }
    [Parameter] public EventCallback OnViewDiff { get; set; }

    /// <summary>Recompute is running: its button shows a spinner.</summary>
    [Parameter] public bool Recomputing { get; set; }
    [Parameter] public EventCallback OnRecompute { get; set; }

    private string MinutesAfter(DateTime t)
    {
        var span = t - (Detail?.Row.OccurredAt ?? t);
        return span.TotalMinutes < 90 ? $"{Math.Max(0, (int)span.TotalMinutes)} min" : $"{span.TotalHours:0.#} h";
    }
}
