@implements IDisposable
@using NetworkOptimizer.Web.Services.ChangeControl
@using NetworkOptimizer.Storage.Models
@using System.Text
@inject IChangeControlService Site
@inject SiteContextService SiteCtx
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<CcReviewPlan> Logger

<PageTitle>Review Plan - Network Optimizer</PageTitle>

<div class="page-header">
    <PageBackButton />
    <h1>Review Plan @if (_view != null) { <span class="page-header-suffix">@_view.Plan.Name</span> }</h1>
    <p class="page-description">Nothing is written until you apply. Every item below is what Network Optimizer will change on the UniFi Console.</p>
</div>

<div class="change-control">
@if (_view == null)
{
    @if (_notFound)
    {
        <div class="empty-state"><h3>Plan not found</h3><p>It may belong to another site. <a href="/change-control/changes">Back to Changes</a></p></div>
    }
    else
    {
        <div class="loading-container"><div class="spinner"></div></div>
    }
}
else
{
    var plan = _view.Plan;
    var doc = _view.Doc;
    var editable = plan.Status is ConfigPlanStatus.Draft or ConfigPlanStatus.PendingApproval or ConfigPlanStatus.Approved or ConfigPlanStatus.Scheduled;
    var tierCount = doc.Operations.Count(o => o.Tier == PlanTiers.Acknowledge);
    var acked = doc.Operations.Count(o => o.Tier == PlanTiers.Acknowledge && _acks.Items.Contains(o.Key));
    var gatewaySteps = doc.WriteOrder.Count(s => s.Detail.Contains("gateway provision", StringComparison.OrdinalIgnoreCase));

    <div class="cc-strip">
        <div class="cc-tile cc-tile-site">
            <div class="cc-tile-label">Site</div>
            <div class="cc-tile-value" style="font-size:1.05rem">@_view.SiteName</div>
            <div class="cc-tile-sub">@_view.SiteDetail</div>
        </div>
        <div class="cc-tile">
            <div class="cc-tile-label">Source</div>
            <div class="cc-tile-value" style="font-size:1.05rem">@plan.SourceDescription</div>
            <div class="cc-tile-sub">@doc.Context.GetValueOrDefault("source_detail", "")</div>
        </div>
        <div class="cc-tile">
            <div class="cc-tile-label">Writes</div>
            <div class="cc-tile-value" style="font-size:1.05rem">@CcFormat.Plural(plan.ObjectCount, "object", "objects")@(plan.DeviceCount > 0 ? $", {CcFormat.Plural(plan.DeviceCount, "device", "devices")}" : "")</div>
            <div class="cc-tile-sub">@(gatewaySteps == 0 ? "No gateway provision" : CcFormat.Plural(gatewaySteps, "gateway provision", "gateway provisions"))</div>
        </div>
        <div class="cc-tile">
            <div class="cc-tile-label">Highest tier</div>
            <div class="cc-tile-value" style="font-size:1.05rem">
                <span class="status-badge @CcFormat.TierBadge(doc.HighestTier)">@(doc.HighestTier == PlanTiers.Lockout ? (PlanReadiness.HasCertainLockout(doc) ? "Certain lockout" : "Possible lockout") : PlanTiers.Label(doc.HighestTier))</span>
            </div>
            <div class="cc-tile-sub">@TierHint(doc.HighestTier)</div>
        </div>
        <div class="cc-tile">
            <div class="cc-tile-label">Approval</div>
            <div class="cc-tile-value" style="font-size:1.05rem">@(_view.ApprovalRequired ? "Required" : "Not required")</div>
            <div class="cc-tile-sub">Approvals are @(_view.ApprovalsOn ? "on" : "off") for @_view.SiteName</div>
        </div>
    </div>

    @if (doc.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <strong>This plan cannot apply:</strong>
            <ul style="margin:0.25rem 0 0">@foreach (var e in doc.Errors) { <li>@e</li> }</ul>
        </div>
    }

    <div class="card">
        <div class="card-header"><h3 class="card-title">Impact <span class="card-title-suffix">Security Audit and lockout checks on the planned config</span></h3></div>
        @if (doc.Lockouts.Count == 0 && doc.Regressions.Count == 0 && doc.Fixes.Count == 0)
        {
            <div class="card-body muted-text">@(doc.ImpactRan || !doc.Collections.Any() ? "No security regressions or lockout risks." : "No lockout risks. The Security Audit did not run for these collections.")</div>
        }
        @foreach (var lockout in doc.Lockouts)
        {
            <div class="cc-impact-row">
                <div class="cc-badge-col"><span class="status-badge status-error">Lockout</span></div>
                <div>
                    <div class="cc-item-title">@lockout.Title</div>
                    <div class="cc-item-detail">@lockout.Detail @(doc.WatchDevices ? $"If it goes offline, Network Optimizer reverts the plan within {_view.WatchMinutes} minutes." : "")</div>
                    @if (lockout == doc.Lockouts.Last() && editable)
                    {
                        <div class="cc-confirm">
                            @if (PlanReadiness.HasCertainLockout(doc) && !_view.CallerIsSiteAdmin)
                            {
                                <span class="danger-text">A certain lockout is refused. Only a Site Admin can override it.</span>
                            }
                            else
                            {
                                <span>Type <b>@_view.ConfirmationText</b> to confirm</span>
                                <input class="form-control" @bind="_acks.TypedConfirmation" @bind:event="oninput" @bind:after="Changed" />
                            }
                        </div>
                    }
                </div>
                <span></span>
            </div>
        }
        @foreach (var r in doc.Regressions)
        {
            <div class="cc-impact-row">
                <div class="cc-badge-col"><span class="status-badge status-warning">Regression</span></div>
                <div>
                    <div class="cc-item-title">@r.Title</div>
                    <div class="cc-item-detail">@r.Detail Security Audit rule: @r.Title (@r.Severity).</div>
                </div>
                <label class="checkbox-label">
                    <input type="checkbox" disabled="@(!editable)" checked="@_acks.Regressions.Contains(r.Key)" @onchange="() => Toggle(_acks.Regressions, r.Key)" />
                    <span>I accept this regression</span>
                </label>
            </div>
        }
        @if (doc.Fixes.Count > 0)
        {
            <div class="cc-impact-row">
                <div class="cc-badge-col"><span class="status-badge status-connected">Fixes @doc.Fixes.Count</span></div>
                <div>
                    <div class="cc-item-title">@string.Join("; ", doc.Fixes.Select(f => f.Title))</div>
                </div>
                <span></span>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Changes <span class="card-title-suffix">@CcFormat.Plural(doc.Operations.Count, "object", "objects")</span></h3>
            @if (tierCount > 0)
            {
                <span class="status-badge badge-muted">@acked of @tierCount acknowledged</span>
            }
        </div>
        @if (doc.Operations.Count == 0)
        {
            <div class="empty-state empty-state-small"><p>Nothing to write: the console already matches.</p></div>
        }
        else
        {
            <div class="cc-phone-only">
                @foreach (var group in doc.Operations.Where(o => _showDirect || o.Tier != PlanTiers.Direct).GroupBy(o => ConfigCollections.Get(o.Collection)?.Group ?? o.Collection))
                {
                    <div class="cc-mobile-group">@group.Key</div>
                    @foreach (var op in group)
                    {
                        var open = _open.Contains(op.Key);
                        <div class="cc-plan-card @(open ? "history-row-expanded" : "")" @onclick="() => Toggle(_open, op.Key)">
                            <div class="cc-change-card-head">
                                <span><span class="cc-action-text @CcFormat.PlanActionClass(op.Action)">@op.Action</span> @op.ObjectName</span>
                                <span class="status-badge @CcFormat.TierBadge(op.Tier)">@(op.Tier == PlanTiers.Acknowledge ? "Ack" : PlanTiers.Label(op.Tier))</span>
                            </div>
                            <div class="cc-item-detail">@op.ChangeText</div>
                            @if (open && op.Fields.Count > 0)
                            {
                                <div class="cc-inset" style="margin:0.5rem 0 0">
                                    @foreach (var f in op.Fields)
                                    {
                                        <div class="cc-mobile-field">
                                            <div class="muted-text">@f.Label</div>
                                            <div><span class="danger-text">@(f.Secret ? "Current value" : f.Old)</span> to <span class="success-text">@(f.Secret ? $"{SourceShort(plan)} value (hidden)" : f.New)</span></div>
                                        </div>
                                    }
                                </div>
                            }
                            @if (open && op.Reasons.Count > 0)
                            {
                                <div class="cc-item-detail">@string.Join(". ", op.Reasons).</div>
                            }
                            @if (op.Tier == PlanTiers.Acknowledge)
                            {
                                <label class="checkbox-label" @onclick:stopPropagation>
                                    <input type="checkbox" disabled="@(!editable)" checked="@_acks.Items.Contains(op.Key)" @onchange="() => Toggle(_acks.Items, op.Key)" />
                                    <span>Acknowledged</span>
                                </label>
                            }
                        </div>
                    }
                }
                @if (!_showDirect && doc.Operations.Any(o => o.Tier == PlanTiers.Direct))
                {
                    <button class="cc-link-btn" style="padding:12px 16px" @onclick="() => _showDirect = true">+ @doc.Operations.Count(o => o.Tier == PlanTiers.Direct) more direct changes</button>
                }
            </div>
            <div class="table-responsive hide-mobile">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="expand-chevron"></th>
                            <th>Action</th>
                            <th>Object</th>
                            <th class="hide-mobile">Change</th>
                            <th>Tier</th>
                            <th>Acknowledge</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in doc.Operations.GroupBy(o => ConfigCollections.Get(o.Collection)?.Group ?? o.Collection))
                        {
                            <tr class="cc-group-row"><td colspan="6">@group.Key</td></tr>
                            @foreach (var op in group)
                            {
                                var open = _open.Contains(op.Key);
                                var result = _view.Result?.Operations.FirstOrDefault(r => r.Key == op.Key);
                                <tr class="history-row-clickable @(open ? "history-row-expanded" : "")" @onclick="() => Toggle(_open, op.Key)">
                                    <td class="expand-chevron">@(open ? "▲" : "▼")</td>
                                    <td><span class="cc-action-text @CcFormat.PlanActionClass(op.Action)">@op.Action</span></td>
                                    <td>@op.ObjectName</td>
                                    <td class="hide-mobile">@op.ChangeText@(result != null && result.Outcome != "Applied" ? $" ({result.Outcome}: {result.Message})" : "")</td>
                                    <td><span class="status-badge @CcFormat.TierBadge(op.Tier)">@PlanTiers.Label(op.Tier)</span></td>
                                    <td class="cc-ack-col" @onclick:stopPropagation>
                                        @if (op.Tier == PlanTiers.Lockout)
                                        {
                                            <span class="muted-text">See Impact</span>
                                        }
                                        else if (op.Tier == PlanTiers.Acknowledge)
                                        {
                                            <label class="checkbox-label">
                                                <input type="checkbox" disabled="@(!editable)" checked="@_acks.Items.Contains(op.Key)" @onchange="() => Toggle(_acks.Items, op.Key)" />
                                                <span>OK</span>
                                            </label>
                                        }
                                    </td>
                                </tr>
                                <tr class="history-details-row">
                                    <td colspan="6">
                                        <div class="expand-wrapper @(open ? "expanded" : "")">
                                            <div class="expand-content">
                                                @if (open)
                                                {
                                                    <div class="cc-inset" style="margin-top:0.75rem">
                                                        <table class="cc-field-table">
                                                            @if (op.Fields.Count == 0)
                                                            {
                                                                <tr><td class="label">@op.Action</td><td colspan="2">@op.ChangeText</td></tr>
                                                            }
                                                            @foreach (var f in op.Fields)
                                                            {
                                                                <tr>
                                                                    <td class="label">@f.Label</td>
                                                                    <td class="old">@(f.Secret ? "Current value" : f.Old)</td>
                                                                    <td class="new">@(f.Secret ? $"{SourceShort(plan)} value (hidden)" : f.New)</td>
                                                                </tr>
                                                            }
                                                        </table>
                                                    </div>
                                                    @if (op.Reasons.Count > 0 || op.Referrers.Count > 0)
                                                    {
                                                        <div class="cc-inset-note">
                                                            @string.Join(". ", op.Reasons)@(op.Reasons.Count > 0 ? "." : "")
                                                            @if (op.Referrers.Count > 0) { <span> Still referenced by: @string.Join(", ", op.Referrers).</span> }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (doc.Notes.Count > 0)
        {
            <div class="cc-inset-note" style="padding-top:0.75rem">
                @foreach (var n in doc.Notes) { <div>@n</div> }
            </div>
        }
    </div>

    <div class="cc-settings-grid">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Write Order</h3></div>
            <div class="card-body">
                @for (var i = 0; i < doc.WriteOrder.Count; i++)
                {
                    var step = doc.WriteOrder[i];
                    <div class="cc-write-step">
                        <span class="cc-step-num">@(i + 1)</span>
                        <div>
                            <div>@step.Title</div>
                            <div class="cc-item-detail">@step.Detail</div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h3 class="card-title">When to Apply</h3></div>
            <div class="card-body">
                <fieldset disabled="@(!editable)" style="border:none;padding:0;margin:0">
                    <div class="radio-group">
                        <label class="radio-label">
                            <input type="radio" name="when" checked="@(!_schedule)" @onchange="() => SetSchedule(false)" />
                            <span>@(_view.ApprovalRequired ? "After approval" : "Now")</span>
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="when" checked="@_schedule" @onchange="() => SetSchedule(true)" />
                            <span>Schedule</span>
                        </label>
                    </div>
                    @if (_schedule)
                    {
                        <div class="form-row" style="margin-top:0.75rem">
                            <div class="form-group">
                                <label class="form-label">Date</label>
                                <input type="date" class="form-control" @bind="_date" @bind:after="Changed" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Time</label>
                                <input type="time" class="form-control" @bind="_time" @bind:after="Changed" />
                                @if (_view.QuietestHourSuggestion != null)
                                {
                                    <small class="form-help">Quietest hour at @_view.SiteName over the last 14 days</small>
                                }
                            </div>
                        </div>
                    }
                </fieldset>
                <p class="cc-item-detail" style="margin-top:0.75rem">
                    @if (doc.WatchDevices || doc.WatchInternet)
                    {
                        <b>Commit-confirmed: @_view.WatchMinutes minutes.</b>
                        <span> Network Optimizer watches @(doc.WatchDevices ? "every device" : "")@(doc.WatchDevices && doc.WatchInternet ? " and " : "")@(doc.WatchInternet ? "internet reachability" : ""). If either fails, it reverts the plan and alerts.</span>
                    }
                    else
                    {
                        <span>No management-path or WAN change: no commit-confirmed watch. A snapshot is pinned before the apply.</span>
                    }
                </p>
            </div>
        </div>
    </div>

    @if (_view.Result != null)
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Result <span class="card-title-suffix">@CcFormat.PlanStatusText(plan.Status)@(plan.Message != null ? $": {plan.Message}" : "")</span></h3>
                @if (plan.ReportJson != null)
                {
                    <button class="btn btn-contrast btn-sm" @onclick="DownloadReportAsync">Before / After Report (PDF)</button>
                }
            </div>
            <div class="card-body">
                <div class="cc-kv"><span>Writes applied</span><span>@_view.Result.Operations.Count(o => o.Outcome == "Applied") of @_view.Result.Operations.Count</span></div>
                @foreach (var o in _view.Result.Operations.Where(o => o.Outcome != "Applied" || o.Message != null))
                {
                    <div class="cc-kv"><span>@o.Key.Split(':').ElementAtOrDefault(2)</span><span class="@(o.Outcome == "Error" ? "danger-text" : o.Outcome == "Partial" ? "warning-text" : "")">@o.Outcome@(o.Message != null ? $": {o.Message}" : "")</span></div>
                }
                @if (_view.Result.VerifyDifferences.Count > 0)
                {
                    <div class="cc-panel-title" style="margin-top:0.75rem">Verify: what did not land</div>
                    @foreach (var d in _view.Result.VerifyDifferences) { <div class="cc-item-detail warning-text">@d</div> }
                }
                else if (plan.PostApplySnapshotId != null)
                {
                    <div class="cc-item-detail success-text" style="margin-top:0.5rem">Verify: the new snapshot matches the plan.</div>
                }
                @if (plan.Status == ConfigPlanStatus.Applied && _view.Doc.ForgetSuggestions.Count > 0 && !_forgotten)
                {
                    <SiteOperatorOnly>
                        <div class="cc-forget">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="_forget" />
                                <span>Forget @(_view.Doc.Context.GetValueOrDefault("old_name") ?? "the old device") in UniFi. Its monitoring history stays in Network Optimizer.</span>
                            </label>
                            <button class="btn btn-secondary btn-sm" disabled="@(!_forget || _busy)" @onclick="ForgetAsync">Forget Old Device</button>
                        </div>
                    </SiteOperatorOnly>
                }
            </div>
        </div>
    }

    @if (_view.Doc.Recabling.Count > 0)
    {
        <div class="card">
            <div class="card-header"><h3 class="card-title">Re-cabling Sheet</h3></div>
            @foreach (var r in _view.Doc.Recabling)
            {
                <div class="cc-setting-row cc-recable-row">
                    <span>@r.OldPort → @r.NewPort</span>
                    <span class="@(r.Unresolved ? "danger-text" : "")">@r.Connected</span>
                </div>
            }
        </div>
    }

    @if (_message != null)
    {
        <div class="alert @(_ok ? "alert-success" : "alert-danger")">@_message</div>
    }

    <div class="card cc-sticky-footer">
        <div class="cc-card-footer">
            <div class="cc-remaining">
                <div class="cc-state-track">
                    @foreach (var (label, statuses) in Track)
                    {
                        <span class="@(statuses.Contains(plan.Status) ? "on" : "")"><span class="cc-dot"></span> @label</span>
                        @if (label != "Applied") { <span>-</span> }
                    }
                </div>
                @if (editable && _view.Remaining.Count > 0)
                {
                    <div class="warning-text" style="font-size:0.875rem">@string.Join(", ", _view.Remaining)</div>
                }
                @if (plan.Status == ConfigPlanStatus.Watching && plan.WatchUntil is { } until)
                {
                    <div class="warning-text" style="font-size:0.875rem">Watching until @CcFormat.Local(until).ToString("h:mm tt")</div>
                }
            </div>
            <button class="btn btn-secondary" @onclick="DownloadYamlAsync">Download YAML</button>
            @if (editable)
            {
                <SiteOperatorOnly>
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="SaveDraftAsync">Save Draft</button>
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="CancelAsync">Discard</button>
                    @if (plan.Status == ConfigPlanStatus.PendingApproval && _view.CallerIsSiteAdmin)
                    {
                        <button class="btn btn-primary" disabled="@(_busy || _view.Remaining.Count > 0)" @onclick="ApproveAsync">Approve</button>
                    }
                    else if (_view.ApprovalRequired && plan.Status == ConfigPlanStatus.Draft)
                    {
                        <button class="btn btn-primary" disabled="@(_busy || _view.Remaining.Count > 0)" @onclick="SubmitAsync">Submit for Approval</button>
                    }
                    else if (!_view.ApprovalRequired || plan.Status is ConfigPlanStatus.Approved or ConfigPlanStatus.Scheduled)
                    {
                        <button class="btn btn-primary" disabled="@(_busy || _view.Remaining.Count > 0)" @onclick="ApplyAsync">@(_schedule ? "Schedule" : "Apply")</button>
                    }
                </SiteOperatorOnly>
            }
            @if (plan.Status is ConfigPlanStatus.Watching or ConfigPlanStatus.Applied && plan.Kind != ConfigPlanKind.Revert)
            {
                <SiteOperatorOnly>
                    <button class="btn btn-danger" disabled="@_busy" @onclick="RevertAsync">Revert</button>
                </SiteOperatorOnly>
            }
        </div>
    </div>
}
</div>

@code {
    [Parameter] public int PlanId { get; set; }

    private static readonly (string Label, ConfigPlanStatus[] Statuses)[] Track =
    [
        ("Draft", [ConfigPlanStatus.Draft]),
        ("Pending approval", [ConfigPlanStatus.PendingApproval]),
        ("Approved", [ConfigPlanStatus.Approved, ConfigPlanStatus.Scheduled]),
        ("Applied", [ConfigPlanStatus.Applying, ConfigPlanStatus.Watching, ConfigPlanStatus.Applied, ConfigPlanStatus.Reverted, ConfigPlanStatus.Failed]),
    ];

    private PlanView? _view;
    private PlanAcknowledgements _acks = new();
    private readonly HashSet<string> _open = [];
    private bool _showDirect;
    private bool _schedule;
    private DateTime _date = DateTime.Today;
    private TimeOnly _time = new(2, 0);
    private bool _busy;
    private bool _ok;
    private bool _notFound;
    private string? _message;
    private Timer? _refresh;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // A plan that is applying or watching changes on its own; keep the page current.
        _refresh = new Timer(_ => InvokeAsync(async () =>
        {
            if (_view?.Plan.Status is ConfigPlanStatus.Applying or ConfigPlanStatus.Watching)
            {
                await LoadAsync();
                StateHasChanged();
            }
        }), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task LoadAsync()
    {
        try
        {
            _view = await Site.GetPlanAsync(PlanId);
            _notFound = _view == null;
            if (_view == null) return;
            _acks = _view.Acks;
            if (_view.Plan.ScheduledFor is { } at)
            {
                _schedule = true;
                var local = CcFormat.Local(at);
                _date = local.Date;
                _time = TimeOnly.FromDateTime(local);
            }
            else if (_view.QuietestHourSuggestion is { } quiet)
            {
                var local = CcFormat.Local(quiet);
                _date = local.Date;
                _time = TimeOnly.FromDateTime(local);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Plan {Plan} failed to load", PlanId);
            _message = ex.Message;
        }
    }

    private string TierHint(int tier) => tier switch
    {
        PlanTiers.Lockout => "Typed confirmation needed",
        PlanTiers.SecurityRegression => "Accept each regression",
        PlanTiers.Acknowledge => "Acknowledge each flagged item",
        _ => "Apply directly",
    };

    private static string SourceShort(ConfigPlan plan) =>
        plan.SourceDescription.StartsWith("Snapshot, ", StringComparison.Ordinal) ? plan.SourceDescription[10..].Split(',')[0] : "New";

    private void Toggle(HashSet<string> set, string key)
    {
        if (!set.Remove(key)) set.Add(key);
        Changed();
    }

    private void Changed()
    {
        if (_view == null) return;
        _view = new PlanView
        {
            Plan = _view.Plan, Doc = _view.Doc, Acks = _acks, Result = _view.Result, SiteName = _view.SiteName, SiteDetail = _view.SiteDetail,
            ApprovalsOn = _view.ApprovalsOn, ApprovalRequired = _view.ApprovalRequired, CallerIsSiteAdmin = _view.CallerIsSiteAdmin,
            Remaining = PlanReadiness.Remaining(_view.Doc, _acks, _view.CallerIsSiteAdmin), ConfirmationText = _view.ConfirmationText,
            WatchMinutes = _view.WatchMinutes, DeviceCount = _view.DeviceCount, QuietestHourSuggestion = _view.QuietestHourSuggestion,
        };
    }

    private void SetSchedule(bool on) => _schedule = on;

    private DateTime? ScheduledUtc() =>
        _schedule ? TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(_date.Date + _time.ToTimeSpan(), DateTimeKind.Unspecified), TimeZoneInfo.Local) : null;

    private async Task RunAsync(Func<Task<string?>> work, string? success = null)
    {
        _busy = true;
        _message = null;
        try
        {
            var why = await work();
            _ok = why == null;
            _message = why ?? success;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _ok = false;
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // Checked by default (hardware-replacement.md), but only the button forgets.
    private bool _forget = true;
    private bool _forgotten;

    private Task ForgetAsync() => RunAsync(async () =>
    {
        foreach (var mac in _view!.Doc.ForgetSuggestions)
            if (await Site.ForgetDeviceAsync(mac) is { } refused) return refused;
        _forgotten = true;
        return null;
    }, "Old device forgotten in UniFi.");

    private Task SaveDraftAsync() => RunAsync(async () =>
    {
        await Site.SavePlanAsync(PlanId, _acks, ScheduledUtc(), applyOnApproval: !_schedule);
        return null;
    }, "Draft saved.");

    private Task SubmitAsync() => RunAsync(async () =>
    {
        await Site.SavePlanAsync(PlanId, _acks, ScheduledUtc(), applyOnApproval: !_schedule);
        await Site.SubmitPlanAsync(PlanId);
        return null;
    }, "Submitted for approval.");

    private Task ApproveAsync() => RunAsync(async () =>
    {
        await Site.SavePlanAsync(PlanId, _acks, ScheduledUtc(), applyOnApproval: !_schedule);
        await Site.ApprovePlanAsync(PlanId);
        return null;
    }, "Approved.");

    private Task ApplyAsync() => RunAsync(async () =>
    {
        await Site.SavePlanAsync(PlanId, _acks, ScheduledUtc(), applyOnApproval: false);
        return await Site.ApplyPlanAsync(PlanId);
    }, _schedule ? "Scheduled." : "Applied.");

    private Task CancelAsync() => RunAsync(async () =>
    {
        await Site.CancelPlanAsync(PlanId);
        return null;
    }, "Discarded.");

    private Task RevertAsync() => RunAsync(() => Site.RevertPlanAsync(PlanId), "Reverted to the snapshot pinned before the apply.");

    private async Task DownloadReportAsync()
    {
        var pdf = await Site.GetPlanReportPdfAsync(PlanId);
        if (pdf != null)
            await JS.InvokeVoidAsync("downloadFile", $"plan-{PlanId}-report.pdf", "application/pdf", Convert.ToBase64String(pdf));
    }

    /// <summary>The plan's writes as YAML: action, object, and field changes (secret values never appear).</summary>
    private async Task DownloadYamlAsync()
    {
        if (_view == null) return;
        var sb = new StringBuilder($"# {_view.Plan.Name}\n# Source: {_view.Plan.SourceDescription}\noperations:\n");
        foreach (var op in _view.Doc.Operations)
        {
            sb.Append($"  - action: {op.Action.ToString().ToLowerInvariant()}\n    collection: {op.Collection}\n    object: \"{op.ObjectName.Replace("\"", "\\\"")}\"\n");
            if (op.Fields.Count > 0)
            {
                sb.Append("    fields:\n");
                foreach (var f in op.Fields)
                    sb.Append($"      - {{field: \"{f.Label}\", from: \"{(f.Secret ? "<current>" : f.Old)}\", to: \"{(f.Secret ? "<hidden>" : f.New)}\"}}\n");
            }
        }
        await JS.InvokeVoidAsync("downloadFile", $"plan-{PlanId}.yaml", "application/yaml", Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString())));
    }

    public void Dispose() => _refresh?.Dispose();
}
