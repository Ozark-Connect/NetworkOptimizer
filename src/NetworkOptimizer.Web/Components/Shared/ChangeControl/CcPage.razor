@implements IDisposable
@inject NavigationManager Nav
@inject UniFiConnectionService ConnectionService

<PageTitle>Change Control - Network Optimizer</PageTitle>

<div class="page-header">
    <PageBackButton />
    <h1>Change Control</h1>
    <p class="page-description">Snapshots are backups of your UniFi Network config, stored outside your UniFi Console. Every change, who made it, and how to roll it back.</p>
</div>

<div class="change-control">
    <div class="wifi-view-tabs-wrapper">
        <button class="wifi-tabs-scroll-btn wifi-tabs-scroll-left" onclick="this.parentElement.querySelector('.wifi-view-tabs').scrollBy({left: -200, behavior: 'smooth'})">&#8249;</button>
        <div class="wifi-view-tabs">
            @foreach (var (key, label) in Tabs)
            {
                <button class="wifi-view-tab @(ActiveTab == key ? "active" : "")" @onclick="() => Go(key)">@label</button>
            }
        </div>
        <button class="wifi-tabs-scroll-btn wifi-tabs-scroll-right" onclick="this.parentElement.querySelector('.wifi-view-tabs').scrollBy({left: 200, behavior: 'smooth'})">&#8250;</button>
    </div>

    @if (SiteTabs.Contains(ActiveTab))
    {
        <ConsoleConnectionBanner />
    }

    <CascadingValue Name="ConsoleConnected" Value="ConnectionService.IsConnected">
    @switch (ActiveTab)
    {
        case "changes":
            <CcChanges />
            break;
        case "snapshots":
            <CcSnapshots />
            break;
        case "edit":
            <CcEdit />
            break;
        case "migrate":
            <CcMigrate />
            break;
        case "settings":
            <CcSettings />
            break;
        default:
            <CcOverview />
            break;
    }
    </CascadingValue>
</div>

@code {
    [Parameter] public string? Tab { get; set; }

    private static readonly (string Key, string Label)[] Tabs =
    [
        ("overview", "Overview"), ("changes", "Changes"), ("snapshots", "Snapshots + Templates"),
        ("edit", "Edit"), ("migrate", "Migrate / Restore"), ("settings", "Settings"),
    ];

    // Tabs that act on one site's Console. Overview and Changes span the fleet and show each
    // site's reachability themselves; Settings is stored config only.
    private static readonly HashSet<string> SiteTabs = ["snapshots", "edit", "migrate"];

    private string ActiveTab => Tabs.Any(t => t.Key == Tab) ? Tab! : "overview";

    protected override void OnInitialized() => ConnectionService.OnConnectionChanged += OnConnectionChanged;

    // Fires from a background thread (console reconnect).
    private void OnConnectionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ConnectionService.OnConnectionChanged -= OnConnectionChanged;

    private void Go(string key)
    {
        var url = key == "overview" ? "/change-control" : $"/change-control/{key}";
        var slug = SiteSlugFromUri();
        Nav.NavigateTo(string.IsNullOrEmpty(slug) ? url : SiteContextService.WithSiteParam(url, slug));
    }

    private string SiteSlugFromUri()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        return query.TryGetValue(SiteContextService.SiteQueryParam, out var v) ? v.ToString() : "";
    }
}
