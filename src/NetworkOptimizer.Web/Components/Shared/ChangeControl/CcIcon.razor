@* The download / upload icon that stands in for the verb on Change Control file buttons. *@
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px" aria-hidden="true">
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
    @if (Name == "upload")
    {
        <polyline points="17 8 12 3 7 8" />
        <line x1="12" y1="3" x2="12" y2="15" />
    }
    else
    {
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
    }
</svg>

@code {
    /// <summary>"download" (the default) or "upload".</summary>
    [Parameter] public string Name { get; set; } = "download";
}
