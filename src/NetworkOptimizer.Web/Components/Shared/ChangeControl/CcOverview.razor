@using NetworkOptimizer.Web.Services.ChangeControl
@using NetworkOptimizer.Storage.Models
@implements IDisposable
@inject IChangeControlFleetService Fleet
@inject ChangeControlRegistry Registry
@inject CcNavigator Navigator
@inject ILogger<CcOverview> Logger

@if (_view == null)
{
    <div class="loading-container"><div class="spinner"></div></div>
}
else
{
    // Worst first: the site that needs looking at leads the list.
    var sites = _view.Sites.OrderBy(s => s.Health24h ?? 101).ThenBy(s => s.Name).ToList();
    var regressionSites = sites.Count(s => s.Regressions > 0);
    var driftSites = sites.Count(s => s.DriftObjects > 0);

    <div class="cc-tiles">
        <div class="cc-tile cc-tile-sites">
            <div class="cc-tile-label">Sites</div>
            <div class="cc-tile-value">@sites.Count</div>
            <div class="cc-tile-sub">@(sites.Count(s => s.AgentOffline) is var off && off > 0 ? CcFormat.Plural(off, "agent offline", "agents offline") : "All reachable")</div>
        </div>
        <div class="cc-tile cc-tile-changes">
            <div class="cc-tile-label">Changes, 24h</div>
            <div class="cc-tile-value">@sites.Sum(s => s.Changes24h)</div>
            <div class="cc-tile-sub">@sites.Sum(s => s.Changes7d) in the last 7 days</div>
        </div>
        <div class="cc-tile cc-tile-security">
            <div class="cc-tile-label">Security regressions</div>
            <div class="cc-tile-value @(sites.Sum(s => s.Regressions) > 0 ? "danger" : "")">@sites.Sum(s => s.Regressions)</div>
            <div class="cc-tile-sub">On @CcFormat.Plural(regressionSites, "site", "sites")</div>
        </div>
        <div class="cc-tile cc-tile-unattributed">
            <div class="cc-tile-label">No admin recorded</div>
            <div class="cc-tile-value @(sites.Sum(s => s.Unattributed) > 0 ? "warning" : "")">@sites.Sum(s => s.Unattributed)</div>
            <div class="cc-tile-sub">Last 7 days</div>
        </div>
        <div class="cc-tile cc-tile-drift">
            <div class="cc-tile-label">Drift from Baseline</div>
            <div class="cc-tile-value">@sites.Sum(s => s.DriftObjects ?? 0)</div>
            <div class="cc-tile-sub">Objects on @CcFormat.Plural(driftSites, "site", "sites")</div>
        </div>
        <div class="cc-tile cc-tile-plans">
            <div class="cc-tile-label">Plans</div>
            <div class="cc-tile-value">@_view.Plans.Count</div>
            <div class="cc-tile-sub">@_view.Plans.Count(p => p.Status == ConfigPlanStatus.PendingApproval) awaiting approval</div>
        </div>
    </div>

    <div class="cc-mobile-order">
        <div class="card cc-attention-card">
            <div class="card-header">
                <h3 class="card-title">Needs Attention <span class="card-title-suffix">@CcFormat.Plural(_view.Attention.Count, "item", "items")</span></h3>
            </div>
            @if (_view.Attention.Count == 0)
            {
                <div class="empty-state empty-state-small"><p>Nothing needs attention.</p></div>
            }
            @foreach (var item in _view.Attention)
            {
                <div class="cc-item">
                    <div class="cc-badge-col">
                        <span class="status-badge @(item.Kind switch { "Regression" or "Reverted" => "status-error", "Approval" => "status-info", _ => "status-warning" })">@item.Kind</span>
                        @if (sites.Count > 1)
                        {
                            <span class="cc-site-chip cc-phone-inline">@item.SiteName</span>
                        }
                    </div>
                    <div>
                        <div class="cc-item-title">
                            @if (sites.Count > 1)
                            {
                                <span class="cc-site-chip hide-mobile">@item.SiteName</span>
                            }
                            <span>@item.Title</span>
                        </div>
                        <div class="cc-item-detail">@item.Detail</div>
                    </div>
                    <div class="cc-item-actions">
                        @switch (item.Kind)
                        {
                            case "Regression" when item.FromSnapshotId != null:
                                <button class="btn btn-secondary" @onclick="() => Navigator.CompareAsync(item.SiteSlug, item.FromSnapshotId, item.ToSnapshotId)">View Diff</button>
                                break;
                            case "Regression":
                                <button class="btn btn-secondary" @onclick="() => Navigator.ChangeAsync(item.SiteSlug, item.ChangeId!.Value)">View Change</button>
                                <SiteOperatorOnly><button class="btn btn-primary" @onclick="() => Navigator.RollBackChangeAsync(item.SiteSlug, item.ChangeId!.Value)">Roll Back</button></SiteOperatorOnly>
                                break;
                            case "Approval" or "Reverted":
                                <button class="btn btn-primary" @onclick="() => Navigator.PlanAsync(item.SiteSlug, item.PlanId!.Value)">Review Plan</button>
                                break;
                            case "Drift":
                                <button class="btn btn-secondary" @onclick="@(() => Navigator.TabAsync(item.SiteSlug, "snapshots", "drift=1"))">View Drift</button>
                                break;
                            default:
                                <button class="btn btn-secondary" @onclick="@(() => Navigator.TabAsync(item.SiteSlug, "changes"))">Open Site</button>
                                break;
                        }
                    </div>
                </div>
            }
        </div>

        <div class="cc-two-col">
            <div class="card cc-sites-card">
                <div class="card-header"><h3 class="card-title">Sites</h3></div>
                <div class="cc-site-list cc-phone-only">
                    @foreach (var s in sites)
                    {
                        <div class="cc-site-list-row history-row-clickable" @onclick="@(() => Navigator.TabAsync(s.Slug, "changes"))">
                            <div>
                                <div><span class="cc-dot @(s.Online ? "online" : "offline")"></span> @s.Name</div>
                                <div class="cc-item-detail">@CcFormat.Plural(s.Changes7d, "change", "changes"), @(s.Regressions > 0 ? CcFormat.Plural(s.Regressions, "regression", "regressions") + ", " : "")@(s.DriftObjects switch { null => "no Baseline", 0 => "no drift", var d => $"{d} objects drifted" })@(s.AgentOffline ? ", agent offline" : "")</div>
                            </div>
                            <span class="cc-site-health health-@Level(s.Health24h)">@(s.Health24h is { } h ? h.ToString("0.#") : "--")</span>
                        </div>
                    }
                </div>
                <div class="table-responsive hide-mobile">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Site</th>
                                <th data-tooltip="Average Site Health over the last 24 hours">Health, 24h</th>
                                <th>Last snapshot</th>
                                <th>Changes, 7d</th>
                                <th>Regressions</th>
                                <th>Drift</th>
                                <th>Network app</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in sites)
                            {
                                <tr class="history-row-clickable" @onclick="@(() => Navigator.TabAsync(s.Slug, "changes"))">
                                    <td><span class="cc-dot @(s.Online ? "online" : "offline")" data-tooltip="@(s.Online ? "Connected" : s.AgentOffline ? "Agent offline" : "UniFi Console unreachable")"></span> @s.Name</td>
                                    <td><span class="health-@Level(s.Health24h)" data-tooltip="@(s.HealthIssue ?? "No issues")">@(s.Health24h is { } h ? h.ToString("0.#") : "--")</span></td>
                                    <td>@(s.LastSnapshotAt is { } t ? CcFormat.Time(t) : "None yet")</td>
                                    <td>@s.Changes7d</td>
                                    <td><span class="status-badge @(s.Regressions > 0 ? "status-error" : "badge-muted")">@s.Regressions</span></td>
                                    <td>
                                        @if (s.DriftObjects == null)
                                        {
                                            <span class="muted-text">No Baseline</span>
                                        }
                                        else if (s.DriftObjects == 0)
                                        {
                                            <span class="status-badge status-connected">None</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-warning">@CcFormat.Plural(s.DriftObjects.Value, "object", "objects")</span>
                                        }
                                    </td>
                                    <td>@(s.NetworkAppVersion ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="cc-side-col">
                <div class="card cc-plans-card">
                    <div class="card-header"><h3 class="card-title">Plans in Progress</h3></div>
                    @if (_view.Plans.Count == 0)
                    {
                        <div class="empty-state empty-state-small"><p>No plans in progress.</p></div>
                    }
                    @foreach (var p in _view.Plans)
                    {
                        <div class="cc-plan-row history-row-clickable" @onclick="() => Navigator.PlanAsync(p.SiteSlug, p.Id)">
                            <div class="cc-plan-row-head">
                                <span>@p.Name</span>
                                <span class="status-badge @CcFormat.PlanStatusBadge(p.Status)">@CcFormat.PlanStatusText(p.Status)</span>
                            </div>
                            <div class="cc-item-detail">@p.Detail</div>
                            @if (p.Status == ConfigPlanStatus.Watching && p.WatchUntil is { } until && p.StartedAt is { } started && until > started)
                            {
                                var pct = Math.Clamp((DateTime.UtcNow - started).TotalSeconds / (until - started).TotalSeconds * 100, 0, 100);
                                <div class="cc-progress"><div style="width:@(pct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                            }
                        </div>
                    }
                </div>

                <div class="card cc-upgrade-card">
                    <div class="card-header"><h3 class="card-title">Last Network App Upgrade</h3></div>
                    @if (_view.Upgrades.Count == 0)
                    {
                        <div class="empty-state empty-state-small"><p>No Network app upgrade recorded yet.</p></div>
                    }
                    else
                    {
                        <div class="card-body">
                            @foreach (var u in _view.Upgrades)
                            {
                                <div class="cc-kv">
                                    <span>@(sites.Count > 1 ? $"{u.SiteName}, " : "")@CcFormat.Day(u.At)</span>
                                    <span>
                                        @u.From to @u.To, @(u.ObjectsChanged == 0 ? "no config changes" : CcFormat.Plural(u.ObjectsChanged, "object changed", "objects changed"))@if (u.Regressions > 0)
                                        {
                                            <text>, </text><span class="danger-text">@CcFormat.Plural(u.Regressions, "regression", "regressions")</span>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private OverviewView? _view;

    private static string Level(double? health) => NetworkOptimizer.Web.Services.ChangeControl.SiteHealth.SiteHealthSeriesBuilder.Level(health);

    private CcLiveRefresh? _live;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _view = await Fleet.GetOverviewAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Change Control overview failed");
            _view = new OverviewView();
        }
        _live = new CcLiveRefresh(Registry, _ => true, InvokeAsync, async () =>
        {
            _view = await Fleet.GetOverviewAsync();
            StateHasChanged();
        }, Logger);
    }

    public void Dispose() => _live?.Dispose();
}
