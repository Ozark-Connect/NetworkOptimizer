@using NetworkOptimizer.Web.Services.Monitoring.PathLocalization
@using NetworkOptimizer.Storage.Models
@inject IPathEpisodeService PathEpisodes
@inject ILogger<PathEpisodeHopTable> Logger
@inject NavigationManager NavigationManager
@inject NetworkOptimizer.Threats.Enrichment.GeoEnrichmentService Geo
@inject NetworkOptimizer.Web.Services.Monitoring.IHopLocationOverrideService HopLocationSets
@inject NetworkOptimizer.Web.Services.Monitoring.LearnedHopLocations LearnedLocations
@inject SiteContextService SiteContext

@* The hop table behind one Path Localization episode: every TTL of each degraded target's rounds,
   pooled, with the hop where the degradation first appears and the last clean one marked. Loaded
   when opened, and re-read when the episode records a new round. *@
<div class="path-episode-detail">
    @if (_detail == null)
    {
        <div class="text-muted">@(_failed ? "Couldn't load the traces." : "Loading the traces...")</div>
    }
    else
    {
        @* The event row above carries the verdict; only a pause, which it does not say, shows here. *@
        @if (_detail.Episode.Summary?.StartsWith("Paused:", StringComparison.Ordinal) == true)
        {
            <p class="path-episode-summary">@_detail.Episode.Summary.Split(". ", 2)[0].</p>
        }
        @if (_detail.Episode.Degraded.Count > 1 || _detail.Episode.Controls.Count > 0)
        {
            <div class="path-episode-destinations">
                <div><span class="path-episode-dest-label">Degraded</span> @string.Join(", ", _detail.Episode.Degraded.Select(t => t.Name))</div>
                @if (_detail.Episode.Controls.Count > 0)
                {
                    <div>
                        <span class="path-episode-dest-label">Clean</span>
                        @foreach (var (control, i) in _detail.Episode.Controls.Select((c, i) => (c, i)))
                        {
                            <span class="path-episode-target-name">@control.Name<MonitoringJumpButton Icon="MonitoringJumpButton.JumpIcon.Analyze"
                                Tooltip="@JumpTooltip(control)" OnClick="() => Jump(control)" /></span>@(i < _detail.Episode.Controls.Count - 1 ? ", " : "")
                        }
                    </div>
                }
            </div>
        }
        @foreach (var table in _detail.Tables)
        {
            <div class="path-episode-table">
            <div class="path-episode-table-head">
                <span class="path-episode-table-title path-episode-target-name">@table.Target.Name<MonitoringJumpButton Icon="MonitoringJumpButton.JumpIcon.Analyze"
                    Tooltip="@JumpTooltip(table.Target)" OnClick="() => Jump(table.Target)" /></span>
                @if (table.VantageName == null)
                {
                    @if (_detail.Episode.Tracing)
                    {
                        <span class="text-muted">Tracing every minute</span>
                    }
                }
                else
                {
                <span class="text-muted">
                    @table.Rounds @(table.Rounds == 1 ? "trace" : "traces") from @table.VantageName@(_detail.Episode.Tracing ? ", every minute" : "")@(table.HasRecovery ? ", traced again after it recovered" : _detail.Episode.ClosedAt == null ? "" : ", no trace after recovery yet")
                </span>
                @if (table.TracedAddress != null && table.TracedAddress != table.Address)
                {
                    <span class="text-muted">Traced @table.TracedAddress</span>
                }
                <a class="path-episode-rerun" href="@PathEpisodePresentation.RerunUrl(table.TracedAddress ?? table.Address, table.Vantage, _detail.Episode.WanContextId)"
                   data-tooltip="Fill Network Tools with this target and vantage" data-tooltip-hover-only>Re-run</a>
                }
            </div>
            @if (table.Hops.Count == 0)
            {
                <div class="text-muted">No round has answered yet.</div>
            }
            else
            {
            var locations = LocationsFor(table);
            <div class="table-responsive">
                <table class="data-table path-episode-hops @(table.Hops.Any(ReturnHopsWorthShowing) ? "has-return" : "") @(locations.Count > 0 ? "has-location" : "")" style="@ColumnWidths()">
                    <colgroup>
                        <col class="path-col-hop" />
                        <col />
                        <col class="path-col-network" />
                        @if (locations.Count > 0)
                        {
                            <col class="path-col-location" />
                        }
                        <col class="path-col-loss" />
                        <col class="path-col-rtt" />
                        @if (table.Hops.Any(ReturnHopsWorthShowing))
                        {
                            <col class="path-col-return" />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Hop</th>
                            <th>Address / PTR</th>
                            <th>Network</th>
                            @if (locations.Count > 0)
                            {
                                <th class="path-loc-cell" data-tooltip="The city in the router's hostname when it names one, else where GeoLite2 places the address. Hover a location for its source.">Location</th>
                            }
                            <th>Loss</th>
                            <th data-tooltip="One bar per trace. Taller is slower.">RTT (normal &rarr; during)</th>
                            @if (table.Hops.Any(ReturnHopsWorthShowing))
                            {
                                <th data-tooltip="How many hops the reply took to come back, from its TTL. Far from the hop number means a different way home.">Return hops</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hop in table.Hops)
                        {
                            var tag = PathEpisodePresentation.HopTagLabel(hop);
                            <tr class="@RowClass(hop)" @onclick="() => _selectedHop = hop">
                                <td>@hop.Ttl</td>
                                <td>
                                    @if (hop.Has(HopTag.Destination) && hop.Responses == 0)
                                    {
                                        <span>@(hop.Address ?? table.Address)</span> <span class="text-muted">(never answered)</span>
                                    }
                                    else if (hop.Responses == 0)
                                    {
                                        <span class="text-muted">* * *</span>
                                    }
                                    else if (!string.IsNullOrEmpty(hop.Hostname))
                                    {
                                        <span @attributes="NetworkOptimizer.Web.Services.Monitoring.LiveTraffic.LiveTrafficLinks.DestinationCard(hop.Address, hop.Hostname, threatsLink: false)">@hop.Hostname (@hop.Address)</span>
                                    }
                                    else
                                    {
                                        <span @attributes="NetworkOptimizer.Web.Services.Monitoring.LiveTraffic.LiveTrafficLinks.DestinationCard(hop.Address, threatsLink: false)">@hop.Address</span>
                                    }
                                    @if (tag != null)
                                    {
                                        <span class="path-hop-tag @TagClass(hop)" data-tooltip="@TagTooltip(hop)">@tag</span>
                                    }
                                    @if (hop.Has(HopTag.SeriesOnly))
                                    {
                                        <span class="path-hop-tag path-hop-tag-onset" data-tooltip="Its own ping series is degraded over the episode, but the traces didn't catch it, so they can't place where. Loss and RTT here are from that series.">Degraded</span>
                                    }
                                    @if (hop.Has(HopTag.Anchored) && hop.Address != null && _detail.PingedHops?.Contains(hop.Address) == true)
                                    {
                                        <span class="path-hop-tag path-hop-tag-muted" data-tooltip="Pinged directly during the episode, which decided it. A router limits the replies a traceroute reads far more than ping replies, and a ping to it crosses the same path.">Pinged</span>
                                    }
                                    else if (hop.Has(HopTag.Anchored))
                                    {
                                        <span class="path-hop-tag path-hop-tag-muted" data-tooltip="A monitored hop: its own ping series over the episode decided it, not these few trace probes.">Monitored</span>
                                    }
                                    @if (hop.Has(HopTag.RateLimited))
                                    {
                                        <span class="path-hop-tag path-hop-tag-muted" data-tooltip="Lost the same number of probes every round: an ICMP rate limit, not forwarding loss.">Rate-limited</span>
                                    }
                                    @if (hop.Has(HopTag.SlowPath))
                                    {
                                        <span class="path-hop-tag path-hop-tag-muted" data-tooltip="Its RTT spread dwarfs the next hop's: the router is slow to answer ICMP itself, not slow to forward.">Slow ICMP</span>
                                    }
                                </td>
                                <td><TextWithCode Text="@PathTraceAnalyzer.NetworkCell(hop)" /></td>
                                @if (locations.Count > 0)
                                {
                                    <td class="path-loc-cell">
                                        <HopLocationCell Address="@(hop.Responses > 0 ? hop.Address : null)"
                                            Location="@(hop.Responses > 0 && hop.Address != null && locations.TryGetValue(hop.Address, out var location) ? location : null)"
                                            Selected="@ReferenceEquals(_selectedHop, hop)" Open="@(_locationEdit?.Address == hop.Address)"
                                            OnEdit="e => _locationEdit = e" />
                                    </td>
                                }
                                <td class="path-hop-nowrap">
                                    @if (LossCell(hop) is { } loss)
                                    {
                                        <span data-tooltip="@loss.Tooltip">@($"{loss.Shown:0.#}%")</span>
                                        @if (loss.Higher is double higher)
                                        {
                                            @(" ")<span class="text-muted">(@loss.HigherSource @($"{higher:0.#}%"))</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td class="path-hop-nowrap path-rtt-cell">
                                    @if (hop.ReferenceRttMs is double reference && hop.RoundMinRttMs.Count > 0)
                                    {
                                        <span class="path-rtt-bars" aria-hidden="true">
                                            @for (var r = 0; r < hop.RoundMinRttMs.Count; r++)
                                            {
                                                var ms = hop.RoundMinRttMs[r];
                                                var slow = r < hop.RoundSlow.Count && hop.RoundSlow[r];
                                                <i class="@(ms == null ? "empty" : slow ? "slow" : "")" style="@BarHeight(ms, reference)"></i>
                                            }
                                        </span>
                                    }
                                    @{ var rtt = PathEpisodePresentation.HopRtt(hop, _detail); }
                                    @if (RttTooltip(hop, table, rtt) is { } rttTip)
                                    {
                                        <span class="path-rtt-value" data-tooltip="@rttTip">@(rtt?.Text ?? "-")</span>
                                    }
                                    else
                                    {
                                        <span class="path-rtt-value">@(rtt?.Text ?? "-")</span>
                                    }
                                    @if (rtt?.TraceMs is double traceMs)
                                    {
                                        @(" ")<span class="path-rtt-value text-muted">(trace @($"{traceMs:0.0}"))</span>
                                    }
                                </td>
                                @if (table.Hops.Any(ReturnHopsWorthShowing))
                                {
                                    <td>
                                        @if (ReturnHopsWorthShowing(hop) && hop.ReturnHops is int rh)
                                        {
                                            <span>@(hop.BaselineReturnHops is int b && b != rh ? $"{b} → {rh}" : rh.ToString())</span>
                                            @if (hop.Has(HopTag.ReturnDiffers))
                                            {
                                                <span class="path-hop-tag path-hop-tag-muted" data-tooltip="The reply came home by a hop count far from this hop's position on the way out.">Return differs</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
            </div>
        }
    }
</div>

@if (_locationEdit != null)
{
    <HopLocationEditor Edit="_locationEdit" OnClose="() => _locationEdit = null" OnChanged="LocationSetChangedAsync" />
}

@code {
    [Parameter, EditorRequired] public int EpisodeId { get; set; }

    /// <summary>The episode's last write: a change re-reads the table, so an open one follows the rounds.</summary>
    [Parameter] public DateTime UpdatedAt { get; set; }

    /// <summary>The WAN ISP Health is showing, so a target link lands on the same one.</summary>
    [Parameter] public string? WanKey { get; set; }

    private static string JumpTooltip(PathEpisodeTargetView t) => $"Open {t.Name} on Network Performance over this episode";

    private void Jump(PathEpisodeTargetView t) =>
        NavigationManager.NavigateTo(PathEpisodePresentation.TargetUrl(_detail!.Episode, t, WanKey, DateTime.UtcNow));

    private PathEpisodeDetail? _detail;
    private bool _failed;
    private (int Id, DateTime At)? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == (EpisodeId, UpdatedAt)) return;
        _loadedFor = (EpisodeId, UpdatedAt);
        try
        {
            _detail = await PathEpisodes.GetEpisodeAsync(EpisodeId);
            await LoadLocationSetsAsync();
            _failed = _detail == null;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not load path episode {Id}", EpisodeId);
            _failed = true;
        }
    }

    private PathHopLoss? LossCell(HopReading hop) => PathEpisodePresentation.HopLoss(hop, _detail!);

    // Location and Loss sized to their longest text, in ch, across every table in the episode so
    // the tables still line up. The rem part covers padding, the flag, and the Set location icon.
    private string ColumnWidths()
    {
        int loss = 5, loc = 8;
        foreach (var table in _detail!.Tables.Where(t => t.Hops.Count > 0))
        {
            var locations = LocationsFor(table);
            foreach (var hop in table.Hops)
            {
                loss = Math.Max(loss, PathEpisodePresentation.HopLossText(LossCell(hop)).Length);
                if (hop.Responses > 0 && hop.Address != null && locations.TryGetValue(hop.Address, out var l))
                {
                    loc = Math.Max(loc, l.Text.Length + (l.Source == NetworkOptimizer.Web.Services.Monitoring.HopLocationSource.Set ? 4 : 0));
                }
            }
        }
        // A ch is a digit's width; Loss is mostly digits, a place name mostly narrower letters.
        return $"--path-loss-w: calc({loss}ch + 1.25rem); --path-loc-w: calc({Math.Ceiling(loc * 0.85)}ch + 4.25rem);";
    }

    // Each table's hop locations, worked out once per load: a GeoLite2 read per hop is not free.
    private readonly Dictionary<NetworkOptimizer.Web.Services.Monitoring.PathLocalization.PathEpisodeHopTable, Dictionary<string, NetworkOptimizer.Web.Services.Monitoring.HopLocationView>> _locations = new();

    private Dictionary<string, NetworkOptimizer.Web.Services.Monitoring.HopLocationView> LocationsFor(NetworkOptimizer.Web.Services.Monitoring.PathLocalization.PathEpisodeHopTable table)
    {
        if (!_locations.TryGetValue(table, out var found))
        {
            var hops = table.Hops.Where(h => h.Responses > 0).Select(h => (h.Address, h.Hostname, h.MinRttMs)).ToList();
            found = NetworkOptimizer.Web.Services.Monitoring.HopLocations.Resolve(hops, Geo.Enrich, _locationSets, _learned);
            _locations[table] = found;
            // Rendering cannot wait on it, and it never throws.
            _ = LearnedLocations.LearnAsync(SiteContext.Slug, hops, found, Geo.Enrich, _detail?.Episode.ClosedAt ?? _detail?.Episode.OpenedAt);
        }
        return found;
    }

    private IReadOnlyDictionary<string, NetworkOptimizer.Web.Services.Monitoring.HopLocationSetting>? _locationSets;
    private IReadOnlyDictionary<string, NetworkOptimizer.Web.Services.Monitoring.LearnedHop>? _learned;

    // Re-reads the locations set by hand and drops the worked-out tables, so the next render places the hops again.
    private async Task LoadLocationSetsAsync()
    {
        try { _locationSets = await HopLocationSets.GetAllAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Could not read the hop locations set by hand"); }
        _learned = await LearnedLocations.GetAsync(SiteContext.Slug);
        _locations.Clear();
    }

    private Task LocationSetChangedAsync() => LoadLocationSetsAsync();

    // The tapped row, whose Set location icon shows without a hover, and the hop whose editor is open.
    private HopReading? _selectedHop;
    private NetworkOptimizer.Web.Services.Monitoring.HopLocationEdit? _locationEdit;

    // A reply that came home by as many hops as it went out says nothing, and is most of them.
    private static bool ReturnHopsWorthShowing(HopReading h) =>
        (h.ReturnHops is int rh && rh != h.Ttl) || (h.BaselineReturnHops is int b && b != h.ReturnHops);

    private static string RowClass(HopReading h) =>
        h.Has(HopTag.InRun) ? "path-hop-elevated" : h.Has(HopTag.IcmpLimited) ? "path-hop-icmp" : "";

    private static string TagClass(HopReading h) =>
        h.Has(HopTag.Onset) ? "path-hop-tag-onset" : h.Has(HopTag.LastClean) ? "path-hop-tag-clean" : "path-hop-tag-muted";

    private static string TagTooltip(HopReading h) =>
        h.Has(HopTag.Onset) ? "The degradation first appears here and every responding hop beyond it carries it. Each hop's RTT includes its own way home, so this is where it appears, not necessarily the broken link."
        : h.Has(HopTag.LastClean) ? "The last hop that stayed clean."
        : "Elevated, but the hops beyond it were not: this router deprioritizes its own ICMP replies. Shown, never blamed.";


    private static string? RttTooltip(HopReading h, NetworkOptimizer.Web.Services.Monitoring.PathLocalization.PathEpisodeHopTable table, PathHopRtt? rtt)
    {
        if (rtt == null) return null;
        var reading = PathEpisodePresentation.RoundsReading(h, table.Hops, table.Target.Name);
        if (rtt.FromSeries)
            return $"{reading}. Both figures are from its own ping series: the typical RTT over the last 24 hours, then the median over the episode.";
        return h.SeriesBaselineRttMs.HasValue
            ? $"{reading}. Normal is from its own monitored series: the typical RTT over the last 24 hours."
            : reading;
    }

    /// <summary>A round's bar: its rise over the hop's reference on a fixed 40 ms scale, so rows compare.</summary>
    private static string BarHeight(double? ms, double reference) =>
        ms is double v ? $"height: {Math.Clamp((v - reference) / 40.0 * 100.0, 0, 100):0.#}%" : "";
}
