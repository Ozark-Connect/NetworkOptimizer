@using NetworkOptimizer.Core.Helpers
@using NetworkOptimizer.Web.Services.Monitoring.LiveTraffic
@inherits LiveTrafficPieces

@if (Sankey == null || Sankey.Nodes.Count == 0)
{
    <div class="empty-state lt-sankey-empty"><p>@(Filters.Count > 0 || Searching ? "Nothing matching your filters is moving right now." : "Nothing is moving right now.")</p></div>
}
else
{
    var layout = Layout(Sankey);
    <svg class="lt-sankey-svg" viewBox="0 0 @W @H" role="img" aria-label="Where traffic goes: clients to apps to routes">
        <text class="lt-col-label" text-anchor="end" x="@(ColX[0] + NodeW)" y="14">Client</text>
        <text class="lt-col-label" x="@ColX[1]" y="14">App</text>
        <text class="lt-col-label" x="@ColX[2]" y="14">Route</text>
        @* Keyed so each band and node is the same element across refreshes; CSS then tweens its
           position and size. The d attribute is the fallback for browsers without CSS d. *@
        @foreach (var p in layout.Paths)
        {
            <path @key="p.Key" d="@p.D" style="d: path('@p.D'); stroke-width: @(F(p.Width))px" stroke="@p.Color" stroke-opacity="@F2(p.Opacity)" stroke-width="@F(p.Width)" fill="none" />
        }
        @foreach (var n in layout.Nodes)
        {
            var node = n.Node;
            var clickable = !node.IsOther;
            var anchor = node.Column == 0 ? "end" : "start";
            var appIcon = node.Column == 1 && !node.IsOther;
            var tx = node.Column == 0 ? -8 : NodeW + 8 + (appIcon ? IconW : 0);
            var clientLink = node.Column == 0 ? LiveTrafficLinks.ClientPerformance(node.ClientIp) : null;
            var unnamed = node.Column == 1 ? node.Unnamed : null;
            var routeDests = RouteDestinations(node, Sankey.ValueIsFlows);
            <g @key="(node.Column, node.Name)" class="lt-sankey-node @(clickable ? "is-clickable" : null) @(IsFiltered(node) ? "is-filtered" : null) @(unnamed != null ? "lt-app-unnamed" : null)"
               style="transform: translate(@(F(ColX[node.Column]))px, @(F(n.Y))px)"
               data-client-name="@(clientLink != null ? node.Name : null)" data-client-link="@clientLink"
               data-app-unnamed="@(unnamed != null ? node.Name : null)" data-app-seed="@unnamed?.Encode()" data-app-link="@NameAppLink(unnamed)"
               data-route-name="@(routeDests != null ? node.Name : null)" data-route-lan="@(routeDests != null && node.RouteKind == LiveRouteKind.Lan ? "1" : null)"
               data-route-dests="@routeDests" data-route-more="@(routeDests != null && node.MoreDestinations > 0 ? node.MoreDestinations : null)"
               @onclick="() => OnNodeClick(node)"
               @onmouseenter="() => { if (clickable) OnHover?.Invoke(node, DrawnColumn(node.Column)); }"
               @onmouseleave="() => { if (clickable) OnHover?.Invoke(null, null); }">
                <rect x="0" y="0" width="@NodeW" height="@F(n.Height)" style="height: @(F(n.Height))px" rx="2"
                      fill="@(node.Column == 2 ? RouteColor(node.RouteKind) : "var(--bg-elevated)")"
                      stroke="var(--text-muted)" stroke-width="0.5" />
                <g class="lt-node-text" style="transform: translateY(@(F(n.Height / 2))px)">
                    @if (appIcon)
                    {
                        @* The tables' own icon markup: SVG cannot draw a favicon or a Font Awesome glyph itself. *@
                        <foreignObject class="lt-sankey-icon" x="@(NodeW + 6)" y="-9" width="18" height="18">@(node.IconDomain != null || node.IconClass != null ? AppIcon(node.Name, node.IconDomain, node.IconClass) : AppIcon(node.Name))</foreignObject>
                    }
                    <text class="lt-node-label" text-anchor="@anchor" x="@tx" y="-1" data-tooltip="@(clientLink != null || unnamed != null || routeDests != null || Fit(node.Name, node.Column) == node.Name ? null : node.Name)" data-tooltip-hover-only>@Fit(node.Name, node.Column)</text>
                    <text class="lt-node-sub" text-anchor="@anchor" x="@tx" y="12">@if (Sankey.ValueIsFlows)
                        {
                            @TimeFormatHelper.Pluralize((int)node.Value, "flow")
                        }
                        else
                        {
                            <tspan class="@(node.DownBps >= 1 ? "lt-sub-down" : "lt-sub-idle")">↓ @SubRate(node.DownBps)</tspan><tspan class="@(node.UpBps >= 1 ? "lt-sub-up" : "lt-sub-idle")" dx="6">↑ @SubRate(node.UpBps)</tspan>
                        }</text>
                </g>
            </g>
        }
    </svg>
}

@code {
    /// <summary>The diagram to draw; null or empty draws the idle state.</summary>
    [Parameter] public LiveSankey? Sankey { get; set; }

    /// <summary>The page's filters: a node already filtered to is marked, and clicking it removes the filter.</summary>
    [Parameter] public IReadOnlyList<LiveTrafficFilter> Filters { get; set; } = Array.Empty<LiveTrafficFilter>();

    private bool IsFiltered(LiveSankeyNode node) => Filters.Any(f => !f.Exclude && f.Field == node.Field
        && string.Equals(f.Value, node.Name, StringComparison.OrdinalIgnoreCase));

    /// <summary>While true no node changes place (the pointer is on the diagram); sizes still update.</summary>
    [Parameter] public bool Hold { get; set; }

    /// <summary>A search narrows the page, so an empty diagram says nothing matches rather than nothing moves.</summary>
    [Parameter] public bool Searching { get; set; }

    /// <summary>A click on a client, app, or route node: filter the page to it.</summary>
    [Parameter] public EventCallback<LiveTrafficFilter> OnFilter { get; set; }

    /// <summary>
    /// The pointer entered a clickable node, with the column as last drawn (or left one, with nulls).
    /// A plain delegate, not an EventCallback: the page only records it for its next query, so
    /// nothing needs to redraw.
    /// </summary>
    [Parameter] public Action<LiveSankeyNode?, IReadOnlyList<LiveSankeyNode>?>? OnHover { get; set; }

    /// <summary>The column the pointer is on as it was drawn: newer data may already sit with the page.</summary>
    private IReadOnlyList<LiveSankeyNode> DrawnColumn(int column) =>
        _drawn.Where(n => n.Column == column).ToList();

    private IReadOnlyList<LiveSankeyNode> _drawn = Array.Empty<LiveSankeyNode>();

    /// <summary>The hovered node the page holds: it keeps its place on screen while it is held.</summary>
    [Parameter] public LiveSankeyNode? Pinned { get; set; }

    /// <summary>Each node's vertical center at the last render, by column and name.</summary>
    private Dictionary<(int, string), double> _centers = new();

    private const int W = 790;
    private const int H = 360;
    private const double Top = 30;
    private const double Bottom = 22;
    private const int NodeW = 10;
    /// <summary>Approximate width of one 12px Inter character, in viewBox units.</summary>
    private const double CharW = 6.2;
    private const int LabelGap = 8;
    /// <summary>Width of the widest likely rate subtitle, in viewBox units.</summary>
    private const double SubW = 130;
    /// <summary>Room an app node's icon takes before its label.</summary>
    private const int IconW = 22;
    private double[] ColX = [150, 400, 620];

    /// <summary>
    /// Places the columns from the labels they carry: client labels sit left of their nodes and app
    /// and route labels right of theirs, so the client column moves right as far as its longest name
    /// needs, the route column keeps room for its own, and the app column sits midway.
    /// </summary>
    private static double[] Columns(LiveSankey sankey)
    {
        // A rate subtitle ("↓ 12.3 Mbps ↑ 1.1 Mbps", in the smaller sub font) needs its room as much as a name.
        var sub = sankey.ValueIsFlows ? 0 : SubW;
        double Longest(int col) => Math.Max(sub, sankey.Nodes.Where(n => n.Column == col)
            .Select(n => n.Name.Length * CharW).DefaultIfEmpty(0).Max());
        // Capped: a long client name is trimmed rather than squeezing the flows into the right half.
        var left = Math.Clamp(Longest(0) + LabelGap + 2, 90, 230);
        var route = Math.Clamp(W - NodeW - LabelGap - Longest(2) - 4, left + 260, W - NodeW - LabelGap - 60);
        var app = Math.Min(left + (route - left) / 2, route - NodeW - LabelGap - IconW - Longest(1) - 24);
        return [left, Math.Max(app, left + 120), route];
    }

    private sealed record PlacedNode(LiveSankeyNode Node, double Y, double Height);
    private sealed record PlacedPath(string Key, string D, string Color, double Width, double Opacity);

    /// <summary>Each node's place at the last render, by column and name.</summary>
    private Dictionary<(int, string), int> _ranks = new();

    /// <summary>How far a node must out-rate the one above it before they swap.</summary>
    private const double SwapMargin = 1.2;
    private sealed record Placed(List<PlacedNode> Nodes, List<PlacedPath> Paths);

    private Task OnNodeClick(LiveSankeyNode node) =>
        node.IsOther ? Task.CompletedTask : OnFilter.InvokeAsync(new LiveTrafficFilter(node.Field, node.Name));

    /// <summary>Log scale (on Mbps for rate), so a 2 Mbps flow stays visible beside a 500 Mbps download.</summary>
    private static double Size(double value, bool flows) => 6 + 16 * Math.Log10(1 + (flows ? value : value / 1_000_000));

    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>A node's rate in one direction: an idle one reads "0 bps" (muted by its class), never "-".</summary>
    private static string SubRate(double bps) => bps >= 1 ? DisplayFormatters.FormatRate(bps) : "0 bps";

    /// <summary>
    /// A route node's hover card rows as JSON (name, address when it differs, and rates or a flow count),
    /// for App.razor's card. Null for other columns and for a route with nothing moving. A LAN host is
    /// a client too, so its rates read from its own side: what the source downloads, the host uploads.
    /// </summary>
    private static string? RouteDestinations(LiveSankeyNode node, bool flows)
    {
        if (node.Column != 2 || node.Destinations is not { Count: > 0 } dests) return null;
        var hostSide = node.RouteKind == LiveRouteKind.Lan;
        return System.Text.Json.JsonSerializer.Serialize(dests.Select(d => new
        {
            n = d.Name,
            ip = d.Ip != null && !d.Ip.Equals(d.Name, StringComparison.OrdinalIgnoreCase) ? d.Ip : null,
            d = flows ? null : SubRate(hostSide ? d.UpBps : d.DownBps),
            u = flows ? null : SubRate(hostSide ? d.DownBps : d.UpBps),
            f = flows ? TimeFormatHelper.Pluralize((int)d.Value, "flow") : null,
        }));
    }

    private static string F2(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string RouteColor(LiveRouteKind? kind) => kind switch
    {
        LiveRouteKind.Vpn => "#a78bfa",
        LiveRouteKind.Lan => "#f59e0b",
        _ => "#2ba89a",
    };

    /// <summary>The name, cut with an ellipsis when it would run past the room its column has.</summary>
    private string Fit(string name, int column)
    {
        var room = column switch
        {
            0 => ColX[0] - LabelGap - 2,
            1 => ColX[2] - ColX[1] - NodeW - LabelGap - IconW - 12,
            _ => W - ColX[2] - NodeW - LabelGap - 2,
        };
        var max = Math.Max(4, (int)(room / CharW));
        return name.Length <= max ? name : name[..(max - 1)].TrimEnd() + "…";
    }

    private Placed Layout(LiveSankey sankey)
    {
        ColX = Columns(sankey);
        var placed = new Dictionary<(int, string), PlacedNode>();
        var outOffset = new Dictionary<(int, string), double>();
        var inOffset = new Dictionary<(int, string), double>();
        var nodes = new List<PlacedNode>();
        var avail = H - Top - Bottom;

        var ranks = new Dictionary<(int, string), int>();
        for (var col = 0; col < 3; col++)
        {
            var column = Order(sankey.Nodes.Where(n => n.Column == col).ToList(), col);
            for (var i = 0; i < column.Count; i++) ranks[(col, column[i].Name)] = i;
            if (column.Count == 0) continue;
            var heights = column.Select(n => Size(n.Value, sankey.ValueIsFlows)).ToList();
            var total = heights.Sum();
            // Too many nodes for the column: shrink every height, keep a minimum gap.
            var scale = total + 4 * (column.Count - 1) > avail ? (avail - 4 * (column.Count - 1)) / total : 1;
            heights = heights.Select(h => Math.Max(2, h * scale)).ToList();
            var gap = column.Count > 1 ? (avail - heights.Sum()) / (column.Count - 1) : 0;
            var ys = PinnedYs(column, heights, col, gap);
            var y = Top;
            for (var i = 0; i < column.Count; i++)
            {
                var p = new PlacedNode(column[i], ys?[i] ?? y, heights[i]);
                placed[(col, column[i].Name)] = p;
                nodes.Add(p);
                y += heights[i] + gap;
            }
        }

        _ranks = ranks;
        _centers = nodes.ToDictionary(n => (n.Node.Column, n.Node.Name), n => n.Y + n.Height / 2);
        _drawn = sankey.Nodes;

        // Each node stacks its links in the order of the nodes at their other end, so a band keeps
        // its slot from one refresh to the next and bands cross as little as they can.
        var ends = new List<(LiveSankeyLink Link, PlacedNode From, PlacedNode To, double SFrom, double STo)>();
        foreach (var link in sankey.Links)
        {
            if (!placed.TryGetValue((link.Column, link.From), out var from)
                || !placed.TryGetValue((link.Column + 1, link.To), out var to)) continue;
            ends.Add((link, from, to, from.Height * link.Value / Math.Max(1, from.Node.Value), to.Height * link.Value / Math.Max(1, to.Node.Value)));
        }
        var y0s = new Dictionary<LiveSankeyLink, double>();
        foreach (var e in ends.OrderBy(e => e.To.Y))
        {
            var o = outOffset.GetValueOrDefault((e.Link.Column, e.Link.From));
            outOffset[(e.Link.Column, e.Link.From)] = o + e.SFrom;
            y0s[e.Link] = e.From.Y + o + e.SFrom / 2;
        }
        var paths = new List<PlacedPath>();
        // One pair can carry two links (the same client and service over WAN and VPN), and a duplicate
        // @key throws and kills the circuit: key by route too, and number any repeat.
        var keyCount = new Dictionary<string, int>();
        foreach (var e in ends.OrderBy(e => e.From.Y))
        {
            var o = inOffset.GetValueOrDefault((e.Link.Column + 1, e.Link.To));
            inOffset[(e.Link.Column + 1, e.Link.To)] = o + e.STo;
            var y0 = y0s[e.Link];
            var y1 = e.To.Y + o + e.STo / 2;
            double x0 = ColX[e.Link.Column] + NodeW, x1 = ColX[e.Link.Column + 1];
            var mx = (x0 + x1) / 2;
            var key = $"{e.Link.Column}|{e.Link.From}|{e.Link.To}|{e.Link.RouteKind}";
            var seen = keyCount.GetValueOrDefault(key);
            keyCount[key] = seen + 1;
            if (seen > 0) key += $"#{seen}";
            var width = Math.Max(1.2, Math.Min(e.SFrom, e.STo));
            var color = RouteColor(e.Link.RouteKind);
            string Curve(double dy) => $"M{F(x0)},{F(y0 + dy)} C{F(mx)},{F(y0 + dy)} {F(mx)},{F(y1 + dy)} {F(x1)},{F(y1 + dy)}";
            var total = e.Link.DownBps + e.Link.UpBps;
            if (sankey.ValueIsFlows || total <= 0)
            {
                paths.Add(new PlacedPath(key, Curve(0), color, width, BandOpacity));
                continue;
            }
            // Split by direction, both in the route's color: download on top and stronger, upload below
            // and lighter. Keyed apart so each strand tweens on its own.
            var down = width * e.Link.DownBps / total;
            var up = width - down;
            if (down >= 0.5) paths.Add(new PlacedPath(key + "|d", Curve(-width / 2 + down / 2), color, down, DownOpacity));
            if (up >= 0.5) paths.Add(new PlacedPath(key + "|u", Curve(width / 2 - up / 2), color, up, UpOpacity));
        }
        return new Placed(nodes, paths);
    }

    /// <summary>The smallest gap the pinned layout leaves between nodes: a label and its rate line, with room.</summary>
    private const double PinnedGapFloor = 24;

    /// <summary>
    /// Tops for the pinned node's column: the pinned node keeps the center it had at the last render,
    /// and the nodes above and below it spread evenly in the room left on each side. The page holds
    /// the column's node set while it is pinned, so nothing new can crowd in beside it. Where holding
    /// its center would close a gap below the floor, it moves only as far as the floor needs. Null
    /// (the ordinary even spread) when the pin is elsewhere, was not drawn last time, or cannot fit.
    /// </summary>
    private List<double>? PinnedYs(List<LiveSankeyNode> column, List<double> heights, int col, double gap)
    {
        if (Pinned == null || Pinned.Column != col) return null;
        var k = column.FindIndex(n => n.Name == Pinned.Name);
        if (k < 0 || !_centers.TryGetValue((col, Pinned.Name), out var center)) return null;
        var floor = Math.Min(gap, PinnedGapFloor);
        var above = heights.Take(k).ToList();
        var below = heights.Skip(k + 1).ToList();
        var lowest = Top + above.Sum() + floor * above.Count;
        var highest = H - Bottom - heights[k] - below.Sum() - floor * below.Count;
        if (lowest > highest) return null;
        var pinnedY = Math.Clamp(center - heights[k] / 2, lowest, highest);

        var ys = new List<double>();
        var gapAbove = above.Count > 0 ? (pinnedY - Top - above.Sum()) / above.Count : 0;
        var y = Top;
        foreach (var h in above)
        {
            ys.Add(y);
            y += h + gapAbove;
        }
        ys.Add(pinnedY);
        var gapBelow = below.Count > 0 ? (H - Bottom - pinnedY - heights[k] - below.Sum()) / below.Count : 0;
        y = pinnedY + heights[k] + gapBelow;
        foreach (var h in below)
        {
            ys.Add(y);
            y += h + gapBelow;
        }
        return ys;
    }

    private const double BandOpacity = 0.35;
    private const double DownOpacity = 0.55;
    private const double UpOpacity = 0.2;

    /// <summary>
    /// A column's order: the last order kept, with a node moving up only once it beats the one above
    /// by a clear margin, so two near-equal nodes do not trade places every refresh. Held, nothing
    /// moves. New nodes join by value; Other stays last.
    /// </summary>
    private List<LiveSankeyNode> Order(List<LiveSankeyNode> column, int col)
    {
        var ordered = column.Where(n => !n.IsOther)
            .OrderBy(n => _ranks.TryGetValue((col, n.Name), out var r) ? r : int.MaxValue)
            .ThenByDescending(n => n.Value)
            .ToList();
        if (!Hold)
        {
            for (var pass = 0; pass < ordered.Count; pass++)
            {
                var swapped = false;
                for (var i = 0; i + 1 < ordered.Count; i++)
                {
                    var above = ordered[i];
                    var below = ordered[i + 1];
                    var isNew = !_ranks.ContainsKey((col, below.Name));
                    if (below.Value > above.Value * (isNew ? 1 : SwapMargin))
                    {
                        (ordered[i], ordered[i + 1]) = (below, above);
                        swapped = true;
                    }
                }
                if (!swapped) break;
            }
        }
        ordered.AddRange(column.Where(n => n.IsOther));
        return ordered;
    }
}
