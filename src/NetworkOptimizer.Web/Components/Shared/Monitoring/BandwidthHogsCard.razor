@using NetworkOptimizer.Core.Helpers
@using NetworkOptimizer.Web.Services.Monitoring.BandwidthHogs
@inject BandwidthHogsService Hogs
@inject IConntrackStatusService ConntrackStatus
@inject SiteContextService SiteContext
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ILogger<BandwidthHogsCard> Logger
@inject NetworkOptimizer.Web.Services.Monitoring.LiveWanScope SelfWan
@inject MonitoringLiveStats LiveStats
@inject UniFiConnectionService ConnectionService
@inject NetworkOptimizer.Web.Services.Monitoring.LiveTraffic.ILiveTrafficService LiveTraffic
@inject NavigationManager Nav
@implements IDisposable
@using NetworkOptimizer.Web.Services.Monitoring.LiveTraffic
@using NetworkOptimizer.Web.Components.Shared.Monitoring.LiveTraffic

@if (SelfFedUnavailable)
{
    @Unavailable
}
else
{
<div class="card bandwidth-hogs-card" style="margin-top: 1rem;" data-tour="@(SelfFed ? null : "bandwidth-hogs")">
    @* The whole header opens Live Traffic; its controls stop the click so they only do their own job. *@
    <div class="card-header lt-header-link" @onclick="@(() => Nav.NavigateTo("/monitoring/live-traffic"))">
        <div class="card-title-group">
            <a href="/monitoring/live-traffic" class="card-title-link" @onclick:stopPropagation><h2 class="card-title">@Title</h2></a>
            @* The maps' own mode badge, so the card says what they say about the moment it shows. *@
            @if (HistoricAt != null)
            {
                <span class="lan-flow-map-mode is-historic" style="cursor: pointer;" data-tooltip="Click to return to live" data-tooltip-hover-only
                      @onclick="ReturnToLiveAsync" @onclick:stopPropagation>Historic</span>
            }
            else if (_mode == Mode.Throughput)
            {
                <span class="lan-flow-map-mode">Live</span>
            }
            @* On a phone Detailed View sits here, at the right of the title, instead of in the By row. *@
            <a href="/monitoring/live-traffic" class="btn btn-secondary btn-sm lt-icon-btn lt-header-detail" @onclick:stopPropagation>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="9" y1="6" x2="21" y2="6" /><line x1="9" y1="12" x2="21" y2="12" /><line x1="9" y1="18" x2="21" y2="18" /><line x1="4" y1="6" x2="4.01" y2="6" /><line x1="4" y1="12" x2="4.01" y2="12" /><line x1="4" y1="18" x2="4.01" y2="18" /></svg>
                Detailed View
            </a>
        </div>
        <div class="card-header-right bandwidth-hogs-controls" @onclick:stopPropagation>
            <div class="time-range-selector">
                <button class="time-btn @(_mode == Mode.Throughput ? "active" : "")" @onclick="() => SetModeAsync(Mode.Throughput)">Throughput</button>
                <button class="time-btn @(_mode == Mode.Data ? "active" : "")" @onclick="() => SetModeAsync(Mode.Data)">Data</button>
            </div>
            <div class="time-range-selector">
                <button class="time-btn @(_view == View.Wan ? "active" : "")" @onclick="() => SetViewAsync(View.Wan)">WAN</button>
                <button class="time-btn @(_view == View.LanPlusWan ? "active" : "")" @onclick="() => SetViewAsync(View.LanPlusWan)">LAN + WAN</button>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (_mode == Mode.Data)
        {
            <div class="time-range-selector bandwidth-hogs-window">
                @foreach (var (hours, label) in TimeFilters)
                {
                    <button class="time-btn @(_hours == hours ? "active" : "")" @onclick="() => SetHoursAsync(hours)">@label</button>
                }
            </div>
        }
        @if (_mode == Mode.Throughput && _view == View.Wan && _result != null)
        {
            <div class="bandwidth-hogs-wan-line">
                @{ var (liveDown, liveUp) = CurrentWanRate(); }
                @if (liveDown == null && liveUp == null)
                {
                    <span class="hogs-wan-detail">WAN rate unavailable</span>
                }
                else
                {
                    var down = liveDown ?? 0;
                    var up = liveUp ?? 0;
                    var capacity = (_result.WanCapacityDownBps ?? 0) + (_result.WanCapacityUpBps ?? 0);
                    if (capacity > 0)
                    {
                        <strong>WAN @Math.Round(100 * (down + up) / capacity)% saturated</strong>
                        <span class="hogs-wan-detail hogs-wan-pair">
                            <span class="hogs-wan-half"><span class="speed-down @Muted(down)">@Rate0(down)</span><span class="hogs-wan-of">of @DisplayFormatters.FormatRate(_result.WanCapacityDownBps)<span class="hogs-wan-dir"> down</span></span></span>
                            <span class="hogs-wan-half"><span class="speed-up @Muted(up)">@Rate0(up)</span><span class="hogs-wan-of">of @DisplayFormatters.FormatRate(_result.WanCapacityUpBps)<span class="hogs-wan-dir"> up</span></span></span>
                        </span>
                    }
                    else
                    {
                        <strong>WAN</strong>
                        <span class="hogs-wan-detail">
                            <span class="speed-down @Muted(down)">@Rate0(down)</span> down,
                            <span class="speed-up @Muted(up)">@Rate0(up)</span> up
                        </span>
                    }
                }
            </div>
        }
        @if (LiveTrafficEnabled)
        {
            <div class="lt-card-tools">
                @if (AgentCovered)
                {
                    <span class="lt-by-label">By</span>
                    <div class="time-range-selector">
                        @foreach (var by in Enum.GetValues<CardBy>())
                        {
                            <button class="time-btn @(_by == by ? "active" : "")" @onclick="() => SetByAsync(by)">@by</button>
                        }
                    </div>
                }
                <div class="lt-tools-right">
                    <a href="/monitoring/live-traffic" class="btn btn-secondary btn-sm lt-icon-btn" data-tour="live-traffic-full-view">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="9" y1="6" x2="21" y2="6" /><line x1="9" y1="12" x2="21" y2="12" /><line x1="9" y1="18" x2="21" y2="18" /><line x1="4" y1="6" x2="4.01" y2="6" /><line x1="4" y1="12" x2="4.01" y2="12" /><line x1="4" y1="18" x2="4.01" y2="18" /></svg>
                        Detailed View
                    </a>
                </div>
            </div>
        }
        @if (_mode == Mode.Throughput && HistoricAt == null && _view == View.Wan && _result?.WarmupSecondsRemaining > 0)
        {
            <div class="alert-info hogs-warmup">
                Warming up - device WAN rates may read low or inaccurately for the next @_result.WarmupSecondsRemaining seconds.
            </div>
        }
        @if (HistoricAt == null && _view == View.Wan && _agentStatus is { } status)
        {
            @if (status.State == GatewayAgentConntrackState.GatewayAgentNeedsUpdate)
            {
                <div class="connection-banner pwa-banner hogs-agent-notice">
                    <div class="banner-content">
                        <span class="banner-icon" style="background: var(--info-color); color: white;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                                <polyline points="21 3 21 9 15 9" />
                            </svg>
                        </span>
                        <div class="banner-text">
                            <strong style="color: var(--info-color);">Update the On-Site Agent on your Gateway</strong>
                            <span style="color: var(--text-secondary);">Newer Agent builds measure per-device WAN usage right at the Gateway, upgrading these figures from estimates to accurate @(MultiWan ? "per-WAN " : "")measurements for all clients.</span>
                        </div>
                        <SiteAdminOnly>
                            <div class="banner-actions">
                                <a href="@($"/settings?tab=multisite&configure={SiteContext.Slug}")" class="btn-pwa-action">Upgrade Agent</a>
                            </div>
                        </SiteAdminOnly>
                    </div>
                </div>
            }
            else if (status.State == GatewayAgentConntrackState.NoGatewayAgent && !status.SuggestionDismissed)
            {
                <SiteAdminOnly>
                    <div class="connection-banner pwa-banner hogs-agent-notice">
                        <div class="banner-content">
                            <span class="banner-icon" style="background: var(--info-color); color: white;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                                    <line x1="6" y1="18" x2="6.01" y2="18" />
                                    <line x1="10" y1="18" x2="10.01" y2="18" />
                                    <path d="M12 14V6a2 2 0 0 1 2-2h6" />
                                </svg>
                            </span>
                            <div class="banner-text">
                                <strong style="color: var(--info-color);">Measure per-device WAN at the source</strong>
                                <span style="color: var(--text-secondary);">Install the On-Site Agent on your UniFi Gateway and these WAN figures become accurate @(MultiWan ? "per-WAN " : "")measurements for all clients instead of an approximation.</span>
                            </div>
                            <div class="banner-actions">
                                <a href="@($"/settings?tab=multisite&configure={SiteContext.Slug}")" class="btn-pwa-action">Set It Up</a>
                                <button class="btn-pwa-dismiss" @onclick="DismissAgentSuggestionAsync">Dismiss</button>
                            </div>
                        </div>
                    </div>
                </SiteAdminOnly>
            }
        }
        @if (LiveTrafficEnabled && AgentCovered && _by != CardBy.Client)
        {
            @GroupedTable
        }
        else
        {
        var rows = Sorted(TopRows());
        @if (_result == null && !_error)
        {
            <div class="loading-container hogs-loading"><div class="spinner spinner-sm"></div></div>
        }
        else if (rows.Count == 0)
        {
            <div class="empty-state">
                <p>@EmptyText</p>
            </div>
        }
        else
        {
            var rank = 0;
            var denominator = ShareDenominator();
            // Pad no further than the site's client count: slots no client could ever fill are blank rows.
            // The count of clients on the map, not of rows: rows are only the clients moving traffic now,
            // and padding to those let the card change height with the traffic.
            var slots = _mode == Mode.Data ? rows.Count : Math.Min(_showAll ? MaxRows : CollapsedRows, Math.Max(rows.Count, _result?.ClientCount ?? 0));
            <div class="table-responsive">
                <table class="data-table bandwidth-hogs-table">
                    @* Widths sit on the header cells, not a colgroup: a hidden <col> left an empty column
                       in Safari once the colgroup re-rendered. *@
                    <thead>
                        <tr>
                            <th class="hogs-rank hogs-col-rank hide-mobile">#</th>
                            <th class="hogs-col-client">Client</th>
                            @if (_mode == Mode.Throughput)
                            {
                                <th class="hogs-col-via hide-mobile">Via</th>
                            }
                            <th class="hogs-col-rate sortable @SortClass(SortColumn.Download)" @onclick="() => ToggleSort(SortColumn.Download)">Download</th>
                            <th class="hogs-col-rate sortable @SortClass(SortColumn.Upload)" @onclick="() => ToggleSort(SortColumn.Upload)">Upload</th>
                            <th class="hogs-col-share"><span data-tooltip="@ShareTooltip">Share</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (row, fading) in rows.Take(slots))
                        {
                            rank++;
                            var value = RowValue(row);
                            var share = denominator > 0 ? 100 * value / denominator : 0;
                            // The bar IS the share, so the number and the bar say one thing.
                            var width = Math.Min(100, share);
                            var expandable = Expandable(row);
                            var expanded = expandable && _expandedMac == row.ClientMac;
                            <tr class="@(fading ? "hogs-fading" : null) @(expanded ? "lt-row-open" : null) @(expandable ? "lt-expandable" : null)"
                                @onclick="() => expandable ? ToggleExpandAsync(row.ClientMac) : Task.CompletedTask">
                                <td class="hogs-rank hide-mobile">
                                    @if (expandable)
                                    {
                                        <span class="expand-chevron lt-chev" role="button" aria-label="Show this client's flows">@(expanded ? "▲" : "▼")</span>
                                    }
                                    @rank
                                </td>
                                <td class="hogs-client">
                                    @if (expandable)
                                    {
                                        @* The rank column is hidden on mobile, so the chevron moves beside the name. *@
                                        <span class="expand-chevron lt-chev hogs-chev-mobile" aria-hidden="true">@(expanded ? "▲" : "▼")</span>
                                    }
                                    @if (!string.IsNullOrEmpty(row.Ip))
                                    {
                                        <a href="@ClientLink(row)" data-tooltip="@PortGroupTooltip(row)" @onclick:stopPropagation>@row.DisplayName</a>
                                    }
                                    else
                                    {
                                        <span data-tooltip="@PortGroupTooltip(row)">@row.DisplayName</span>
                                    }
                                </td>
                                @if (_mode == Mode.Throughput)
                                {
                                    <td class="hide-mobile hogs-via">
                                        @if (!row.IsWired && row.Band != null)
                                        {
                                            <span class="band-badge @BandClass(row.Band)">@row.Band GHz</span>
                                        }
                                        else if (row.IsWired && row.ViaPort != null)
                                        {
                                            <span class="band-badge hogs-port-badge" data-tooltip="@PortTooltip(row.ViaPort)" data-tooltip-hover-only>@row.ViaPort</span>
                                        }
                                        @if (row.ViaDevice != null)
                                        {
                                            <span>@row.ViaDevice</span>
                                        }
                                    </td>
                                }
                                <td>
                                    <span class="speed-down @(IsIdle(row, true) ? "lt-muted" : null)">@FormatDown(row)</span>
                                    @if (ShowLocal)
                                    {
                                        <span class="hogs-sub">Local @DisplayFormatters.FormatBytes(Math.Max(0, row.DownBytes - row.WanDownBytes))</span>
                                    }
                                </td>
                                <td>
                                    <span class="speed-up @(IsIdle(row, false) ? "lt-muted" : null)">@FormatUp(row)</span>
                                    @if (ShowLocal)
                                    {
                                        <span class="hogs-sub">Local @DisplayFormatters.FormatBytes(Math.Max(0, row.UpBytes - row.WanUpBytes))</span>
                                    }
                                </td>
                                <td>
                                    <span class="hogs-share">
                                        <span>@DisplayFormatters.FormatShare(share)%</span>
                                        <span class="hogs-bar"><span class="hogs-fill" style="width: @width.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></span></span>
                                    </span>
                                </td>
                            </tr>
                            @if (expanded)
                            {
                                @NestedFlows(row)
                            }
                        }
                        @for (var i = rows.Count; i < slots; i++)
                        {
                            <tr class="hogs-slot-empty"><td colspan="6">&nbsp;</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_mode == Mode.Throughput)
            {
                <button type="button" class="btn btn-secondary btn-sm hogs-show-more @(_showAll || VisibleRows(_view).Count() > CollapsedRows ? null : "hogs-show-more-hidden")"
                        @onclick="() => _showAll = !_showAll">
                    @(_showAll ? "Show fewer" : "Show more")
                </button>
            }
        }
        }
    </div>
</div>
}

@code {
    /// <summary>The card's heading. Firmware Rollout names it Clear to Deploy?.</summary>
    [Parameter] public string Title { get; set; } = "Live Traffic";

    // ---------------------------------------------------------------- Live Traffic

    private enum CardBy { Client, App, Destination, Route }
    private CardBy _by = CardBy.Client;
    private string? _expandedMac;
    private LiveTrafficView? _lt;
    private readonly string _ltViewer = Guid.NewGuid().ToString("N");
    private bool _ltHeld;

    /// <summary>Live Traffic's extras live on Live View's live WAN throughput, not at a playhead or on a self-fed card.</summary>
    private bool LiveTrafficEnabled => !SelfFed && _mode == Mode.Throughput && _view == View.Wan && HistoricAt == null;

    /// <summary>Per-flow detail comes from the gateway agent only.</summary>
    private bool AgentCovered => _agentStatus?.State == GatewayAgentConntrackState.Covered;

    private bool Expandable(HogRow row) =>
        LiveTrafficEnabled && AgentCovered && !row.IsPortGroup && !string.IsNullOrEmpty(row.ClientMac);

    /// <summary>The agent sends per-flow detail only while a view needs it: a group or an open client.</summary>
    private bool LiveTrafficWanted => LiveTrafficEnabled && AgentCovered && (_by != CardBy.Client || _expandedMac != null);

    private async Task RefreshLiveTrafficAsync()
    {
        if (!LiveTrafficWanted)
        {
            _lt = null;
            await ReleaseLiveTrafficAsync();
            return;
        }
        try
        {
            _lt = await LiveTraffic.GetViewAsync(new LiveTrafficQuery
            {
                ViewerId = _ltViewer,
                WanOnly = true,
                IncludeDns = false,
                IncludeSankey = false,
                GroupBy = _by switch
                {
                    CardBy.App => LiveTrafficGroupBy.App,
                    CardBy.Destination => LiveTrafficGroupBy.Destination,
                    CardBy.Route => LiveTrafficGroupBy.Route,
                    _ => LiveTrafficGroupBy.Flows,
                },
                Filters = _by == CardBy.Client && _expandedMac != null
                    ? [new LiveTrafficFilter(LiveTrafficField.Client, _expandedMac)]
                    : [],
                MaxRows = 6,
            });
            _ltHeld = true;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Live Traffic: card refresh failed");
        }
    }

    private async Task ReleaseLiveTrafficAsync()
    {
        if (!_ltHeld) return;
        _ltHeld = false;
        try { await LiveTraffic.ReleaseAsync(_ltViewer); }
        catch (Exception ex) { Logger.LogDebug(ex, "Live Traffic: release failed"); }
    }

    private async Task ToggleExpandAsync(string mac)
    {
        _expandedMac = _expandedMac == mac ? null : mac;
        _lt = null;
        await RefreshLiveTrafficAsync();
    }

    private async Task SetByAsync(CardBy by)
    {
        if (_by == by) return;
        _by = by;
        _expandedMac = null;
        _lt = null;
        await RefreshLiveTrafficAsync();
    }

    private static string FullViewLink(params (string Key, string? Value)[] filters)
    {
        var parts = filters.Where(f => !string.IsNullOrEmpty(f.Value)).Select(f => $"{f.Key}={Uri.EscapeDataString(f.Value!)}");
        var query = string.Join("&", parts);
        return query.Length == 0 ? "/monitoring/live-traffic" : $"/monitoring/live-traffic?{query}";
    }

    private static string RouteClass(LiveRouteKind kind) => LiveTrafficDisplay.RouteClass(kind);

    private LiveTrafficRowContext? _nestedContext;
    private string? _nestedFor;

    /// <summary>The card has no filters: a flow's values open Detailed View filtered to them, the destination with its client.</summary>
    private LiveTrafficRowContext NestedContext(HogRow row)
    {
        if (_nestedContext != null && _nestedFor == row.DisplayName) return _nestedContext;
        var client = row.DisplayName;
        _nestedFor = client;
        return _nestedContext = new LiveTrafficRowContext
        {
            LinkFor = (field, value) => field switch
            {
                LiveTrafficField.Destination => FullViewLink(("client", client), ("dest", value)),
                LiveTrafficField.App => FullViewLink(("app", value)),
                LiveTrafficField.Route => FullViewLink(("route", value)),
                _ => null,
            },
        };
    }

    /// <summary>
    /// A client's flows under its row, lined up with the parent's columns. Rendered twice, one cell
    /// per breakpoint: a cell spanning the columns a phone hides would add phantom columns there.
    /// </summary>
    private RenderFragment NestedFlows(HogRow row) => __builder =>
    {
        <tr class="lt-nested">
            <td colspan="6" class="hide-mobile">@NestedTable(row, phone: false)</td>
            <td colspan="4" class="show-mobile">@NestedTable(row, phone: true)</td>
        </tr>
    };

    private RenderFragment NestedTable(HogRow row, bool phone) => __builder =>
    {
        var flows = _lt?.Flows ?? Array.Empty<LiveFlowRow>();
        <table class="lt-nested-table">
            <colgroup>
                @if (!phone)
                {
                    <col class="hogs-col-rank" />
                }
                <col />
                @if (!phone)
                {
                    <col class="hogs-col-via" />
                }
                <col class="hogs-col-rate" /><col class="hogs-col-rate" /><col class="hogs-col-share" />
            </colgroup>
            <thead>
                <tr>
                    @if (!phone)
                    {
                        <th></th>
                    }
                    <th>Destination</th>
                    @if (!phone)
                    {
                        <th>App and Route</th>
                    }
                    <th>Download</th><th>Upload</th><th>Started</th>
                </tr>
            </thead>
            <tbody>
                @if (_lt == null)
                {
                    <tr><td colspan="6"><span class="spinner spinner-sm"></span></td></tr>
                }
                else if (flows.Count == 0)
                {
                    <tr><td colspan="6" class="lt-muted">No WAN flows moving right now.</td></tr>
                }
                @foreach (var f in flows)
                {
                    <LiveFlowRowView @key="f.Key" Flow="f" Layout="@(phone ? LiveFlowLayout.NestedPhone : LiveFlowLayout.Nested)" Context="NestedContext(row)" />
                }
            </tbody>
        </table>
        <div class="lt-nested-more">
            <a href="@FullViewLink(("client", row.DisplayName))">All flows for @row.DisplayName in Detailed View</a>
        </div>
    };

    /// <summary>The card grouped by app, destination, or route: the same columns, the group in the Client column.</summary>
    private RenderFragment GroupedTable => __builder =>
    {
        if (_lt == null)
        {
            <div class="loading-container hogs-loading"><div class="spinner spinner-sm"></div></div>
            return;
        }
        var groups = _lt.Groups.Take(_showAll ? MaxRows : CollapsedRows).ToList();
        if (groups.Count == 0)
        {
            <div class="empty-state"><p>No WAN traffic right now.</p></div>
            return;
        }
        var total = _lt.Groups.Sum(g => g.DownBps + g.UpBps);
        var key = _by switch { CardBy.App => "app", CardBy.Destination => "dest", _ => "route" };
        var rank = 0;
        <div class="table-responsive">
            <table class="data-table bandwidth-hogs-table">
                <thead>
                    <tr>
                        <th class="hogs-rank hogs-col-rank hide-mobile">#</th>
                        <th class="hogs-col-client">@_by</th>
                        <th class="hogs-col-via hide-mobile">Flows</th>
                        <th class="hogs-col-rate sortable sort-desc">Download</th>
                        <th class="hogs-col-rate">Upload</th>
                        <th class="hogs-col-share">Share</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in groups)
                    {
                        rank++;
                        var share = total > 0 ? 100 * (g.DownBps + g.UpBps) / total : 0;
                        <tr>
                            <td class="hogs-rank hide-mobile">@rank</td>
                            <td class="hogs-client">
                                @if (g.RouteKind is { } kind)
                                {
                                    <a class="filter-pill @RouteClass(kind)" href="@FullViewLink((key, g.Name))">@g.Name</a>
                                }
                                else
                                {
                                    <a href="@FullViewLink((key, g.Name))">@g.Name</a>
                                }
                            </td>
                            <td class="hide-mobile hogs-via">@TimeFormatHelper.Pluralize(g.Flows, "flow")@(string.IsNullOrEmpty(g.Sub) ? "" : $" · {g.Sub}")</td>
                            <td><span class="speed-down @Muted(g.DownBps)">@Rate0(g.DownBps)</span></td>
                            <td><span class="speed-up @Muted(g.UpBps)">@Rate0(g.UpBps)</span></td>
                            <td>
                                <span class="hogs-share">
                                    <span>@DisplayFormatters.FormatShare(share)%</span>
                                    <span class="hogs-bar"><span class="hogs-fill" style="width: @Math.Min(100, share).ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></span></span>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_lt.Groups.Count > CollapsedRows)
        {
            <button type="button" class="btn btn-secondary btn-sm hogs-show-more" @onclick="() => _showAll = !_showAll">@(_showAll ? "Show fewer" : "Show more")</button>
        }
    };

    /// <summary>
    /// The card reads every WAN's live rate itself, for a page with no Live View tiles to feed
    /// it. Live only: the WAN parameters and the playhead are ignored.
    /// </summary>
    [Parameter] public bool SelfFed { get; set; }

    /// <summary>Shown in place of a self-fed card once the site turns out to have no live traffic data.</summary>
    [Parameter] public RenderFragment? Unavailable { get; set; }

    private string? _selfGatewayMac;
    private List<string> _selfGatewayWanIfNames = new();
    private bool _selfResolved;

    /// <summary>No live WAN rate and no client rows once everything has been asked: nothing to show.</summary>
    private bool SelfFedUnavailable => SelfFed && _selfResolved && (_result != null || _error)
        && _result?.Rows.Count is null or 0 && CurrentWanRate() is (null, null);

    private (double? Down, double? Up) WanRateNow() => SelfFed
        ? SelfWan.LiveRates(LiveStats, _selfGatewayMac, _selfGatewayWanIfNames)
        : (WanDownBps, WanUpBps);

    private IReadOnlyCollection<string> WanKeysNow() => SelfFed ? SelfWan.SelectedKeys : WanKeys;

    private IReadOnlyCollection<string> WanHistoryKeysNow() => SelfFed
        ? SelfWan.LiveRateHistoryKeys(_selfGatewayMac, _selfGatewayWanIfNames)
        : WanHistoryKeys;

    /// <summary>The gateway and every WAN, for a self-fed card. Every WAN: a rollout touches the whole site.</summary>
    private async Task ResolveSelfFedAsync()
    {
        try
        {
            await SelfWan.LoadAsync();
            await SelfWan.SelectAllAsync(persist: false);
            var devices = await ConnectionService.GetDiscoveredDevicesAsync();
            var gw = devices?.FirstOrDefault(d =>
                d.Type == NetworkOptimizer.Core.Enums.DeviceType.Gateway
                || d.HardwareType == NetworkOptimizer.Core.Enums.DeviceType.Gateway);
            _selfGatewayMac = gw?.Mac?.Replace("-", ":").ToLowerInvariant();
            _selfGatewayWanIfNames = gw?.WanInterfaceNames ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Bandwidth Hogs: could not resolve the gateway for a self-fed card");
        }
        _selfResolved = true;
    }

    /// <summary>The map's playhead; null while live. A change re-answers the list for that instant.</summary>
    [Parameter] public DateTime? HistoricAt { get; set; }

    /// <summary>The map is paused: live refresh holds until it resumes.</summary>
    [Parameter] public bool Paused { get; set; }

    /// <summary>The selected WAN(s)' rate right now, or at the playhead, from the Live View tiles.</summary>
    [Parameter] public double? WanDownBps { get; set; }
    [Parameter] public double? WanUpBps { get; set; }

    /// <summary>The instant the WAN rate above describes, once the page's snapshot for it has
    /// landed; null while live. At the playhead the card waits for it to match HistoricAt.</summary>
    [Parameter] public DateTime? WanRateAt { get; set; }

    /// <summary>The selected WAN keys, for their expected speeds.</summary>
    [Parameter] public IReadOnlyCollection<string> WanKeys { get; set; } = Array.Empty<string>();

    /// <summary>Live-cache history keys for the selected WAN interfaces, for co-movement corroboration.</summary>
    [Parameter] public IReadOnlyCollection<string> WanHistoryKeys { get; set; } = Array.Empty<string>();

    /// <summary>Whether the page's own multi-WAN detection lit its multi-WAN UI; the banners say
    /// "per-WAN" only where a second WAN exists for the phrase to mean anything.</summary>
    [Parameter] public bool MultiWan { get; set; }

    private enum Mode { Throughput, Data }
    private enum View { Wan, LanPlusWan }

    /// <summary>A client under this share of the total is not a hog and is left off the list.</summary>
    private const double MinSharePercent = 1;

    /// <summary>
    /// Share alone is not enough: on a near-idle network one percent of the denominator is a few
    /// Kbps, which qualified half the network and let it linger through the decay. A hog moves
    /// real traffic, whatever its share.
    /// </summary>
    private const double MinQualifyBps = 250_000;

    /// <summary>The largest few are always worth seeing, share or no share: five live, ten over a window.</summary>
    private int MinRows => _mode == Mode.Data ? 10 : 5;

    /// <summary>The list never grows past this, however many clear the share bar: on a near-idle
    /// WAN one percent of the denominator is a few Kbps and half the network would qualify.</summary>
    private const int MaxRows = 10;

    /// <summary>Rows visible before Show more. Both states pad to a fixed slot count so the card never changes height.</summary>
    private const int CollapsedRows = 5;

    private bool _showAll;

    /// <summary>
    /// How long a live client stays listed after it last held the share. Rates move every few
    /// seconds, and a list that drops a client the instant it dips is one that flickers.
    /// </summary>
    private static readonly TimeSpan HogDecay = TimeSpan.FromSeconds(60);

    /// <summary>When each (view, client) last held the share, stamped as answers land - never
    /// during a render, so a paused list does not keep extending them.</summary>
    private readonly Dictionary<string, DateTime> _lastQualified = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// "Switch port" explains a user-defined port label; a stock name (Port 3, SFP+ 1) already
    /// says what it is, so it carries no tooltip.
    /// </summary>
    private static string? PortTooltip(string port) =>
        System.Text.RegularExpressions.Regex.IsMatch(port, @"^(Port|SFP\+?|SFP28) \d+$") ? null : "Switch port";

    private static string? PortGroupTooltip(HogRow row) =>
        !row.IsPortGroup ? null
        : row.Ip != null
            ? $"Everything through this switch port, shared by {row.PortClientCount} interfaces. Opens the busiest one; the others are in its selector."
            : $"Everything through this switch port, shared by {row.PortClientCount} interfaces";

    private static readonly (int Hours, string Label)[] TimeFilters =
    {
        (1, "1h"), (6, "6h"), (24, "24h"), (168, "7d"), (720, "30d"),
    };

    private Mode _mode = Mode.Throughput;
    private View _view = View.Wan;
    private int _hours = 24;
    private HogsResult? _result;
    private bool _error;
    private int _loading;
    private bool _ready;
    private DateTime? _loadedAt;
    private string _loadedSeekKey = "";
    // Cancels the answer in flight when the playhead moves: whatever it was answering for is
    // behind the user now, and rendering it anyway is what made a scrub land twice.
    private CancellationTokenSource? _refreshCts;
    private System.Threading.Timer? _timer;
    private System.Threading.Timer? _seekTimer;
    // Timers are armed after awaits. If the circuit is torn down during one, Dispose has already
    // run, and a timer created afterward polls forever: Blazor's dispatcher keeps running
    // InvokeAsync delegates on a disposed component. Check this before arming and on every tick.
    private bool _disposed;
    private DateTime _lastLiveRefresh = DateTime.MinValue;
    private static readonly TimeSpan LiveRefreshFloor = TimeSpan.FromSeconds(1);
    // Short: the map already spaces seeks half a second apart and the rate gate above admits
    // one render per seek, so this only folds the odd back-to-back render.
    private static readonly TimeSpan SeekDebounce = TimeSpan.FromMilliseconds(150);

    // Same key shape chart-window.js writes for the Network Performance and Stats tabs, so this is
    // one more remembered window per site, per tab, in this browser.
    private string WindowStorageKey => $"netopt.win.{(SiteContext.IsDefault ? "" : SiteContext.Slug)}.bandwidth-hogs";
    private string ViewStorageKey => SiteContext.ScopeStorageKey("bandwidthHogsView");

    private bool ShowLocal => _mode == Mode.Data && _view == View.LanPlusWan;

    private string EmptyText => _mode == Mode.Data
        ? "No usage recorded for this range."
        : HistoricAt != null ? "No client traffic at this moment." : "No client traffic right now.";

    private string ShareTooltip => (_mode, _view) switch
    {
        (Mode.Throughput, View.Wan) => _result?.WanMeasured == true
            ? "Share of the listed clients' WAN traffic, measured on the Gateway"
            : "Share of the listed clients' WAN traffic",
        (Mode.Throughput, _) => "Share of everything the listed clients are moving",
        (Mode.Data, View.Wan) => "Share of WAN traffic, per UniFi Network",
        _ => "Share of everything through the clients' ports and radios",
    };

    private GatewayAgentConntrackStatus? _agentStatus;
    private DateTime _agentStatusAt = DateTime.MinValue;
    private static readonly TimeSpan AgentStatusRefreshEvery = TimeSpan.FromMinutes(1);
    // While the answer is transitional - never asked, or an enrolled agent is still
    // reconnecting (a server restart's normal first minute) - re-ask fast, so the banner
    // appears the moment the agent's hello settles it instead of a stale blank holding for
    // a minute and reading as "needs a page refresh".
    private static readonly TimeSpan AgentStatusRefreshWhileSettling = TimeSpan.FromSeconds(5);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (SelfFed) await ResolveSelfFedAsync();
        await RestorePreferencesAsync();
        _ready = true;
        await RefreshAsync();
        ArmTimer();
    }

    /// <summary>The gateway-agent notice state, re-asked off the card's own refresh - it
    /// self-clears on the first capable hello, so it can never be asked just once.</summary>
    private async Task RefreshAgentStatusAsync()
    {
        var settling = _agentStatus is null or { State: GatewayAgentConntrackState.AwaitingAgent };
        if (DateTime.UtcNow - _agentStatusAt < (settling ? AgentStatusRefreshWhileSettling : AgentStatusRefreshEvery)) return;
        _agentStatusAt = DateTime.UtcNow;
        try
        {
            _agentStatus = await ConntrackStatus.GetStatusAsync();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Bandwidth Hogs: agent status unavailable");
        }
    }

    private async Task DismissAgentSuggestionAsync()
    {
        try
        {
            await ConntrackStatus.DismissGatewayAgentSuggestionAsync();
            _agentStatus = _agentStatus is { } s ? s with { SuggestionDismissed = true } : null;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Bandwidth Hogs: could not dismiss the agent suggestion");
        }
    }

    protected override void OnParametersSet()
    {
        // A self-fed card has no page tick to follow; its own timer refreshes it.
        if (!_ready || SelfFed) return;
        if (HistoricAt != _loadedAt || SeekKey() != _loadedSeekKey)
        {
            _refreshCts?.Cancel();
            // The page renders on its own tick before the snapshot for a seek lands, carrying
            // the previous instant's rate. Asking then is a question the snapshot cancels.
            if (AwaitingPlayheadRate) { _seekTimer?.Dispose(); return; }
            ScheduleSeekRefresh();
            return;
        }
        // Live throughput refreshes on the page's own tick - the one the tiles beside it render
        // on - so the two never sit a timer phase apart. Once a second at most; the answer is a
        // few in-memory lookups, and the source moves no faster than that anyway.
        if (_mode == Mode.Throughput && HistoricAt == null && !Paused
            && DateTime.UtcNow - _lastLiveRefresh >= LiveRefreshFloor)
            _ = RefreshAsync();
    }

    /// <summary>
    /// What a playhead answer depends on beyond the instant: the selected WANs and their rate,
    /// which the split is allocated against. The page's snapshot for an instant can land after
    /// the instant itself, so a changed rate at the same playhead is a new question. Empty live;
    /// Data usage at the playhead depends on neither.
    /// </summary>
    private string SeekKey() => HistoricAt == null || _mode != Mode.Throughput ? ""
        : $"{string.Join(",", WanKeys)}|{WanDownBps?.ToString("R", System.Globalization.CultureInfo.InvariantCulture)}|{WanUpBps?.ToString("R", System.Globalization.CultureInfo.InvariantCulture)}";

    /// <summary>The playhead has moved but the WAN rate on the tiles still describes the previous instant.</summary>
    private bool AwaitingPlayheadRate => HistoricAt != null && _mode == Mode.Throughput && WanRateAt != HistoricAt;

    /// <summary>
    /// A drag or playback moves the playhead many times a second; one refresh after it settles,
    /// not one per position.
    /// </summary>
    private void ScheduleSeekRefresh()
    {
        _seekTimer?.Dispose();
        if (_disposed) return;
        _seekTimer = new System.Threading.Timer(_ =>
        {
            if (_disposed) return;
            try { _ = InvokeAsync(RefreshAsync); }
            catch { /* circuit going away */ }
        }, null, SeekDebounce, Timeout.InfiniteTimeSpan);
    }

    private async Task RestorePreferencesAsync()
    {
        try
        {
            // The view is a preference; the mode is not. Live View opens live, and Data is a
            // drill-down someone chose for one investigation, so it always starts on Throughput.
            var view = await JS.InvokeAsync<string?>("localStorage.getItem", ViewStorageKey);
            if (Enum.TryParse<View>(view, true, out var v)) _view = v;
            var hours = await JS.InvokeAsync<string?>("localStorage.getItem", WindowStorageKey);
            if (int.TryParse(hours, out var h) && TimeFilters.Any(t => t.Hours == h)) _hours = h;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Bandwidth Hogs: could not read saved preferences");
        }
    }

    private async Task SetModeAsync(Mode mode)
    {
        if (_mode == mode) return;
        _mode = mode;
        _result = null;
        ArmTimer();
        await RefreshAsync();
    }

    private async Task SetViewAsync(View view)
    {
        if (_view == view) return;
        _view = view;
        // A WAN-only data answer has no LAN figures; the first look at LAN + WAN reads them.
        // Nulled BEFORE any await: the first re-render happens at the persist below, and a
        // WAN-only answer viewed as LAN + WAN is all zero-byte rows - which drew the empty
        // state for a beat instead of the spinner.
        if (_mode == Mode.Data && view == View.LanPlusWan && _result?.IncludesLan != true)
        {
            _result = null;
            await PersistViewAsync();
            await RefreshAsync();
        }
        else
        {
            await PersistViewAsync();
        }
    }

    private async Task SetHoursAsync(int hours)
    {
        if (_hours == hours) return;
        _hours = hours;
        _result = null;
        try { await JS.InvokeVoidAsync("localStorage.setItem", WindowStorageKey, hours.ToString()); }
        catch (Exception ex) { Logger.LogDebug(ex, "Bandwidth Hogs: could not save the time filter"); }
        ArmTimer();
        await RefreshAsync();
    }

    /// <summary>The same return-to-live the maps' badge performs; the playhead change comes back through the page.</summary>
    private async Task ReturnToLiveAsync()
    {
        try { await JS.InvokeVoidAsync("eval", "window.__lanFlowMap?.getInstance?.()?._returnToLive?.();"); }
        catch (Exception ex) { Logger.LogDebug(ex, "Bandwidth Hogs: could not return the map to live"); }
    }

    private async Task PersistViewAsync()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", ViewStorageKey, _view.ToString()); }
        catch (Exception ex) { Logger.LogDebug(ex, "Bandwidth Hogs: could not save the view"); }
    }

    private void ArmTimer()
    {
        _timer?.Dispose();
        if (_disposed) return;
        // Data follows the Data tab's cadence: a day or less every minute, the long windows every
        // five (those are the site-wide scans). The WAN half is cached five minutes either way.
        // Live throughput ticks at the conntrack sample cadence; the answer is in-memory lookups.
        var period = _mode == Mode.Throughput ? TimeSpan.FromSeconds(2)
            : _hours <= 24 ? TimeSpan.FromMinutes(1) : TimeSpan.FromMinutes(5);
        _timer = new System.Threading.Timer(_ =>
        {
            if (_disposed) return;
            try
            {
                _ = InvokeAsync(async () =>
                {
                    if (Paused || HistoricAt != null) return;
                    await RefreshAsync();
                });
            }
            catch { /* circuit going away */ }
        }, null, period, period);
    }

    private async Task RefreshAsync()
    {
        if (Interlocked.CompareExchange(ref _loading, 1, 0) != 0) return;
        var cts = new CancellationTokenSource();
        _refreshCts = cts;
        // Recorded up front: what this answer is FOR, so a failure does not ask again forever.
        // A cancelled answer is not a failure - the record goes back to what is on screen.
        var (shownAt, shownKey) = (_loadedAt, _loadedSeekKey);
        var at = HistoricAt;
        _loadedAt = at;
        _loadedSeekKey = SeekKey();
        var discarded = false;
        try
        {
            var wanKeys = WanKeysNow().ToList();
            var (wanDown, wanUp) = WanRateNow();
            if (at == null) _lastLiveRefresh = DateTime.UtcNow;
            // At the playhead the window snaps to five minutes, so a drag inside them reuses the
            // same cached answer rather than asking for each position.
            var end = at is { } a ? new DateTime(a.Ticks - a.Ticks % TimeSpan.FromMinutes(5).Ticks, DateTimeKind.Utc) : DateTime.UtcNow;
            var result = _mode == Mode.Throughput
                ? await Hogs.GetThroughputAsync(at, wanDown, wanUp, wanKeys, WanHistoryKeysNow(), cts.Token)
                : await Hogs.GetDataUsageAsync(end - TimeSpan.FromHours(_hours), end, includeLan: _view == View.LanPlusWan, ct: cts.Token);
            // Answered for an instant the playhead has since left: nobody's answer now.
            if (cts.IsCancellationRequested)
            {
                discarded = true;
            }
            else
            {
                _result = result;
                await RefreshAgentStatusAsync();
                _error = false;
                StampQualified(at);
                await RefreshLiveTrafficAsync();
            }
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            discarded = true;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Bandwidth Hogs: refresh failed");
            _error = true;
        }
        finally
        {
            if (discarded) (_loadedAt, _loadedSeekKey) = (shownAt, shownKey);
            if (ReferenceEquals(_refreshCts, cts)) _refreshCts = null;
            cts.Dispose();
            Interlocked.Exchange(ref _loading, 0);
        }
        if (!discarded) await InvokeAsync(StateHasChanged);
        // The playhead moved while this was answering: answer for where it is now. The seek that
        // moved it armed the debounce, but it may have fired into the loading guard and been dropped.
        if ((HistoricAt != _loadedAt || SeekKey() != _loadedSeekKey) && !AwaitingPlayheadRate) ScheduleSeekRefresh();
    }

    // Column sort, three states per header: largest first, smallest first, then back to the
    // default order by total. It reorders the rows the card would show anyway; it never changes
    // which rows those are.
    private enum SortColumn { Download, Upload }
    private SortColumn? _sortCol;
    private bool _sortAsc;

    private void ToggleSort(SortColumn col)
    {
        if (_sortCol != col) { _sortCol = col; _sortAsc = false; }
        else if (!_sortAsc) _sortAsc = true;
        else _sortCol = null;
    }

    private string SortClass(SortColumn col) => _sortCol != col ? "" : _sortAsc ? "sort-asc" : "sort-desc";

    private double SortKey(HogRow row, SortColumn col) => (col, _mode, _view) switch
    {
        (SortColumn.Download, Mode.Throughput, View.Wan) => row.WanDownBps,
        (SortColumn.Download, Mode.Throughput, _) => row.DownBps,
        (SortColumn.Download, Mode.Data, View.Wan) => row.WanDownBytes,
        (SortColumn.Download, _, _) => row.DownBytes,
        (_, Mode.Throughput, View.Wan) => row.WanUpBps,
        (_, Mode.Throughput, _) => row.UpBps,
        (_, Mode.Data, View.Wan) => row.WanUpBytes,
        _ => row.UpBytes,
    };

    private List<(HogRow Row, bool Fading)> Sorted(List<(HogRow Row, bool Fading)> rows)
    {
        if (_sortCol is not { } col) return rows;
        return _sortAsc
            ? rows.OrderBy(x => SortKey(x.Row, col)).ToList()
            : rows.OrderByDescending(x => SortKey(x.Row, col)).ToList();
    }

    private double RowValue(HogRow row) => RowValue(row, _view);

    private double RowValue(HogRow row, View view) => (_mode, view) switch
    {
        (Mode.Throughput, View.Wan) => row.WanDownBps + row.WanUpBps,
        (Mode.Throughput, _) => row.DownBps + row.UpBps,
        (Mode.Data, View.Wan) => row.WanDownBytes + row.WanUpBytes,
        _ => row.DownBytes + row.UpBytes,
    };

    /// <summary>
    /// The rows this view can show. In the Data WAN view the DPI report already names every
    /// interface behind a shared port, so the port's own row would count them twice and is left out.
    /// </summary>
    private IEnumerable<HogRow> VisibleRows(View view)
    {
        if (_result == null) return Enumerable.Empty<HogRow>();
        return _mode == Mode.Data && view == View.Wan
            ? _result.Rows.Where(r => !r.IsPortGroup)
            : _result.Rows;
    }

    private bool Qualifies(HogRow row, View view, double denominator) =>
        denominator > 0 && RowValue(row, view) >= MinQualifyBps
        && 100 * RowValue(row, view) / denominator >= MinSharePercent;

    /// <summary>
    /// The largest <see cref="MinRows"/> whatever their share, then everyone holding at least
    /// <see cref="MinSharePercent"/> of the share denominator, largest first. Live throughput also
    /// keeps, dimmed, anyone who held it within <see cref="HogDecay"/> - and nothing past
    /// <see cref="MaxRows"/> either way. Show more lifts the floor: the top MaxRows by value.
    /// </summary>
    private List<(HogRow Row, bool Fading)> TopRows()
    {
        var denominator = ShareDenominator();
        var live = _mode == Mode.Throughput && HistoricAt == null;
        var now = DateTime.UtcNow;
        return VisibleRows(_view)
            .Where(r => RowValue(r) > 0 || live)
            .OrderByDescending(RowValue)
            .Select((r, index) => (Row: r, Index: index, Qualifies: Qualifies(r, _view, denominator)))
            .Where(x => (_showAll && RowValue(x.Row) > 0)
                || x.Index < MinRows && RowValue(x.Row) > 0
                || x.Qualifies
                || (live && _lastQualified.TryGetValue(QualifiedKey(_view, x.Row), out var t) && now - t <= HogDecay))
            .Take(MaxRows)
            .Select(x => (x.Row, Fading: !x.Qualifies && x.Index >= MinRows))
            .ToList();
    }

    /// <summary>Records, for both views, who holds the share in a freshly landed live answer.</summary>
    private void StampQualified(DateTime? at)
    {
        if (_mode != Mode.Throughput || at != null) return;
        var now = DateTime.UtcNow;
        foreach (var view in new[] { View.Wan, View.LanPlusWan })
        {
            var denominator = ShareDenominator(view);
            foreach (var row in VisibleRows(view))
                if (Qualifies(row, view, denominator)) _lastQualified[QualifiedKey(view, row)] = now;
        }
        foreach (var stale in _lastQualified.Where(kv => now - kv.Value > HogDecay).Select(kv => kv.Key).ToList())
            _lastQualified.Remove(stale);
    }

    private static string QualifiedKey(View view, HogRow row) => $"{view}|{row.ClientMac}";

    private double ShareDenominator() => ShareDenominator(_view);

    /// <summary>
    /// Everything listed, in every view. Never the gateway's WAN rate: the client and WAN feeds
    /// are sampled apart and rarely agree, so shares against it did not add up to 100.
    /// </summary>
    private double ShareDenominator(View view) => VisibleRows(view).Sum(r => RowValue(r, view));

    /// <summary>
    /// The WAN rate as the tiles beside the card carry it, live or at the playhead, so the WAN
    /// line moves with them rather than with the card's own refresh. Never the answer's echo of
    /// it: that is the rate the tiles held when the question was asked, and at the playhead the
    /// snapshot can land after the question does.
    /// </summary>
    private (double? Down, double? Up) CurrentWanRate() => WanRateNow();

    /// <summary>A live rate; idle reads "0 bps", not "-", as everywhere in Live Traffic.</summary>
    private static string Rate0(double? bps) => bps is >= 1 ? DisplayFormatters.FormatRate(bps) : "0 bps";

    /// <summary>The muted class for an idle rate.</summary>
    private static string? Muted(double? bps) => bps is >= 1 ? null : "lt-muted";

    /// <summary>Whether a row's rate in one direction is idle (Throughput only; Data shows bytes).</summary>
    private bool IsIdle(HogRow row, bool down) => _mode == Mode.Throughput && (_view, down) switch
    {
        (View.Wan, true) => row.WanDownBps < 1,
        (View.Wan, false) => row.WanUpBps < 1,
        (_, true) => row.DownBps < 1,
        _ => row.UpBps < 1,
    };

    private string FormatDown(HogRow row) => (_mode, _view) switch
    {
        (Mode.Throughput, View.Wan) => Rate0(row.WanDownBps),
        (Mode.Throughput, _) => Rate0(row.DownBps),
        (Mode.Data, View.Wan) => DisplayFormatters.FormatBytes(row.WanDownBytes),
        _ => DisplayFormatters.FormatBytes(row.DownBytes),
    };

    private string FormatUp(HogRow row) => (_mode, _view) switch
    {
        (Mode.Throughput, View.Wan) => Rate0(row.WanUpBps),
        (Mode.Throughput, _) => Rate0(row.UpBps),
        (Mode.Data, View.Wan) => DisplayFormatters.FormatBytes(row.WanUpBytes),
        _ => DisplayFormatters.FormatBytes(row.UpBytes),
    };

    private string ClientLink(HogRow row)
    {
        var ip = Uri.EscapeDataString(row.Ip ?? "");
        if (_mode == Mode.Throughput) return $"/client-dashboard?ip={ip}&tab=speed";
        var range = TimeFilters.First(t => t.Hours == _hours).Label;
        return $"/client-dashboard?ip={ip}&tab=data&range={range}";
    }

    private static string BandClass(string band) => band switch
    {
        "2.4" => "band-2ghz",
        "6" => "band-6ghz",
        _ => "band-5ghz",
    };

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
        _seekTimer?.Dispose();
        try { _refreshCts?.Cancel(); } catch (ObjectDisposedException) { }
        if (_ltHeld)
        {
            try { _ = LiveTraffic.ReleaseAsync(_ltViewer); }
            catch { /* circuit going away */ }
        }
    }
}
