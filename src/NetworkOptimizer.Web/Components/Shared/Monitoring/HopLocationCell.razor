@using NetworkOptimizer.Core.Helpers
@using NetworkOptimizer.Web.Services.Monitoring
@inject IHopLocationOverrideService HopLocationSets
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@inject ILogger<HopLocationCell> Logger
@implements IAsyncDisposable

@* A traced hop's location in a trace table, with the Set location editor for an Admin. The edit icon
   shows on hover, or after a tap on the location on a phone; the editor is a bottom sheet there. *@
<span class="hop-loc @(_revealed ? "is-revealed" : null)">
    @if (Location != null)
    {
        <span class="flag-icon" data-tooltip="@CountryDisplay.CountryTooltip(Location.CountryCode)">@CountryDisplay.CountryFlag(Location.CountryCode)</span>
        <span data-tooltip="@Location.Tooltip" @onclick="() => _revealed = true">@Location.Text</span>
        @if (Location.Source == HopLocationSource.Set)
        {
            <span class="hop-loc-set">Set</span>
        }
    }
    else
    {
        <span @onclick="() => _revealed = true">-</span>
    }
    @if (Editable)
    {
        <AdminOnly>
            <button type="button" @ref="_button" class="hop-loc-edit @(_open ? "is-open" : null)" aria-label="Set location"
                    @onclick="Open" @onclick:stopPropagation>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.97 9.304A8 8 0 0 0 2 10c0 4.69 4.887 9.562 7.022 11.468" /><path d="M21.378 16.626a1 1 0 0 0-3.004-3.004l-4.01 4.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z" /><circle cx="10" cy="10" r="3" /></svg>
            </button>
        </AdminOnly>
    }
    @if (_open)
    {
        <div class="lt-fpop-backdrop" @onclick="CloseAsync" @onclick:stopPropagation></div>
        <div @ref="_pop" class="lt-fpop hop-loc-pop" role="dialog" aria-label="Set location" @onkeydown="OnKeyAsync" @onclick:stopPropagation>
            <div class="lt-fpop-grab" aria-hidden="true"></div>
            <div class="lt-fpop-head"><span class="lt-fpop-title">Set location</span></div>
            <div class="hop-loc-for">For <code class="text-code">@Address</code> on every trace</div>
            <input @ref="_input" class="form-control lt-fpop-search" placeholder="Search a city, then Enter" aria-label="City"
                   @bind="_query" @bind:event="oninput" @bind:after="QueryChanged" />
            <div class="lt-fpop-list" role="listbox">
                @if (_searching)
                {
                    <div class="lt-fpop-empty"><span class="spinner spinner-sm"></span></div>
                }
                else if (_searched && _results.Count == 0)
                {
                    <div class="lt-fpop-empty">No city matches.</div>
                }
                @for (var i = 0; i < _results.Count; i++)
                {
                    var index = i;
                    var hit = _results[i];
                    <div class="lt-fpop-item @(index == _highlight ? "is-active" : null)" role="option" aria-selected="@(index == _highlight ? "true" : "false")"
                         @onmouseenter="() => _highlight = index" @onclick="() => SaveAsync(hit)">
                        <span class="lt-fpop-name">@hit.City<span class="hop-loc-region">@Where(hit)</span></span>
                    </div>
                }
            </div>
            @if (_error != null)
            {
                <div class="alert-danger hop-loc-error">@_error</div>
            }
            <div class="lt-fpop-foot">
                <span class="hop-loc-now">@Now()</span>
                @if (Location?.Source == HopLocationSource.Set)
                {
                    <a href="" @onclick="ResetAsync" @onclick:preventDefault>Reset</a>
                }
            </div>
        </div>
    }
</span>

@code {
    /// <summary>The hop's address; null for a hop that did not answer.</summary>
    [Parameter] public string? Address { get; set; }

    /// <summary>Where the hop is placed now; null when nothing places it.</summary>
    [Parameter] public HopLocationView? Location { get; set; }

    /// <summary>Called after a location is set or reset, so the table places its hops again.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>A geocoder result.</summary>
    public sealed record CityHit(string City, string? Region, string? Country, string CountryCode, double Latitude, double Longitude);

    private IJSObjectReference? _module;
    private ElementReference _button, _pop, _input;
    private bool _open, _revealed, _searching, _searched, _focus;
    private string _query = "";
    private List<CityHit> _results = [];
    private int _highlight = -1;
    private string? _error;

    // A private address means a different router on every site, so only a public one takes an install-wide location.
    private bool Editable => Address != null && NetworkUtilities.IsPublicIpAddress(Address);

    private async Task<IJSObjectReference> ModuleAsync() =>
        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", FileVersionProvider.AddFileVersionToPath("", "/js/hop-location-search.js"));

    private void Open()
    {
        _open = true;
        _focus = true;
        _query = "";
        _results = [];
        _searched = false;
        _highlight = -1;
        _error = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focus) return;
        _focus = false;
        try
        {
            await (await ModuleAsync()).InvokeVoidAsync("place", _pop, _button);
            await _input.FocusAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            // The editor closed or the circuit went away before it drew.
        }
    }

    private async Task CloseAsync()
    {
        _open = false;
        if (_module != null)
        {
            try { await _module.InvokeVoidAsync("release"); }
            catch (JSDisconnectedException) { }
        }
    }

    private void QueryChanged() => _highlight = -1;

    private async Task SearchAsync()
    {
        var q = _query.Trim();
        if (q.Length == 0) return;
        _searching = true;
        _error = null;
        StateHasChanged();
        try
        {
            _results = (await (await ModuleAsync()).InvokeAsync<List<CityHit>>("search", q)).ToList();
            _highlight = _results.Count > 0 ? 0 : -1;
        }
        catch (Exception ex) when (ex is not JSDisconnectedException)
        {
            Logger.LogDebug(ex, "City search failed");
            _results = [];
            _error = "The city search could not be reached.";
        }
        finally
        {
            _searching = false;
            _searched = true;
        }
    }

    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" when _results.Count > 0:
                _highlight = _highlight < 0 ? 0 : Math.Min(_results.Count - 1, _highlight + 1);
                break;
            case "ArrowUp" when _results.Count > 0:
                _highlight = _highlight < 0 ? _results.Count - 1 : Math.Max(0, _highlight - 1);
                break;
            case "Enter" when _highlight >= 0 && _highlight < _results.Count:
                await SaveAsync(_results[_highlight]);
                break;
            case "Enter":
                await SearchAsync();
                break;
            case "Escape":
                await CloseAsync();
                break;
        }
    }

    private async Task SaveAsync(CityHit hit)
    {
        _error = null;
        try
        {
            await HopLocationSets.SetAsync(Address!, hit.City, hit.Region, hit.CountryCode, hit.Latitude, hit.Longitude);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not set the location of {Address}", Address);
            _error = ex is ArgumentException ? ex.Message : "Could not save the location.";
            return;
        }
        await CloseAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task ResetAsync()
    {
        _error = null;
        try
        {
            await HopLocationSets.ClearAsync(Address!);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not reset the location of {Address}", Address);
            _error = "Could not reset the location.";
            return;
        }
        await CloseAsync();
        await OnChanged.InvokeAsync();
    }

    private static string Where(CityHit hit) =>
        string.Join(", ", new[] { hit.Region, hit.Country }.Where(s => !string.IsNullOrEmpty(s)));

    // Where the location shown now came from, for the editor's footer.
    private string Now() => Location?.Source switch
    {
        HopLocationSource.Set or HopLocationSource.Hostname => $"Now: {char.ToLowerInvariant(Location.Tooltip[0])}{Location.Tooltip[1..]}",
        HopLocationSource.Neighbor => "Now: from a hop a few ms away",
        HopLocationSource.GeoLite2 => "Now: from GeoLite2",
        HopLocationSource.Country => "Now: the country only",
        _ => "Now: no location",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module == null) return;
        try
        {
            // The module is shared: only an open editor holds the placement.
            if (_open) await _module.InvokeVoidAsync("release");
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
