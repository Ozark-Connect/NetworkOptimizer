@if (Compact)
{
    <div class="isp-plan-hint-compact">
        <span>@ShortHintText</span>
        <a href="javascript:void(0)" @onclick="OnDismiss">Got it</a>
    </div>
}
else
{
    <div class="alert alert-info" style="margin-bottom: 0.75rem;">
        <div class="banner-content">
            <span class="banner-icon banner-icon-info">i</span>
            <div class="banner-text" style="flex: 1;">@HintText</div>
            <div class="banner-actions">
                <button class="btn btn-sm btn-contrast" @onclick="OnDismiss">Got it</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Renders the tight one-line form for placement inside a scorecard, instead of the
    /// full-width banner used above the hero.
    /// </summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Raised when the user dismisses; the panel persists it for both placements.</summary>
    [Parameter] public EventCallback OnDismiss { get; set; }

    private const string HintText =
        "Your plan speeds come from the console: UniFi Network > Settings > Internet, "
        + "select your WAN, then Expected ISP Speeds. ISP Health grades measured throughput "
        + "against whatever is set there. Worth knowing: running a speed test from the UniFi "
        + "mobile app overwrites those values with its own result, so your plan quietly "
        + "becomes your last measurement. WAN Speed Test here leaves them alone.";

    private const string ShortHintText =
        "Plan speeds come from UniFi Network > Settings > Internet > Expected ISP Speeds.";
}
