@using System.Security.Claims
@using NetworkOptimizer.Web.Services.Identity
@inject UserSessionRevocationNotifier Revocations
@inject NavigationManager Navigation
@implements IDisposable

@* Renders nothing. It exists so a circuit whose account has just been disabled, deleted, or signed
   out everywhere goes NOW rather than at the next revalidation, which is a five-minute window.

   Losing a single site already boots a circuit immediately through the site registry broadcast, and
   losing the whole account is the stronger revocation - it cannot be the slower of the two.

   Reloading alone is NOT enough, which is what made the first attempt look like it did nothing: the
   cookie's security stamp is re-checked on an interval, so rotating the stamp does not make the
   cookie stop working at that instant and a reload inside the window is waved straight through. The
   circuit is sent to /api/account/revalidate, which asks the question the interval was going to get
   round to asking and ends the session there and then if the answer has changed.

   It lives in a component rather than in the auth-state provider because marshalling onto the
   circuit needs InvokeAsync, which a component has and the provider does not. *@

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? _userId;
    private string? _sessionId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
            _sessionId = user.FindFirstValue(NetOptClaims.SessionId);
        }

        Revocations.SessionsRevoked += OnRevoked;
        Revocations.PermissionsChanged += OnPermissionsChanged;
    }

    private void OnRevoked(string userId, string? exceptSessionId)
    {
        // Every circuit for the account hears this, including the circuits of the browser that asked.
        if (_userId is null || !string.Equals(_userId, userId, StringComparison.Ordinal))
            return;

        // Spared: this is the session that asked. Its replacement cookie is on the way but cannot
        // arrive before this message did, so sending it to revalidate would have it present the very
        // cookie the request just replaced - signing someone out for changing their own password.
        // Every tab of that browser shares the cookie and so shares this id, which is right: they are
        // one session, and it is the one being kept.
        if (exceptSessionId is not null && string.Equals(_sessionId, exceptSessionId, StringComparison.Ordinal))
            return;

        _ = InvokeAsync(() =>
        {
            try
            {
                var back = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
                Navigation.NavigateTo(
                    $"/api/account/revalidate?returnUrl={Uri.EscapeDataString(back)}", forceLoad: true);
            }
            catch (ObjectDisposedException)
            {
                // Circuit torn down between the event and the dispatch - it is already gone.
            }
        });
    }

    /// <summary>
    /// Roles or site access moved. The session is still good, so this refreshes the principal rather
    /// than ending anything - the same endpoint the revalidation tick would eventually send it to,
    /// without the wait.
    /// </summary>
    private void OnPermissionsChanged(string userId)
    {
        if (_userId is null || !string.Equals(_userId, userId, StringComparison.Ordinal))
            return;

        _ = InvokeAsync(() =>
        {
            try
            {
                var back = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
                Navigation.NavigateTo(
                    $"/api/account/session?returnUrl={Uri.EscapeDataString(back)}", forceLoad: true);
            }
            catch (ObjectDisposedException)
            {
                // Circuit torn down between the event and the dispatch - it is already gone.
            }
        });
    }

    public void Dispose()
    {
        Revocations.SessionsRevoked -= OnRevoked;
        Revocations.PermissionsChanged -= OnPermissionsChanged;
    }
}
