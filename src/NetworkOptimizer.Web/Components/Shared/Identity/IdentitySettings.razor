@* Settings - Identity. One component, two scopes: instance-wide when no site slug is supplied
   (Users, Access, and Sign-In across every site), and scoped to a single site when one is
   (that site's Access list only, since accounts and sign-in methods are instance-wide). The same
   UX either way - the scoped view is the global one narrowed to what a site admin owns. *@

@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation
@implements IDisposable

@if (SiteSlug is null)
{
    <IdentityUsersCard @ref="_usersCard" OnAccessChanged="RefreshAccessAsync" OnExplainRoles="ExplainRolesAsync" />
    <IdentityRolesCard @ref="_rolesCard" />
    <IdentityAccessCard @ref="_accessCard" OnExplainRoles="ExplainRolesAsync"
                        OnSiteRestrictionChanged="RefreshSiteRestrictionAsync" />
    <IdentitySignInCard OnProvidersChanged="RefreshProvidersAsync" />
}
else
{
    <IdentityAccessCard SiteSlug="@SiteSlug" SiteName="@SiteName" OnExplainRoles="ExplainRolesAsync" />
    @* Roles read the same whichever scope you are in, so the scoped tab carries the reference too
       rather than bouncing a site admin to a tab they may not be able to open. *@
    <IdentityRolesCard @ref="_rolesCard" />
}

@code {
    private IdentityAccessCard? _accessCard;
    private IdentityRolesCard? _rolesCard;
    private IdentityUsersCard? _usersCard;

    /// <summary>The Users card offers the providers when linking an identity, so it follows the list.</summary>
    private async Task RefreshProvidersAsync()
    {
        if (_usersCard is not null)
            await _usersCard.RefreshProvidersAsync();
    }

    /// <summary>The no-access badge in Users only means anything while the restriction is on.</summary>
    private async Task RefreshSiteRestrictionAsync()
    {
        if (_usersCard is not null)
            await _usersCard.RefreshSiteRestrictionAsync();
    }

    /// <summary>Query flag that opens the Roles panel on arrival, for links from the scoped view.</summary>
    private const string RolesQueryParam = "roles";

    /// <summary>
    /// Opens the Roles panel for the tooltip icons beside the role pickers. Both scopes render the
    /// panel, so this normally opens it in place; the navigation is the fallback for a caller that
    /// has the pickers without the panel, and it opens on arrival off the query flag.
    /// </summary>
    private async Task ExplainRolesAsync()
    {
        if (_rolesCard is null)
        {
            Navigation.NavigateTo($"/settings?tab=identity&{RolesQueryParam}=1");
            return;
        }

        await _rolesCard.OpenAndHighlightAsync();
    }

    protected override void OnInitialized() => Navigation.LocationChanged += HandleLocationChanged;

    /// <summary>
    /// Every Settings tab is rendered at once and shown by class, so arriving from another tab does
    /// not remount this component and firstRender never comes round again. The location change is the
    /// only signal that someone has just asked for the panel.
    /// </summary>
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
        => _ = InvokeAsync(OpenRolesIfRequestedAsync);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await OpenRolesIfRequestedAsync();
    }

    private async Task OpenRolesIfRequestedAsync()
    {
        if (_rolesCard is null)
            return;

        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue(RolesQueryParam, out var arrivedForRoles) && arrivedForRoles == "1")
            await _rolesCard.OpenAndHighlightAsync();
    }

    public void Dispose() => Navigation.LocationChanged -= HandleLocationChanged;

    /// <summary>
    /// Creating or deleting an account changes that account's site grants in the same step, so the
    /// Access card below is stale as soon as the Users card finishes.
    /// </summary>
    private async Task RefreshAccessAsync()
    {
        if (_accessCard is not null)
            await _accessCard.RefreshAsync();
    }

    /// <summary>Null for the instance-wide view; a site slug scopes the tab to that site.</summary>
    [Parameter] public string? SiteSlug { get; set; }

    /// <summary>Friendly site name shown on the scoped badge.</summary>
    [Parameter] public string? SiteName { get; set; }
}
