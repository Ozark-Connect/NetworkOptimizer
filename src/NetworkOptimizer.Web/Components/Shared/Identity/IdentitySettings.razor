@* Settings - Identity. One component, two scopes: instance-wide when no site slug is supplied
   (Users, Access, and Sign-In across every site), and scoped to a single site when one is
   (that site's Access list only, since accounts and sign-in methods are instance-wide). The same
   UX either way - the scoped view is the global one narrowed to what a site admin owns. *@

@if (SiteSlug is null)
{
    <IdentityUsersCard OnAccessChanged="RefreshAccessAsync" />
    <IdentityAccessCard @ref="_accessCard" />
    <IdentitySignInCard />
}
else
{
    <IdentityAccessCard SiteSlug="@SiteSlug" SiteName="@SiteName" />
}

@code {
    private IdentityAccessCard? _accessCard;

    /// <summary>
    /// Creating or deleting an account changes that account's site grants in the same step, so the
    /// Access card below is stale as soon as the Users card finishes.
    /// </summary>
    private async Task RefreshAccessAsync()
    {
        if (_accessCard is not null)
            await _accessCard.RefreshAsync();
    }

    /// <summary>Null for the instance-wide view; a site slug scopes the tab to that site.</summary>
    [Parameter] public string? SiteSlug { get; set; }

    /// <summary>Friendly site name shown on the scoped badge.</summary>
    [Parameter] public string? SiteName { get; set; }
}
