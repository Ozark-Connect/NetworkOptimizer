        "computer" => "<rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"1.5\" fill=\"currentColor\" fill-opacity=\"0.18\"/><path d=\"M8 20h8M12 16v4\"/>",
        "laptop" => "<rect x=\"5\" y=\"5\" width=\"14\" height=\"10\" rx=\"1.5\" fill=\"currentColor\" fill-opacity=\"0.18\"/><path d=\"M3 18.500h18\"/>",
        "phone" => "<rect x=\"7\" y=\"3\" width=\"10\" height=\"18\" rx=\"2\" fill=\"currentColor\" fill-opacity=\"0.18\"/><path d=\"M11 18h2\"/>",
        "lock" => "<rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"1.5\" fill=\"currentColor\" fill-opacity=\"0.18\"/><path d=\"M8 11V8a4 4 0 0 1 8 0v3\"/>",
        "unlock" => "<rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"1.5\" fill=\"currentColor\" fill-opacity=\"0.18\"/><path d=\"M8 11V8a4 4 0 0 1 7.700-1.500\"/>",
        "user" => "<circle cx=\"12\" cy=\"8\" r=\"3.500\" fill=\"currentColor\" fill-opacity=\"0.18\"/><path d=\"M5 20a7 7 0 0 1 14 0\"/>",
        "routed" => "<path d=\"M4 7h4l8 10h4M4 17h4l2.300-2.900M13.700 9.900 16 7h4M17.500 4.500 20 7l-2.500 2.500M17.500 14.500 20 17l-2.500 2.500\"/>",
        _ => ""
