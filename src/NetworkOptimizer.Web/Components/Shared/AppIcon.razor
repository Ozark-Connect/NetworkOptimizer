@*
    The app's line icons: one stroke weight, drawn in the text color at the text size, so an icon
    takes the box a glyph would. Never an emoji: those render in the platform's own colors and art.
*@
<svg class="app-icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)Paths(Name))</svg>

@code {
    /// <summary>The icon to draw. An unknown name draws nothing.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Extra classes for the svg element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The path markup for an icon name, on a 24 unit grid.</summary>
    public static string Paths(string name) => name switch
    {
        "warning" => "<path d=\"M12 4 21.5 20h-19L12 4z\"/><path d=\"M12 10v4.5M12 17.2v.1\"/>",
        "copy" => "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.5\"/><path d=\"M15 9V5.5A1.5 1.5 0 0 0 13.5 4h-8A1.5 1.5 0 0 0 4 5.5v8A1.5 1.5 0 0 0 5.5 15H9\"/>",
        "globe" => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9s1.3-6.4 3.800-9z\"/>",
        "switch" => "<rect x=\"3\" y=\"8\" width=\"18\" height=\"8\" rx=\"1.5\"/><path d=\"M7 12h.1M10.4 12h.1M13.700 12h.1M17 12h.1\"/>",
        "access-point" => "<circle cx=\"12\" cy=\"12\" r=\"1.800\"/><path d=\"M8.200 8.200a5.400 5.400 0 0 0 0 7.600M15.800 8.200a5.400 5.400 0 0 1 0 7.600M5.300 5.300a9.500 9.500 0 0 0 0 13.400M18.700 5.300a9.500 9.500 0 0 1 0 13.400\"/>",
        "cellular" => "<path d=\"M5 19v-3M10 19v-7M15 19V8M20 19V4\"/>",
        "wifi" => "<path d=\"M3.500 9.500a12.500 12.500 0 0 1 17 0M6.500 13a8 8 0 0 1 11 0M9.500 16.300a3.800 3.800 0 0 1 5 0M12 19.400v.1\"/>",
        "bridge" => "<path d=\"M3 6v13M21 6v13M3 17h18M3 8c3 5 15 5 18 0M7.500 11.300V17M12 12.200V17M16.500 11.300V17\"/>",
        "cloud" => "<path d=\"M7 18.500h10a4 4 0 0 0 .6-7.950A6 6 0 0 0 6.100 9.600 4.500 4.500 0 0 0 7 18.500z\"/>",
        "link" => "<path d=\"M10 14a4 4 0 0 0 5.650 0l3-3a4 4 0 0 0-5.650-5.650l-1 1M14 10a4 4 0 0 0-5.650 0l-3 3a4 4 0 0 0 5.650 5.650l1-1\"/>",
        "power" => "<path d=\"M13 3 5 13.500h6L10 21l8-10.500h-6L13 3z\"/>",
        "computer" => "<rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"1.5\"/><path d=\"M8 20h8M12 16v4\"/>",
        "laptop" => "<rect x=\"5\" y=\"5\" width=\"14\" height=\"10\" rx=\"1.5\"/><path d=\"M3 18.500h18\"/>",
        "phone" => "<rect x=\"7\" y=\"3\" width=\"10\" height=\"18\" rx=\"2\"/><path d=\"M11 18h2\"/>",
        "lock" => "<rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"1.5\"/><path d=\"M8 11V8a4 4 0 0 1 8 0v3\"/>",
        "unlock" => "<rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"1.5\"/><path d=\"M8 11V8a4 4 0 0 1 7.700-1.500\"/>",
        "user" => "<circle cx=\"12\" cy=\"8\" r=\"3.500\"/><path d=\"M5 20a7 7 0 0 1 14 0\"/>",
        "routed" => "<path d=\"M4 7h4l8 10h4M4 17h4l2.300-2.900M13.700 9.900 16 7h4M17.500 4.500 20 7l-2.500 2.500M17.500 14.500 20 17l-2.500 2.500\"/>",
        _ => ""
    };
}
