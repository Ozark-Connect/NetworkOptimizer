@*
    The app's line icons, in GatewayIcon's language: one stroke weight, faces shaded in the text
    color, drawn at the text size so an icon takes the box a glyph would. Never an emoji: those render in the platform's own colors and art.
*@
<svg class="line-icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)Paths(Name))</svg>

@code {
    /// <summary>The icon to draw. An unknown name draws nothing.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Extra classes for the svg element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The path markup for an icon name, on a 24 unit grid.</summary>
    public static string Paths(string name) => name switch
    {
        "agent" => "<path d=\"M5 8.500 7 6h10l2 2.500v8.250A1.250 1.250 0 0 1 17.750 18H6.250A1.250 1.250 0 0 1 5 16.750z\" fill=\"currentColor\" fill-opacity=\"0.18\"/><path d=\"M5 8.500 7 6h10l2 2.500z\" fill=\"currentColor\" fill-opacity=\"0.35\"/><path d=\"M8 14.750h.1M11.500 12h4M11.500 15h4\"/>",
        "location" => "<path d=\"M12 21.500c-4-4.200-6.500-7.300-6.500-10.500a6.500 6.500 0 0 1 13 0c0 3.200-2.500 6.300-6.500 10.500z\" fill=\"currentColor\" fill-opacity=\"0.18\"/><circle cx=\"12\" cy=\"11\" r=\"2.200\" fill=\"currentColor\" stroke=\"none\"/>",
        "check" => "<path d=\"M5 12.500l4.500 4.500L19 7.500\"/>",
        "close" => "<path d=\"M6.500 6.500l11 11M17.500 6.500l-11 11\"/>",
        "settings" => "<path d=\"M4 7h9M19 7h1M4 17h1M11 17h9\"/><circle cx=\"16\" cy=\"7\" r=\"2.500\"/><circle cx=\"8\" cy=\"17\" r=\"2.500\"/>",
        // Drawn 1.5 units high: a triangle's weight sits below the middle of its box, so centered it reads low.
        "warning" => "<path d=\"M12 2.500 21.500 18.500h-19L12 2.500z\" fill=\"currentColor\" fill-opacity=\"0.18\"/><path d=\"M12 8.500v4.500M12 15.700v.1\"/>",
        "copy" => "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.5\" fill=\"currentColor\" fill-opacity=\"0.18\"/><path d=\"M15 9V5.5A1.5 1.5 0 0 0 13.5 4h-8A1.5 1.5 0 0 0 4 5.5v8A1.5 1.5 0 0 0 5.5 15H9\"/>",
        "globe" => "<circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"currentColor\" fill-opacity=\"0.18\"/><path d=\"M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9s1.3-6.4 3.800-9z\"/>",
        "switch" => "<path d=\"M1.5 11.500 3.500 9h17l2 2.500v5.250A1.250 1.250 0 0 1 21.250 18H2.750A1.250 1.250 0 0 1 1.500 16.750z\" fill=\"currentColor\" fill-opacity=\"0.18\"/><path d=\"M1.5 11.500 3.500 9h17l2 2.500z\" fill=\"currentColor\" fill-opacity=\"0.35\"/><path d=\"M5 14.750h.1M7.800 14.750h.1M10.600 14.750h.1M13.400 14.750h.1M16.200 14.750h.1M19 14.750h.1\"/>",
        "access-point" => "<path d=\"M2.500 11v2.500c0 2.200 4.250 4 9.500 4s9.500-1.800 9.500-4V11\" fill=\"currentColor\" fill-opacity=\"0.18\"/><ellipse cx=\"12\" cy=\"11\" rx=\"9.500\" ry=\"4\" fill=\"currentColor\" fill-opacity=\"0.35\"/><ellipse cx=\"12\" cy=\"11\" rx=\"2.400\" ry=\"1\"/>",
        "cellular" => "<path d=\"M5 19v-3M10 19v-7M15 19V8M20 19V4\"/>",
