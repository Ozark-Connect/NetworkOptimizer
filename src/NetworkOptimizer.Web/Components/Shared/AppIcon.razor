        "link" => "<path d=\"M10 14a4 4 0 0 0 5.650 0l3-3a4 4 0 0 0-5.650-5.650l-1 1M14 10a4 4 0 0 0-5.650 0l-3 3a4 4 0 0 0 5.650 5.650l1-1\"/>",
