@inject IJSRuntime JS
@inject ILogger<ClientSelector> Logger

<div class="client-selector-combo">
    <div class="filterable-select @(_open ? "open" : "")">
        @if (_selected != null && !_open)
        {
            <div class="filterable-select-display" @onclick="OpenForEdit">
                <span class="status-dot @(_selected.IsOnline ? "online" : "offline")"></span>
                <span class="option-text">@_selected.Name</span>
                <span class="option-mac">@_selected.Mac</span>
            </div>
        }
        else
        {
            <input @ref="_filterInput"
                   type="text" class="form-select filterable-select-input"
                   placeholder="@Placeholder"
                   @bind="_search"
                   @bind:event="oninput"
                   @bind:after="OnSearchChanged"
                   @onkeydown="OnKeyDown"
                   @onclick="Open"
                   @onfocus="Open"
                   @onblur="CloseDelayed" />
        }
        @if (_open)
        {
            <div class="filterable-select-overlay" @onclick="Close"></div>
            <div class="filterable-select-dropdown" id="@_listId" role="listbox">
                @{ var shown = Visible(); }
                @for (var i = 0; i < shown.Count; i++)
                {
                    var item = shown[i];
                    <div class="filterable-select-option @(item.IsOnline ? "" : "offline") @(i == _highlight ? "is-active" : "")"
                         role="option"
                         aria-selected="@(i == _highlight)"
                         data-selected="@(item.Key == SelectedKey ? "true" : null)"
                         @onmousedown="() => Pick(item)"
                         @onmousedown:preventDefault>
                        <span class="status-dot @(item.IsOnline ? "online" : "offline")"></span>
                        <span class="option-text">@item.Name</span>
                        <span class="option-mac">@item.Mac</span>
                    </div>
                }
                @if (shown.Count == 0)
                {
                    <div class="filterable-select-empty">No clients found</div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>One choice. Key is whatever the host page identifies a client by - MAC or IP.</summary>
    public sealed record Item(string Key, string Name, string? Mac, bool IsOnline, string? Ip = null, bool IsWired = false);

    [Parameter] public IReadOnlyList<Item> Items { get; set; } = Array.Empty<Item>();
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public EventCallback<string> SelectedKeyChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select or search for a client...";

    private string _search = "";
    private int _highlight;
    private bool _open;
    private ElementReference _filterInput;

    /// <summary>Distinct per instance: two selectors can share a page.</summary>
    private readonly string _listId = "client-selector-" + Guid.NewGuid().ToString("n")[..8];

    private Item? _selected => string.IsNullOrEmpty(SelectedKey)
        ? null
        : Items.FirstOrDefault(i => i.Key == SelectedKey);

    private async Task Open()
    {
        _open = true;
        _highlight = IndexOfSelected();
        await ScrollToSelectedAsync();
    }

    /// <summary>The rows actually rendered, which is what the highlight indexes into.</summary>
    private List<Item> Visible() => Filtered().Take(50).ToList();

    private int IndexOfSelected()
    {
        var i = Visible().FindIndex(x => x.Key == SelectedKey);
        return i < 0 ? 0 : i;
    }

    /// <summary>Typing re-ranks the list, so the top match takes the highlight.</summary>
    private void OnSearchChanged()
    {
        _open = true;
        _highlight = 0;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
            return;
        }

        var shown = Visible();
        if (e.Key == "Enter")
        {
            if (_open && _highlight >= 0 && _highlight < shown.Count)
                await Pick(shown[_highlight]);
            return;
        }

        if (e.Key != "ArrowDown" && e.Key != "ArrowUp") return;

        if (!_open)
        {
            await Open();
            return;
        }

        if (shown.Count == 0) return;
        _highlight = e.Key == "ArrowDown"
            ? Math.Min(_highlight + 1, shown.Count - 1)
            : Math.Max(_highlight - 1, 0);
        await ScrollToHighlightAsync();
    }

    /// <summary>Keeps the highlighted row in view without moving the list when it already is.</summary>
    private async Task ScrollToHighlightAsync()
    {
        StateHasChanged();
        await Task.Delay(1);

        var js = "(function(){var c=document.getElementById('" + _listId + "');"
               + "if(!c)return;var o=c.querySelector('.filterable-select-option.is-active');"
               + "if(!o)return;if(o.offsetTop<c.scrollTop)c.scrollTop=o.offsetTop;"
               + "else if(o.offsetTop+o.offsetHeight>c.scrollTop+c.clientHeight)"
               + "c.scrollTop=o.offsetTop+o.offsetHeight-c.clientHeight;})()";
        try
        {
            await JS.InvokeVoidAsync("eval", js);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Client selector could not scroll to the highlighted option");
        }
    }

    private async Task OpenForEdit()
    {
        _search = "";
        _open = true;
        StateHasChanged();
        await Task.Delay(1); // let the input render before focusing it
        await _filterInput.FocusAsync();
        await ScrollToSelectedAsync();
    }

    /// <summary>
    /// Centers the current selection in the open list, so the options either side of it are visible.
    /// The browser clamps scrollTop, so a selection near either end simply sits at that end.
    /// </summary>
    private async Task ScrollToSelectedAsync()
    {
        if (string.IsNullOrEmpty(SelectedKey)) return;
        StateHasChanged();
        await Task.Delay(1); // the list has to exist before it can be scrolled

        var js = "(function(){var c=document.getElementById('" + _listId + "');"
               + "if(!c)return;var o=c.querySelector('[data-selected=\"true\"]');"
               + "if(!o)return;c.scrollTop=o.offsetTop-(c.clientHeight-o.offsetHeight)/2;})()";
        try
        {
            await JS.InvokeVoidAsync("eval", js);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Client selector could not scroll to the current selection");
        }
    }

    private void Close() => _open = false;

    private async Task CloseDelayed()
    {
        // Long enough for a click on an option to land before the blur closes the list.
        await Task.Delay(150);
        _open = false;
        StateHasChanged();
    }

    private async Task Pick(Item item)
    {
        _open = false;
        _search = "";
        await SelectedKeyChanged.InvokeAsync(item.Key);
    }

    private IEnumerable<Item> Filtered()
    {
        var items = Items.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var filter = _search.Trim();
            items = items.Where(i =>
                i.Name.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                (i.Mac?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (i.Ip?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                i.Key.Contains(filter, StringComparison.OrdinalIgnoreCase));
        }

        // The selector owns the order: a caller's sort would be discarded here anyway.
        return items
            .OrderBy(i => i.IsWired)
            .ThenByDescending(i => i.IsOnline)
            .ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase);
    }
}
