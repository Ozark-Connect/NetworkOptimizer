@inject IJSRuntime JS
@inject ILogger<ClientSelector> Logger
@inject NetworkOptimizer.Audit.Services.IIeeeOuiDatabase OuiDatabase

<div class="client-selector-combo">
    @* The arrows drive the list, so they must not also scroll the page. Inline and on the wrapper:
       Blazor resolves :preventDefault at render, so a blanket one would swallow Tab, and it refuses
       a plain onkeydown beside @onkeydown on the same element. *@
    <div class="filterable-select @(_open ? "open" : "")"
         onkeydown="if(event.key==='ArrowDown'||event.key==='ArrowUp')event.preventDefault();">
        @if (_selected != null && !_open)
        {
            @* Focusable: closed over a selection this replaces the input, and a div is not in the
               tab order on its own. *@
            <div class="filterable-select-display" tabindex="0"
                 role="combobox" aria-expanded="false" aria-haspopup="listbox"
                 @onclick="OpenForEdit" @onkeydown="OnDisplayKeyDown">
                <span class="status-dot @(_selected.IsOnline ? "online" : "offline")"></span>
                <span class="option-text">@_selected.Name</span>
                <span class="option-mac">@_selected.Mac</span>
            </div>
        }
        else
        {
            <input @ref="_filterInput"
                   type="text" class="form-select filterable-select-input"
                   placeholder="@Placeholder"
                   @bind="_search"
                   @bind:event="oninput"
                   @bind:after="OnSearchChanged"
                   @onkeydown="OnKeyDown"
                   @onclick="Open"
                   @onfocus="Open"
                   @onblur="CloseDelayed" />
            @if (!string.IsNullOrEmpty(_search))
            {
                <button type="button" class="filterable-select-clear" aria-label="Clear search"
                        @onmousedown="ClearSearchAsync" @onmousedown:preventDefault>&times;</button>
            }
        }
        @if (_open)
        {
            <div class="filterable-select-overlay" @onclick="Close"></div>
            <div class="filterable-select-dropdown" id="@_listId" role="listbox">
                @{ var shown = Visible(); }
                @for (var i = 0; i < shown.Count; i++)
                {
                    var item = shown[i];
                    var index = i;
                    <div class="filterable-select-option @(item.IsOnline ? "" : "offline") @(i == _highlight ? "is-active" : "")"
                         role="option"
                         aria-selected="@(i == _highlight)"
                         data-selected="@(item.Key == SelectedKey ? "true" : null)"
                         @onmouseenter="() => _highlight = index"
                         @onmousedown="() => Pick(item)"
                         @onmousedown:preventDefault>
                        <span class="status-dot @(item.IsOnline ? "online" : "offline")"></span>
                        <span class="option-text">@item.Name</span>
                        <span class="option-mac">@item.Mac</span>
                    </div>
                }
                @if (shown.Count == 0)
                {
                    <div class="filterable-select-empty">No clients found</div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>One choice. Key is whatever the host page identifies a client by - MAC or IP.</summary>
    public sealed record Item(string Key, string Name, string? Mac, bool IsOnline, string? Ip = null, bool IsWired = false);

    [Parameter] public IReadOnlyList<Item> Items { get; set; } = Array.Empty<Item>();
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public EventCallback<string> SelectedKeyChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select or search for a client...";

    /// <summary>
    /// Storage slot for the search, so it survives a pick that reloads the page. Client Performance
    /// navigates with forceLoad, which destroys this component, and retyping the query for every
    /// candidate is the cost this exists to remove. Unset means the search lives only in memory.
    /// </summary>
    [Parameter] public string? PersistKey { get; set; }

    private string _search = "";
    private int _highlight = NoHighlight;
    private bool _open;
    private ElementReference _filterInput;

    /// <summary>Distinct per instance: two selectors can share a page.</summary>
    private readonly string _listId = "client-selector-" + Guid.NewGuid().ToString("n")[..8];

    private Item? _selected => string.IsNullOrEmpty(SelectedKey)
        ? null
        : Items.FirstOrDefault(i => i.Key == SelectedKey);

    private async Task Open()
    {
        // Idempotent: click fires on every interaction with an already-open control, and re-running
        // this re-renders and re-scrolls under whatever the user is doing.
        if (_open) return;

        _open = true;
        _highlight = NoHighlight;
        await ScrollToSelectedAsync();
    }

    /// <summary>Nothing highlighted. Simply opening the list is not a choice about any row.</summary>
    private const int NoHighlight = -1;

    /// <summary>The rows actually rendered, which is what the highlight indexes into.</summary>
    private List<Item> Visible() => Filtered().Take(50).ToList();

    /// <summary>Searching ranks the list, so the top match leads. Clearing it leads nothing again.</summary>
    private void OnSearchChanged()
    {
        _open = true;
        _highlight = string.IsNullOrWhiteSpace(_search) ? NoHighlight : 0;
    }

    /// <summary>
    /// Drops the search from the outside, for a host action that means "start over" - going back to
    /// the whole list is exactly that, and leaving the query behind would contradict it.
    /// </summary>
    public void ClearSearch()
    {
        _search = "";
        _highlight = NoHighlight;
        StateHasChanged();
    }

    /// <summary>The X. Empties the search without closing, so the full list is there to pick from.</summary>
    private async Task ClearSearchAsync()
    {
        _search = "";
        _highlight = NoHighlight;
        _open = true;
        StateHasChanged();
        await Task.Delay(1); // the input has to be back before it can take focus
        try { await _filterInput.FocusAsync(); } catch { /* gone from the DOM already */ }
    }

    /// <summary>
    /// Hands the search to the page the pick is about to load. Written only here and consumed once
    /// on the way back in, so it carries across a selection and nothing else: an F5, or leaving and
    /// returning, finds nothing stored and starts clean.
    /// </summary>
    private async Task HandOffSearchAsync()
    {
        if (string.IsNullOrEmpty(PersistKey) || string.IsNullOrEmpty(_search)) return;
        try
        {
            var value = System.Text.Json.JsonSerializer.Serialize(_search);
            await JS.InvokeVoidAsync("eval", $"sessionStorage.setItem('{PersistKey}', {value})");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Client selector could not hand off the search");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrEmpty(PersistKey)) return;
        try
        {
            var stored = await JS.InvokeAsync<string?>("eval",
                $"(function(){{var v=sessionStorage.getItem('{PersistKey}');" +
                $"sessionStorage.removeItem('{PersistKey}');return v;}})()");
            if (!string.IsNullOrEmpty(stored))
            {
                _search = stored;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Client selector could not restore the search");
        }
    }

    /// <summary>Opens the list the way a native select does, from the closed display.</summary>
    private async Task OnDisplayKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowDown" or "ArrowUp")
        {
            // Opens and steps in one press, from the client being viewed.
            await OpenForEdit();
            MoveHighlight(e.Key);
            await ScrollToHighlightAsync();
            return;
        }

        if (e.Key is "Enter" or " ")
        {
            await OpenForEdit();
            return;
        }

        // Typing a character searches with it, rather than being swallowed by a control that has to
        // be opened first.
        if (e.Key.Length == 1 && !e.CtrlKey && !e.AltKey && !e.MetaKey)
        {
            await OpenForEdit();
            _search = e.Key;
            OnSearchChanged();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            // Drops the search as the X does, and closes with it.
            _search = "";
            _highlight = NoHighlight;
            _open = false;
            return;
        }

        var shown = Visible();
        if (e.Key == "Enter")
        {
            if (_open && _highlight >= 0 && _highlight < shown.Count)
                await Pick(shown[_highlight]);
            return;
        }

        if (e.Key != "ArrowDown" && e.Key != "ArrowUp") return;

        if (!_open)
            await Open();

        MoveHighlight(e.Key);
        await ScrollToHighlightAsync();
    }

    /// <summary>
    /// One step of the highlight. From nothing it steps off the client being viewed, and only enters
    /// the list at an end when there is no current selection to step from.
    /// </summary>
    private void MoveHighlight(string key)
    {
        var shown = Visible();
        if (shown.Count == 0) return;

        var from = _highlight;
        if (from == NoHighlight)
        {
            from = shown.FindIndex(x => x.Key == SelectedKey);
            if (from == NoHighlight)
            {
                _highlight = key == "ArrowDown" ? 0 : shown.Count - 1;
                return;
            }
        }

        _highlight = key == "ArrowDown"
            ? Math.Min(from + 1, shown.Count - 1)
            : Math.Max(from - 1, 0);
    }

    /// <summary>Keeps the highlighted row in view without moving the list when it already is.</summary>
    private async Task ScrollToHighlightAsync()
    {
        StateHasChanged();
        await Task.Delay(1);

        var js = "(function(){var c=document.getElementById('" + _listId + "');"
               + "if(!c)return;var o=c.querySelector('.filterable-select-option.is-active');"
               + "if(!o)return;if(o.offsetTop<c.scrollTop)c.scrollTop=o.offsetTop;"
               + "else if(o.offsetTop+o.offsetHeight>c.scrollTop+c.clientHeight)"
               + "c.scrollTop=o.offsetTop+o.offsetHeight-c.clientHeight;})()";
        try
        {
            await JS.InvokeVoidAsync("eval", js);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Client selector could not scroll to the highlighted option");
        }
    }

    private async Task OpenForEdit()
    {
        // The search survives: working through several candidates from one query is the normal way
        // this gets used, and retyping it for each is the whole cost. Escape clears it.
        _open = true;
        // Opens without going through Open(), so it clears the highlight itself. Left stale, the
        // arrows move from wherever the last session ended instead of from the current client.
        _highlight = NoHighlight;
        StateHasChanged();
        await Task.Delay(1); // let the input render before focusing it
        await _filterInput.FocusAsync();
        await ScrollToSelectedAsync();
    }

    /// <summary>
    /// Centers the current selection in the open list, so the options either side of it are visible.
    /// The browser clamps scrollTop, so a selection near either end simply sits at that end.
    /// </summary>
    private async Task ScrollToSelectedAsync()
    {
        if (string.IsNullOrEmpty(SelectedKey)) return;
        StateHasChanged();
        await Task.Delay(1); // the list has to exist before it can be scrolled

        var js = "(function(){var c=document.getElementById('" + _listId + "');"
               + "if(!c)return;var o=c.querySelector('[data-selected=\"true\"]');"
               + "if(!o)return;c.scrollTop=o.offsetTop-(c.clientHeight-o.offsetHeight)/2;})()";
        try
        {
            await JS.InvokeVoidAsync("eval", js);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Client selector could not scroll to the current selection");
        }
    }

    private void Close() => _open = false;

    private async Task CloseDelayed()
    {
        // Long enough for a click on an option to land before the blur closes the list.
        await Task.Delay(150);
        _open = false;
        StateHasChanged();
    }

    private async Task Pick(Item item)
    {
        _open = false;
        await HandOffSearchAsync();
        await SelectedKeyChanged.InvokeAsync(item.Key);
    }

    /// <summary>
    /// The hex of a MAC with nothing else, so both sides of a comparison are separator-blind: a
    /// device is found by colons, dashes, dots, or none at all, in whole or in part, and an OUI on
    /// its own is simply a short prefix.
    /// </summary>
    private static string HexDigits(string value) =>
        new(value.Where(Uri.IsHexDigit).Select(char.ToLowerInvariant).ToArray());

    /// <summary>
    /// A search read as a MAC, or empty when it is not one. Every character has to belong in a MAC:
    /// a name is full of hex letters, and stripping the rest of "Kira" leaves "a", which is in
    /// almost every address. Three digits in, so a single stray character cannot match the fleet.
    /// </summary>
    private static string MacQuery(string search)
    {
        foreach (var c in search)
            if (!Uri.IsHexDigit(c) && c is not (':' or '-' or '.' or ' '))
                return "";

        var hex = HexDigits(search);
        return hex.Length >= 3 ? hex : "";
    }

    /// <summary>
    /// Letters and digits only, lowercased, for comparing a typed vendor against a registry name.
    /// Applied to the search side and to a copy of the name, never to the OUI data itself: "cisco"
    /// has to reach "Cisco Systems, Inc", and every Cisco prefix at once, without the punctuation
    /// and casing the registry ships deciding whether it does.
    /// </summary>
    private static string VendorKey(string value) =>
        new(value.Where(char.IsLetterOrDigit).Select(char.ToLowerInvariant).ToArray());

    /// <summary>The registry's name for a MAC's vendor, or empty when it has none.</summary>
    private string VendorOf(string? mac) =>
        string.IsNullOrEmpty(mac) ? "" : OuiDatabase.GetVendor(mac) ?? "";

    private IEnumerable<Item> Filtered()
    {
        var items = Items.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var filter = _search.Trim();
            var hex = MacQuery(filter);
            var vendor = VendorKey(filter);
            // Words in any order, so "tj phone" finds "[Phone] TJ iPhone".
            var words = filter.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            items = items.Where(i =>
                i.Name.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                (words.Length > 1 && words.All(w => i.Name.Contains(w, StringComparison.OrdinalIgnoreCase))) ||
                (i.Mac?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (i.Ip?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                i.Key.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                (hex.Length > 0 && HexDigits(i.Mac ?? "").Contains(hex, StringComparison.Ordinal)) ||
                (vendor.Length > 1 && VendorKey(VendorOf(i.Mac ?? i.Key)).Contains(vendor, StringComparison.Ordinal)));
        }

        // The selector owns the order: a caller's sort would be discarded here anyway.
        return items
            .OrderBy(i => i.IsWired)
            .ThenByDescending(i => i.IsOnline)
            .ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase);
    }
}
