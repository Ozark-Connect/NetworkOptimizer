<div class="security-score-gauge">
    <div class="gauge-container">
        <ScoreDial Score="@Score" Label="Wi-Fi Health" Rating="@GetDialRating()" Thresholds="RatingThresholds" />
    </div>

    <div class="gauge-rating">
        <span class="rating-badge rating-@GetRatingClass()">@GetRatingLabel()</span>
    </div>
</div>

@code {
    [Parameter]
    public int Score { get; set; } = 0;

    // Where Needs Work, Fair, Good, and Excellent start.
    private static readonly int[] RatingThresholds = { 60, 70, 80, 90 };

    /// <summary>The dial's color step. Finer than the badge's: 60-69 is its own step here.</summary>
    private string GetDialRating()
    {
        return Score switch
        {
            0 => "none",
            >= 90 => "excellent",
            >= 80 => "good",
            >= 70 => "fair",
            >= 60 => "weak",
            _ => "poor"
        };
    }

    private string GetRatingClass()
    {
        return Score switch
        {
            0 => "none",
            >= 90 => "excellent",
            >= 80 => "good",
            >= 70 => "fair",
            _ => "poor"
        };
    }

    private string GetRatingLabel()
    {
        return Score switch
        {
            0 => "No Data",
            >= 90 => "Excellent",
            >= 80 => "Good",
            >= 70 => "Fair",
            >= 60 => "Needs Work",
            _ => "Poor"
        };
    }
}
