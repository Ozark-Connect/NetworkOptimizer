@using NetworkOptimizer.Threats.Blocking
@using NetworkOptimizer.Web.Services.Authorization
@inject IThreatBlockingSiteAdmin SiteBlocking
@inject IAuthorizationService Authz
@inject AuthenticationStateProvider AuthState

@* Settings - Multi-Site: Turn On Recommended for every site the caller administers. One gated,
   audited call per site, so a site the caller cannot administer is never touched. Hidden once
   every one of those sites is Blocking with WAN Flood Protection on wherever its agent can run it. *@

@if (_adminSlugs.Count > 1 && !AllBlocking)
{
    <div class="alert alert-info">
        <div class="banner-content">
            <div class="banner-text">
                <span>Automatic Blocking: start blocking repeat attackers on all @_adminSlugs.Count sites at once, sharing what each one blocks.</span>
                <small class="form-help">Also blocks each site's selected public block lists right on its gateway, and turns on WAN Flood Protection where the gateway's On-Site Agent can run it.</small>
            </div>
            <div class="banner-actions">
                <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="TurnOnAll">Turn On Recommended for All Sites</button>
            </div>
        </div>
        @if (_result != null)
        {
            <p class="form-help">@_result</p>
        }
    </div>
}
else if (_result != null)
{
    <div class="alert alert-success">@_result</div>
}

@code {
    /// <summary>The slugs of every enabled site.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> SiteSlugs { get; set; } = [];

    /// <summary>Raised after the run, so the site rows can reload.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<string> _adminSlugs = [];
    private HashSet<string> _blockingSlugs = [];
    private bool _loaded;
    private bool _busy;
    private string? _result;

    // Hidden until the modes load, so the banner never flashes in on a fully Blocking install.
    private bool AllBlocking => !_loaded || _adminSlugs.All(_blockingSlugs.Contains);

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        var slugs = new List<string>();
        foreach (var slug in SiteSlugs)
        {
            if ((await Authz.AuthorizeAsync(user, slug, Policies.SiteAdmin)).Succeeded)
                slugs.Add(slug);
        }
        _adminSlugs = slugs;
        await LoadModesAsync();
    }

    private async Task LoadModesAsync()
    {
        var blocking = new HashSet<string>();
        foreach (var slug in _adminSlugs)
        {
            try
            {
                var summary = await SiteBlocking.GetSummaryAsync(slug);
                if (summary.Mode == BlockingMode.Enforce && !summary.WanFloodPending)
                    blocking.Add(slug);
            }
            catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
            {
                // Unreadable counts as not Blocking, so the banner stays to offer it.
            }
        }
        _blockingSlugs = blocking;
        _loaded = true;
    }

    private async Task TurnOnAll()
    {
        _busy = true;
        _result = null;
        var done = 0;
        var flood = 0;
        var problems = new List<string>();
        foreach (var slug in _adminSlugs)
        {
            try
            {
                var r = await SiteBlocking.TurnOnRecommendedAsync(slug);
                done++;
                if (r.WanFlood) flood++;
                if (r.GatewayError != null) problems.Add($"{slug}: gateway not set up ({r.GatewayError})");
            }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException)
            {
                problems.Add($"{slug}: {ex.Message}");
            }
        }
        var on = flood > 0 ? $"Blocking on {done} sites, WAN Flood Protection on {flood}." : $"Blocking on {done} sites.";
        _result = problems.Count == 0 ? on : $"{on} {string.Join(" ", problems)}";
        await LoadModesAsync();
        _busy = false;
        await OnChanged.InvokeAsync();
    }
}
