@using NetworkOptimizer.Web.Services.Identity
@inject ITimeZonePreferenceSource TimeZonePreferences
@inject IUserPreferences UserPreferences
@inject ICallerContext Caller
@inject IDisplayTimeZone DisplayTime
@inject NavigationManager Navigation

@* The signed-in user's own time zone and date and time formats. Shown on Settings - Application and
   on the account page; both write the same preferences. Renders nothing without a user to own them
   (authentication disabled), where the browser's locale sets the formats. *@

@if (_loaded && Caller.Current?.UserId != null)
{
    @if (ShowZone)
    {
        <div class="form-group">
            <label class="form-label" for="@Id">Your time zone</label>
            <TimeZoneSelect Id="@Id" Value="@_own" ValueChanged="SaveAsync" InheritLabel="@_inheritLabel" />
            <p class="form-help">Times are shown in this zone on every site, wherever you sign in.</p>
        </div>
    }
    <div class="form-group">
        <label class="form-label" for="@($"{Id}-clock")">Your time format</label>
        <select id="@($"{Id}-clock")" class="form-control" data-autosave value="@(_clock ?? "")" @onchange="e => SaveFormatAsync(TimeZonePreferenceSource.ClockKey, e.Value?.ToString())">
            <option value="">@ClockDefaultLabel</option>
            <option value="12">@ClockLabel(ClockStyle.TwelveHour)</option>
            <option value="24">@ClockLabel(ClockStyle.TwentyFourHour)</option>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label" for="@($"{Id}-date")">Your date format</label>
        <select id="@($"{Id}-date")" class="form-control" data-autosave value="@(_order ?? "")" @onchange="e => SaveFormatAsync(TimeZonePreferenceSource.DateOrderKey, e.Value?.ToString())">
            <option value="">@DateDefaultLabel</option>
            <option value="mdy">@DateLabel(DateOrder.MonthFirst)</option>
            <option value="dmy">@DateLabel(DateOrder.DayFirst)</option>
        </select>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "time-zone-personal";

    /// <summary>False where the time zone select is not offered; the formats are still the user's own.</summary>
    [Parameter] public bool ShowZone { get; set; } = true;

    // A fixed afternoon, so the 12-hour and 24-hour examples differ at a glance.
    private static readonly DateTime Sample = new(2026, 11, 3, 14, 5, 0);

    private bool _loaded;
    private string? _own;
    private string? _clock;
    private string? _order;
    private string _inheritLabel = "Default";

    // The install default format, each half null when an admin set none.
    private ClockStyle? _inheritedClock;
    private DateOrder? _inheritedOrder;

    private static string Example(string format) =>
        Sample.ToString(format, System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>"12-hour (2:05 PM)", as the choice and as the install default it names.</summary>
    public static string ClockLabel(ClockStyle clock) => clock == ClockStyle.TwelveHour
        ? $"12-hour ({Example("h:mm tt")})"
        : $"24-hour ({Example("HH:mm")})";

    /// <summary>"Nov 3, 2026" or "3 Nov 2026".</summary>
    public static string DateLabel(DateOrder order) =>
        Example(new DisplayFormat(ClockStyle.TwentyFourHour, order).Date);

    // Names the layer that applies with no choice of their own, as the time zone's "Default - ..." does.
    private string ClockDefaultLabel => _inheritedClock is { } c
        ? $"Default - {ClockLabel(c)}"
        : $"Default - this browser: {Example(DisplayTime.BrowserFormat.Time)}";

    private string DateDefaultLabel => _inheritedOrder is { } o
        ? $"Default - {DateLabel(o)}"
        : $"Default - this browser: {Example(DisplayTime.BrowserFormat.Date)}";

    protected override async Task OnInitializedAsync()
    {
        _own = await TimeZonePreferences.GetOwnAsync();
        (_clock, _order) = await TimeZonePreferences.GetOwnFormatAsync();
        var (inheritedClock, inheritedOrder) = await TimeZonePreferences.GetInheritedFormatAsync();
        _inheritedClock = DisplayFormat.ParseCode(inheritedClock).Clock;
        _inheritedOrder = DisplayFormat.ParseCode(inheritedOrder).Order;
        var inherited = await TimeZonePreferences.GetInheritedAsync();
        var now = DateTime.UtcNow;
        // Names the layer that applies with no choice of their own, so the effective zone is always visible.
        _inheritLabel = TimeZoneCatalog.TryResolve(inherited, out _)
            ? $"Default - {TimeZoneCatalog.Describe(inherited!.Trim(), now)}"
            : DisplayTime.SiteZone is { } site
                ? $"Default - site time zone, {TimeZoneCatalog.Describe(TimeZoneCatalog.ToIana(site), now)}"
                : $"Default - server time zone, {TimeZoneCatalog.Describe(TimeZoneCatalog.ServerZoneId, now)}";
        _loaded = true;
    }

    private async Task SaveAsync(string? value)
    {
        if (value != null && !TimeZoneCatalog.TryResolve(value, out _)) return;
        _own = value;
        await UserPreferences.SetAsync(TimeZonePreferenceSource.Key, value);
        // Every time already on the page was rendered on the old clock; the new circuit resolves the new one.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task SaveFormatAsync(string key, string? value)
    {
        value = string.IsNullOrEmpty(value) ? null : value;
        var (clock, order) = DisplayFormat.ParseCode(value);
        var valid = key == TimeZonePreferenceSource.ClockKey ? clock != null : order != null;
        if (value != null && !valid) return;
        await UserPreferences.SetAsync(key, value);
        // Every time on the page was formatted the old way; the new circuit reads the new format.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
