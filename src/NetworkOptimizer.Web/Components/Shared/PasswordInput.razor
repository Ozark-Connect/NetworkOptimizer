@* A password field with a Show/Hide toggle, in place of a confirm field: the user checks what they
   typed instead of typing it twice. Without @bind-Value the value lives in the DOM, so it posts with a
   plain form. The toggle runs in the browser (togglePasswordVisibility in App.razor), and the render
   tree never changes the type, so a re-render leaves the shown state alone. Clicks stop here: the
   Settings field sits inside a card whose own click handler must not fire. *@
<div class="input-with-button">
    @if (ValueChanged.HasDelegate)
    {
        <input id="@Id" name="@Name" type="password" class="form-control" autocomplete="@AutoComplete"
               placeholder="@Placeholder" spellcheck="false" autocapitalize="none"
               value="@Value" @oninput="OnInputAsync" @onclick:stopPropagation="true" />
    }
    else
    {
        <input id="@Id" name="@Name" type="password" class="form-control" autocomplete="@AutoComplete"
               placeholder="@Placeholder" spellcheck="false" autocapitalize="none" @onclick:stopPropagation="true" />
    }
    <button type="button" class="btn btn-secondary btn-sm" aria-controls="@Id" aria-pressed="false"
            onclick="togglePasswordVisibility(this)" @onclick:stopPropagation="true">Show</button>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string AutoComplete { get; set; } = "";

    /// <summary>The form field name, for a field posted by a plain form.</summary>
    [Parameter] public string? Name { get; set; }

    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private Task OnInputAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
