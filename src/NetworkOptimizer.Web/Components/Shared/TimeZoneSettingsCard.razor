@using NetworkOptimizer.Web.Services.Identity
@inject ITimeZonePreferenceSource TimeZonePreferences
@inject ISystemSettingsAdmin SettingsAdmin
@inject IIdentityAdminService IdentityAdmin
@inject IDisplayTimeZone DisplayTime
@inject NavigationManager Navigation
@inject ILogger<TimeZoneSettingsCard> Logger

@* Settings - Application (Global Admin, main site): the install default first, since on a one-user
   install it is the only setting. Each user's own zone follows once there is more than one user. *@

<div class="card settings-tab-application" id="time-zone">
    <div class="card-header">
        <h2 class="card-title">Date &amp; Time</h2>
    </div>
    <div class="card-body">
        <AuthorizeView Policy="@Policies.RequireAdmin" Context="globalAdmin">
            @if (_loaded)
            {
                <div class="form-group">
                    <label class="form-label" for="time-zone-default">Default time zone</label>
                    <TimeZoneSelect Id="time-zone-default" Value="@_default" ValueChanged="SaveDefaultAsync" InheritLabel="@_siteLabel" />
                    <p class="form-help">For everyone who has not chosen their own. Alerts use each site's time zone.</p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="time-zone-default-clock">Default time format</label>
                    <select id="time-zone-default-clock" class="form-control" data-autosave value="@(_defaultClock ?? "")" @onchange="e => SaveDefaultFormatAsync(TimeZonePreferenceSource.ClockKey, e.Value?.ToString())">
                        <option value="">Each viewer's browser</option>
                        <option value="12">@PersonalTimeZoneField.ClockLabel(ClockStyle.TwelveHour)</option>
                        <option value="24">@PersonalTimeZoneField.ClockLabel(ClockStyle.TwentyFourHour)</option>
                    </select>
                    <p class="form-help">For everyone who has not chosen their own. Alerts use this format too, or 24-hour when none is set.</p>
                </div>
                <div class="form-group">
                    <label class="form-label" for="time-zone-default-date">Default date format</label>
                    <select id="time-zone-default-date" class="form-control" data-autosave value="@(_defaultOrder ?? "")" @onchange="e => SaveDefaultFormatAsync(TimeZonePreferenceSource.DateOrderKey, e.Value?.ToString())">
                        <option value="">Each viewer's browser</option>
                        <option value="mdy">@PersonalTimeZoneField.DateLabel(DateOrder.MonthFirst)</option>
                        <option value="dmy">@PersonalTimeZoneField.DateLabel(DateOrder.DayFirst)</option>
                        <option value="ymd">@PersonalTimeZoneField.DateLabel(DateOrder.YearFirst)</option>
                    </select>
                    <p class="form-help">For everyone who has not chosen their own. Alerts use this format too, or month first when none is set.</p>
                </div>
            }
        </AuthorizeView>

        @* Like the zone, a one-user install sets the defaults above and has no personal layer to offer. *@
        @if (_severalUsers)
        {
            <PersonalTimeZoneField />
        }
    </div>
</div>

@code {
    private bool _loaded;
    private bool _severalUsers;
    private string? _default;
    private string? _defaultClock;
    private string? _defaultOrder;
    private string _siteLabel = "";

    protected override async Task OnInitializedAsync()
    {
        _default = await TimeZonePreferences.GetInheritedAsync();
        (_defaultClock, _defaultOrder) = await TimeZonePreferences.GetInheritedFormatAsync();
        var now = DateTime.UtcNow;
        _siteLabel = DisplayTime.SiteZone is { } site
            ? $"Each site's time zone - this site: {TimeZoneCatalog.Describe(TimeZoneCatalog.ToIana(site), now)}"
            : $"Each site's time zone - this site: server time zone, {TimeZoneCatalog.Describe(TimeZoneCatalog.ServerZoneId, now)}";
        try
        {
            _severalUsers = (await IdentityAdmin.ListUsersAsync()).Count > 1;
        }
        catch (Exception ex)
        {
            // Offer the personal field rather than hide it on a failed read.
            Logger.LogDebug(ex, "Could not count users for the Time Zone card");
            _severalUsers = true;
        }
        _loaded = true;
    }

    private async Task SaveDefaultAsync(string? value)
    {
        if (value != null && !TimeZoneCatalog.TryResolve(value, out _)) return;
        _default = value;
        await SettingsAdmin.SetGlobalAsync(TimeZonePreferenceSource.Key, value);
        // Reloads so the page, and the personal field's "Default - ..." label, read the new default.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task SaveDefaultFormatAsync(string key, string? value)
    {
        value = string.IsNullOrEmpty(value) ? null : value;
        var (clock, order) = DisplayFormat.ParseCode(value);
        var valid = key == TimeZonePreferenceSource.ClockKey ? clock != null : order != null;
        if (value != null && !valid) return;
        await SettingsAdmin.SetGlobalAsync(key, value);
        // Every time on the page was formatted the old way; the new circuit reads the new default.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
