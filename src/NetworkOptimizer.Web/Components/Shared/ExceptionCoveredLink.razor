@using NetworkOptimizer.Threats.Blocking

@* Stands in for Allow on a row an exception already lets through, linking to where it is managed. *@

<a href="/settings?tab=security#blocking-exceptions" class="exception-covered" aria-label="Allowed by an exception"
   data-tooltip="@($"Allowed by an exception: {BlockingExceptions.Describe(Exception, DeviceName)} Select to manage or remove it in Settings - Security & Alerts.")">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>
</a>

@code {
    [Parameter, EditorRequired] public BlockingException Exception { get; set; } = default!;

    /// <summary>A device's name from its IP, for the tooltip.</summary>
    [Parameter] public Func<string, string?>? DeviceName { get; set; }
}
