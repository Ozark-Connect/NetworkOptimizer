@using System.Text
@inject AgentServerUrlProvider AgentServerUrl
@inject IAgentEnrollmentService AgentEnrollment

@* Agent enrollment token plus how to stand the agent up, shared by the site
   wizard and the Multi-Site settings panel. Always the published-release
   one-liners (Docker, bare metal, on-gateway) - even on a source-built server,
   the agent should come from a release, not a hand-built binary. The
   configured central server URL is filled in so nothing is hand-typed. *@

<style>
    .agent-token-box .agent-token-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
</style>

<div class="agent-install">
<div class="alert alert-success agent-token-box">
    <div class="agent-token-row">
        <span>Enrollment token: <code>@_token</code></span>
        @if (CanRefresh)
        {
            <button type="button" class="btn btn-secondary btn-sm" @onclick="RefreshTokenAsync" disabled="@_refreshing">
                New token
            </button>
        }
    </div>
    <div>Copy it now. It is shown only once and expires in @LifetimeText if unused.</div>
    @if (_refreshNote != null)
    {
        <div>@_refreshNote</div>
    }
</div>

@if (string.IsNullOrWhiteSpace(ServerUrl))
{
    <p class="form-hint">
        This server's reverse-proxied HTTPS address isn't set (<code>REVERSE_PROXIED_HOST_NAME</code>), so
        the command below shows a placeholder. Set it so agents have an address to dial back to - the same
        host serves the app and the agent tunnel.
    </p>
}

    <p class="section-description">
        On the site's agent box, install with Docker or as a bare-metal systemd service - pick one. Either
        way the agent dials out to <code>@ServerDisplay</code> over HTTPS only, with no inbound access to the
        site.
    </p>

    <h4 class="agent-flavor-title">Docker</h4>
    <p class="form-hint">Pulls the agent image and compose template, writes the config, and starts it.</p>
    <CopyableCommand Text="@DockerOneLiner()" Tooltip="Copy the Docker install command" />

    <h4 class="agent-flavor-title">Proxmox LXC</h4>
    <p class="form-hint">
        Run on the Proxmox host: builds a small container and installs the agent inside it. Every prompt is
        also a flag, so a site needing one agent per WAN is one command each.
    </p>
    <CopyableCommand Text="@ProxmoxOneLiner()" Tooltip="Copy the Proxmox LXC install command" />

    <h4 class="agent-flavor-title">Bare metal (systemd)</h4>
    <p class="form-hint">
        No Docker required - downloads a self-contained binary and installs a <code>netopt-agent</code>
        systemd service.
    </p>
    <CopyableCommand Text="@NativeOneLiner()" Tooltip="Copy the native install command" />

    <h4 class="agent-flavor-title">On a UniFi gateway <span class="agent-flavor-note">monitoring only - recommended for multi-WAN monitoring</span></h4>
    <p class="form-hint">
        Run the agent on the gateway itself (any current UniFi gateway - UCG, UXG, UDM, UDR, EFG) instead of a
        separate box. It does not host the LAN speed test - that needs one of the options above - and installs
        to <code>/data</code> with a memory-fenced service. UniFi gateways SSH in as root, so run it there
        directly:
    </p>
    <CopyableCommand Text="@GatewayOneLiner()" Tooltip="Copy the gateway install command" />
    @if (!string.IsNullOrWhiteSpace(SiteSlug))
    {
        <GatewayAgentRunPanel SiteSlug="@SiteSlug" EnrollmentToken="@_token" />
    }
    @if (LanSpeedTest)
    {
        <p class="form-hint">
            You asked for LAN speed testing, so this site still needs one of the options above on a separate
            box to host it.
        </p>
    }

    <p class="form-hint">
        Full options and troubleshooting are in the
        <a href="https://github.com/Ozark-Connect/NetworkOptimizer/blob/main/src/NetworkOptimizer.Agent/README.md" target="_blank" rel="noopener">agent deployment guide</a>.
        The server URL just has to be reachable from the site: over a VPN or site-to-site VPN, or a public
        address. If it isn't reachable over a VPN, expose this server's reverse proxy - on a UniFi gateway
        at this server's site: UniFi Network &gt; Settings &gt; Policy Table &gt; Port Forwarding (usually
        443/TCP).
    </p>
</div>

@code {
    /// <summary>The one-time enrollment token shown to the operator.</summary>
    [Parameter, EditorRequired]
    public string Token { get; set; } = "";

    /// <summary>
    /// The pending agent the token belongs to. Enables the New token button; without it the
    /// panel is display-only.
    /// </summary>
    [Parameter]
    public int AgentId { get; set; }

    /// <summary>Raised with the fresh token after a refresh, so the parent's copy stays current.</summary>
    [Parameter]
    public EventCallback<string> TokenChanged { get; set; }

    /// <summary>Whether the agent should also host the LAN speed test server at the site.</summary>
    [Parameter]
    public bool LanSpeedTest { get; set; }

    /// <summary>
    /// The site the agent is being installed for. Enables "Run It for Me" under the gateway
    /// one-liner when that site's gateway SSH is configured and dialable; without it the
    /// commands are copy-paste only.
    /// </summary>
    [Parameter]
    public string? SiteSlug { get; set; }

    // The token every command renders from. Starts as the parameter and is replaced by a refresh;
    // the parameter is re-adopted only when the parent hands in a different one, so a parent that
    // re-renders for an unrelated reason cannot roll a refreshed token back.
    private string _token = "";
    private string _lastTokenParameter = "";
    private bool _refreshing;
    private string? _refreshNote;

    protected override void OnParametersSet()
    {
        if (Token != _lastTokenParameter)
        {
            _lastTokenParameter = Token;
            _token = Token;
            _refreshNote = null;
        }
    }

    private bool CanRefresh => AgentId > 0 && !string.IsNullOrWhiteSpace(SiteSlug);

    private static string LifetimeText
    {
        get
        {
            var life = AgentEnrollmentService.TokenLifetime;
            if (life.TotalHours >= 1)
                return life.TotalHours == 1 ? "1 hour" : $"{life.TotalHours:0} hours";
            return $"{life.TotalMinutes:0} minutes";
        }
    }

    private async Task RefreshTokenAsync()
    {
        if (!CanRefresh)
            return;

        _refreshing = true;
        try
        {
            var fresh = await AgentEnrollment.ReissueTokenAsync(SiteSlug!, AgentId);
            if (fresh == null)
            {
                _refreshNote = "This agent has already enrolled, so it no longer needs a token.";
                return;
            }

            _token = fresh;
            _refreshNote = null;
            await TokenChanged.InvokeAsync(fresh);
        }
        finally
        {
            _refreshing = false;
        }
    }

    /// <summary>The agent-facing HTTPS base URL, derived from REVERSE_PROXIED_HOST_NAME.</summary>
    private string? ServerUrl => AgentServerUrl.Url;

    private string ServerDisplay => string.IsNullOrWhiteSpace(ServerUrl) ? "this server" : ServerUrl!.TrimEnd('/');

    private string ServerValue => string.IsNullOrWhiteSpace(ServerUrl) ? "https://your-network-optimizer" : ServerUrl!.TrimEnd('/');

    // Interactive by default, but seeded with the server and token so the two things
    // that cannot be guessed are already filled in. Everything else the script asks for
    // has a flag, listed in its --help.
    private string ProxmoxOneLiner()
    {
        var sb = new StringBuilder();
        sb.Append("bash -c \"$(wget -qLO - https://raw.githubusercontent.com/Ozark-Connect/NetworkOptimizer/main/scripts/proxmox/install-agent.sh)\" -- \\\n");
        sb.Append($"  --server \"{ServerValue}\" \\\n");
        sb.Append($"  --token \"{_token}\"");
        if (LanSpeedTest)
            sb.Append(" \\\n  --lan-speed-test");
        return sb.ToString();
    }

    private string DockerOneLiner()
    {
        var sb = new StringBuilder();
        sb.Append("curl -fsSL https://raw.githubusercontent.com/Ozark-Connect/NetworkOptimizer/main/scripts/agent/install-docker.sh | bash -s -- \\\n");
        sb.Append($"  --server \"{ServerValue}\" \\\n");
        sb.Append($"  --token \"{_token}\"");
        if (LanSpeedTest)
            sb.Append(" \\\n  --lan-speed-test");
        return sb.ToString();
    }

    private string NativeOneLiner()
    {
        var sb = new StringBuilder();
        sb.Append("curl -fsSL https://raw.githubusercontent.com/Ozark-Connect/NetworkOptimizer/main/scripts/agent/install-native.sh | sudo bash -s -- \\\n");
        sb.Append($"  --server \"{ServerValue}\" \\\n");
        sb.Append($"  --token \"{_token}\"");
        if (LanSpeedTest)
            sb.Append(" \\\n  --lan-speed-test");
        return sb.ToString();
    }

    // The shared builder also feeds the "Run It for Me" SSH run, so the displayed
    // command and the executed one cannot drift.
    private string GatewayOneLiner() => GatewayAgentCommands.Install(ServerUrl, _token);
}
