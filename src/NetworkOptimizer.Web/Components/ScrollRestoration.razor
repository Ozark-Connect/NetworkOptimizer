@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@code {
    private string? _previousPath;
    // Positions are saved per path AND query: a tab (?tab=) is its own place to come back to.
    private string? _previousUrl;

    protected override void OnInitialized()
    {
        _previousPath = GetPath(NavigationManager.Uri);
        _previousUrl = GetPathAndQuery(NavigationManager.Uri);
        NavigationManager.RegisterLocationChangingHandler(OnLocationChanging);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        // Save scroll position BEFORE navigation happens
        if (_previousUrl != null)
        {
            _ = JSRuntime.InvokeVoidAsync("scrollRestoration.savePosition", _previousUrl);
        }
        return ValueTask.CompletedTask;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var newPath = GetPath(e.Location);
        var newUrl = GetPathAndQuery(e.Location);
        _previousUrl = newUrl;

        if (newPath == _previousPath)
        {
            // Query-only change (e.g. tab switch): preserve scroll and nav state, unless it was Back or
            // Forward, which returns to where that tab was left.
            try { await JSRuntime.InvokeVoidAsync("scrollRestoration.restoreIfPopState", newUrl); }
            catch (JSDisconnectedException) { }
            return;
        }

        // Small delay to ensure DOM is ready after Blazor renders
        await Task.Delay(50);

        try
        {
            await JSRuntime.InvokeVoidAsync("scrollRestoration.restoreOrScrollToTop", newUrl);
        }
        catch (JSDisconnectedException)
        {
            // Circuit disconnected, ignore
        }

        _previousPath = newPath;
    }

    private static string GetPath(string uri)
    {
        return new Uri(uri).AbsolutePath;
    }

    /// <summary>
    /// The key a position is saved under: the path and query, without ?site= and in a fixed order. Multi-site
    /// stamps ?site= into the address bar behind the router (site-context.js), so the same page reads with it on
    /// Back and without it when it was left.
    /// </summary>
    private static string GetPathAndQuery(string uri)
    {
        var parsed = new Uri(uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(parsed.Query)
            .Where(kv => !string.Equals(kv.Key, "site", StringComparison.OrdinalIgnoreCase))
            .OrderBy(kv => kv.Key, StringComparer.Ordinal)
            .Select(kv => kv.Key + "=" + kv.Value.ToString());
        return parsed.AbsolutePath + "?" + string.Join("&", query);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
