@using Microsoft.AspNetCore.Components.Web
@using NetworkOptimizer.Web.Components
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@FileVersionProvider.AddFileVersionToPath("/", "css/app.css")" />
    @* Font Awesome Free 6, brands and solid: the marks the Data tab's application list shows. *@
    <link rel="stylesheet" href="@FileVersionProvider.AddFileVersionToPath("/", "lib/fontawesome/css/fontawesome.min.css")" />
    <link rel="stylesheet" href="@FileVersionProvider.AddFileVersionToPath("/", "lib/fontawesome/css/brands.min.css")" />
    <link rel="stylesheet" href="@FileVersionProvider.AddFileVersionToPath("/", "lib/fontawesome/css/solid.min.css")" />
    <!-- PWA icons and manifest -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1a2029" />
    <meta name="msapplication-TileColor" content="#1a2029" />
    <meta name="msapplication-TileImage" content="mstile-150x150.png" />
    <!-- Custom Blazor reconnect modal styles -->
    <style>
        #components-reconnect-modal {
            position: fixed;
            inset: 0;
            z-index: 10000;
            display: none;
            align-items: center;
            justify-content: center;
            background-color: rgba(0, 0, 0, 0.5);
        }
        #components-reconnect-modal.components-reconnect-show,
        #components-reconnect-modal.components-reconnect-failed,
        #components-reconnect-modal.components-reconnect-rejected {
            display: flex;
        }
        #circuit-start-failed {
            position: fixed;
            inset: 0;
            z-index: 10000;
            display: none;
            align-items: center;
            justify-content: center;
        }
        #circuit-start-failed.retrying,
        #circuit-start-failed.failed {
            display: flex;
        }
        #circuit-start-failed .circuit-start-message,
        #circuit-start-failed .btn,
        #circuit-start-failed.failed .reconnect-spinner,
        #circuit-start-failed.failed .circuit-start-retrying {
            display: none;
        }
        #circuit-start-failed.failed .circuit-start-message,
        #circuit-start-failed.failed .btn {
            display: block;
        }
        #circuit-start-failed .btn {
            margin: 1.25rem auto 0;
        }
        #components-reconnect-modal .reconnect-dialog,
        #circuit-start-failed .reconnect-dialog {
            background-color: #161618;
            color: #ededef;
            padding: 2rem 3rem;
            border-radius: 6px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            text-align: center;
            min-width: 20rem;
        }
        #components-reconnect-modal .reconnect-dialog p,
        #circuit-start-failed .reconnect-dialog p {
            margin: 0;
            font-size: 1rem;
        }
        #components-reconnect-modal .reconnect-spinner,
        #circuit-start-failed .reconnect-spinner {
            width: 2rem;
            height: 2rem;
            margin: 0 auto 1rem;
            border: 3px solid rgba(255, 255, 255, 0.2);
            border-top-color: #3b82f6;
            border-radius: 50%;
            animation: reconnect-spin 0.8s linear infinite;
        }
        @@keyframes reconnect-spin {
            to { transform: rotate(360deg); }
        }
    </style>
    <!-- Tippy.js for interactive tooltips/popovers -->
    <script src="https://unpkg.com/@@popperjs/core@2"></script>
    <script src="https://unpkg.com/tippy.js@6"></script>
    <!-- Three.js importmap. Vendored under /lib/three/. Used by the 3D LAN flow map (spec 5.7). -->
    <script type="importmap">
    {
        "imports": {
            "three": "/lib/three/three.module.js",
            "three/addons/": "/lib/three/addons/"
        }
    }
    </script>
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>

<body>
    <script>
        // Apply kiosk mode before the app renders so the sidebar never flashes
        // in on a kiosk display. Per-device preference; see Settings > UI / Display.
        try {
            if (localStorage.getItem('networkOptimizerKioskMode') === '1') {
                document.body.classList.add('kiosk-mode');
            }
        } catch (e) { }
    </script>
    <Routes />

    <!-- Custom reconnect modal (prevents Blazor from injecting shadow DOM version) -->
    <div id="components-reconnect-modal">
        <div class="reconnect-dialog">
            <div class="reconnect-spinner"></div>
            <p>Reconnecting...</p>
        </div>
    </div>

    <div id="circuit-start-failed" role="alert">
        <div class="reconnect-dialog">
            <div class="reconnect-spinner"></div>
            <p class="circuit-start-retrying">Connecting...</p>
            <p class="circuit-start-message">This page could not connect to Network Optimizer.</p>
            <button type="button" class="btn btn-primary">Reload</button>
        </div>
    </div>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/circuit-start.js")"></script>

    <script>window.__noSiteDefault = "@(NetworkOptimizer.Web.Services.SiteManagementService.DefaultSiteSlug)";</script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/passkey.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/federated-login.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/display-time.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/site-context.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/collapse-reveal.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/card-index.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/chart-defaults.js")"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/scrollRestoration.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/updateCheck.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/steppedScaleBar.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/tour.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/map-address-search.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/map-satellite.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "lib/heic2any.min.js")"></script>
    <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/floorPlanEditor.js")"></script>
    @if (!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("DEMO_MODE_MAPPINGS")))
    {
        <script src="@FileVersionProvider.AddFileVersionToPath("/", "js/demo-mask.js")"></script>
    }
    <script>
        // Kiosk mode: per-device (localStorage), forces the collapsed hamburger
        // layout at any width so a mini-display shows just the content.
        function setKioskMode(enabled) {
            try {
                if (enabled) {
                    localStorage.setItem('networkOptimizerKioskMode', '1');
                    document.body.classList.add('kiosk-mode');
                } else {
                    localStorage.removeItem('networkOptimizerKioskMode');
                    document.body.classList.remove('kiosk-mode');
                }
            } catch (e) { }
        }

        function getKioskMode() {
            try {
                return localStorage.getItem('networkOptimizerKioskMode') === '1';
            } catch (e) {
                return false;
            }
        }

        function downloadFile(fileName, contentType, base64Data) {
            const bytes = Uint8Array.from(atob(base64Data), c => c.charCodeAt(0));
            saveBlob(new Blob([bytes], { type: contentType }), fileName);
        }

        // Downloads a server endpoint's response as a file. Returns null, or why it failed. For files too
        // large to pass through a .NET-to-JS call, which serializes as one JSON string.
        async function downloadUrl(url, fileName) {
            try {
                const response = await fetch(url, { credentials: 'same-origin' });
                if (!response.ok) return `the server answered ${response.status}`;
                saveBlob(await response.blob(), fileName);
                return null;
            } catch (e) {
                console.error('downloadUrl failed', e);
                return e.message || 'the download did not complete';
            }
        }

        // An app added to the iOS home screen does nothing with <a download> for a file it cannot show (YAML, JSON,
        // CSV): no error, no file. A PDF it opens in its viewer, so only other files go to the share sheet there.
        function isIosHomeScreenApp() {
            const ios = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
            return ios && (navigator.standalone === true || window.matchMedia('(display-mode: standalone)').matches);
        }

        // A File the share sheet accepts: its own type, else plain text for text formats (YAML, JSON, CSV).
        function shareableFile(blob, fileName) {
            if (!navigator.canShare) return null;
            const types = [blob.type || 'application/octet-stream'];
            if (/^(text\/|application\/(json|yaml|x-yaml|csv))/.test(blob.type)) types.push('text/plain');
            for (const type of types) {
                const file = new File([blob], fileName, { type });
                if (navigator.canShare({ files: [file] })) return file;
            }
            return null;
        }

        // A blob link with download, as the PDF exports already do (a data: URL is not reliable in a Safari PWA).
        // Returns at once: the share sheet stays open as long as the person likes, past any interop timeout.
        function saveBlob(blob, fileName) {
            if (isIosHomeScreenApp() && blob.type !== 'application/pdf') {
                const file = shareableFile(blob, fileName);
                if (file) {
                    // iOS allows the share sheet only during a tap; after the server round trip it can be too
                    // late. A tap on the prompt opens it. AbortError is the person closing the sheet.
                    navigator.share({ files: [file] }).catch(e => { if (e.name !== 'AbortError') showSavePrompt(file); });
                    return;
                }
            }
            const href = URL.createObjectURL(blob);
            const downloadLink = document.createElement('a');
            downloadLink.href = href;
            downloadLink.download = fileName;
            document.body.appendChild(downloadLink);
            downloadLink.click();
            downloadLink.remove();
            setTimeout(() => URL.revokeObjectURL(href), 60000);
        }

        function showSavePrompt(file) {
            document.querySelector('.save-file-prompt')?.remove();
            const bar = document.createElement('div');
            bar.className = 'save-file-prompt';
            bar.setAttribute('role', 'status');
            const name = document.createElement('span');
            name.className = 'save-file-name';
            name.textContent = file.name;
            const save = document.createElement('button');
            save.type = 'button';
            save.className = 'btn btn-primary btn-sm';
            save.textContent = 'Save file';
            save.addEventListener('click', async () => {
                bar.remove();
                try { await navigator.share({ files: [file] }); } catch (e) { if (e.name !== 'AbortError') console.error('share failed', e); }
            });
            const close = document.createElement('button');
            close.type = 'button';
            close.className = 'save-file-close';
            close.setAttribute('aria-label', 'Dismiss');
            close.textContent = '\u00d7';
            close.addEventListener('click', () => bar.remove());
            bar.append(name, save, close);
            document.body.appendChild(bar);
        }

        // Copy a shared secret from the sibling input, stripping the grouping spaces. The key is
        // displayed in groups of four because that is what a human can read back, but an
        // authenticator app wants the bare base32 string.
        function copySecretFromInput(button) {
            const input = button.previousElementSibling;
            const text = input.value.replace(/\s+/g, '');

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text);
            } else {
                input.select();
                input.setSelectionRange(0, 99999);
                document.execCommand('copy');
            }
            input.blur();

            const icon = button.querySelector('.copy-icon');
            const check = button.querySelector('.copy-check');
            if (icon && check) {
                icon.style.display = 'none';
                check.style.display = 'inline-flex';
                setTimeout(function () {
                    icon.style.display = 'inline-flex';
                    check.style.display = 'none';
                }, 1500);
            }
        }

        // Show or hide the sibling password field (PasswordInput). Done here, not in the circuit:
        // Blazor did not apply a changed type attribute to the input, so the field stayed masked.
        function togglePasswordVisibility(button) {
            const input = button.previousElementSibling;
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            button.setAttribute('aria-pressed', show ? 'true' : 'false');
            button.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        }

        // Copy a command block's text. Same tick-swap feedback as the input copiers; the text comes
        // from the sibling <pre>, whose textContent is exactly what was rendered.
        function copyFromCodeBlock(button) {
            const block = button.parentElement.querySelector('pre');
            if (!block) return;
            const text = block.textContent;

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text);
            } else {
                const scratch = document.createElement('textarea');
                scratch.value = text;
                scratch.setAttribute('readonly', '');
                scratch.style.position = 'absolute';
                scratch.style.left = '-9999px';
                document.body.appendChild(scratch);
                scratch.select();
                document.execCommand('copy');
                document.body.removeChild(scratch);
            }

            const icon = button.querySelector('.copy-icon');
            const check = button.querySelector('.copy-check');
            if (icon && check) {
                icon.style.display = 'none';
                check.style.display = 'inline-flex';
                setTimeout(function () {
                    icon.style.display = 'inline-flex';
                    check.style.display = 'none';
                }, 1500);
            }
        }

        // Copy text from sibling input element with visual feedback
        function copyFromInput(button) {
            const input = button.previousElementSibling;
            const text = input.value;

            // Try modern API first (requires HTTPS)
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text);
            } else {
                // Fallback for HTTP contexts
                input.select();
                input.setSelectionRange(0, 99999);
                document.execCommand('copy');
            }
            input.blur();

            // Visual feedback
            const icon = button.querySelector('.copy-icon');
            const check = button.querySelector('.copy-check');
            icon.style.display = 'none';
            check.style.display = 'inline';
            setTimeout(() => {
                icon.style.display = 'inline';
                check.style.display = 'none';
            }, 2000);
        }

        // Tooltip text is data, not markup: a device name or firmware string from the console
        // must never run on hover. Only a sibling .tooltip-content block or an explicit
        // data-tooltip-html opt-in renders as HTML; everything else is escaped here, with
        // newlines kept as line breaks.
        function tooltipContent(el) {
            var raw = el.dataset.tooltip || '';
            if (el.hasAttribute('data-tooltip-html')) return raw;
            return raw.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/\n/g, '<br>');
        }

        // A tooltip that is open takes changed text in place. Rebuilding it closes it, so one whose
        // text carries a live reading (a Wi-Fi link's signal) shut on every poll. Returns true if it did.
        function refreshOpenTip(el) {
            var tip = el._tippy;
            if (!tip || !tip.state.isVisible) return false;
            tip.setContent(tooltipContent(el));
            tip.popper.querySelectorAll('a').forEach(function (link) {
                link.addEventListener('click', function () { tip.unmount(); });
            });
            return true;
        }

        // A cut cell's full text, or the tooltip of a child marked data-tooltip-names-cut: that tooltip
        // already names the full text and says more (Live DNS's redirect), so one tooltip covers both.
        function cutText(el) {
            var names = el.matches('[data-tooltip-names-cut]') ? el : el.querySelector('[data-tooltip-names-cut]');
            return names ? (names.getAttribute('data-tooltip') || '') : (el.textContent || '').trim();
        }

        // A small X at the top right of a tooltip that stays up (interactive: it has links to click), so
        // it can be put away without moving off it. On the box, not the content: setContent keeps it.
        function addTipClose(instance) {
            var box = instance.popper.querySelector('.tippy-box');
            if (!box || box.querySelector('.tip-close')) return;
            var x = document.createElement('button');
            x.type = 'button';
            x.className = 'tip-close';
            x.setAttribute('aria-label', 'Close');
            x.textContent = '×';
            x.addEventListener('click', function (e) { e.stopPropagation(); instance.hide(); });
            box.appendChild(x);
        }

        // One tooltip on screen at a time: the newest one to mount hides the rest at once. A plugin, not a
        // default onMount, because a tooltip's own onMount replaces a default but runs beside a plugin.
        // Fixed positioning: a tooltip or card that follows its reference out of the scroll area never
        // grows the document, which flashed a second, whole-page scrollbar beside .page-content's.
        if (window.tippy) {
            tippy.setDefaultProps({
                popperOptions: { strategy: 'fixed' },
                plugins: [{
                    name: 'newestOnly',
                    fn: function (instance) {
                        return { onMount: function () { tippy.hideAll({ exclude: instance, duration: 0 }); } };
                    }
                }]
            });
        }

        // Live Traffic's filter editor is a bottom sheet on a phone: dragging its handle or header down
        // closes it, through the backdrop tap that already does. Short of 80px it springs back.
        (function () {
            var drag = null;
            var end = function () {
                if (!drag) return;
                var d = drag;
                drag = null;
                d.sheet.style.transition = 'transform 0.15s ease-out';
                var backdrop = d.sheet.previousElementSibling;
                if (d.dy > 80 && backdrop && backdrop.classList.contains('lt-fpop-backdrop')) backdrop.click();
                else d.sheet.style.transform = '';
            };
            document.addEventListener('touchstart', function (e) {
                if (!e.target.closest || !window.matchMedia('(max-width: 768px)').matches) return;
                var handle = e.target.closest('.lt-fpop-grab, .lt-fpop-head');
                // The header's Include / Exclude keep their taps.
                if (!handle || e.target.closest('button, input')) return;
                drag = { sheet: handle.closest('.lt-fpop'), y: e.touches[0].clientY, dy: 0 };
                drag.sheet.style.transition = 'none';
            }, { passive: true });
            document.addEventListener('touchmove', function (e) {
                if (!drag) return;
                drag.dy = Math.max(0, e.touches[0].clientY - drag.y);
                drag.sheet.style.transform = 'translateY(' + drag.dy + 'px)';
            }, { passive: true });
            document.addEventListener('touchend', end);
            document.addEventListener('touchcancel', end);
        })();

        // The X takes room at the right: a tooltip that has one may draw that much wider before it wraps.
        function withCloseRoom(maxWidth) {
            return String(maxWidth).replace(/(\d+)px\)$/, function (m, px) { return (+px + 24) + 'px)'; });
        }

        // The nearest ancestor its ellipsis is cutting, within a few levels, where the cut-name tooltip
        // runs (the mouseover handler's hosts); null when none is, so the child keeps its own tooltip.
        function cutAncestor(el) {
            if (!el.closest('.live-traffic, .bandwidth-hogs-card')) return null;
            for (var p = el.parentElement, i = 0; p && i < 4; p = p.parentElement, i++) {
                if (getComputedStyle(p).textOverflow === 'ellipsis' && p.scrollWidth > p.clientWidth + 1) return p;
            }
            return null;
        }

        // Initialize Tippy.js tooltips
        function initTooltips() {
            // Find all tooltip icons with content siblings
            document.querySelectorAll('.tooltip-icon').forEach(function(icon) {
                // Already built: a Blazor re-render swaps only the attribute, so push the new text
                // into the instance rather than leaving the text it was built with.
                if (icon._tippy) {
                    if (icon.dataset.tooltip && icon._tippy.props.content !== tooltipContent(icon)) {
                        icon._tippy.setContent(tooltipContent(icon));
                    }
                    return;
                }

                // Get content from sibling or data attribute
                const contentEl = icon.nextElementSibling;
                let content;

                // Check for wide tooltip class
                let isWide = false;
                if (contentEl && contentEl.classList.contains('tooltip-content')) {
                    content = contentEl.innerHTML;
                    isWide = contentEl.classList.contains('tooltip-wide');
                    contentEl.style.display = 'none'; // Hide the original content element
                } else if (icon.dataset.tooltip) {
                    content = tooltipContent(icon);
                } else {
                    return;
                }

                var iconOpts = {
                    content: content,
                    allowHTML: true,
                    interactive: true,
                    interactiveBorder: 10,
                    trigger: 'mouseenter click',
                    hideOnClick: true,
                    delay: [100, 200],
                    placement: 'top',
                    theme: 'custom',
                    appendTo: document.body,
                    maxWidth: isWide ? 'min(100vw - 10px, 400px)' : 'min(100vw - 10px, 360px)',
                    onShow(instance) {
                        // Close other open tooltips
                        document.querySelectorAll('.tooltip-icon').forEach(function(other) {
                            if (other !== icon && other._tippy) {
                                other._tippy.hide();
                            }
                        });
                    },
                    onMount(instance) {
                        // Hide tooltip when clicking links inside it (before Blazor navigation)
                        instance.popper.querySelectorAll('a').forEach(function(link) {
                            link.addEventListener('click', function() {
                                instance.unmount();
                            });
                        });
                    },
                    onClickOutside(instance, event) {
                        instance.hide();
                    }
                };
                // An icon that DOES something on click must not also open on click: the click
                // re-renders or navigates, the reference element goes away mid-show, and the popper
                // is left parented to the body with nothing to position against - it strands itself
                // in the top-left corner and no longer has a reference to hide it. Hover still shows
                // it; touch gets nothing, which is what it already got, since the tap acts instead.
                if (icon.hasAttribute('data-tooltip-hover-only')) {
                    iconOpts.trigger = 'mouseenter';
                    iconOpts.touch = false;
                }
                tippy(icon, iconOpts);
            });

            // Simple tooltips for elements with data-tooltip (not .tooltip-icon)
            document.querySelectorAll('[data-tooltip]:not(.tooltip-icon)').forEach(function(el) {
                // Destroy existing tippy if content changed (Blazor may reuse elements)
                if (el._tippy) {
                    if (el._tippy.props.content === tooltipContent(el)) {
                        return; // Content unchanged, keep existing
                    }
                    if (refreshOpenTip(el)) return;
                    el._tippy.destroy();
                }
                var isInteractive = el.hasAttribute('data-tooltip-interactive');
                var opts = {
                    content: tooltipContent(el),
                    allowHTML: true,
                    trigger: el.hasAttribute('data-tooltip-hover') ? 'mouseenter' : 'mouseenter click',
                    hideOnClick: true,
                    delay: [100, 200],
                    placement: 'top',
                    theme: 'custom',
                    appendTo: document.body,
                    maxWidth: el.hasAttribute('data-tooltip-wrap')
                        ? 'min(100vw - 10px, 320px)'
                        : el.hasAttribute('data-tooltip-wide')
                            ? 'min(100vw - 10px, 400px)'
                            : 'min(100vw - 10px, 360px)',
                    onShow: function(instance) {
                        var ref = instance.reference;
                        // data-tooltip-truncated: only when the text is cut off by its ellipsis
                        if (ref.hasAttribute('data-tooltip-truncated') && ref.scrollWidth <= ref.clientWidth + 1) {
                            return false;
                        }
                        // data-tooltip-names-cut: the cut-name tooltip on a cut ancestor shows this text instead.
                        if (ref.hasAttribute('data-tooltip-names-cut') && cutAncestor(ref)) {
                            return false;
                        }
                        // Suppress if an adjacent sibling already shows the same tooltip.
                        // data-tooltip-distinct: siblings are separate things that can share a text (site tiles).
                        if (ref.hasAttribute('data-tooltip-distinct')) return;
                        var siblings = [ref.previousElementSibling, ref.nextElementSibling];
                        for (var i = 0; i < siblings.length; i++) {
                            var sib = siblings[i];
                            if (sib && sib._tippy && sib._tippy.state.isVisible &&
                                sib._tippy.props.content === instance.props.content) {
                                return false; // Cancel showing
                            }
                        }
                    }
                };
                if (isInteractive) {
                    opts.interactive = true;
                    opts.interactiveBorder = 10;
                    opts.maxWidth = withCloseRoom(opts.maxWidth);
