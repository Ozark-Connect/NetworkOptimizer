<Project>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.*" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 (pulled transitively by Microsoft.Data.Sqlite /
         EF Core Sqlite 10.0.7) is flagged for GHSA-2m69-gcr7-jv3q, a vulnerability in the
         bundled native SQLite. We are not in the affected code path: the app opens only its
         own EF-managed database, never foreign .db files or untrusted SQL. The EF team's
         sanctioned interim is to suppress this advisory (they cannot bump the managed bundle
         to v3 in a patch - it's a breaking change); the real fix ships in EF 10.0.11.
         See https://github.com/dotnet/efcore/issues/38257 - REMOVE this when we move to 10.0.11. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />

    <!-- System.Security.Cryptography.Xml 10.0.7 is pulled in only by the declared dependency of
         ITfoxtec.Identity.Saml2 4.20.1 (our SAML SP). On net10.0 the SDK prunes it - the assembly
         is part of the shared framework, so after restore the package resolves to nothing and the
         flagged 10.0.7 never ships. Confirmed by adding an explicit 10.0.10 reference, which
         silenced these but raised NU1510 ("will not be pruned ... likely unnecessary"), the SDK
         saying the explicit reference is the wrong fix.
         REMOVE these when ITfoxtec.Identity.Saml2 bumps its dependency past 10.0.7. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-23rf-6693-g89p" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-8q5v-6pqq-x66h" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-cvvh-rhrc-wg4q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g8r8-53c2-pm3f" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-mmjf-rqrv-855v" />
  </ItemGroup>
  <PropertyGroup>
    <!-- MinVer derives version from git tags (e.g., v0.7.3 -> 0.7.3) -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
</Project>
